<div class="dropdown user-menu">
 <button class="btn user-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><span class="user-avatar"><i class="bi bi-person" aria-hidden="true"></i></span><span class="user-info"><span class="user-name">@(User.Identity?.Name ?? "Usuário")</span><small>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Perfil")</small></span></button>
 <ul class="dropdown-menu dropdown-menu-end shadow"><li><a class="dropdown-item" asp-controller="Configuracoes" asp-action="MeuPerfil"><i class="bi bi-person-gear me-2"></i>Meu perfil</a></li><li><hr class="dropdown-divider" /></li><li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li></ul>
</div>
