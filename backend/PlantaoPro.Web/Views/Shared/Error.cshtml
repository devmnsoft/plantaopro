@{
    ViewData["Title"] = "Erro";
}
<section class="pp-error-page" role="alert" aria-labelledby="errorTitle">
    <span class="pp-error-page__icon" aria-hidden="true"><app-icon name="Warning" size="30" /></span>
    <div>
        <span class="pp-eyebrow">Falha recuperável</span>
        <h1 id="errorTitle">Não foi possível concluir a operação</h1>
        <p>Ocorreu uma instabilidade. Seus dados não devem ser reenviados até você confirmar o estado da operação. Nenhum detalhe técnico foi exposto por segurança.</p>
        <div class="pp-error-page__actions"><a class="btn btn-primary" asp-controller="MinhaCentral" asp-action="Index">Ir para Minha Central</a><a class="btn btn-outline-secondary" asp-controller="Ajuda" asp-action="Index">Obter ajuda</a></div>
    </div>
</section>
