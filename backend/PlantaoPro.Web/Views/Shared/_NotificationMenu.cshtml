<a class="btn btn-light btn-icon position-relative" asp-controller="Notificacoes" asp-action="Index" title="Notificações" aria-label="Notificações">
 <i class="bi bi-bell" aria-hidden="true"></i>
 @if (((ViewBag.NotificationCount as int?) ?? 0) > 0) { <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">@ViewBag.NotificationCount<span class="visually-hidden"> notificações não lidas</span></span> }
</a>
