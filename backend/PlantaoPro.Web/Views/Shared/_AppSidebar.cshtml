@using PlantaoPro.Web.Services.Security
@inject IMenuBuilderService MenuBuilder
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var tenantName = User.FindFirst("cliente")?.Value ?? User.FindFirst("tenant")?.Value ?? "Contexto global";
    var planName = User.FindFirst("plano")?.Value ?? "Plano não informado";
}
<aside class="app-sidebar" id="appSidebar" aria-label="Navegação principal">
 <div class="sidebar-brand">
  <img src="~/branding/logo-horizontal-light.svg" alt="PlantãoPro" class="brand-logo tenant-logo-light" />
  <div class="brand-subtitle" title="@tenantName">@tenantName</div>
  <div class="sidebar-badges"><span class="pp-pill pp-pill-soft"><i class="bi bi-gem" aria-hidden="true"></i>@planName</span></div>
 </div>
 <nav class="sidebar-nav">
 @foreach (var group in MenuBuilder.Build(controller, action)) {
  <div class="nav-section-title"><i class="bi @group.Icon" aria-hidden="true"></i><span>@group.Title</span></div>
  @foreach (var item in group.Items) {
   if (item.IsLocked) { <span class="nav-link-app locked" title="@item.LockedReason" aria-disabled="true"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Title</span><small>Bloqueado</small></span> }
   else { <a class="nav-link-app @(item.IsActive ? "active" : string.Empty)" asp-controller="@item.Controller" asp-action="@item.Action" title="@item.Title" aria-current="@(item.IsActive ? "page" : null)"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Title</span></a> }
  }
 }
 </nav>
 <button class="nav-link-app sidebar-collapse m-3 border-0" id="sidebarCollapse" type="button" aria-controls="appSidebar" aria-expanded="true"><i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i><span>Recolher menu</span></button>
</aside>
