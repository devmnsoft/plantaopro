@model string?
@{
    // R71: componente canonico de estado — sempre icone + texto (nunca cor sozinha).
    // O pareamento estado->tom/icone vem do mapa unico EstadoVisual; a cor do tom
    // vive somente na camada canonica v2151 (secao 9, tokens --pp-tone-*).
    var estado = EstadoVisual.Interpretar(Model);
    var rotulo = estado.Rotulo.Replace('_', ' ').Replace('-', ' ');
}
<span class="status-badge pp-status pp-status--@estado.Tom status-@estado.Nome" role="status" aria-label="Status: @rotulo"><i class="bi @estado.Icone" aria-hidden="true"></i><span data-status-label>@rotulo</span></span>
