@model PlantaoPro.Web.Models.DetailsPageViewModel<PlantaoPro.Web.Models.MedicoDto>
@{
    ViewData["Title"] = "Profissional";
    var vm = Model;
}
<div class="container py-4" style="max-width: 720px">
    <h1 class="h3 mb-3">Detalhes do profissional</h1>
    @if (vm is null || vm.IsPlaceholder || vm.Data is null)
    {
        <div class="alert alert-info">Os detalhes deste profissional não estão disponíveis agora.</div>
    }
    else if (!string.IsNullOrEmpty(vm.ErrorMessage))
    {
        <div class="alert alert-warning">@vm.ErrorMessage</div>
    }
    else
    {
        var p = vm.Data;
        <dl class="row mb-4">
            <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@p.Nome</dd>
            <dt class="col-sm-3">CPF</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Cpf) ? "Não informado" : p.Cpf)</dd>
            <dt class="col-sm-3">Registro</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Crm) ? "Não informado" : $"{p.Crm}/{p.UfCrm}")</dd>
            <dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Email) ? "Não informado" : p.Email)</dd>
            <dt class="col-sm-3">Telefone</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Telefone) ? "Não informado" : p.Telefone)</dd>
            <dt class="col-sm-3">Cidade/UF</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(p.Cidade) ? "Não informado" : $"{p.Cidade}/{p.Estado}")</dd>
            <dt class="col-sm-3">Situação</dt><dd class="col-sm-9"><span class="badge bg-primary-subtle text-primary">@p.RegStatus</span></dd>
        </dl>
    }
    <a class="btn btn-outline-secondary" asp-controller="Medicos" asp-action="Index">Voltar para os profissionais</a>
</div>
