@{ ViewData["Title"]="Portal da unidade"; }
<main class="container-fluid py-4 portal-unidade" aria-labelledby="titulo-portal">
 <header class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="badge text-bg-primary mb-2">Operação em tempo real</span><h1 id="titulo-portal" class="h2 mb-1">Portal da unidade</h1><p class="text-secondary mb-0">Cobertura contratada, solicitações e decisões em um único contexto seguro.</p></div><a asp-action="NovaSolicitacao" class="btn btn-primary">Solicitar plantões</a></header>
 <section class="pp-onboarding-card" aria-labelledby="unit-first-step"><span class="pp-onboarding-card__icon"><i class="bi bi-compass" aria-hidden="true"></i></span><div><h2 id="unit-first-step">Primeiro passo: confira a cobertura</h2><p>Quando precisar ampliar a equipe, registre uma solicitação com período e especialidade.</p></div><a asp-action="NovaSolicitacao" class="btn btn-sm btn-outline-primary">Criar solicitação</a></section>
 <section class="row g-3 mb-4" aria-label="Indicadores da unidade">
  @foreach(var item in new[]{("Hoje","--","calendar"),("Cobertura","--%","shield-check"),("Descobertos","--","alert-triangle"),("SLA","Aguardando dados","activity")}){<div class="col-6 col-xl-3"><article class="card h-100 border-0 shadow-sm"><div class="card-body"><span class="text-secondary small">@item.Item1</span><strong class="d-block fs-4 mt-2">@item.Item2</strong></div></article></div>}
 </section>
 <div class="row g-4"><section class="col-lg-8"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">Cobertura contratada</h2><span class="badge text-bg-secondary">Unidade atual</span></div><div class="alert alert-light border mt-4" role="status">Os indicadores serão carregados com os dados reais da unidade selecionada. Nenhum dado de outro tenant é exibido.</div><div class="progress" aria-label="Cobertura carregando"><div class="progress-bar progress-bar-striped progress-bar-animated" style="width:100%"></div></div></div></div></section>
 <aside class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Notificações operacionais</h2><div class="pp-future-empty-state text-center py-4"><div class="empty-state-icon"><i class="bi bi-bell" aria-hidden="true"></i></div><h3 class="h6">Tudo acompanhado por aqui</h3><p class="text-secondary mb-0">Nenhuma notificação recente. Novas atualizações da unidade aparecerão nesta área.</p></div></div></div></aside></div>
</main>
