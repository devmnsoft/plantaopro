@model PlantaoPro.Web.Models.Saude360FormViewModel
@{
    var vm = Model ?? new PlantaoPro.Web.Models.Saude360FormViewModel();
    ViewData["Title"] = vm.Titulo;
}

@if (ViewBag.AssistenteContextual is PlantaoPro.Web.Models.AssistenteContextualViewModel assistenteContextual)
{
    @await Html.PartialAsync("_AssistenteContextual", assistenteContextual)
}

@await Html.PartialAsync("_PageHelp", new PlantaoPro.Web.Models.PageHelpViewModel
{
    Title = vm.Titulo,
    Description = UiText.L("Clinical.FormHelpDescription"),
    WhenToUse = UiText.L("Clinical.FormHelpWhenToUse"),
    StepByStep = new List<string> { UiText.L("Clinical.FormHelpStep1"), UiText.L("Clinical.FormHelpStep2"), UiText.L("Clinical.FormHelpStep3"), UiText.L("Clinical.FormHelpStep4") },
    Tips = new List<string> { UiText.L("Clinical.FormHelpTip1"), UiText.L("Clinical.FormHelpTip2"), UiText.L("Clinical.FormHelpTip3") },
    ProfileNotes = UiText.L("Clinical.FormHelpProfileNotes"),
    DocumentationUrl = Url.Action("Perfil", "Manual") ?? string.Empty
})

<div class="d-flex justify-content-between align-items-center mb-4 saude360-page-header">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">PlantãoPro @UiText.L("Nav.SectionClinical")</p>
        <h1 class="h3 mb-0">@vm.Titulo</h1>
        <p class="text-muted mb-0">@UiText.L("Clinical.FormSubline")</p>
    </div>
    <a asp-controller="@vm.Controller" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@UiText.L("Shift.Back")</a>
</div>

<form asp-controller="@vm.Controller" asp-action="Salvar" method="post" class="pp-form card border-0 shadow-sm saude360-form clinical-mvp-journey" data-saude360-form data-clinical-mvp-journey data-next-action aria-describedby="saude360-form-hint" data-focus-invalid data-unsaved-form>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ApiEndpoint" />
    <input type="hidden" asp-for="Controller" />
    <input type="hidden" asp-for="Action" />
    <input type="hidden" asp-for="Id" />
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="pp-alert pp-alert--danger" role="alert" aria-live="assertive"></div>
        <p id="saude360-form-hint" class="visually-hidden">@UiText.L("Clinical.FormHiddenHint")</p>
        <h2 class="h6 text-uppercase text-primary">@UiText.L("Clinical.SectionPersonalData")</h2>
        <div class="row g-3 mb-4">
            <div class="col-md-5"><label asp-for="Nome" class="form-label">@UiText.L("Clinical.LabelFullName")</label><input asp-for="Nome" class="form-control" maxlength="180" /></div>
            <div class="col-md-3"><label asp-for="NomeSocial" class="form-label">@UiText.L("Clinical.LabelSocialName")</label><input asp-for="NomeSocial" class="form-control" maxlength="180" /></div>
            <div class="col-md-2"><label asp-for="DataNascimento" class="form-label">@UiText.L("Clinical.LabelBirthDate")</label><input asp-for="DataNascimento" type="date" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="SexoGenero" class="form-label">@UiText.L("Clinical.LabelGender")</label><input asp-for="SexoGenero" class="form-control" maxlength="40" /></div>
            <div class="col-md-3"><label asp-for="Cpf" class="form-label">@UiText.L("Clinical.LabelCpfOptional")</label><input asp-for="Cpf" class="form-control" maxlength="20" /></div>
            <div class="col-md-3"><label asp-for="Cns" class="form-label">@UiText.L("Clinical.LabelCns")</label><input asp-for="Cns" class="form-control" maxlength="30" /></div>
            <div class="col-md-3"><label asp-for="DocumentoAlternativo" class="form-label">@UiText.L("Clinical.LabelAltDocument")</label><input asp-for="DocumentoAlternativo" class="form-control" maxlength="80" /></div>
            <div class="col-md-3"><label asp-for="ResponsavelNome" class="form-label">@UiText.L("Clinical.LabelResponsible")</label><input asp-for="ResponsavelNome" class="form-control" maxlength="180" /></div>
        </div>

        <h2 class="h6 text-uppercase text-primary">@UiText.L("Clinical.SectionContactAddress")</h2>
        <div class="row g-3 mb-4">
            <div class="col-md-4"><label asp-for="Telefone" class="form-label">@UiText.L("Profile.Phone")</label><input asp-for="Telefone" class="form-control" maxlength="40" /></div>
            <div class="col-md-4"><label asp-for="Email" class="form-label">@UiText.L("Clinical.LabelEmail")</label><input asp-for="Email" type="email" class="form-control" maxlength="180" /></div>
            <div class="col-md-4"><label asp-for="Endereco" class="form-label">@UiText.L("Clinical.LabelAddress")</label><input asp-for="Endereco" class="form-control" maxlength="300" /></div>
        </div>

        <h2 class="h6 text-uppercase text-primary">@UiText.L("Clinical.SectionScheduleLinks")</h2>
        <div class="row g-3 mb-4">
            <div class="col-md-4">@await Html.PartialAsync("_LookupSelect", new PlantaoPro.Web.Models.LookupSelectViewModel { FieldName = nameof(vm.PacienteId), Label = UiText.L("Clinical.JourneyPatient"), Endpoint = "/api/lookups/pacientes", Value = vm.PacienteId?.ToString() ?? string.Empty, Placeholder = UiText.L("Clinical.LookupPatientPlaceholder") })</div>
            <div class="col-md-4">@await Html.PartialAsync("_LookupSelect", new PlantaoPro.Web.Models.LookupSelectViewModel { FieldName = nameof(vm.MedicoId), Label = UiText.L("Clinical.LookupDoctor"), Endpoint = "/api/lookups/medicos", Value = vm.MedicoId?.ToString() ?? string.Empty, Placeholder = UiText.L("Clinical.LookupDoctorPlaceholder") })</div>
            <div class="col-md-4">@await Html.PartialAsync("_LookupSelect", new PlantaoPro.Web.Models.LookupSelectViewModel { FieldName = nameof(vm.AgendamentoId), Label = UiText.L("Clinical.JourneyAppointment"), Endpoint = "/api/lookups/agendamentos", Value = vm.AgendamentoId?.ToString() ?? string.Empty, Placeholder = UiText.L("Clinical.LookupAppointmentPlaceholder") })</div>
            <div class="col-md-4">@await Html.PartialAsync("_LookupSelect", new PlantaoPro.Web.Models.LookupSelectViewModel { FieldName = nameof(vm.ConsultaId), Label = UiText.L("Clinical.JourneyConsult"), Endpoint = "/api/lookups/consultas", Value = vm.ConsultaId?.ToString() ?? string.Empty, Placeholder = UiText.L("Clinical.LookupConsultPlaceholder") })</div>
            <div class="col-md-4">@await Html.PartialAsync("_LookupSelect", new PlantaoPro.Web.Models.LookupSelectViewModel { FieldName = nameof(vm.PlanoSaudeId), Label = UiText.L("Clinical.LookupHealthPlan"), Endpoint = "/api/lookups/planos-saude", Value = vm.PlanoSaudeId?.ToString() ?? string.Empty, Placeholder = UiText.L("Clinical.LookupPlanPlaceholder") })</div>
            <div class="col-md-4"><label asp-for="Especialidade" class="form-label">@UiText.L("Shift.ThSpecialty")</label><input asp-for="Especialidade" class="form-control" maxlength="120" /></div>
            <div class="col-md-3"><label asp-for="DataInicio" class="form-label">@UiText.L("Shift.Start")</label><input asp-for="DataInicio" type="datetime-local" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DataFim" class="form-label">@UiText.L("Shift.End")</label><input asp-for="DataFim" type="datetime-local" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Codigo" class="form-label">@UiText.L("Clinical.ThCode")</label><input asp-for="Codigo" class="form-control" maxlength="80" /></div>
            <div class="col-md-3"><label asp-for="Valor" class="form-label">@UiText.L("Shift.Value")</label><input asp-for="Valor" type="number" step="0.01" class="form-control" /></div>
        </div>

        <h2 class="h6 text-uppercase text-primary" data-triage-rules>@UiText.L("Clinical.SectionTriageVitals")</h2>
        <div class="row g-3 mb-4">
            <div class="col-md-4"><label asp-for="QueixaPrincipal" class="form-label">@UiText.L("Clinical.LabelChiefComplaint")</label><input asp-for="QueixaPrincipal" class="form-control" maxlength="500" /></div>
            <div class="col-md-4"><label asp-for="ClassificacaoRisco" class="form-label">@UiText.L("Clinical.LabelRiskClassification")</label><select asp-for="ClassificacaoRisco" class="form-select" required="@(string.Equals(vm.Controller, "Triagem", StringComparison.OrdinalIgnoreCase) ? "required" : null)" aria-describedby="risco-help"><option value="">@UiText.L("Clinical.LabelSelectOption")</option><option>EMERGENCIA</option><option>MUITO_URGENTE</option><option>URGENTE</option><option>POUCO_URGENTE</option><option>NAO_URGENTE</option></select><small id="risco-help">@UiText.L("Clinical.TriageRiskHelp")</small></div>
            <div class="col-md-2"><label asp-for="PressaoSistolica" class="form-label">@UiText.L("Clinical.VitalSystolic")</label><input asp-for="PressaoSistolica" type="number" step="1" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="PressaoDiastolica" class="form-label">@UiText.L("Clinical.VitalDiastolic")</label><input asp-for="PressaoDiastolica" type="number" step="1" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="FrequenciaCardiaca" class="form-label">@UiText.L("Clinical.VitalHeartRate")</label><input asp-for="FrequenciaCardiaca" type="number" step="1" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="FrequenciaRespiratoria" class="form-label">@UiText.L("Clinical.VitalRespRate")</label><input asp-for="FrequenciaRespiratoria" type="number" step="1" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="Temperatura" class="form-label">@UiText.L("Clinical.VitalTemperature")</label><input asp-for="Temperatura" type="number" step="0.1" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="Saturacao" class="form-label">@UiText.L("Clinical.VitalSpO2")</label><input asp-for="Saturacao" type="number" step="0.1" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="Peso" class="form-label">@UiText.L("Clinical.VitalWeight")</label><input asp-for="Peso" type="number" step="0.01" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="Altura" class="form-label">@UiText.L("Clinical.VitalHeight")</label><input asp-for="Altura" type="number" step="0.001" class="form-control" /></div>
        </div>

        <h2 class="h6 text-uppercase text-primary">@UiText.L("Clinical.SectionObservationsBilling")</h2>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="FormaPagamento" class="form-label">@UiText.L("Clinical.LabelPaymentMethod")</label><input asp-for="FormaPagamento" class="form-control" maxlength="80" /></div>
            <div class="col-md-6"><label asp-for="NumeroCarteirinha" class="form-label">@UiText.L("Clinical.LabelCardNumber")</label><input asp-for="NumeroCarteirinha" class="form-control" maxlength="80" /></div>
            <div class="col-12"><label asp-for="Descricao" class="form-label">@UiText.L("Clinical.LabelAdminNotes")</label><textarea asp-for="Descricao" class="form-control" rows="4" maxlength="2000"></textarea></div>
            <div class="col-md-6"><label asp-for="Motivo" class="form-label">@UiText.L("Clinical.LabelReason")</label><input asp-for="Motivo" class="form-control" maxlength="300" /></div>
            <div class="col-md-6"><label asp-for="Justificativa" class="form-label">@UiText.L("Clinical.LabelJustification")</label><input asp-for="Justificativa" class="form-control" maxlength="300" /></div>
            <div class="col-12 form-check ms-2"><input asp-for="Principal" class="form-check-input" /><label asp-for="Principal" class="form-check-label">@UiText.L("Clinical.LabelMarkPrimary")</label></div>
        </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-end gap-2">
        <a asp-controller="@vm.Controller" asp-action="Index" class="btn btn-outline-secondary">@UiText.L("Clinical.ButtonCancel")</a>
        <button type="submit" class="btn btn-primary" data-loading-text="@UiText.L("Clinical.LoadingSaving")"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i>@UiText.L("Clinical.ButtonSave")</button>
        @if (string.Equals(vm.Controller, "Triagem", StringComparison.OrdinalIgnoreCase))
        {
            @if (vm.Id.HasValue)
            {
                <button type="submit" class="btn btn-success" asp-controller="Triagem" asp-action="Finalizar" data-loading-text="@UiText.L("Clinical.LoadingFinalizing")">@UiText.L("Clinical.ButtonFinishTriage")</button>
            }
            else
            {
                <button type="button" class="btn btn-success" disabled title="@UiText.L("Clinical.TriageFinishDisabledTitle")">@UiText.L("Clinical.ButtonFinishTriage")</button>
            }
            <button type="button" class="btn btn-outline-primary" disabled title="@UiText.L("Clinical.TriageReferDisabledTitle")">@UiText.L("Clinical.ButtonReferConsult")</button>
        }
    </div>
</form>
