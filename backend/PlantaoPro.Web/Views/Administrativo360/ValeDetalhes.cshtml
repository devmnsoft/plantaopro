@model PlantaoPro.Web.Models.ValeDetalhesViewModel
@{
    ViewData["Title"] = $"{Model.Numero} — Vale de Consignação — Administrativo 360";
    var badgeClass = Model.Situacao switch
    {
        "RASCUNHO" => "pp-badge--neutral",
        "EM_SEPARACAO" => "pp-badge--info",
        "PRONTO_PARA_EXPEDICAO" => "pp-badge--primary",
        "EXPEDIDO" => "pp-badge--warning",
        "RETORNO_PARCIAL" => "pp-badge--warning",
        "RECONCILIADO" => "pp-badge--success",
        "CANCELADO" => "pp-badge--danger",
        _ => "pp-badge--neutral"
    };

    var totalPendente = Model.Itens.Sum(i => i.PendenteCustodia);
    var podeReconciliar = (Model.Situacao is "EXPEDIDO" or "RETORNO_PARCIAL") && totalPendente == 0;
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="h4 mb-0 text-light fw-bold">Vale @Model.Numero</h2>
                <span class="pp-badge @badgeClass">@Model.Situacao</span>
                <span class="pp-badge pp-badge--neutral">@Model.SituacaoFinanceira</span>
            </div>
            <p class="text-muted small mb-0">Destinado a @Model.Hospital — Local de Custódia: @Model.LocalDestino</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Vales" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
            <a asp-action="ValeImprimir" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-info">
                <i class="bi bi-printer me-1"></i> Imprimir Documento
            </a>
            @if (Model.Situacao == "PRONTO_PARA_EXPEDICAO")
            {
                <form asp-action="ValeExpedir" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary" onclick="this.disabled=true; this.form.submit();">
                        <i class="bi bi-send-check me-1"></i> Confirmar Expedição
                    </button>
                </form>
            }
            @if (Model.Situacao is "RASCUNHO" or "EM_SEPARACAO")
            {
                <form asp-action="ValeConcluirSeparacao" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success">
                        <i class="bi bi-check2-all me-1"></i> Concluir Separação
                    </button>
                </form>
            }
            @if (podeReconciliar)
            {
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalReconciliar">
                    <i class="bi bi-award me-1"></i> Concluir Reconciliação
                </button>
            }
            @if (Model.Situacao is "RASCUNHO" or "EM_SEPARACAO" or "PRONTO_PARA_EXPEDICAO")
            {
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalCancelarVale">
                    <i class="bi bi-x-circle me-1"></i> Cancelar Vale
                </button>
            }
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-2"><i class="bi bi-info-circle me-2"></i>Como acompanhar um vale de consignação</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">1. Para que serve</strong>
                    Acompanhar cada etapa do kit que vai ao hospital: separação, expedição e a reconciliação quando o material volta.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">2. Como utilizar</strong>
                    Olhe a situação do vale no topo. Os botões mudam com a etapa: é possível concluir a separação, expedir o vale pronto e reconciliar o que já voltou.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">3. Efeito da expedição</strong>
                    Confirmar a expedição registra a saída do material da custódia e habilita a impressão do documento para o hospital.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">4. Próxima ação</strong>
                    Quando todos os itens retornarem, conclua a reconciliação para fechar o ciclo e liberar a custódia.
                </div>
            </div>
        </div>
    </div>

<partial name="_AlertasAcao" />

    <!-- Cabeçalho de Dados -->
    <div class="card bg-dark border-secondary text-light mb-4">
        <div class="card-header bg-dark border-secondary">
            <h5 class="card-title h6 mb-0 text-light">Informações Operacionais da Consignação</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 small">
                <div class="col-md-3">
                    <span class="text-secondary d-block">Hospital</span>
                    <strong class="text-light">@Model.Hospital</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-secondary d-block">Origem (Interno)</span>
                    <span class="text-light">@Model.LocalOrigem</span>
                </div>
                <div class="col-md-3">
                    <span class="text-secondary d-block">Destino (Custódia Externa)</span>
                    <strong class="text-info">@Model.LocalDestino</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-secondary d-block">Cirurgia Vinculada</span>
                    @if (!string.IsNullOrWhiteSpace(Model.CirurgiaNumero))
                    {
                        <a asp-action="CirurgiaDetalhes" asp-route-id="@Model.CirurgiaId" class="text-info text-decoration-none fw-bold">
                            @Model.CirurgiaNumero
                        </a>
                    }
                    else
                    {
                        <span class="text-white-50">—</span>
                    }
                </div>
                <div class="col-md-3">
                    <span class="text-secondary d-block">Data Prevista de Saída</span>
                    <span class="text-light">@Model.DataSaidaPrevista.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="col-md-3">
                    <span class="text-secondary d-block">Saída Efetiva</span>
                    <span class="text-light">@(Model.DataSaidaEfetiva.HasValue ? Model.DataSaidaEfetiva.Value.ToString("dd/MM/yyyy HH:mm") : "Aguardando expedição")</span>
                </div>
                <div class="col-md-3">
                    <span class="text-secondary d-block">Previsão de Retorno</span>
                    <span class="text-light">@(Model.DataRetornoPrevista.HasValue ? Model.DataRetornoPrevista.Value.ToString("dd/MM/yyyy") : "Não estipulada")</span>
                </div>
                <div class="col-md-3">
                    <span class="text-secondary d-block">Pendente em Custódia</span>
                    <strong class="@(totalPendente > 0 ? "text-warning" : "text-success") fs-6">@totalPendente.ToString("0.00") un</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Itens e Rastreabilidade -->
    <div class="card bg-dark border-secondary text-light mb-4">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
            <h5 class="card-title h6 mb-0 text-light">Itens do Vale de Consignação</h5>
            <span class="pp-badge pp-badge--neutral">Total: @Model.Itens.Count itens</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0">
                    <thead class="table-secondary text-secondary small">
                        <tr>
                            <th scope="col">Produto</th>
                            <th scope="col">Lote</th>
                            <th scope="col">Validade</th>
                            <th class="text-end" scope="col">Solicitado</th>
                            <th class="text-end" scope="col">Separado</th>
                            <th class="text-end" scope="col">Expedido</th>
                            <th class="text-end text-info" scope="col">Consumido</th>
                            <th class="text-end text-success" scope="col">Devolvido</th>
                            <th class="text-end text-danger" scope="col">Perda</th>
                            <th class="text-end text-warning" scope="col">Pendente</th>
                            <th class="text-end" scope="col">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var it in Model.Itens)
                        {
                            <tr>
                                <td>
                                    <strong class="d-block">@it.Produto</strong>
                                    <span class="text-white-50 small">SKU: @it.Sku</span>
                                </td>
                                <td class="font-monospace">@it.Lote</td>
                                <td>@(it.Validade.HasValue ? it.Validade.Value.ToString("dd/MM/yyyy") : "—")</td>
                                <td class="text-end">@it.QuantidadeSolicitada.ToString("0.00")</td>
                                <td class="text-end">@it.QuantidadeSeparada.ToString("0.00")</td>
                                <td class="text-end fw-bold">@it.QuantidadeExpedida.ToString("0.00")</td>
                                <td class="text-end text-info fw-bold">@it.QuantidadeConsumida.ToString("0.00")</td>
                                <td class="text-end text-success fw-bold">@it.QuantidadeDevolvida.ToString("0.00")</td>
                                <td class="text-end text-danger fw-bold">@it.QuantidadePerda.ToString("0.00")</td>
                                <td class="text-end text-warning fw-bold">@it.PendenteCustodia.ToString("0.00")</td>
                                <td class="text-end">
                                    @if (Model.Situacao is "RASCUNHO" or "EM_SEPARACAO")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#modalSeparar_@it.Id">
                                            <i class="bi bi-box-seam me-1"></i> Separar
                                        </button>
                                    }
                                    else if ((Model.Situacao is "EXPEDIDO" or "RETORNO_PARCIAL") && it.PendenteCustodia > 0)
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#modalEvento_@it.Id" data-tipo="CONSUMO" title="Registrar Consumo">
                                                Consumo
                                            </button>
                                            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalEvento_@it.Id" data-tipo="RETORNO" title="Devolver (Quarentena)">
                                                Retorno
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalEvento_@it.Id" data-tipo="PERDA" title="Registrar Perda/Avaria">
                                                Perda
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-white-50 small">Conferido</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Histórico de Eventos -->
    <div class="card bg-dark border-secondary text-light mb-4">
        <div class="card-header bg-dark border-secondary">
            <h5 class="card-title h6 mb-0 text-light">Eventos e Rastreabilidade do Vale</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0">
                    <thead class="table-secondary text-secondary small">
                        <tr>
                            <th scope="col">Data & Hora</th>
                            <th scope="col">Tipo de Evento</th>
                            <th scope="col">Produto</th>
                            <th scope="col">Lote</th>
                            <th class="text-end" scope="col">Quantidade</th>
                            <th scope="col">Motivo / Justificativa</th>
                            <th scope="col">Registrado Por</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.Eventos.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-3 text-white-50">
                                    Nenhum evento registrado ainda para este vale de consignação.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var e in Model.Eventos)
                            {
                                var badgeEvento = e.Tipo switch
                                {
                                    "CONSUMO" => "pp-badge--info",
                                    "RETORNO" => "pp-badge--success",
                                    "PERDA" => "pp-badge--danger",
                                    "AVARIA" => "pp-badge--danger",
                                    _ => "pp-badge--neutral"
                                };

                                <tr>
                                    <td>@e.DataEvento.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="pp-badge @badgeEvento">@e.Tipo</span></td>
                                    <td>@e.Produto</td>
                                    <td class="font-monospace">@e.Lote</td>
                                    <td class="text-end fw-bold">@e.Quantidade.ToString("0.00")</td>
                                    <td>@(string.IsNullOrWhiteSpace(e.Motivo) ? "—" : e.Motivo)</td>
                                    <td>@e.RegistradoPor</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modais de Separação de Itens -->
@foreach (var it in Model.Itens)
{
    if (Model.Situacao is "RASCUNHO" or "EM_SEPARACAO")
    {
        <div class="modal fade" id="modalSeparar_@it.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content bg-dark text-light border-secondary">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title h6">Conferência de Separação: @it.Produto</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <form asp-action="ValeSepararItem" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="itemId" value="@it.Id" />
                        <div class="modal-body small">
                            <p class="text-secondary mb-2">Lote: <strong class="text-light">@it.Lote</strong> | Qtd Solicitada: <strong class="text-light">@it.QuantidadeSolicitada.ToString("0.00")</strong></p>
                            <div class="mb-3">
                                <label class="form-label text-secondary">Quantidade Separada e Conferida</label>
                                <input type="number" step="0.0001" min="0" max="@it.QuantidadeSolicitada" name="quantidade" value="@it.QuantidadeSolicitada" class="form-control bg-dark text-light border-secondary" required aria-label="Quantidade">
                            </div>
                        </div>
                        <div class="modal-footer border-secondary">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                            <button type="submit" class="btn btn-sm btn-primary">Registrar Separação</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    else if ((Model.Situacao is "EXPEDIDO" or "RETORNO_PARCIAL") && it.PendenteCustodia > 0)
    {
        <div class="modal fade" id="modalEvento_@it.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content bg-dark text-light border-secondary">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title h6">Registrar Evento: @it.Produto</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <form asp-action="ValeEvento" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="itemId" value="@it.Id" />
                        <div class="modal-body small">
                            <div class="mb-3">
                                <label class="form-label text-secondary">Tipo de Evento</label>
                                <select name="tipo" class="form-select bg-dark text-light border-secondary" required aria-label="Tipo">
                                    <option value="CONSUMO">Consumo Cirúrgico (Baixa em custódia externa)</option>
                                    <option value="RETORNO">Retorno do Material (Entrada em Quarentena)</option>
                                    <option value="PERDA">Perda ou Avaria (Decisão autorizada)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-secondary">Quantidade (Máximo pendente: @it.PendenteCustodia.ToString("0.00"))</label>
                                <input type="number" step="0.0001" min="0.0001" max="@it.PendenteCustodia" name="quantidade" value="@it.PendenteCustodia" class="form-control bg-dark text-light border-secondary" required aria-label="Quantidade">
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-secondary">Motivo / Justificativa</label>
                                <input type="text" name="motivo" class="form-control bg-dark text-light border-secondary" placeholder="Ex: Utilizado em sala / Sobra cirúrgica devolvida" />
                            </div>
                        </div>
                        <div class="modal-footer border-secondary">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                            <button type="submit" class="btn btn-sm btn-primary">Confirmar Evento</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<!-- Modal Reconciliação -->
@if (podeReconciliar)
{
    <div class="modal fade" id="modalReconciliar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title h6">Confirmar Reconciliação do Vale</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form asp-action="ValeReconciliar" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body small">
                        <p class="text-success fw-bold mb-2">Conferência matemática atendida:</p>
                        <p class="text-secondary mb-3">Todos os materiais expedidos foram totalmente justificados entre consumo, retorno a quarentena e perdas autorizadas. O saldo pendente em custódia é zero.</p>
                        <div class="mb-3">
                            <label class="form-label text-secondary">Observações da Reconciliação</label>
                            <textarea name="observacoes" class="form-control bg-dark text-light border-secondary" rows="2" placeholder="Observações finais da conferência..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                        <button type="submit" class="btn btn-sm btn-success">Concluir Reconciliação</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Cancelar Vale -->
@if (Model.Situacao is "RASCUNHO" or "EM_SEPARACAO" or "PRONTO_PARA_EXPEDICAO")
{
    <div class="modal fade" id="modalCancelarVale" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title h6">Confirmar Cancelamento do Vale</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form asp-action="ValeCancelar" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body small">
                        <p class="text-danger fw-bold mb-2">Atenção ao efeito da confirmação:</p>
                        <ul class="text-secondary ps-3 mb-3">
                            <li>O vale sai de circulação e não pode mais ser expedido.</li>
                            <li>Tarefas móveis ainda pendentes são canceladas junto.</li>
                            <li>O cancelamento fica registrado nas observações do vale com o motivo informado.</li>
                        </ul>
                        <div class="mb-3">
                            <label class="form-label text-secondary">Motivo do Cancelamento <span class="text-danger">*</span></label>
                            <textarea name="motivo" class="form-control bg-dark text-light border-secondary" rows="3" required
                                      placeholder="Informe o motivo do cancelamento do vale..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                        <button type="submit" class="btn btn-sm btn-danger">Confirmar Cancelamento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
