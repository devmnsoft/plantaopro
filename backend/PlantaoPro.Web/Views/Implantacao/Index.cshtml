@{
    ViewData["Title"] = UiText.L("Implantacao.PageTitle");
}
<section class="container py-4" aria-labelledby="implantacao-title" id="implantacao-app" data-prontidao-url="/api/implantacao/prontidao" data-etapas-url="/api/implantacao/etapas" data-relatorio-url="/api/implantacao/relatorio" data-validar-tudo-url="/api/implantacao/validar-tudo" data-responsavel-label="@UiText.L("Onboarding.ResponsiblePrefix")" data-prazo-label="@UiText.L("Implantacao.JsDueDateLabel")" data-validar-etapa-label="@UiText.L("Implantacao.JsValidateStep")" data-load-error="@UiText.L("Implantacao.JsLoadError")" data-validate-error="@UiText.L("Implantacao.JsValidateError")">
    <div class="p-4 rounded-3 bg-light border">
        <p class="text-uppercase text-muted mb-1">PlantãoPro v1.18.9</p>
        <h1 id="implantacao-title">@UiText.L("Implantacao.HeroTitle")</h1>
        <p class="lead">@UiText.L("Implantacao.HeroBody")</p>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmarValidacaoModal">@UiText.L("Implantacao.ValidateAll")</button>
            <button class="btn btn-outline-secondary" id="atualizar-implantacao" type="button">@UiText.L("Implantacao.Refresh")</button>
        </div>
    </div>

    <div id="implantacao-loading" class="alert alert-info mt-3" role="status">@UiText.L("Implantacao.Loading")</div>
    <div id="implantacao-error" class="alert alert-danger mt-3 d-none" role="alert"></div>

    <div class="row g-3 mt-1" aria-label="@UiText.L("Implantacao.KpisAria")">
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-muted">@UiText.L("Implantacao.KpiReadiness")</span><strong class="d-block fs-3" id="kpi-prontidao">--%</strong></div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-muted">@UiText.L("Implantacao.KpiSteps")</span><strong class="d-block fs-3" id="kpi-etapas">17</strong></div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-muted">@UiText.L("Implantacao.KpiPending")</span><strong class="d-block fs-3" id="kpi-pendencias">--</strong></div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-muted">@UiText.L("Implantacao.KpiAlerts")</span><strong class="d-block fs-3" id="kpi-alertas">--</strong></div></div></div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <label for="filtro-status" class="form-label">@UiText.L("Implantacao.FilterStatus")</label>
            <select id="filtro-status" class="form-select mb-3"><option value="">@UiText.L("Implantacao.FilterAll")</option><option>PENDENTE</option><option>OK</option></select>
            <div class="progress mb-3" aria-label="@UiText.L("Implantacao.ProgressAria")"><div id="barra-prontidao" class="progress-bar" data-progress="0">0%</div></div>
            <div id="empty-state" class="text-center text-muted py-4 d-none">@UiText.L("Implantacao.EmptyFiltered")</div>
            <div id="lista-etapas" class="row g-3"></div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-6"><div class="card h-100"><div class="card-body"><h2 class="h5">@UiText.L("Implantacao.TimelineTitle")</h2><ol id="timeline" class="mb-0"></ol></div></div></div>
        <div class="col-lg-6"><div class="card h-100"><div class="card-body"><h2 class="h5">@UiText.L("Implantacao.EvidenceTitle")</h2><pre id="relatorio" class="small bg-light p-3 rounded overflow-auto">@UiText.L("Implantacao.WaitingLoad")</pre></div></div></div>
    </div>
</section>

<div class="modal fade" id="confirmarValidacaoModal" tabindex="-1" aria-labelledby="confirmarValidacaoTitle" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="confirmarValidacaoTitle">@UiText.L("Implantacao.ConfirmTitle")</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@UiText.L("Implantacao.CloseAria")"></button></div><div class="modal-body">@UiText.L("Implantacao.ConfirmBody")</div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">@UiText.L("Clinical.ButtonCancel")</button><button class="btn btn-primary" id="validar-tudo" type="button" data-bs-dismiss="modal">@UiText.L("Implantacao.ValidateAll")</button></div></div></div>
</div>

@section Scripts { <script src="~/js/implantacao.js" asp-append-version="true"></script> }
