@model PlantaoPro.Web.Models.Saude360PageViewModel
@{
    var vm = Model ?? new PlantaoPro.Web.Models.Saude360PageViewModel();
    ViewData["Title"] = vm.Titulo;
    var registros = (vm.Registros ?? Array.Empty<PlantaoPro.Web.Models.Saude360RegistroViewModel>()).ToList();
    var acoes = (vm.Acoes ?? Array.Empty<PlantaoPro.Web.Models.Saude360ActionLinkViewModel>()).ToList();
    var primaria = acoes.FirstOrDefault();
    string? Quantidade(string indicador) => registros.FirstOrDefault(item => string.Equals(item.Nome, indicador, StringComparison.OrdinalIgnoreCase))?.Descricao;
}

@if (ViewBag.AssistenteContextual is PlantaoPro.Web.Models.AssistenteContextualViewModel assistenteContextual)
{
    @await Html.PartialAsync("_AssistenteContextual", assistenteContextual)
}

@await Html.PartialAsync("_PageHelp", new PlantaoPro.Web.Models.PageHelpViewModel
{
    Title = vm.Titulo,
    Description = vm.Descricao,
    WhenToUse = UiText.L("Clinical.PhWhenToUse"),
    StepByStep = new List<string> { UiText.L("Clinical.PhStep1"), UiText.L("Clinical.PhStep2"), UiText.L("Clinical.PhStep3"), UiText.L("Clinical.PhStep4") },
    Tips = new List<string> { UiText.L("Clinical.PhTipAudit"), UiText.L("Clinical.PhTipTenant"), UiText.L("Clinical.PhTipSensitive") },
    RelatedActions = vm.Acoes,
    ProfileNotes = UiText.L("Clinical.PhProfileNotes"),
    DocumentationUrl = Url.Action("Perfil", "Manual") ?? string.Empty
})

<div class="pp-page pp-clinical-page clinical-mvp-journey pp-strategic-surface" data-clinical-mvp-journey data-patient-context="@(string.Equals(vm.Controller, "Pacientes", StringComparison.OrdinalIgnoreCase) ? "available-from-api" : null)">
<section class="pp-page-hero" aria-labelledby="saude360Title">
    <div>
        <span class="pp-eyebrow">PlantãoPro @UiText.L("Nav.SectionClinical") · @UiText.L("Clinical.JourneyTagline")</span>
        <h1 id="saude360Title">@vm.Titulo</h1>
        <p>@vm.Descricao</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var acao in acoes)
        {
            <a asp-controller="@(string.IsNullOrWhiteSpace(acao.Controller) ? vm.Controller : acao.Controller)" asp-action="@acao.Action" class="btn btn-primary">
                <i class="bi @acao.Icone me-1" aria-hidden="true"></i>@acao.Titulo
            </a>
        }
    </div>
</section>

<nav class="clinical-journey" aria-label="@UiText.L("Clinical.JourneyAria")">
    <a asp-controller="Pacientes" asp-action="Index"><i class="bi bi-person-vcard" aria-hidden="true"></i><span>@UiText.L("Clinical.JourneyPatient")</span></a>
    <a asp-controller="Agendamentos" asp-action="Index"><i class="bi bi-calendar-check" aria-hidden="true"></i><span>@UiText.L("Clinical.JourneyAppointment")</span>@if (Quantidade("agendamentos hoje") is string agendamentos) { <strong aria-label="@UiText.L("Clinical.JourneyCountAppointments")">@agendamentos</strong> }</a>
    <a asp-controller="Agendamentos" asp-action="CheckIn"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i><span>@UiText.L("Clinical.JourneyCheckIn")</span>@if (Quantidade("checkins realizados") is string checkins) { <strong aria-label="@UiText.L("Clinical.JourneyCountCheckIns")">@checkins</strong> }</a>
    <a asp-controller="PainelChamada" asp-action="Index"><i class="bi bi-megaphone" aria-hidden="true"></i><span>@UiText.L("Clinical.JourneyCallBoard")</span>@if (Quantidade("pacientes aguardando") is string aguardando) { <strong aria-label="@UiText.L("Clinical.JourneyCountWaiting")">@aguardando</strong> }</a>
    <a asp-controller="Triagem" asp-action="Index"><i class="bi bi-activity" aria-hidden="true"></i><span>@UiText.L("Clinical.JourneyTriage")</span>@if (Quantidade("triagens pendentes") is string triagens) { <strong aria-label="@UiText.L("Clinical.JourneyCountTriagePending")">@triagens</strong> }</a>
    <a asp-controller="Consultas" asp-action="Index"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i><span>@UiText.L("Clinical.JourneyConsult")</span>@if (Quantidade("consultas em andamento") is string consultas) { <strong aria-label="@UiText.L("Clinical.JourneyCountConsultActive")">@consultas</strong> }</a>
    <a asp-controller="Prescricoes" asp-action="Index"><i class="bi bi-capsule" aria-hidden="true"></i><span>@UiText.L("Clinical.JourneyPrescription")</span>@if (Quantidade("prescricoes pendentes") is string prescricoes) { <strong aria-label="@UiText.L("Clinical.JourneyCountRxPending")">@prescricoes</strong> }</a>
    <a asp-controller="ClinicaFinanceiro" asp-action="Index"><i class="bi bi-receipt" aria-hidden="true"></i><span>@UiText.L("Clinical.JourneyFinance")</span>@if (Quantidade("financeiro pendente") is string financeiro) { <strong aria-label="@UiText.L("Clinical.JourneyCountFinancePending")">@financeiro</strong> }</a>
</nav>

<section class="clinical-next-action" data-next-action aria-labelledby="clinicalNextActionTitle">
    <div>
        <span class="pp-section-kicker">@UiText.L("Clinical.NextKicker")</span>
        <h2 id="clinicalNextActionTitle">@UiText.L("Clinical.NextTitle")</h2>
        <p>@UiText.L("Clinical.NextBody")</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="ClinicaDashboard" asp-action="FluxoAtendimento">@UiText.L("Clinical.NextRulesButton")</a>
</section>

@if (string.Equals(vm.Controller, "Pacientes", StringComparison.OrdinalIgnoreCase))
{
    <section class="clinical-patient-sections" aria-label="@UiText.L("Clinical.PatientContextAria")">
        @foreach (var bloco in new[] { UiText.L("Clinical.PatientBlockData"), UiText.L("Clinical.PatientBlockSchedule"), UiText.L("Clinical.JourneyTriage"), UiText.L("Clinical.PatientBlockConsults"), UiText.L("Clinical.PatientBlockBilling") })
        {
            <article class="clinical-context-card"><h2>@bloco</h2><p>@UiText.L("Clinical.PatientBlockBody")</p></article>
        }
    </section>
}

@if (!string.IsNullOrWhiteSpace(vm.ErrorMessage) && !string.Equals(vm.ErrorMessage, "Registros carregados.", StringComparison.OrdinalIgnoreCase))
{
    <div class="pp-alert pp-alert--warning" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>@vm.ErrorMessage</span></div>
}

@if (registros.Count == 0 && string.IsNullOrWhiteSpace(vm.ErrorMessage))
{
    <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-inbox", string.Format(System.Globalization.CultureInfo.InvariantCulture, UiText.L("Clinical.EmptyTitle"), vm.Modulo), UiText.L("Clinical.EmptyBody"), primaria != null ? primaria.Titulo : null, primaria != null ? primaria.Action : null, primaria != null ? (string.IsNullOrWhiteSpace(primaria.Controller) ? vm.Controller : primaria.Controller) : null, primaria == null)' />
}

<div class="pp-kpi-strip" aria-label="@UiText.L("Clinical.KpiStripAria")">
    <article class="pp-kpi-card"><span>@UiText.L("Clinical.KpiPlanMin")</span><strong>@vm.Plano</strong><small>@UiText.L("Clinical.KpiPlanHint")</small></article>
    <article class="pp-kpi-card"><span>@UiText.L("Clinical.KpiRecords")</span>@if (string.IsNullOrWhiteSpace(vm.ErrorMessage) || string.Equals(vm.ErrorMessage, "Registros carregados.", StringComparison.OrdinalIgnoreCase)) { <strong>@registros.Count</strong><small>@UiText.L("Clinical.KpiRecordsHint")</small> } else { <strong>@UiText.L("Clinical.KpiUnavailable")</strong><small>@UiText.L("Clinical.KpiUnavailableHint")</small> }</article>
    <article class="pp-kpi-card"><span>@UiText.L("Clinical.KpiAccess")</span><strong>@UiText.L("Clinical.KpiProtected")</strong><small>@UiText.L("Clinical.KpiProtectedHint")</small></article>
</div>

<section class="pp-data-table" aria-labelledby="moduleRecordsTitle">
    <div class="pp-section-heading">
        <div><span class="pp-section-kicker">@UiText.L("Clinical.RecordsKicker")</span><h2 id="moduleRecordsTitle">@vm.Modulo</h2></div>
        <span class="badge bg-light text-dark">@vm.Permissao</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0" aria-label="@string.Format(System.Globalization.CultureInfo.InvariantCulture, UiText.L("Clinical.RecordsTableAria"), vm.Modulo)">
            <thead><tr><th scope="col">@UiText.L("Clinical.ThIdentity")</th><th scope="col">@UiText.L("Clinical.ThCode")</th><th scope="col">@UiText.L("Clinical.ThDescription")</th><th scope="col">@UiText.L("Clinical.ThStatus")</th><th scope="col">@UiText.L("Clinical.ThRecordDate")</th></tr></thead>
            <tbody>
            @if (!registros.Any())
            {
                <tr><td colspan="5"><div class="saude360-empty-state" role="status" aria-live="polite"><i class="bi bi-inbox" aria-hidden="true"></i><strong>@string.Format(System.Globalization.CultureInfo.InvariantCulture, UiText.L("Clinical.EmptyTitle"), vm.Modulo)</strong><span>@UiText.L("Clinical.EmptyTableBody")</span></div></td></tr>
            }
            else
            {
                @foreach (var item in registros)
                {
                    <tr>
                        <td><span class="fw-semibold">@(string.IsNullOrWhiteSpace(item.Nome) ? item.Id.ToString() : item.Nome)</span></td>
                        <td>@(string.IsNullOrWhiteSpace(item.Codigo) ? "—" : item.Codigo)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Descricao) ? "—" : item.Descricao)</td>
                        <td><span class="badge bg-primary-subtle text-primary">@item.Status</span></td>
                        <td>@item.RegDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>


<div class="pp-info-banner" role="note">
    <strong>@UiText.L("Clinical.LgpdLabel")</strong> @UiText.L("Clinical.LgpdBody")
</div>
</div>
