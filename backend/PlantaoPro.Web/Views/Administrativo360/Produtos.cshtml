@model PlantaoPro.Web.Models.ProdutosIndexViewModel
@{
    ViewData["Title"] = "Produtos e Materiais — Administrativo 360";
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    @if (!string.IsNullOrWhiteSpace(Model.Erro))
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><strong>Erro:</strong> @Model.Erro</div>
        </div>
    }

    <!-- Header Executivo -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 mb-1 text-dark fw-bold">Catálogo de Produtos &amp; OPME</h1>
            <p class="text-muted mb-0 small">
                Gestão de itens com controle de rastreabilidade por lote, laudo de qualidade na recepção e precificação de custo.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#comoUsarProdutos" aria-expanded="false">
                <i class="bi bi-info-circle me-1"></i> Como Usar
            </button>
            <button class="btn btn-primary btn-sm px-3" type="button" onclick="abrirModalNovoProduto()">
                <i class="bi bi-plus-lg me-1"></i> Novo Produto
            </button>
        </div>
    </div>

    <!-- Guia Como Usar -->
    <div class="collapse mb-4" id="comoUsarProdutos">
        <div class="card card-body bg-light border-0 shadow-sm rounded-3">
            <h6 class="fw-bold mb-2 text-primary"><i class="bi bi-shield-check me-1"></i> Regras de Cadastro e Integridade de Estoque</h6>
            <ul class="mb-0 small text-secondary">
                <li><strong>SKU Único:</strong> O código de identificação do item deve ser exclusivo no seu cliente.</li>
                <li><strong>Preço de Custo:</strong> Deve ser positivo ou zero. Serve como base de valorização nas compras e orçamentos.</li>
                <li><strong>Trava de Movimentação:</strong> Não é permitido alterar a Unidade de Medida, Controle de Lote ou Exigência de Inspeção de produtos que já possuam movimentações de estoque registradas.</li>
                <li><strong>Controle de Lote:</strong> Itens cirúrgicos e OPME exigem rastreabilidade estrita por lote e data de validade.</li>
            </ul>
        </div>
    </div>

    <!-- Filtros de Consulta -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Produtos" class="row g-2 align-items-center">
                <div class="col-md-7 col-lg-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="busca" value="@Model.Busca" class="form-control" placeholder="Buscar por SKU, descrição do material ou código de barras..." />
                    </div>
                </div>
                <div class="col-md-3 col-lg-2">
                    <div class="form-check form-switch pt-1">
                        <input class="form-check-input" type="checkbox" name="apenasAtivos" id="filtroApenasAtivos" value="true" checked="@Model.ApenasAtivos" onchange="this.form.submit()" />
                        <label class="form-check-label small" for="filtroApenasAtivos">Apenas Ativos</label>
                    </div>
                </div>
                <div class="col-md-2 col-lg-2 d-flex gap-1">
                    <button type="submit" class="btn btn-secondary btn-sm flex-fill">Filtrar</button>
                    <a asp-action="Produtos" class="btn btn-outline-secondary btn-sm">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- s5 (rodada 9): Lotes vinculados ao produto em contexto -->
    @if (Model.ProdutoId.HasValue)
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4" style="border-left: 4px solid var(--bs-primary);">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-boxes me-1 text-primary"></i> Lotes vinculados
                    <span class="badge bg-primary-subtle text-primary ms-1">@Model.Lotes.Count</span>
                    @if (!string.IsNullOrWhiteSpace(Model.ProdutoSku))
                    {
                        <span class="badge bg-light text-dark font-monospace border ms-1">@Model.ProdutoSku</span>
                    }
                </h6>
                <a asp-action="Produtos" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Voltar ao catálogo</a>
            </div>
            <div class="card-body p-3">
                <p class="small text-muted mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    @Model.ProdutoNome. Registrar um lote <strong>não ajusta o estoque</strong>: a quantidade entra apenas por
                    movimentação com origem (recebimento de compra, inventário ou ajuste) no módulo de Estoque.
                    A validade do lote é a data de expiração do produto e não substitui a vigência regulatória.
                </p>
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th>Código do Lote</th>
                                <th>Validade</th>
                                <th>Custo Unitário (R$)</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (Model.Lotes.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-3 text-muted">Nenhum lote registrado para este produto.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var l in Model.Lotes)
                                {
                                    var vencido = l.Validade.HasValue && l.Validade.Value < DateOnly.FromDateTime(DateTime.Now);
                                    <tr>
                                        <td><span class="badge bg-light text-dark font-monospace border">@l.Codigo</span></td>
                                        <td>
                                            @if (l.Validade.HasValue)
                                            {
                                                <span class="@(vencido ? "text-danger fw-semibold" : "")">@l.Validade.Value.ToString("dd/MM/yyyy")@(vencido ? " (vencido)" : "")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="font-monospace">@(l.CustoUnitario.HasValue ? l.CustoUnitario.Value.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) : "—")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <form method="post" asp-action="SalvarLote" class="row g-2 align-items-end" onsubmit="return desabilitarAoEnviar(this);">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="produtoId" value="@Model.ProdutoId" />
                    <div class="col-md-4">
                        <label for="loteCodigo" class="form-label small fw-bold">Código do Lote <span class="text-danger">*</span></label>
                        <input type="text" name="codigo" id="loteCodigo" class="form-control form-control-sm font-monospace" required maxlength="60" placeholder="Ex.: LT-2026-014" />
                    </div>
                    <div class="col-md-3">
                        <label for="loteValidade" class="form-label small fw-bold">Data de Validade <span class="text-danger">*</span></label>
                        <input type="date" name="validade" id="loteValidade" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-3">
                        <label for="loteCusto" class="form-label small fw-bold">Custo Unitário (R$)</label>
                        <input type="number" step="0.01" min="0" name="custoUnitario" id="loteCusto" class="form-control form-control-sm font-monospace" placeholder="Opcional" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-plus-lg me-1"></i>Registrar Lote</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Tabela de Produtos -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                Materiais Cadastrados <span class="badge bg-secondary ms-1">@Model.Produtos.Count</span>
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th style="min-width: 120px;">SKU</th>
                        <th style="min-width: 250px;">Descrição do Produto</th>
                        <th>Unidade</th>
                        <th>Preço Custo (R$)</th>
                        <th>Preço Venda / Precificação</th>
                        <th>Rastreabilidade</th>
                        <th>ANVISA</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Produtos.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam fs-2 d-block mb-2 text-secondary"></i>
                                Nenhum produto encontrado com os filtros aplicados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model.Produtos)
                        {
                            var anvisaVigenciaStr = p.AnvisaVigencia?.ToString("yyyy-MM-dd") ?? "";
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark font-monospace border">@p.Sku</span>
                                </td>
                                <td>
                                    <strong class="text-dark">@p.Nome</strong>
                                    @if (!string.IsNullOrWhiteSpace(p.CodigoBarras))
                                    {
                                        <div class="small text-muted font-monospace"><i class="bi bi-upc me-1"></i>@p.CodigoBarras</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">@p.Unidade</span>
                                </td>
                                <td class="font-monospace fw-semibold">
                                    @if (p.PrecoCusto.HasValue)
                                    {
                                        @p.PrecoCusto.Value.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="custo não informado (ausente — não tratado como zero)">—</span>
                                    }
                                </td>
                                <td>
                                    @if (p.PrecoVenda.HasValue)
                                    {
                                        <div class="font-monospace fw-semibold">@p.PrecoVenda.Value.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>
                                        <div class="small @(p.MargemPercentual.HasValue && p.MargemPercentual.Value < 0 ? "text-danger fw-semibold" : "text-muted")">
                                            Lucro unit: @(p.LucroBrutoUnitario?.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) ?? "—") ·
                                            M vend.: @(p.MargemPercentual?.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) ?? "não calc.")% ·
                                            Markup: @(p.MarkupPercentual?.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) ?? "não calc.")%
                                        </div>
                                        @if (p.MargemPercentual.HasValue && p.MargemPercentual.Value < 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">margem negativa</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="preço de venda padrão não definido">—</span>
                                    }
                                </td>
                                <td>
                                    @if (p.ControlaLote)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle me-1" title="Exige lote e validade">
                                            <i class="bi bi-tag me-1"></i> Lote
                                        </span>
                                    }
                                    @if (p.ExigeInspecao)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" title="Exige inspeção de qualidade">
                                            <i class="bi bi-shield-check me-1"></i> Inspeção
                                        </span>
                                    }
                                    @if (!p.ControlaLote && !p.ExigeInspecao)
                                    {
                                        <span class="text-muted small">Padrão</span>
                                    }
                                </td>
                                <td>
                                    @switch (p.AnvisaAplicabilidade)
                                    {
                                        case "INFORMADO":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" title="Registro ANVISA informado manualmente@(p.AnvisaVigencia.HasValue ? " · Vigência regulatória: " + p.AnvisaVigencia.Value.ToString("dd/MM/yyyy") : "")">
                                                <i class="bi bi-patch-check me-1"></i>@(p.AnvisaNumero ?? "")
                                            </span>
                                            break;
                                        case "NAO_APLICAVEL":
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" title="@p.AnvisaJustificacao">
                                                <i class="bi bi-slash-circle me-1"></i>n/a
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">pendente</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (p.Ativo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inativo</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Produtos" asp-route-produtoId="@p.Id" class="btn btn-outline-secondary btn-sm py-0 px-2 me-1"
                                       title="Lotes vinculados">
                                        <i class="bi bi-boxes"></i>
                                    </a>
                                    <button class="btn btn-outline-primary btn-sm py-0 px-2 me-1" type="button"
                                            onclick="editarProduto('@p.Id', '@p.Sku', '@p.Nome', '@p.Unidade', '@p.CodigoBarras', @p.ControlaLote.ToString().ToLower(), @p.ExigeInspecao.ToString().ToLower(), @((p.PrecoCusto?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? ""), @p.Ativo.ToString().ToLower(), '@p.AnvisaNumero', '@p.AnvisaAplicabilidade', '@anvisaVigenciaStr', '@p.AnvisaJustificacao', @((p.PrecoVenda?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? ""))">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" asp-action="AlternarStatusProduto" class="d-inline" onsubmit="return desabilitarAoEnviar(this);"
                                          data-confirm="true" data-confirm-type="@(p.Ativo ? "warning" : "success")"
                                          data-confirm-title="@((p.Ativo ? "Inativar" : "Ativar") + " produto " + p.Sku)"
                                          data-confirm-message="@((p.Ativo ? "O produto sairá dos cadastros ativos; lotes, ANVISA e preços permanecem legíveis nos relatórios." : "O produto volta aos cadastros ativos.") + " Deseja continuar?")">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="ativo" value="@((!p.Ativo).ToString().ToLower())" />
                                        <button type="submit" class="btn btn-sm py-0 px-2 @(p.Ativo ? "btn-outline-danger" : "btn-outline-success")"
                                                title="@(p.Ativo ? "Inativar produto" : "Ativar produto")">
                                            <i class="bi @(p.Ativo ? "bi-slash-circle" : "bi-check2-circle")"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Pagina > 1 || Model.TemProximaPagina)
        {
            <nav class="d-flex justify-content-between align-items-center pt-3" aria-label="Paginação de produtos">
                @if (Model.Pagina > 1)
                {
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Produtos", new { busca = Model.Busca, status = Model.Status, pagina = Model.Pagina - 1 })">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                }
                else
                {
                    <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true"><i class="bi bi-chevron-left"></i> Anterior</span>
                }
                <span class="small text-muted">@Model.Produtos.Count item(ns) na página @Model.Pagina · máximo 100 por página</span>
                @if (Model.TemProximaPagina)
                {
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Produtos", new { busca = Model.Busca, status = Model.Status, pagina = Model.Pagina + 1 })">
                        Próxima <i class="bi bi-chevron-right"></i>
                    </a>
                }
                else
                {
                    <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Próxima <i class="bi bi-chevron-right"></i></span>
                }
            </nav>
        }
    </div>
</div>

<!-- Modal de Cadastro / Edição de Produto -->
<div class="modal fade" id="modalProduto" tabindex="-1" aria-labelledby="modalProdutoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="SalvarProduto" id="formProduto" onsubmit="return desabilitarAoEnviar(this);">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="modalProdutoLabel">Novo Produto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="Id" id="produtoId" value="" />

                    <!-- Seção 1 — Identificação (r9h) -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-2 text-dark">1 · @UiText.L("Adm360.Produtos.SecIdentificacao")</span>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label for="produtoSku" class="form-label small fw-bold">SKU / Código <span class="text-danger">*</span></label>
                                <input type="text" name="Sku" id="produtoSku" class="form-control form-control-sm font-monospace text-uppercase" required maxlength="60" placeholder="Ex.: STENT-001" />
                            </div>
                            <div class="col-md-6">
                                <label for="produtoUnidade" class="form-label small fw-bold">Unidade <span class="text-danger">*</span></label>
                                <select name="Unidade" id="produtoUnidade" class="form-select form-select-sm" required>
                                    <option value="UN">UN — Unidade</option>
                                    <option value="CX">CX — Caixa</option>
                                    <option value="PC">PC — Peça</option>
                                    <option value="KIT">KIT — Conjunto</option>
                                    <option value="KG">KG — Quilograma</option>
                                    <option value="LT">LT — Litro</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label for="produtoNome" class="form-label small fw-bold">Descrição do Material <span class="text-danger">*</span></label>
                            <input type="text" name="Nome" id="produtoNome" class="form-control form-control-sm" required maxlength="200" placeholder="Ex.: Stent Coronário Farmacológico de Sirolimus" />
                        </div>
                        <div class="mb-0">
                            <label for="produtoCodigoBarras" class="form-label small fw-bold">Código de Barras (EAN)</label>
                            <input type="text" name="CodigoBarras" id="produtoCodigoBarras" class="form-control form-control-sm font-monospace" maxlength="60" placeholder="Opcional" />
                        </div>
                    </div>

                    <!-- Seção 2 — Estoque, Lotes e Rastreabilidade (r9h) -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-1 text-dark">2 · @UiText.L("Adm360.Produtos.SecEstoqueLotes")</span>
                        <p class="small text-muted mb-2">Os lotes e datas de validade não são lançados aqui — eles entram no painel do produto (seção Lotes), onde cada lote tem sua própria validade.</p>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="ControlaLote" id="produtoControlaLote" value="true" checked />
                            <label class="form-check-label small" for="produtoControlaLote">Exige controle de Lote e Validade</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="ExigeInspecao" id="produtoExigeInspecao" value="true" checked />
                            <label class="form-check-label small" for="produtoExigeInspecao">Exige Laudo de Inspeção no Recebimento</label>
                        </div>
                    </div>

                    <!-- Seção 3 — Regulação ANVISA (r9h; bloco existente preservado) -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-1 text-dark">3 · @UiText.L("Adm360.Produtos.SecRegulacaoAnvisa")</span>
                        <p class="small text-muted mb-2">O número é registrado como texto (preserva zeros à esquerda) e a entrada é manual — não há busca simulada. A vigência regulatória é independente da validade do lote.</p>
                        <input type="hidden" name="AnvisaEntradaManual" value="true" />
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label for="produtoAnvisaNumero" class="form-label small fw-bold">Número de Registro ANVISA</label>
                                <input type="text" name="AnvisaNumero" id="produtoAnvisaNumero" class="form-control form-control-sm font-monospace" maxlength="60" placeholder="Ex.: 800123456789512" autocomplete="off" />
                            </div>
                            <div class="col-md-6">
                                <label for="produtoAnvisaAplicabilidade" class="form-label small fw-bold">Aplicabilidade</label>
                                <select name="AnvisaAplicabilidade" id="produtoAnvisaAplicabilidade" class="form-select form-select-sm">
                                    <option value="PENDENTE">Pendente</option>
                                    <option value="INFORMADO">Informado</option>
                                    <option value="NAO_APLICAVEL">Não aplicável</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label for="produtoAnvisaVigencia" class="form-label small fw-bold">Vigência regulatória (autorização)</label>
                                <input type="date" name="AnvisaVigencia" id="produtoAnvisaVigencia" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-6">
                                <label for="produtoAnvisaJustificacao" class="form-label small fw-bold">Justificação (obrigatória quando "não aplicável")</label>
                                <input type="text" name="AnvisaJustificacao" id="produtoAnvisaJustificacao" class="form-control form-control-sm" maxlength="200" placeholder="Ex.: produto fora do escopo de regulação RDC ..." />
                            </div>
                        </div>
                    </div>

                    <!-- Seção 4 — Precificação (r9h) -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-2 text-dark">4 · @UiText.L("Adm360.Produtos.SecPrecificacao")</span>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label for="produtoPrecoCusto" class="form-label small fw-bold">Preço de Custo (R$) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0" name="PrecoCusto" id="produtoPrecoCusto" class="form-control form-control-sm font-monospace" required placeholder="0.00" oninput="recalcularPrecos()" />
                            </div>
                            <div class="col-md-6">
                                <label for="produtoPrecoVenda" class="form-label small fw-bold">Preço de Venda padrão (R$)</label>
                                <input type="number" step="0.01" min="0" name="PrecoVenda" id="produtoPrecoVenda" class="form-control form-control-sm font-monospace" placeholder="Opcional" oninput="recalcularPrecos()" />
                            </div>
                        </div>
                        <div class="small text-muted mb-0" id="previewPrecos" aria-live="polite"></div>
                    </div>

                    <!-- Seção 5 — Status (r9h) -->
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-2 text-dark">5 · @UiText.L("Adm360.Produtos.SecStatus")</span>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" name="Ativo" id="produtoAtivo" value="true" checked />
                            <label class="form-check-label small fw-bold" for="produtoAtivo">Produto Ativo</label>
                        </div>
                        <p class="small text-muted mb-0">Inativar preserva o histórico do produto (lotes, ANVISA e preços permanecem legíveis nos relatórios).</p>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnSalvarProduto" class="btn btn-primary btn-sm px-4">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function abrirModalNovoProduto() {
        document.getElementById('modalProdutoLabel').innerText = 'Novo Produto';
        document.getElementById('produtoId').value = '';
        document.getElementById('produtoSku').value = '';
        document.getElementById('produtoSku').readOnly = false;
        document.getElementById('produtoNome').value = '';
        document.getElementById('produtoUnidade').value = 'UN';
        document.getElementById('produtoPrecoCusto').value = '0.00';
        document.getElementById('produtoCodigoBarras').value = '';
        document.getElementById('produtoControlaLote').checked = true;
        document.getElementById('produtoExigeInspecao').checked = true;
        document.getElementById('produtoAnvisaNumero').value = '';
        document.getElementById('produtoAnvisaAplicabilidade').value = 'PENDENTE';
        document.getElementById('produtoAnvisaVigencia').value = '';
        document.getElementById('produtoAnvisaJustificacao').value = '';
        document.getElementById('produtoAtivo').checked = true;
        document.getElementById('produtoPrecoVenda').value = '';
        recalcularPrecos();
        new bootstrap.Modal(document.getElementById('modalProduto')).show();
    }

    function editarProduto(id, sku, nome, unidade, codigoBarras, controlaLote, exigeInspecao, precoCusto, ativo, anvisaNumero, anvisaAplicabilidade, anvisaVigencia, anvisaJustificacao, precoVenda) {
        document.getElementById('modalProdutoLabel').innerText = 'Editar Produto';
        document.getElementById('produtoId').value = id;
        document.getElementById('produtoSku').value = sku;
        document.getElementById('produtoNome').value = nome;
        document.getElementById('produtoUnidade').value = unidade || 'UN';
        document.getElementById('produtoPrecoCusto').value = precoCusto || '0.00';
        document.getElementById('produtoCodigoBarras').value = codigoBarras || '';
        document.getElementById('produtoControlaLote').checked = controlaLote;
        document.getElementById('produtoExigeInspecao').checked = exigeInspecao;
        document.getElementById('produtoAnvisaNumero').value = anvisaNumero || '';
        document.getElementById('produtoAnvisaAplicabilidade').value = anvisaAplicabilidade || 'PENDENTE';
        document.getElementById('produtoAnvisaVigencia').value = anvisaVigencia || '';
        document.getElementById('produtoAnvisaJustificacao').value = anvisaJustificacao || '';
        document.getElementById('produtoAtivo').checked = ativo;
        document.getElementById('produtoPrecoVenda').value = precoVenda || '';
        recalcularPrecos();
        new bootstrap.Modal(document.getElementById('modalProduto')).show();
    }

    // s7 (rodada 9): prévia LOCAL apenas para usabilidade — o cálculo oficial das derivadas
    // (lucro unitário, margem sobre venda %, markup sobre custo %) é recalculado no SERVIDOR.
    // Mesmas regras: ausente ≠ zero; denominador zero => "não calculável"; negativo é evidenciado.
    function recalcularPrecos() {
        var el = document.getElementById('previewPrecos');
        if (!el) { return; }
        var c = parseFloat(document.getElementById('produtoPrecoCusto').value);
        var v = parseFloat(document.getElementById('produtoPrecoVenda').value);
        var fmt = function (n) { return n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
        if (isNaN(v)) { el.textContent = 'Informe o preço de venda para calcular a precificação.'; return; }
        if (isNaN(c)) { el.textContent = 'Custo ausente — margem/markup não calculáveis (ausente não é tratado como zero).'; return; }
        var lucro = Math.round((v - c) * 100) / 100;
        var m = v > 0 ? Math.round((v - c) / v * 10000) / 100 : null;
        var mu = c > 0 ? Math.round((v - c) / c * 10000) / 100 : null;
        el.textContent = 'Lucro unitário: R$ ' + fmt(lucro)
            + ' · Margem sobre venda: ' + (m === null ? 'não calculável (venda zero)' : fmt(m) + '%')
            + ' · Markup sobre custo: ' + (mu === null ? 'não calculável (custo zero)' : fmt(mu) + '%')
            + (m !== null && m < 0 ? ' · MARGEM NEGATIVA' : '')
            + ' — prévia local; o cálculo oficial é recalculado no servidor ao salvar.';
    }

    function desabilitarAoEnviar(form) {
        var btn = form.querySelector('button[type="submit"]');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Processando...';
        }
        return true;
    }
</script>
}
