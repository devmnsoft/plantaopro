@model PlantaoPro.Web.Models.ManagerCommandCenterViewModel
@{ViewData["Title"]="Command Center";}
<main class="command-center">
 <header class="cc-hero"><div><span class="cc-eyebrow">Operação em tempo real</span><h1>Command Center</h1><p>Antecipe riscos, proteja a cobertura e concentre decisões do dia em uma visão segura.</p></div><div class="cc-pulse"><span></span>Atualizado @Model.GeneratedAt.ToLocalTime().ToString("HH:mm")</div></header>
 @if(!string.IsNullOrWhiteSpace(Model.Error)){<section class="cc-state" role="alert"><h2>Não conseguimos sincronizar a operação</h2><p>@Model.Error</p><a class="cc-button" asp-action="Index">Tentar novamente</a></section>}
 else {
 <section class="cc-kpis" aria-label="Indicadores operacionais">
  <article class="critical"><span>Risco agora</span><strong>@Model.Summary.Critical</strong><small>plantões críticos</small></article><article><span>Descobertos</span><strong>@Model.Summary.Uncovered</strong><small>exigem cobertura</small></article><article><span>Confirmação</span><strong>@Model.Summary.PendingConfirmation</strong><small>respostas pendentes</small></article><article><span>Profissionais</span><strong>@Model.Summary.AvailableProfessionals</strong><small>ativos no tenant</small></article><article><span>Financeiro</span><strong>@Model.Summary.FinancialPending</strong><small>pendências associadas</small></article><article><span>Alertas</span><strong>@Model.Summary.CriticalNotifications</strong><small>notificações críticas</small></article>
 </section>
 <section class="cc-panel"><div class="cc-heading"><div><span class="cc-eyebrow">Cobertura operacional</span><h2>Próximos plantões</h2></div><p>Risco calculado por cobertura, proximidade e confirmação.</p></div>
 <form method="get" class="cc-filters"><label>De<input type="date" name="from" value="@ViewBag.From.ToString("yyyy-MM-dd")" required /></label><label>Até<input type="date" name="to" value="@ViewBag.To.ToString("yyyy-MM-dd")" required /></label><label>Status<select name="status"><option value="">Todos</option>@foreach(var s in new[]{"aberto","pendente","confirmado","cancelado","realizado"}){<option value="@s" selected="@(ViewBag.Status==s)">@s</option>}</select></label><button class="cc-button" type="submit">Aplicar filtros</button></form>
 @if(Model.Coverage.Count==0){<div class="cc-empty"><h3>Operação tranquila neste período</h3><p>Nenhum plantão corresponde aos filtros selecionados.</p></div>}else{<div class="coverage-grid">@foreach(var item in Model.Coverage){<article class="coverage-card risk-@item.RiskLabel.ToLowerInvariant().Replace("í","i").Replace("ç","c")"><header><span class="status">@item.Status</span><span class="risk">@item.RiskLabel · @item.Risk</span></header><h3>@item.Unit</h3><p>@item.Specialty</p><time datetime="@item.StartsAt.ToString("O")">@item.StartsAt.ToString("dd/MM · HH:mm") — @item.EndsAt.ToString("HH:mm")</time><footer><span>@(item.OpenSlots>0?$"{item.OpenSlots} vaga(s) aberta(s)":"Cobertura completa")</span><a asp-controller="Plantoes" asp-action="Details" asp-route-id="@item.Id">Ver detalhe <span aria-hidden="true">→</span></a></footer></article>}</div>}
 </section>}
</main>
@section Styles{<link rel="stylesheet" href="~/css/pages/command-center.css" asp-append-version="true" />}
