@model PlantaoPro.Web.Models.RelatoriosFinanceirosPageViewModel
@{
    ViewData["Title"] = UiText.L("Adm360.RelFin.PageTitle");
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">@UiText.L("Adm360.RelFin.Heading")</h2>
            <p class="text-muted small mb-0">@UiText.L("Adm360.RelFin.Subheading")</p>
        </div>
    </div>

    <!-- Filtro Superior -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="aba" value="@Model.AbaAtiva" />
                @if (Model.VendedorId.HasValue)
                {
                    <input type="hidden" name="vendedorId" value="@Model.VendedorId.Value" />
                }
                <div class="col-6 col-md-2">
                    <label class="form-label small text-secondary" for="dataInicio">@UiText.L("Adm360.RelFin.LabelInicio")</label>
                    <input type="date" id="dataInicio" name="inicio" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@Model.Inicio?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small text-secondary" for="dataFim">@UiText.L("Adm360.RelFin.LabelFim")</label>
                    <input type="date" id="dataFim" name="fim" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@Model.Fim?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small text-secondary" for="selCliente">@UiText.L("Adm360.RelFin.LabelCliente")</label>
                    <select id="selCliente" name="clienteId" class="form-select form-select-sm bg-dark text-light border-secondary">
                        <option value="">@UiText.L("Adm360.RelFin.OptTodosClientes")</option>
                        @foreach (var opcao in Model.Clientes)
                        {
                            <option value="@opcao.Value" selected="@((Model.ClienteId?.ToString() == opcao.Value) ? "selected" : "")">@opcao.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-search me-1"></i> @UiText.L("Adm360.RelFin.ButtonAtualizar")
                    </button>
                    @if (Model.AbaAtiva == "vendas")
                    {
                        <a asp-action="ExportarVendasCsv" asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
                           asp-route-vendedorId="@Model.VendedorId?.ToString()" asp-route-clienteId="@Model.ClienteId?.ToString()"
                           class="btn btn-sm btn-outline-success">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> @UiText.L("Adm360.RelFin.ExportCsv")
                        </a>
                    }
                    else if (Model.AbaAtiva == "comissoes")
                    {
                        <a asp-action="ExportarComissoesCsv" asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
                           asp-route-vendedorId="@Model.VendedorId?.ToString()" asp-route-clienteId="@Model.ClienteId?.ToString()"
                           class="btn btn-sm btn-outline-success">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> @UiText.L("Adm360.RelFin.ExportCsv")
                        </a>
                    }
                    else if (Model.AbaAtiva == "margem")
                    {
                        <a asp-action="ExportarMargemCsv" asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
                           asp-route-clienteId="@Model.ClienteId?.ToString()"
                           class="btn btn-sm btn-outline-success">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> @UiText.L("Adm360.RelFin.ExportCsv")
                        </a>
                    }
                    else if (Model.AbaAtiva == "vencimentos")
                    {
                        <a asp-action="ExportarVencimentosCsv" asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
                           asp-route-clienteId="@Model.ClienteId?.ToString()"
                           class="btn btn-sm btn-outline-success">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> @UiText.L("Adm360.RelFin.ExportCsv")
                        </a>
                    }
                    else if (Model.AbaAtiva == "dre")
                    {
                        <a asp-action="ExportarDreCsv" asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
                           asp-route-clienteId="@Model.ClienteId?.ToString()"
                           class="btn btn-sm btn-outline-success">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> @UiText.L("Adm360.RelFin.ExportCsv")
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Abas de Navegação -->
    <ul class="nav nav-tabs border-secondary mb-3" role="tablist">
        <li class="nav-item">
            <a class="nav-link @(Model.AbaAtiva == "vendas" ? "active bg-dark text-light border-secondary border-bottom-0" : "text-muted")" role="tab" aria-selected="@(Model.AbaAtiva == "vendas" ? "true" : "false")"
               asp-action="RelatoriosFinanceiros" asp-route-aba="vendas"
               asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
               asp-route-vendedorId="@Model.VendedorId?.ToString()" asp-route-clienteId="@Model.ClienteId?.ToString()">
                <i class="bi bi-graph-up me-1"></i> @UiText.L("Adm360.RelFin.TabVendas")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.AbaAtiva == "comissoes" ? "active bg-dark text-light border-secondary border-bottom-0" : "text-muted")" role="tab" aria-selected="@(Model.AbaAtiva == "comissoes" ? "true" : "false")"
               asp-action="RelatoriosFinanceiros" asp-route-aba="comissoes"
               asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
               asp-route-vendedorId="@Model.VendedorId?.ToString()" asp-route-clienteId="@Model.ClienteId?.ToString()">
                <i class="bi bi-people me-1"></i> @UiText.L("Adm360.RelFin.TabComissoes")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.AbaAtiva == "margem" ? "active bg-dark text-light border-secondary border-bottom-0" : "text-muted")" role="tab" aria-selected="@(Model.AbaAtiva == "margem" ? "true" : "false")"
               asp-action="RelatoriosFinanceiros" asp-route-aba="margem"
               asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
               asp-route-vendedorId="@Model.VendedorId?.ToString()" asp-route-clienteId="@Model.ClienteId?.ToString()">
                <i class="bi bi-pie-chart me-1"></i> @UiText.L("Adm360.RelFin.TabMargem")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.AbaAtiva == "vencimentos" ? "active bg-dark text-light border-secondary border-bottom-0" : "text-muted")" role="tab" aria-selected="@(Model.AbaAtiva == "vencimentos" ? "true" : "false")"
               asp-action="RelatoriosFinanceiros" asp-route-aba="vencimentos"
               asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
               asp-route-vendedorId="@Model.VendedorId?.ToString()" asp-route-clienteId="@Model.ClienteId?.ToString()">
                <i class="bi bi-stopwatch me-1"></i> @UiText.L("Adm360.RelFin.TabVencimentos")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.AbaAtiva == "dre" ? "active bg-dark text-light border-secondary border-bottom-0" : "text-muted")" role="tab" aria-selected="@(Model.AbaAtiva == "dre" ? "true" : "false")"
               asp-action="RelatoriosFinanceiros" asp-route-aba="dre"
               asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
               asp-route-vendedorId="@Model.VendedorId?.ToString()" asp-route-clienteId="@Model.ClienteId?.ToString()">
                <i class="bi bi-journal-text me-1"></i> @UiText.L("Adm360.RelFin.TabDre")
            </a>
        </li>
    </ul>

    @if (Model.AbaAtiva == "vendas")
    {
        <!-- Conteúdo Aba Vendas -->
        <div class="card bg-dark border-secondary text-light">
            <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                <span class="fw-bold">Vendas Faturadas no Período</span>
                <span class="badge bg-secondary">@Model.Vendas.Count vendas</span>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0" style="min-width: 860px;">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th scope="col">Número</th>
                            <th scope="col">Competência</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Pagador</th>
                            <th scope="col">Vendedor</th>
                            <th scope="col" class="text-end">Total Bruto</th>
                            <th scope="col" class="text-end">Desconto</th>
                            <th scope="col" class="text-end">Total Líquido</th>
                            <th scope="col" class="text-end">Comissão Prev.</th>
                            <th scope="col">Situação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Vendas.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">Nenhuma venda encontrada no período.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var it in Model.Vendas)
                            {
                                <tr>
                                    <td class="fw-bold text-info">@it.VendaNumero</td>
                                    <td>@it.Competencia.ToString("dd/MM/yyyy")</td>
                                    <td>@it.Cliente</td>
                                    <td>@it.Pagador</td>
                                    <td>@(it.Vendedor ?? "—")</td>
                                    <td class="text-end font-monospace">@it.TotalBruto.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-warning">@it.Desconto.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace fw-bold text-success">@it.TotalLiquido.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-light">@it.ComissaoPrevista.ToString("C2", ptBr)</td>
                                    <td><span class="badge bg-success">@it.Situacao</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.AbaAtiva == "comissoes")
    {
        <!-- Conteúdo Aba Comissões -->
        <div class="card bg-dark border-secondary text-light">
            <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                <span class="fw-bold">Apropriação de Comissões por Recebimentos Efetivos</span>
                <span class="badge bg-secondary">@Model.Comissoes.Count baixas</span>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0" style="min-width: 800px;">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th scope="col">Vendedor</th>
                            <th scope="col">Venda</th>
                            <th scope="col">Data do Recebimento</th>
                            <th scope="col" class="text-end">Base de Cálculo (Recebido)</th>
                            <th scope="col" class="text-end">% Comissão</th>
                            <th scope="col" class="text-end">Comissão Apropriada</th>
                            <th scope="col">Situação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Comissoes.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Nenhuma comissão apropriada no período.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var c in Model.Comissoes)
                            {
                                <tr>
                                    <td class="fw-bold text-light">@c.Vendedor</td>
                                    <td class="text-info">@c.VendaNumero</td>
                                    <td>@c.DataBaixa.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end font-monospace">@c.BaseCalculo.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace">@c.Percentual.ToString("N1", ptBr)%</td>
                                    <td class="text-end font-monospace fw-bold text-success">@c.ComissaoApropriada.ToString("C2", ptBr)</td>
                                    <td><span class="badge @(c.Situacao == "APROPRIADA" ? "bg-success" : "bg-warning text-dark")">@c.Situacao</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-dark border-secondary">
                        <tr class="fw-bold">
                            <td colspan="5" class="text-end">Total Apropriado (líquido de estornos — apenas APROPRIADA):</td>
                            <td class="text-end text-success fs-6 font-monospace">
                                @Model.Comissoes.Where(x => x.Situacao == "APROPRIADA").Sum(x => x.ComissaoApropriada).ToString("C2", ptBr)
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else if (Model.AbaAtiva == "margem")
    {
        <!-- Conteúdo Aba Margem -->
        <div class="card bg-dark border-secondary text-light">
            <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                <span class="fw-bold">Resultado Gerencial e Margem por Cirurgia</span>
                <span class="badge bg-secondary">@Model.Margens.Count cirurgias</span>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0" style="min-width: 860px;">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th scope="col">Venda</th>
                            <th scope="col">Vale</th>
                            <th scope="col">Cliente</th>
                            <th scope="col" class="text-end">Receita Líquida</th>
                            <th scope="col" class="text-end">Custo Materiais</th>
                            <th scope="col" class="text-end">Comissão Prev.</th>
                            <th scope="col" class="text-end">Comissão Aprop.</th>
                            <th scope="col" class="text-end">Margem Bruta (R$)</th>
                            <th scope="col" class="text-end">Margem (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Margens.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">Nenhum resultado gerencial encontrado no período.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var m in Model.Margens)
                            {
                                <tr>
                                    <td class="fw-bold text-info">@m.VendaNumero</td>
                                    <td>@m.ValeNumero</td>
                                    <td>@m.Cliente</td>
                                    <td class="text-end font-monospace text-success">@m.ReceitaLiquida.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-muted">@m.CustoConsumido.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-muted">@m.ComissaoPrevista.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-info">@m.ComissaoApropriada.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace fw-bold @(m.MargemContribuicao >= 0 ? "text-success" : "text-danger")">
                                        @m.MargemContribuicao.ToString("C2", ptBr)
                                    </td>
                                    <td class="text-end font-monospace fw-bold @(m.MargemPercentual >= 0 ? "text-success" : "text-danger")">
                                        @m.MargemPercentual.ToString("N1", ptBr)%
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.AbaAtiva == "vencimentos")
    {
        <!-- Conteúdo Aba Vencimentos por Parcela (s10 / rodada 9 r9f) -->
        <div class="card bg-dark border-secondary text-light">
            <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                <span class="fw-bold">Títulos a Receber por Parcela — vencido avaliado na data do relatório</span>
                <span class="badge bg-secondary">@Model.Vencimentos.Count parcelas</span>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0" style="min-width: 960px;">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th scope="col">Título</th>
                            <th scope="col">Venda</th>
                            <th scope="col">Competência</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Pagador</th>
                            <th scope="col">Parcela</th>
                            <th scope="col">Emissão</th>
                            <th scope="col">Vencimento</th>
                            <th scope="col" class="text-end">Valor Principal</th>
                            <th scope="col" class="text-end">Recebido</th>
                            <th scope="col" class="text-end">Saldo Aberto</th>
                            <th scope="col">Situação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Vencimentos.Count == 0)
                        {
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">Nenhuma parcela com vencimento no período.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var it in Model.Vencimentos)
                            {
                                var badgeSituacao = it.Situacao == "QUITADO" ? "bg-success" : (it.Situacao == "PARCIAL" ? "bg-warning text-dark" : "bg-secondary");
                                <tr>
                                    <td class="fw-bold text-info">@it.TituloNumero</td>
                                    <td>@it.VendaNumero</td>
                                    <td>@it.Competencia.ToString("dd/MM/yyyy")</td>
                                    <td>@it.Cliente</td>
                                    <td>@it.Pagador</td>
                                    <td class="font-monospace">@it.Parcela/@it.TotalParcelas</td>
                                    <td>@it.DataEmissao.ToString("dd/MM/yyyy")</td>
                                    <td class="@(it.Vencido ? "text-danger fw-bold" : "")">@it.DataVencimento.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end font-monospace">@it.ValorPrincipal.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-muted">@it.ValorRecebido.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace @(it.SaldoAberto > 0 ? "fw-bold text-warning" : "text-muted")">@it.SaldoAberto.ToString("C2", ptBr)</td>
                                    <td>
                                        @if (it.Vencido)
                                        {
                                            <span class="badge bg-danger me-1" title="Vencimento anterior à data do relatório com saldo aberto">VENCIDO</span>
                                        }
                                        <span class="badge @badgeSituacao">@it.Situacao</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-dark border-secondary">
                        <tr class="fw-bold">
                            <td colspan="8" class="text-end">Totais do relatório (cada parcela contada uma única vez):</td>
                            <td class="text-end font-monospace">@Model.Vencimentos.Sum(x => x.ValorPrincipal).ToString("C2", ptBr)</td>
                            <td class="text-end font-monospace">@Model.Vencimentos.Sum(x => x.ValorRecebido).ToString("C2", ptBr)</td>
                            <td class="text-end font-monospace text-warning">@Model.Vencimentos.Sum(x => x.SaldoAberto).ToString("C2", ptBr)</td>
                            <td class="text-center">
                                @if (Model.Vencimentos.Any(x => x.Vencido))
                                {
                                    <span class="badge bg-danger">
                                        @Model.Vencimentos.Count(x => x.Vencido) vencida(s) — @Model.Vencimentos.Where(x => x.Vencido).Sum(x => x.SaldoAberto).ToString("C2", ptBr)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Sem saldo vencido na data do relatório</span>
                                }
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    else if (Model.AbaAtiva == "dre")
    {
        <!-- Conteúdo Aba DRE Gerencial por Cliente (s11 / rodada 9 r9g) -->
        <div class="card bg-dark border-secondary text-light">
            <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="fw-bold">@UiText.L("Adm360.RelFin.DreTableTitle")</span>
                <div>
                    @if (Model.DreConciliacao is { } concHead)
                    {
                        @if (concHead.ReceitaLiquidaBate && concHead.CustoBate && concHead.DespesasBatem)
                        {
                            <span class="badge bg-success me-1" title="Consolidado = clientes + Não atribuída, verificado re-agregando as mesmas fontes no período">@UiText.L("Adm360.RelFin.DreBadgeReconciliado")</span>
                        }
                        else
                        {
                            <span class="badge bg-danger me-1">@UiText.L("Adm360.RelFin.DreBadgeDivergencia")</span>
                        }
                    }
                    <span class="badge bg-secondary">@Model.Dre.Count @UiText.L("Adm360.RelFin.DreUnitLinhas")</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0" style="min-width: 1160px;">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th scope="col">@UiText.L("Adm360.RelFin.DreThCliente")</th>
                            <th scope="col" class="text-end">@UiText.L("Adm360.RelFin.DreThQtdVendas")</th>
                            <th scope="col" class="text-end">@UiText.L("Adm360.RelFin.DreThReceitaBruta")</th>
                            <th scope="col" class="text-end">@UiText.L("Adm360.RelFin.DreThDeducoes")</th>
                            <th scope="col" class="text-end">@UiText.L("Adm360.RelFin.DreThReceitaLiquida")</th>
                            <th scope="col" class="text-end">@UiText.L("Adm360.RelFin.DreThCustoRealizado")</th>
                            <th scope="col" class="text-end">@UiText.L("Adm360.RelFin.DreThResultadoBruto")</th>
                            <th scope="col" class="text-end">@UiText.L("Adm360.RelFin.DreThComissoes")</th>
                            <th scope="col" class="text-end">@UiText.L("Adm360.RelFin.DreThDespesas")</th>
                            <th scope="col" class="text-end">@UiText.L("Adm360.RelFin.DreThResultadoGerencial")</th>
                            <th scope="col">@UiText.L("Adm360.RelFin.DreThOrigem")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Dre.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="text-center text-muted py-4">Sem vendas confirmadas nem títulos de despesa no período.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var it in Model.Dre)
                            {
                                var ehOrfa = !it.ClienteId.HasValue;
                                <tr>
                                    <td>
                                        @if (ehOrfa)
                                        {
                                            <em class="text-muted">@it.Cliente</em>
                                        }
                                        else
                                        {
                                            @it.Cliente
                                        }
                                    </td>
                                    <td class="text-end font-monospace">@it.QtdVendas</td>
                                    <td class="text-end font-monospace">@it.ReceitaBruta.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-warning">@it.Deducoes.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-success">@it.ReceitaLiquida.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-muted">@it.CustoRealizado.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace fw-bold @(it.ResultadoBruto >= 0 ? "text-success" : "text-danger")">@it.ResultadoBruto.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-muted">@it.ComissoesPrevistas.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace text-muted">@it.DespesasAtribuidas.ToString("C2", ptBr)</td>
                                    <td class="text-end font-monospace fw-bold @(it.ResultadoGerencial >= 0 ? "text-success" : "text-danger")">@it.ResultadoGerencial.ToString("C2", ptBr)</td>
                                    <td class="text-nowrap">
                                        @if (it.ClienteId.HasValue)
                                        {
                                            <a asp-action="RelatoriosFinanceiros" asp-route-aba="vendas"
                                               asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
                                               asp-route-clienteId="@it.ClienteId.Value.ToString()"
                                               class="text-info" title="Ver as vendas que compõem esta linha (aba Vendas filtrada por este cliente)">
                                                <i class="bi bi-search"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="RelatoriosFinanceiros" asp-route-aba="vendas"
                                               asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
                                               class="text-info" title="Revisar vendas sem atribuição na aba Vendas (o bucket é derivado — não há filtro único para ele)">
                                                <i class="bi bi-search"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (Model.Dre.Count > 0)
                    {
                        <tfoot class="table-dark border-secondary">
                            <tr class="fw-bold">
                                <td colspan="2" class="text-end">@UiText.L("Adm360.RelFin.DreRodapeTotal")</td>
                                <td class="text-end font-monospace">@Model.Dre.Sum(x => x.ReceitaBruta).ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace text-warning">@Model.Dre.Sum(x => x.Deducoes).ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace text-success">@Model.Dre.Sum(x => x.ReceitaLiquida).ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace">@Model.Dre.Sum(x => x.CustoRealizado).ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace">@Model.Dre.Sum(x => x.ResultadoBruto).ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace">@Model.Dre.Sum(x => x.ComissoesPrevistas).ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace">@Model.Dre.Sum(x => x.DespesasAtribuidas).ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace @(Model.Dre.Sum(x => x.ResultadoGerencial) >= 0 ? "text-success" : "text-danger")">@Model.Dre.Sum(x => x.ResultadoGerencial).ToString("C2", ptBr)</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
            @if (Model.DreConciliacao is { } conc)
            {
                <div class="card-footer bg-dark border-secondary small text-secondary">
                    <strong class="text-light d-block mb-2"><i class="bi bi-check2-all me-1"></i>@UiText.L("Adm360.RelFin.DreConciliacaoTitulo")</strong>
                    <div class="row g-2">
                        <div class="col-md-4">
                            Receita líquida:
                            @if (conc.ReceitaLiquidaBate)
                            {
                                <span class="badge bg-success">bate — delta zero</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">delta @conc.DeltaReceitaLiquida.ToString("C2", ptBr)</span>
                            }
                        </div>
                        <div class="col-md-4">
                            Custo realizado:
                            @if (conc.CustoBate)
                            {
                                <span class="badge bg-success">bate — delta zero</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">delta @conc.DeltaCusto.ToString("C2", ptBr)</span>
                            }
                        </div>
                        <div class="col-md-4">
                            Despesas:
                            <span class="badge bg-secondary">por construção (sem divisão por cliente nesta base)</span>
                        </div>
                    </div>
                    <p class="mb-0 mt-2">
                        Período com <strong>@conc.VendasNoPeriodo</strong> venda(s) confirmada(s) e <strong>@conc.DespesasNoPeriodo</strong> título(s) de despesa em competência.
                        <strong>Diferença de caixa:</strong> esta visão reconhece na <code>competencia</code> dos documentos (competência), e não nas datas de recebimento/pagamento — para o lado caixa use o Fluxo de Caixa.
                    </p>
                </div>
            }
        </div>
    }

    <!-- B4 (J12) — Indicadores declarados: fonte, fórmula, filtros/período e tratamento de estorno -->
    <div class="card bg-dark border-secondary mt-4 text-light">
        <div class="card-header bg-dark border-secondary">
            <span class="fw-bold"><i class="bi bi-calculator me-2"></i>@UiText.L("Adm360.RelFin.IndicatorsTitle")</span>
        </div>
        <div class="card-body small text-secondary">
            <div class="row g-3">
                <div class="col-lg-3">
                    <strong class="text-light d-block mb-1">Vendas por Período</strong>
                    <ul class="mb-0 ps-3">
                        <li><strong>Fonte:</strong> <code>adm360_vendas</code> (linha por venda confirmada), com nomes de cliente/pagador/vendedor resolvidos via <code>adm360_parceiros</code>; registros históricos podem apontar para a tabela clínica <code>hospitais</code> (fallback de nome) e sem nome vira "Cliente não identificado".</li>
                        <li><strong>Fórmula:</strong> Total Líquido = bruto − desconto; Custo = Σ custo dos lotes consumidos na valorização; Comissão prevista = líquido × % comissão da venda. Valores gravados na venda, sem recálculo retroativo.</li>
                        <li><strong>Filtros/período:</strong> <code>competencia &gt;= início AND competencia &lt;= fim</code> (inclusivo); opcionais <code>clienteId</code> e <code>vendedorId</code>; sempre isolado por tenant — <code>clienteId</code> de outro tenant é rejeitado com erro explícito (400). Sem data: últimos 30 dias até hoje.</li>
                        <li><strong>Estorno:</strong> não altera a linha da venda; o efeito aparece apenas em Comissões (situação ESTORNADA) e no Fluxo de Caixa (movimento compensatório).</li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <strong class="text-light d-block mb-1">Comissões Apropriadas</strong>
                    <ul class="mb-0 ps-3">
                        <li><strong>Fonte:</strong> <code>adm360_comissoes_apropriadas</code> — uma linha por recebimento efetivo (baixa de título), junta venda, usuário e baixa para auditoria.</li>
                        <li><strong>Fórmula:</strong> por baixa: arred((recebido acumulado da venda) × % ÷ 100, 2) − já apropriada, mínimo 0 (resíduo corrigido na última baixa).</li>
                        <li><strong>Filtros/período:</strong> <code>data_recebimento &gt;= início AND data_recebimento &lt;= fim</code> (inclusivo); opcional <code>vendedorId</code>.</li>
                        <li><strong>Estorno:</strong> a linha vira ESTORNADA (preservada para auditoria; badge âmbar) e o total do rodapé conta apenas APROPRIADA. Re-estorno devolve a APROPRIADA. Estorno é bloqueado dentro de fechamento de caixa fechado.</li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <strong class="text-light d-block mb-1">Margem por Cirurgia</strong>
                    <ul class="mb-0 ps-3">
                        <li><strong>Fonte:</strong> <code>adm360_vendas</code> somente com <code>situacao='CONFIRMADA'</code>, via valorização até o vale de origem.</li>
                        <li><strong>Fórmula:</strong> Margem R$ = Receita Líquida − Custo Consumido − Comissão Prevista; Margen % = margem ÷ receita × 100 (2 casas; 0 quando receita = 0). Coluna "Comissão Aprop." = Σ comissões APROPRIADA (estornos já excluídos no banco).</li>
                        <li><strong>Filtros/período:</strong> <code>competencia</code> entre início e fim (inclusivo); opcional <code>clienteId</code> (com rejeição cross-tenant); sem filtro de vendedor nesta aba.</li>
                        <li><strong>Estorno:</strong> não altera receita, custo nem comissão prevista; somente a coluna "Comissão Aprop." cai quando uma baixa da venda é estornada.</li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <strong class="text-light d-block mb-1">Vencimentos por Parcela</strong>
                    <ul class="mb-0 ps-3">
                        <li><strong>Fonte:</strong> <code>adm360_titulos_receber</code> × <code>adm360_vendas</code> — um título (parcela) = exatamente uma linha; os JOINs de nome são 1:1, então os totais do rodapé somam cada parcela uma única vez (sem multiplicação). Parcelas CANCELADO ficam fora; QUITADO/PARCIAL aparecem como histórico de liquidação.</li>
                        <li><strong>Fórmula "vencido":</strong> <code>data_vencimento &lt; data do relatório AND saldo_aberto &gt; 0</code> (referência = momento da geração do relatório), mesma regra das Contas a Receber.</li>
                        <li><strong>Filtros/período:</strong> período sobre <code>data_vencimento</code> (inclusivo); opcional <code>clienteId</code> (com rejeição cross-tenant); sempre isolado por tenant.</li>
                        <li><strong>Estorno/recebimento:</strong> baixas e estornos atualizam <code>valor_recebido</code>/<code>saldo_aberto</code>/<code>situacao</code> no próprio título; a linha reflete o estado corrente sem duplicar.</li>
                    </ul>
                </div>
                <div class="col-lg-12">
                    <strong class="text-light d-block mb-1">DRE Gerencial por Cliente (competência)</strong>
                    <ul class="mb-0 ps-3">
                        <li><strong>Fonte:</strong> lado receita/custo = <code>adm360_vendas</code> somente <code>situacao='CONFIRMADA'</code>, período sobre <code>competencia</code>; lado despesa = <code>adm360_titulos_pagar</code> do período (sobre o <code>competencia</code> do título; CANCELADO fora). Vendas sem nome resolvido no tenant caem no bucket "Não atribuída".</li>
                        <li><strong>Fórmula:</strong> Receita Líquida = Bruta − Deduções (descontos identificados na venda); Resultado Bruto = Líquida − Custo Realizado (valor gravado na venda); Resultado Gerencial = Bruto − Comissões Previstas (gravadas na venda) − Despesas Atribuídas (Σ valor_principal dos títulos do período).</li>
                        <li><strong>Conciliação:</strong> consolidado = clientes + "Não atribuída", verificado na geração re-agregando as mesmas fontes; deltas diferentes de zero aparecem como badge vermelho em vez de somas "que casam por construção". Cada linha tem atalho para a aba Vendas (registros de origem), filtrada pelo cliente quando aplicável.</li>
                        <li><strong>Filtros/período:</strong> competência entre início e fim (inclusivo); opcional <code>clienteId</code> com rejeição cross-tenant (400); sempre isolado por tenant.</li>
                        <li><strong>Diferente de fluxo de caixa:</strong> reconhece na <code>competencia</code> do documento — não nas datas de recebimento/pagamento.</li>
                        <li><strong>Limitações (fontes incompletas, sinalizadas sem esconder):</strong> (1) despesas não têm vínculo com cliente comercial nesta base (<code>origem_tipo</code> ∈ RECEBIMENTO_COMPRA/DESPESA_MANUAL/COMISSAO_VENDEDOR) — todo o total se concentra na linha "Não atribuída", e com filtro por cliente a linha leva 0 (nenhuma regra de atribuição foi inventada); (2) comissões são as previstas na venda, não o efetivamente pago em caixa; (3) base gerencial (sem critério contábil/ISC, sem conversão cambial); (4) valores gravados no documento — sem recálculo retroativo de custos.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-3"><i class="bi bi-info-circle me-2"></i>Entendendo os Relatórios Financeiros</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-4 col-lg-2">
                    <strong class="text-light d-block mb-1">Para que serve</strong>
                    Permite auditar as vendas efetuadas, a liquidação de comissões por vendedor e a rentabilidade gerencial dos procedimentos cirúrgicos.
                </div>
                <div class="col-md-4 col-lg-2">
                    <strong class="text-light d-block mb-1">Quem pode usar</strong>
                    Diretoria, controladoria, gerência comercial e auditoria interna.
                </div>
                <div class="col-md-4 col-lg-3">
                    <strong class="text-light d-block mb-1">Como executar</strong>
                    Selecione a visão desejada nas abas, aplique os filtros de período e de cliente (comercial) e exporte em CSV caso necessite de análises em planilhas.
                </div>
                <div class="col-md-6 col-lg-3">
                    <strong class="text-light d-block mb-1">Efeito da confirmação</strong>
                    Os relatórios utilizam custos históricos reais e comissões efetivamente apropriadas pelas liquidações de caixa.
                </div>
                <div class="col-md-6 col-lg-2">
                    <strong class="text-light d-block mb-1">Próximo passo</strong>
                    Utilizar as exportações protegidas para fechamento contábil e conciliação de pagamentos.
                </div>
            </div>
        </div>
    </div>
</div>
