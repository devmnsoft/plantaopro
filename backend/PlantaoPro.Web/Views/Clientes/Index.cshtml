@model PlantaoPro.Web.Models.ClienteCentralPageDto
@{
    ViewData["Title"] = "Central global de clientes";
    ViewData["Subtitle"] = "Administração MNSOFT com contexto explícito, indicadores verificáveis e isolamento por cliente.";
    var busca = ViewBag.Busca as string;
    var status = ViewBag.Status as string;
    var totalPaginas = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Model.PageSize));
}
<div class="pp-page pp-clients-workspace">
<header class="pp-page-hero" aria-labelledby="clientsTitle"><div class="pp-page-hero__copy"><span class="pp-eyebrow">Administração da plataforma · Modo global</span><h2 id="clientsTitle">Central de clientes</h2><p>Compare organizações sem confundir situação administrativa, contrato vigente e permissões individuais.</p></div><div class="pp-hero-actions"><a class="btn btn-outline-primary" asp-controller="Auditoria" asp-action="Index"><app-icon name="Audit" size="18" /> Auditoria</a><a class="btn btn-primary" asp-controller="Onboarding" asp-action="NovoCliente"><app-icon name="Hospital" size="18" /> Novo cliente</a></div></header>
<details class="pp-screen-guide"><summary><span><app-icon name="Help" size="17" /><strong>Regras e origem dos dados</strong></span><span class="pp-screen-guide__hint">Ajuda</span></summary><div class="pp-screen-guide__body"><p>Os totais abrangem todo o conjunto filtrado. Usuário ativo é a identidade/vínculo ativo agora. Módulo vigente exige concessão habilitada, ativada e não desativada; contratar não concede permissões. Pendências são itens persistidos do onboarding com estado PENDENTE. Ausência de telemetria não é apresentada como falta de uso.</p></div></details>
<div class="pp-scope-guardrails" role="status"><span><app-icon name="Security" size="17" /><strong>Cliente selecionado:</strong> nenhum · visão global</span><span><app-icon name="Audit" size="17" /><strong>Ator:</strong> @User.Identity?.Name</span><span><app-icon name="Lock" size="17" /><strong>Operações:</strong> autorizadas e auditadas no servidor</span></div>
<form method="get" class="pp-operation-panel mb-3" aria-label="Filtros da Central"><div class="row g-3 align-items-end"><div class="col-12 col-lg-6"><label class="form-label" for="busca">Nome, razão social ou CNPJ</label><input class="form-control" id="busca" name="busca" value="@busca" autocomplete="off" /></div><div class="col-12 col-sm-6 col-lg-3"><label class="form-label" for="status">Situação administrativa</label><select class="form-select" id="status" name="status"><option value="">Todas</option><option value="ATIVO" selected="@(status == "ATIVO")">Ativo</option><option value="SUSPENSO" selected="@(status == "SUSPENSO")">Suspenso</option><option value="TESTE" selected="@(status == "TESTE")">Em teste</option><option value="CANCELADO" selected="@(status == "CANCELADO")">Cancelado</option></select></div><div class="col-12 col-sm-6 col-lg-3 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit">Aplicar filtros</button><a class="btn btn-outline-secondary" asp-action="Index">Limpar</a></div></div></form>
@if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage as string)) { <div class="alert alert-danger" role="alert"><strong>Falha ao carregar.</strong> @ViewBag.ErrorMessage</div> }
<section class="pp-operational-kpis" aria-label="Totais do conjunto filtrado"><article class="pp-operational-kpi"><span>Clientes filtrados</span><strong>@Model.Totais.Clientes</strong><small>fonte: clientes ativos no cadastro</small></article><article class="pp-operational-kpi"><span>Em operação</span><strong>@Model.Totais.Ativos</strong><small>situação administrativa ATIVO, agora</small></article><article class="pp-operational-kpi"><span>Usuários ativos</span><strong>@Model.Totais.UsuariosAtivos</strong><small>vínculos ativos no conjunto filtrado</small></article><article class="pp-operational-kpi is-warning"><span>Pendências</span><strong>@Model.Totais.Pendencias</strong><small>checklist persistido, estado PENDENTE</small></article></section>
<section class="pp-operation-panel" aria-labelledby="listTitle"><header class="pp-operation-panel__header"><div><h2 id="listTitle">Organizações</h2><p>Página @Model.Page de @totalPaginas · @Model.Total resultados no filtro.</p></div></header><div class="table-responsive pp-premium-table"><table class="table align-middle" data-mobile-cards><caption class="visually-hidden">Clientes, módulos vigentes, equipe e pendências</caption><thead><tr><th>Cliente</th><th>Situação</th><th>Módulos habilitados e vigentes</th><th>Equipe</th><th>Pendências</th><th class="text-end">Ações</th></tr></thead><tbody>
@if (!Model.Items.Any()) { <tr><td colspan="6"><div class="pp-guided-empty"><app-icon name="Search" size="28" /><strong>Nenhum cliente encontrado</strong><span>Altere os filtros. Uma falha do serviço é exibida como erro, não como estado vazio.</span></div></td></tr> }
@foreach (var cliente in Model.Items) { var css=cliente.Status=="ATIVO"?"is-success":cliente.Status=="SUSPENSO"?"is-danger":"is-muted";<tr><td data-label="Cliente"><strong>@cliente.NomeFantasia</strong><div class="small text-muted">@cliente.Cnpj · @cliente.Cidade/@cliente.Estado</div></td><td data-label="Situação"><span class="pp-status-badge @css">@cliente.Status</span></td><td data-label="Módulos">@(string.IsNullOrWhiteSpace(cliente.ModulosVigentes) ? "Nenhum módulo vigente" : cliente.ModulosVigentes)</td><td data-label="Equipe">@cliente.UsuariosAtivos ativos</td><td data-label="Pendências">@cliente.Pendencias</td><td data-label="Ações"><div class="pp-table-actions"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@cliente.Id">Abrir contexto</a><a class="btn btn-sm btn-outline-secondary" asp-controller="Modulos" asp-action="Tenant" asp-route-id="@cliente.Id">Contratos</a><form asp-action="AlterarStatus" method="post" data-confirm="true" data-confirm-title="Alterar situação de @cliente.NomeFantasia" data-confirm-message="Esta ação afeta o acesso do cliente, não apaga históricos nem altera contratos. Confirme após informar o motivo." data-confirm-type="warning">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@cliente.Id"/><input type="hidden" name="acao" value="@(cliente.Status=="SUSPENSO"?"REATIVAR":"SUSPENDER")"/><input type="hidden" name="busca" value="@busca"/><input type="hidden" name="status" value="@status"/><input type="hidden" name="pagina" value="@Model.Page"/><label class="visually-hidden" for="motivo-@cliente.Id">Motivo</label><input id="motivo-@cliente.Id" class="form-control form-control-sm" name="motivo" required maxlength="300" placeholder="Motivo obrigatório"/><button class="btn btn-sm btn-outline-warning" type="submit">@(cliente.Status=="SUSPENSO"?"Reativar":"Suspender")</button></form></div></td></tr> }
</tbody></table></div><nav aria-label="Paginação"><div class="d-flex justify-content-between"><a class="btn btn-sm btn-outline-secondary @(Model.Page<=1?"disabled":null)" asp-route-busca="@busca" asp-route-status="@status" asp-route-pagina="@(Model.Page-1)">Anterior</a><span>Página @Model.Page de @totalPaginas</span><a class="btn btn-sm btn-outline-secondary @(Model.Page>=totalPaginas?"disabled":null)" asp-route-busca="@busca" asp-route-status="@status" asp-route-pagina="@(Model.Page+1)">Próxima</a></div></nav></section>
</div>
