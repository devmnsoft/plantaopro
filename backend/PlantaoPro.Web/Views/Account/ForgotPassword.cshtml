@model ForgotPasswordViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Recuperar acesso"; }
<div class="auth-experience auth-experience--compact">
    <section class="auth-form-panel auth-recovery-card" aria-labelledby="recoveryTitle">
        <a asp-action="Login" class="auth-back-link">← Voltar para o login</a>
        <span class="pp-page-intro__eyebrow">Recuperação segura</span>
        <h1 id="recoveryTitle">Recupere seu acesso</h1>
        <p>Informe o e-mail profissional. Se houver uma conta ativa, enviaremos instruções seguras sem revelar dados de cadastro.</p>
        <div class="pp-info-banner" role="note"><span class="pp-alert__icon" aria-hidden="true">i</span><div class="pp-alert__content"><strong>Proteção da sua conta</strong><p>O link tem validade limitada e só pode ser utilizado uma vez.</p></div></div>
        <form asp-action="ForgotPassword" method="post" class="pp-form" novalidate data-focus-invalid>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" tabindex="-1"></div>
            <div class="pp-form-field"><label asp-for="Email" class="pp-form-label">E-mail profissional <span class="pp-required-marker" aria-hidden="true">*</span></label><input asp-for="Email" class="form-control form-control-lg" type="email" autocomplete="email" inputmode="email" aria-describedby="recoveryEmailHelp" required /><small id="recoveryEmailHelp" class="pp-field-help">Use o mesmo e-mail vinculado ao PlantãoPro.</small><span asp-validation-for="Email" class="pp-form-error" data-valmsg-for="Email"></span></div>
            <button class="btn btn-primary btn-lg" type="submit"><app-icon name="Check" size="18" /> Enviar instruções</button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
