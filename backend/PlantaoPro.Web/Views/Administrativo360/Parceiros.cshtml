@model PlantaoPro.Web.Models.ParceirosIndexViewModel
@{
    ViewData["Title"] = "Parceiros — Administrativo 360";
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    @if (!string.IsNullOrWhiteSpace(Model.Erro))
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><strong>Erro:</strong> @Model.Erro</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Sucesso))
    {
        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@Model.Sucesso</div>
        </div>
    }

    <!-- Header Executivo -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 mb-1 text-dark fw-bold">Cadastro de Parceiros</h1>
            <p class="text-muted mb-0 small">
                Gestão de hospitais solicitantes, convênios pagadores e fornecedores distribuidores com isolamento estrito de cliente.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#comoUsarParceiros" aria-expanded="false">
                <i class="bi bi-info-circle me-1"></i> Como Usar
            </button>
            <button class="btn btn-primary btn-sm px-3" type="button" onclick="abrirModalNovoParceiro()">
                <i class="bi bi-plus-lg me-1"></i> Novo Parceiro
            </button>
        </div>
    </div>

    <!-- Guia Como Usar -->
    <div class="collapse mb-4" id="comoUsarParceiros">
        <div class="card card-body bg-light border-0 shadow-sm rounded-3">
            <h6 class="fw-bold mb-2 text-primary"><i class="bi bi-lightbulb me-1"></i> Diretrizes de Cadastro de Parceiros</h6>
            <ul class="mb-0 small text-secondary">
                <li><strong>Classificação:</strong> Marque "Fornecedor" para distribuidores de OPME e compras. Parceiros sem essa marcação atuam como Hospitais ou Pagadores.</li>
                <li><strong>Isolamento:</strong> Todos os parceiros pertencem estritamente ao seu cliente e nunca vazam para outras instituições.</li>
                <li><strong>Médicos:</strong> Os médicos do corpo clínico são gerenciados na base canônica de profissionais e não devem ser duplicados aqui.</li>
                <li><strong>Inativação:</strong> Parceiros inativos preservam todo o histórico de cotações e compras, mas são bloqueados para novas operações.</li>
            </ul>
        </div>
    </div>

    <!-- Filtros de Consulta -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Parceiros" class="row g-2 align-items-center">
                <div class="col-md-6 col-lg-7">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="busca" value="@Model.Busca" class="form-control" placeholder="Buscar por razão social, nome fantasia ou CNPJ/CPF..." />
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <select name="papel" class="form-select form-select-sm">
                        <option value="">Todos os Papéis</option>
                        <option value="HOSPITAL" selected="@(Model.Papel == "HOSPITAL")">Hospitais / Unidades</option>
                        <option value="PAGADOR" selected="@(Model.Papel == "PAGADOR")">Pagadores / Convênios</option>
                        <option value="FORNECEDOR" selected="@(Model.Papel == "FORNECEDOR")">Fornecedores / Distribuidores</option>
                        <option value="CLIENTE" selected="@(Model.Papel == "CLIENTE")">Clientes Comerciais</option>
                    </select>
                </div>
                <div class="col-md-2 col-lg-2 d-flex gap-1">
                    <button type="submit" class="btn btn-secondary btn-sm flex-fill">Filtrar</button>
                    <a asp-action="Parceiros" class="btn btn-outline-secondary btn-sm">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Parceiros -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                Parceiros Registrados <span class="badge bg-secondary ms-1">@Model.Parceiros.Count</span>
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th style="min-width: 250px;">Nome / Razão Social</th>
                        <th>Documento (CNPJ/CPF)</th>
                        <th>Papéis Operacionais</th>
                        <th>Status</th>
                        <th>Cadastrado Em</th>
                        <th class="text-end pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Parceiros.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Nenhum parceiro encontrado com os filtros aplicados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model.Parceiros)
                        {
                            <tr>
                                <td>
                                    <strong class="text-dark">@p.Nome</strong>
                                </td>
                                <td>
                                    <span class="font-monospace text-secondary">@(string.IsNullOrWhiteSpace(p.Documento) ? "—" : p.Documento)</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (p.EhHospital)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                <i class="bi bi-hospital me-1"></i> Hospital
                                            </span>
                                        }
                                        @if (p.EhPagador)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                <i class="bi bi-credit-card me-1"></i> Pagador
                                            </span>
                                        }
                                        @if (p.Fornecedor)
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle">
                                                <i class="bi bi-truck me-1"></i> Fornecedor
                                            </span>
                                        }
                                        @if (p.EhCliente)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                                                <i class="bi bi-briefcase me-1"></i> Cliente
                                            </span>
                                        }
                                        @if (!p.EhHospital && !p.EhPagador && !p.Fornecedor && !p.EhCliente)
                                        {
                                            <span class="badge bg-light text-muted border">Não Definido</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (p.Ativo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inativo</span>
                                    }
                                </td>
                                <td class="text-muted">
                                    @p.CriadoEm.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-outline-primary btn-sm py-0 px-2 me-1" type="button"
                                            onclick="editarParceiro('@p.Id', '@p.Nome', '@p.Documento', @p.Fornecedor.ToString().ToLower(), @p.Ativo.ToString().ToLower(), @p.EhHospital.ToString().ToLower(), @p.EhPagador.ToString().ToLower(), @p.EhCliente.ToString().ToLower())">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" asp-action="AlternarStatusParceiro" class="d-inline" onsubmit="return desabilitarAoEnviar(this);">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="ativo" value="@((!p.Ativo).ToString().ToLower())" />
                                        <button type="submit" class="btn btn-sm py-0 px-2 @(p.Ativo ? "btn-outline-danger" : "btn-outline-success")"
                                                title="@(p.Ativo ? "Inativar parceiro" : "Ativar parceiro")">
                                            <i class="bi @(p.Ativo ? "bi-slash-circle" : "bi-check2-circle")"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Cadastro / Edição de Parceiro -->
<div class="modal fade" id="modalParceiro" tabindex="-1" aria-labelledby="modalParceiroLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="SalvarParceiro" id="formParceiro" onsubmit="return desabilitarAoEnviar(this);">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="modalParceiroLabel">Novo Parceiro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="Id" id="parceiroId" value="" />

                    <div class="mb-3">
                        <label for="parceiroNome" class="form-label small fw-bold">Razão Social / Nome <span class="text-danger">*</span></label>
                        <input type="text" name="Nome" id="parceiroNome" class="form-control form-control-sm" required maxlength="160" placeholder="Ex.: Distribuidora Cirúrgica Brasil Ltda" />
                    </div>

                    <div class="mb-3">
                        <label for="parceiroDocumento" class="form-label small fw-bold">CNPJ ou CPF</label>
                        <input type="text" name="Documento" id="parceiroDocumento" class="form-control form-control-sm font-monospace" maxlength="20" placeholder="00.000.000/0000-00" />
                        <div class="form-text small">Será validada unicidade dentro do seu cliente.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Papéis Operacionais do Parceiro</label>
                        <div class="d-flex flex-column gap-2 p-2 bg-light rounded border">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="EhHospital" id="parceiroEhHospital" value="true" />
                                <label class="form-check-label small" for="parceiroEhHospital">
                                    <i class="bi bi-hospital me-1 text-info"></i> <strong>Hospital / Unidade Solicitante</strong> (habilita para Cirurgias e Cotações)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="EhPagador" id="parceiroEhPagador" value="true" />
                                <label class="form-check-label small" for="parceiroEhPagador">
                                    <i class="bi bi-credit-card me-1 text-primary"></i> <strong>Pagador / Convênio</strong> (responsável financeiro e faturamento)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Fornecedor" id="parceiroFornecedor" value="true" />
                                <label class="form-check-label small" for="parceiroFornecedor">
                                    <i class="bi bi-truck me-1 text-warning"></i> <strong>Fornecedor / Distribuidor</strong> (habilita para Compras e Recebimentos)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="EhCliente" id="parceiroEhCliente" value="true" />
                                <label class="form-check-label small" for="parceiroEhCliente">
                                    <i class="bi bi-briefcase me-1 text-secondary"></i> <strong>Cliente Comercial</strong> (vendas diretas de produtos)
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="Ativo" id="parceiroAtivo" value="true" checked />
                            <label class="form-check-label small fw-bold" for="parceiroAtivo">Parceiro Ativo</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnSalvarParceiro" class="btn btn-primary btn-sm px-4">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function abrirModalNovoParceiro() {
        document.getElementById('modalParceiroLabel').innerText = 'Novo Parceiro';
        document.getElementById('parceiroId').value = '';
        document.getElementById('parceiroNome').value = '';
        document.getElementById('parceiroDocumento').value = '';
        document.getElementById('parceiroEhHospital').checked = true;
        document.getElementById('parceiroEhPagador').checked = false;
        document.getElementById('parceiroFornecedor').checked = false;
        document.getElementById('parceiroEhCliente').checked = false;
        document.getElementById('parceiroAtivo').checked = true;
        new bootstrap.Modal(document.getElementById('modalParceiro')).show();
    }

    function editarParceiro(id, nome, documento, fornecedor, ativo, ehHospital, ehPagador, ehCliente) {
        document.getElementById('modalParceiroLabel').innerText = 'Editar Parceiro';
        document.getElementById('parceiroId').value = id;
        document.getElementById('parceiroNome').value = nome;
        document.getElementById('parceiroDocumento').value = documento || '';
        document.getElementById('parceiroFornecedor').checked = fornecedor === true;
        document.getElementById('parceiroEhHospital').checked = ehHospital === true;
        document.getElementById('parceiroEhPagador').checked = ehPagador === true;
        document.getElementById('parceiroEhCliente').checked = ehCliente === true;
        document.getElementById('parceiroAtivo').checked = ativo === true;
        new bootstrap.Modal(document.getElementById('modalParceiro')).show();
    }

    function desabilitarAoEnviar(form) {
        var btn = form.querySelector('button[type="submit"]');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Processando...';
        }
        return true;
    }
</script>
}
