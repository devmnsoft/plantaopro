@model PlantaoPro.Web.Models.ListPageViewModel<PlantaoPro.Web.Models.PagamentoResumoDto>

@{ 
    ViewData["Title"] = "Financeiro";
    var items = Model?.Items ?? Array.Empty<PlantaoPro.Web.Models.PagamentoResumoDto>();
    var totalPrevisto = items.Sum(x => x.ValorPrevisto);
    var totalPago = items.Where(x => x.ValorPago.HasValue).Sum(x => x.ValorPago ?? 0);
    var possuiValorPago = items.Any(x => x.ValorPago.HasValue);
    var pendentes = items.Count(x => string.Equals(x.Status, "Pendente", StringComparison.OrdinalIgnoreCase));
    var cancelados = items.Count(x => string.Equals(x.Status, "Cancelado", StringComparison.OrdinalIgnoreCase));
    var porStatus = items.GroupBy(x => x.Status).Select(g => new { Status = g.Key, Total = g.Sum(v => v.ValorPrevisto) }).ToList();
    var maiorValor = porStatus.Any() ? porStatus.Max(x => x.Total) : 0;
    var filtroInicio = Context.Request.Query["dataInicio"].ToString();
    var filtroFim = Context.Request.Query["dataFim"].ToString();
}

<div class="pp-page pp-financial-workspace">
<partial name="_PageIntroduction" model='new PlantaoPro.Web.Models.PageIntroductionViewModel(
    "Financeiro",
    "Acompanhe pagamentos, repasses, divergências, vencimentos e fechamentos operacionais.",
    "Identifique pendências financeiras e aja com rastreabilidade.",
    Steps: new[] { "Confira valores previstos e realizados.", "Analise divergências e pendências.", "Registre a resolução antes do fechamento." },
    Eyebrow: "Controle financeiro")' />

<nav class="pp-financial-journey" aria-label="Jornada financeira" data-financial-mvp-journey>
    <span>Faturamento</span><span class="is-current">Financeiro</span><span>Glosa / contestação</span><span>Pagamento</span><span>Repasse</span><span>Relatório</span>
</nav>

<form method="get" class="pp-payment-card mb-3" aria-label="Filtros de pagamentos">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-3"><label class="form-label" for="filter-start">Período inicial</label><input class="form-control" id="filter-start" name="dataInicio" type="date" value="@filtroInicio" /></div>
        <div class="col-12 col-md-3"><label class="form-label" for="filter-end">Período final</label><input class="form-control" id="filter-end" name="dataFim" type="date" value="@filtroFim" /></div>
        <div class="col-12 col-md-2"><label class="form-label" for="filter-status">Status</label><select class="form-select" id="filter-status" name="status"><option value="">Todos</option><option value="pendente">Pendente</option><option value="pago">Pago</option><option value="contestado">Contestado</option><option value="cancelado">Cancelado</option></select></div>
        <div class="col-12 col-md-2"><label class="form-label" for="filter-method">Forma de pagamento</label><select class="form-select" id="filter-method" name="formaPagamento"><option value="">Todas</option><option value="PIX">Pix</option><option value="TED">TED</option><option value="DOC">DOC</option><option value="BOLETO">Boleto</option><option value="OUTRO">Outro</option></select></div>
        <div class="col-12 col-md-2 d-grid"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrar</button></div>
    </div>
</form>

<section class="pp-kpi-strip" aria-label="Resumo financeiro da página atual">
    <article class="pp-kpi-card"><span>Total previsto</span><strong>@totalPrevisto.ToString("C")</strong><small>Composição dos registros exibidos</small></article>
    <article class="pp-kpi-card"><span>Total pago</span><strong class="text-success">@(possuiValorPago ? totalPago.ToString("C") : "Não informado")</strong><small>Somente valores realizados retornados pela API</small></article>
    <article class="pp-kpi-card pp-kpi-card--warning"><span>Pendentes</span><strong>@pendentes</strong><small>Aguardando avanço operacional</small></article>
    <article class="pp-kpi-card"><span>Cancelados</span><strong>@cancelados</strong><small>Registros sem continuidade</small></article>
</section>

<section class="pp-section" aria-labelledby="financial-status-title">
    <div class="pp-section-heading"><div><span class="pp-section-kicker">Competência atual</span><h2 id="financial-status-title">Consolidação por status</h2><p>Distribuição calculada somente com os registros retornados nesta página.</p></div></div>
    <div class="card-body">
        @if (!porStatus.Any())
        {
            <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-bar-chart","Sem dados para consolidar","Ajuste os filtros para analisar a consolidação financeira.")' />
        }
        else
        {
            @foreach (var item in porStatus)
            {
                var percentual = maiorValor <= 0 ? 0 : Math.Round((item.Total / maiorValor) * 100, 0);
                <div class="mb-2">
                    <div class="d-flex justify-content-between small"><span>@item.Status</span><strong>@item.Total.ToString("C")</strong></div>
                    <div class="progress"><div class="progress-bar" style="width:@percentual%"></div></div>
                </div>
            }
        }
    </div>
</section>

@if (!items.Any())
{
    <div class="pp-empty-state" data-financial-status-honest data-glosa-rules data-repasse-rules>
        <i class="bi bi-calendar2-x"></i>
        <h5>Sem pagamentos</h5>
        <p>A API não retornou lançamentos para os filtros atuais. Isso não significa saldo zero, pagamento pendente, glosa ou repasse.</p><p><strong>Glosas e repasses:</strong> serão exibidos somente quando a fonte financeira fornecer registros vinculados.</p>
    </div>
}
else
{
    <div class="pp-data-table d-none d-md-block"><div class="table-responsive">
        <table class="table table-modern align-middle mb-0" data-financial-status-honest data-financial-next-action>
            <caption class="visually-hidden">Pagamentos e situação financeira</caption><thead>
                <tr>
                    <th>Médico</th>
                    <th>Hospital</th>
                    <th>Especialidade</th>
                    <th>Data do Plantão</th>
                    <th>Valor Previsto</th>
                    <th>Valor Pago</th>
                    <th>Status</th>
                    <th class="text-end">Próxima ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in items)
                {
                    <tr>
                        <td>@p.MedicoNome</td>
                        <td>@p.HospitalNome</td>
                        <td>@p.EspecialidadeNome</td>
                        <td>@p.DataPlantao.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@p.ValorPrevisto.ToString("C")</td>
                        <td>@(p.ValorPago.HasValue ? p.ValorPago.Value.ToString("C") : "Não informado")</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(p.Status)) { <span class="text-muted">Não informado pela API</span> } else { <span class="badge status-@p.Status.ToLowerInvariant()">@p.Status</span> }
                        </td>
                        <td class="text-end">
                            <div class="action-buttons">
                                <a class="btn btn-sm btn-soft-primary" asp-action="Details" asp-route-id="@p.Id">Detalhes</a>
                                <span class="pp-locked-action"><button class="btn btn-sm btn-soft-success" type="button" disabled title="Use o detalhe; a confirmação exige status pendente, valor e endpoint transacional.">Confirmar</button></span>
                                <span class="pp-locked-action"><button class="btn btn-sm btn-soft-danger" type="button" disabled title="Use o detalhe; o cancelamento exige um lançamento real e justificativa.">Cancelar</button></span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
    <div class="pp-mobile-card-list d-md-none" aria-label="Pagamentos em formato compacto">
        @foreach (var p in items)
        {
            <article class="pp-operational-card">
                <header><div><span class="pp-section-kicker">@p.DataPlantao.ToString("dd/MM/yyyy HH:mm")</span><h3>@p.MedicoNome</h3><p>@p.HospitalNome · @p.EspecialidadeNome</p></div><partial name="_StatusBadge" model="p.Status" /></header>
                <dl><div><dt>Previsto</dt><dd>@p.ValorPrevisto.ToString("C")</dd></div><div><dt>Pago</dt><dd>@(p.ValorPago?.ToString("C") ?? "Não informado")</dd></div></dl>
                <footer><a class="btn btn-outline-primary w-100" asp-action="Details" asp-route-id="@p.Id">Ver composição e histórico</a></footer>
            </article>
        }
    </div>
}

<div class="card-footer bg-white">
    <partial name="_Pagination" model="Model" />
</div>
</div>
