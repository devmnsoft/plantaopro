@model PlantaoPro.Web.Models.FaturamentoClinicoViewModel
@{
    ViewData["Title"] = "Faturamento Clínico";
}

<div class="pp-page pp-clinical-page">
    <partial name="_PageIntroduction" model='new PlantaoPro.Web.Models.PageIntroductionViewModel(
        "Faturamento Clínico",
        "Confira contas geradas a partir das jornadas assistenciais antes do fluxo financeiro.",
        "Os dados abaixo são retornados pela API do tenant; campos não fornecidos pela origem não são estimados.",
        Steps: new[] { "Confira a referência e a competência.", "Investigue pendências na jornada de origem.", "Prossiga no Financeiro somente com dados consistentes." },
        Eyebrow: "Receita assistencial")' />

    <nav class="pp-action-grid" aria-label="Jornadas relacionadas">
        <a class="pp-action-card" asp-controller="Consultas" asp-action="Index"><span>Consultas</span><small>Abrir a origem assistencial</small></a>
        <a class="pp-action-card" asp-controller="Financeiro" asp-action="Index"><span>Financeiro</span><small>Conferir valores e situações</small></a>
        <a class="pp-action-card" asp-controller="Pagamentos" asp-action="Index"><span>Pagamentos</span><small>Acompanhar realizações financeiras</small></a>
    </nav>

    <section class="pp-filter-panel" aria-labelledby="billing-filter-title">
        <div class="pp-section-heading"><div><span class="pp-section-kicker">Dados retornados</span><h2 id="billing-filter-title">Filtrar contas</h2></div></div>
        <form method="get" class="pp-form pp-filter-form">
            <div><label class="form-label" for="status">Status</label><input class="form-control" id="status" name="status" value="@Model.Status" /></div>
            <div><label class="form-label" for="competencia">Competência</label><input class="form-control" id="competencia" name="competencia" placeholder="MM/AAAA" value="@Model.CompetenciaFiltro" inputmode="numeric" /></div>
            <div><label class="form-label" for="convenio">Convênio</label><input class="form-control" id="convenio" name="convenio" value="@Model.Convenio" /></div>
            <button class="btn btn-primary" type="submit">Aplicar filtros</button>
            @if (Model.HasActiveFilters) { <a class="btn btn-outline-secondary" asp-action="Index">Limpar filtros</a> }
        </form>
        <p class="form-text">Os filtros usam somente status, competência e convênio fornecidos pela API.</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <section class="pp-empty-state" role="status" aria-labelledby="billing-error-title">
            <h2 id="billing-error-title">Não foi possível carregar o faturamento</h2>
            <p>@Model.Error</p>
            <a class="btn btn-outline-primary" asp-action="Index">Tentar novamente</a>
        </section>
    }
    else if (Model.Items.Count == 0)
    {
        <section class="pp-empty-state" role="status" aria-labelledby="billing-empty-title">
            <h2 id="billing-empty-title">@(Model.HasActiveFilters ? "Nenhuma conta corresponde aos filtros" : "Nenhuma conta clínica encontrada")</h2>
            <p>@(Model.HasActiveFilters ? "Ajuste ou limpe os filtros para consultar novamente os dados retornados pela API." : "A API não retornou contas para este tenant. Nenhum valor ou histórico demonstrativo foi criado.")</p>
            <a class="btn btn-outline-primary" asp-controller="Consultas" asp-action="Index">Revisar consultas</a>
        </section>
    }
    else
    {
        <section class="pp-section" aria-labelledby="billing-list-title">
            <div class="pp-section-heading">
                <div><span class="pp-section-kicker">Dados reais</span><h2 id="billing-list-title">Contas retornadas</h2><p>@Model.Items.Count registro(s) disponível(is) para conferência.</p></div>
            </div>
            <div class="pp-data-table d-none d-md-block"><div class="table-responsive">
                <table class="table table-modern align-middle mb-0">
                    <caption class="visually-hidden">Contas do faturamento clínico</caption>
                    <thead><tr><th>Competência</th><th>Consulta / origem</th><th>Paciente</th><th>Profissional</th><th>Convênio / procedimento</th><th>Valor previsto</th><th>Aprovado / pago</th><th>Status</th><th class="text-end">Ações</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var referencia = item.OrigemId;
                        <tr>
                            <td>@item.Competencia</td>
                            <td>@(referencia?.ToString() ?? "Não informada pela API")</td>
                            <td><span class="text-muted">Não informado pela fonte</span></td>
                            <td><span class="text-muted">Não informado pela fonte</span></td>
                            <td><span class="text-muted">Não informado pela fonte</span></td>
                            <td>@(item.Valor.HasValue ? item.Valor.Value.ToString("C") : "Não informado pela API")</td>
                            <td><span class="text-muted">Não informado pela fonte</span></td>
                            <td>@if (string.IsNullOrWhiteSpace(item.Status)) { <span class="text-muted">Não informado pela API</span> } else { <partial name="_StatusBadge" model="item.Status" /> }</td>
                            <td class="text-end"><div class="d-flex flex-wrap justify-content-end gap-2">
                                @if (item.AtendimentoId.HasValue)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Consultas" asp-action="Details" asp-route-id="@item.AtendimentoId">Abrir origem</a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button" disabled title="A API não informou o identificador da consulta.">Abrir origem</button>
                                }
                                <a class="btn btn-sm btn-outline-primary" asp-controller="ClinicaFinanceiro" asp-action="ContasReceber">Abrir financeiro clínico</a>
                                <button class="btn btn-sm btn-outline-primary" type="button" disabled title="A API atual não oferece aprovação, glosa ou exportação desta conta.">Outras ações</button>
                            </div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></div>
            <div class="pp-mobile-card-list d-md-none" aria-label="Contas em formato compacto">
            @foreach (var item in Model.Items)
            {
                var referencia = item.OrigemId;
                <article class="pp-mobile-card pp-data-card">
                    <header><div><span class="pp-section-kicker">@item.Competencia</span><h3>@(item.Valor.HasValue ? item.Valor.Value.ToString("C") : "Valor não informado")</h3></div>@if (!string.IsNullOrWhiteSpace(item.Status)) { <partial name="_StatusBadge" model="item.Status" /> }</header>
                    <p>Origem: @(referencia?.ToString() ?? "não informada pela API")</p>
                    <p class="text-muted">Paciente, profissional, convênio, procedimento, aprovação, pagamento, glosas, repasses e histórico não são fornecidos por esta API.</p>
                    <a class="btn btn-outline-primary w-100" asp-controller="ClinicaFinanceiro" asp-action="ContasReceber">Abrir financeiro clínico</a>
                </article>
            }
            </div>
        </section>
    }
</div>
