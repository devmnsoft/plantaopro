@model PlantaoPro.Web.Models.ConsultaWorkspaceViewModel
@{ ViewData["Title"] = "Atendimento médico"; }
<link rel="stylesheet" href="~/css/design-system/clinical-workspace.css" asp-append-version="true" />
<main class="clinical-workspace clinical-mvp-journey" data-clinical-workspace data-clinical-mvp-journey data-patient-context data-next-action data-consulta-id="@Model.ConsultaId" data-api-base="@Model.ApiBase">
  <header class="patient-context" aria-live="polite"><div><small>Atendimento médico</small><h1 data-patient-name>Carregando paciente…</h1><p><span data-patient-age></span> <span data-patient-gender></span> · <strong data-risk></strong></p></div><div><span class="clinical-status" data-status></span><span data-wait></span></div></header>
  <ol class="journey-stepper" aria-label="Jornada assistencial"><li>Agendado</li><li>Check-in</li><li>Triagem</li><li>Aguardando médico</li><li class="active">Em atendimento</li><li>Prescrição</li><li>Finalizado</li><li>Financeiro</li></ol>
  <div class="clinical-layout">
    <nav aria-label="Seções do prontuário"><a href="#visao">Visão geral</a><a href="#anamnese">Anamnese</a><a href="#exame">Exame físico</a><a href="#diagnostico">Diagnóstico</a><a href="#cid">CID</a><a href="#conduta">Conduta</a><a href="#orientacoes">Orientações</a></nav>
    <form id="clinical-form" novalidate>
      <input type="hidden" name="versao" value="1" />
      <section id="visao" class="clinical-card"><h2>Contexto clínico</h2><dl><dt>Alergias</dt><dd data-allergies>Não informadas</dd><dt>Plano</dt><dd data-plan>Não informado</dd><dt>Unidade</dt><dd data-unit>—</dd></dl></section>
      <section id="anamnese" class="clinical-card"><label for="anamnese">Anamnese</label><textarea id="anamnese" name="anamnese" rows="7" maxlength="12000"></textarea></section>
      <section id="exame" class="clinical-card"><label for="exameFisico">Exame físico</label><textarea id="exameFisico" name="exameFisico" rows="7" maxlength="12000"></textarea></section>
      <section id="diagnostico" class="clinical-card"><label for="hipoteseDiagnostica">Hipótese diagnóstica</label><textarea id="hipoteseDiagnostica" name="hipoteseDiagnostica"></textarea><label for="diagnosticoTexto">Diagnóstico</label><textarea id="diagnosticoTexto" name="diagnostico"></textarea></section>
      <section id="cid" class="clinical-card"><h2>CIDs vinculados</h2><div data-cids></div><button type="button" class="btn btn-outline-primary" data-add-cid>Adicionar CID</button></section>
      <section id="conduta" class="clinical-card"><label for="condutaTexto">Conduta</label><textarea id="condutaTexto" name="conduta"></textarea></section>
      <section id="orientacoes" class="clinical-card"><label for="orientacoesTexto">Orientações ao paciente</label><textarea id="orientacoesTexto" name="orientacoes"></textarea></section>
    </form>
  </div>
  <div class="save-indicator" data-save-status role="status">Dados carregados</div>
  <footer class="clinical-actions" data-consultation-billing-honest><a asp-action="Index" class="btn btn-outline-secondary">Voltar para fila</a><button type="button" class="btn btn-primary" data-save>Salvar rascunho</button><a asp-controller="Prescricoes" asp-action="Editor" asp-route-consultaId="@Model.ConsultaId" class="btn btn-outline-primary">Abrir prescrição</a><button type="button" class="btn btn-success" data-finalize>Finalizar consulta</button><a asp-controller="FaturamentoClinico" asp-action="Index" asp-route-atendimentoId="@Model.ConsultaId" class="btn btn-outline-primary">Abrir faturamento clínico</a><button type="button" class="btn btn-outline-secondary" disabled title="O pagamento depende de uma conta financeira real gerada após o faturamento.">Abrir pagamento</button></footer>
  <dialog data-conflict-modal><h2>Alteração em outra sessão</h2><p>Seus campos foram preservados. Recarregue os dados antes de salvar novamente.</p><button type="button" data-reload>Recarregar</button></dialog>
  <dialog data-finalize-modal><h2>Revisar finalização</h2><div data-pendencies></div><button type="button" data-close-finalization>Voltar</button><button type="button" data-confirm-finalization>Confirmar finalização</button></dialog>
</main>
<script src="~/js/clinical-workspace.js" asp-append-version="true" defer></script>
