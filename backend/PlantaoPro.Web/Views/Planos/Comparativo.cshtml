@model IEnumerable<PlantaoPro.Web.Models.PlanoSaasViewModel>
@{ ViewData["Title"] = "Comparativo de planos"; var planos = Model ?? Array.Empty<PlantaoPro.Web.Models.PlanoSaasViewModel>(); }
<div class="container-fluid py-3"><h1 class="h3">Comparativo de planos</h1><div class="table-responsive card"><table class="table mb-0"><thead><tr><th scope="col">Plano</th><th scope="col">Valor</th><th scope="col">Médicos</th><th scope="col">Hospitais</th><th scope="col">Plantões</th><th scope="col">Mobile</th><th scope="col">BI</th><th scope="col">Integrações</th></tr></thead><tbody>@foreach (var p in planos){<tr><td>@p.Nome</td><td>@p.ValorMensal.ToString("C")</td><td>@p.LimiteMedicos</td><td>@p.LimiteHospitais</td><td>@p.LimitePlantoesMes</td><td>@(p.PermiteMobile ? "Sim" : "Não")</td><td>@(p.PermiteBi ? "Sim" : "Não")</td><td>@(p.PermiteIntegracoes ? "Sim" : "Não")</td></tr>}</tbody></table></div></div>
