@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = UiText.L("Auth.LoginTitle");
    var loginReason = Context.Request.Query["reason"].ToString().ToLowerInvariant();
    // R7-E1: mensagens de contexto em recursos localizados (mesmas chaves em pt-BR/en/es/fr).
    var sessionMessage = loginReason switch
    {
        "expired" or "session-expired" => UiText.L("Login.ReasonExpired"),
        "tenant-required" => UiText.L("Login.ReasonTenantRequired"),
        "user-blocked" => UiText.L("Login.ReasonUserBlocked"),
        "tenant-blocked" => UiText.L("Login.ReasonTenantBlocked"),
        "feature-blocked" => UiText.L("Login.ReasonFeatureBlocked"),
        "access-denied" => UiText.L("Login.ReasonAccessDenied"),
        _ => null
    };
}
<div class="pp-auth-page pp-auth auth-experience">
    <div class="pp-auth-shell pp-auth__shell login-card-modern">
        <section class="pp-auth-brand-panel pp-auth-brand auth-story" aria-labelledby="authStoryTitle">
            <div class="auth-logo-surface">
                <img class="pp-auth-logo auth-logo" src="~/media/brand/logo-horizontal-color.svg" width="360" height="86" alt="PlantãoPro" />
            </div>
            <span class="pp-auth-kicker auth-product-tag">PlantãoPro por MNSOFT</span>
            <h1 id="authStoryTitle">@UiText.L("Login.StoryTitle")</h1>
            <p>@UiText.L("Login.StorySubtitle")</p>
            <div class="pp-auth-trust-row" aria-label="Compromissos da plataforma"><span><app-icon name="Lock" size="17" /> @UiText.L("Login.TrustAcessoProtegido")</span><span>@UiText.L("Login.TrustContextoIsolado")</span><span>@UiText.L("Login.TrustAuditoriaAtiva")</span></div>
        </section>
        <section class="pp-auth-form-panel pp-auth-panel auth-form-panel" aria-labelledby="loginTitle">
          <div class="pp-auth-card">
            <span class="pp-page-intro__eyebrow">@UiText.L("Login.Eyebrow")</span>
            <h2 id="loginTitle">@UiText.L("Login.Title")</h2>
            <p>@UiText.L("Login.Subtitle")</p>
            @if (!string.IsNullOrWhiteSpace(sessionMessage))
            {
                <div class="pp-auth-context-message" role="status" aria-live="polite" tabindex="-1"><app-icon name="Warning" size="20" /><div><strong>@UiText.L("Login.SessionAttention")</strong><span>@sessionMessage</span></div></div>
            }
            <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" class="pp-form pp-login-form" novalidate data-login-form data-focus-invalid data-submit-loading="manual">
                @Html.AntiForgeryToken()
                @if (!string.IsNullOrWhiteSpace(ViewData["ReturnUrl"] as string))
                {
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                }
                <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1" data-login-errors></div>
                @if (ViewData.ModelState.ErrorCount == 0 && TempData["Error"] is string loginError && !string.IsNullOrWhiteSpace(loginError))
                {
                    <div class="pp-error-panel" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1" data-login-errors>@loginError</div>
                }
                <div class="pp-login-delay d-none" role="status" aria-live="polite" data-login-delay>
                    <app-icon name="Warning" size="20" />
                    <span><strong>@UiText.L("Login.DelayTitle")</strong> @UiText.L("Login.DelayDetail")</span>
                </div>
                <div class="pp-login-connection" role="status" aria-live="polite" data-connection-status hidden>
                    <span class="pp-login-connection__dot" aria-hidden="true"></span>
                    <span>@UiText.L("Login.ConnectionLost")</span>
                </div>
                <div class="pp-login-progress" role="status" aria-live="polite" aria-atomic="true" data-login-progress hidden>
                    <span class="pp-login-progress__icon" aria-hidden="true"><app-icon name="Lock" size="18" /></span>
                    <span><strong data-login-progress-title>@UiText.L("Login.ProgressTitle")</strong><small data-login-progress-detail>@UiText.L("Login.ProgressDetail")</small></span>
                </div>
                <div class="pp-form-field">
                    <label asp-for="Email" class="pp-form-label form-required">@UiText.L("Login.EmailLabel")</label>
                    <input asp-for="Email" class="pp-form-control" autocomplete="username" inputmode="text" maxlength="254" aria-describedby="emailHelp Email-error" required data-login-identifier />
                    <small id="emailHelp" class="form-help">@UiText.L("Login.EmailHelp")</small>
                    <span asp-validation-for="Email" class="pp-form-error" data-valmsg-for="Email" id="Email-error"></span>
                </div>
                <div class="pp-form-field">
                    <label asp-for="Senha" class="pp-form-label form-required">@UiText.L("Login.PasswordLabel")</label>
                    <div class="pp-password-field">
                        <input asp-for="Senha" class="pp-form-control" type="password" id="senha" autocomplete="current-password" aria-describedby="passwordHelp capsLockWarning Senha-error" required />
                        <button class="btn auth-password-toggle" type="button" data-password-toggle aria-label="@UiText.L("Login.ShowPasswordAria")" aria-pressed="false"><app-icon name="View" size="20" /></button>
                    </div>
                    <small id="passwordHelp" class="form-help">@UiText.L("Login.PasswordHelp")</small>
                    <div id="capsLockWarning" class="form-help d-none" role="status"><app-icon name="Warning" size="18" /> @UiText.L("Login.CapsLock")</div>
                    <span asp-validation-for="Senha" class="pp-form-error" data-valmsg-for="Senha" id="Senha-error"></span>
                </div>
                <div class="pp-login-actions">
                    <button id="btnLogin" class="btn btn-primary btn-lg" type="submit" aria-busy="false" data-idle-label="@UiText.L("Login.Button")">
                        <span class="label">@UiText.L("Login.Button")</span><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                    </button>
                    <a asp-action="ForgotPassword" class="auth-recovery-link">@UiText.L("Login.ForgotPassword")</a>
                </div>
            </form>
            <details class="pp-login-help">
                <summary>@UiText.L("Login.HelpSummary")</summary>
                <!-- Html.Raw deliberado: esta é a única chave com marcação (<strong> no verbo da ação). -->
                <p>@Html.Raw(UiText.L("Login.HelpBody"))</p>
            </details>
            <div class="auth-security"><app-icon name="Lock" size="18" /><span>@UiText.L("Login.SecurityNote")</span></div>
            <footer class="pp-login-footer"><partial name="_ProductVersion" /><a asp-controller="Lgpd" asp-action="Politica">@UiText.L("Login.PrivacyLink")</a></footer>
          </div>
        </section>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth-login.js" asp-append-version="true"></script>
}
