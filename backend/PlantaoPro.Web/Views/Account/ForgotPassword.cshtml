@model ForgotPasswordViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = UiText.L("Auth.ForgotTitle"); }
@* R7-D-F2: tela de recuperacao de acesso em recursos localizados (UiTexts.resx x4). *@
<div class="auth-experience auth-experience--compact">
    <section class="auth-form-panel auth-recovery-card" aria-labelledby="recoveryTitle">
        <a asp-action="Login" class="auth-back-link">@UiText.L("Auth.ForgotBack")</a>
        <span class="pp-page-intro__eyebrow">@UiText.L("Auth.ForgotEyebrow")</span>
        <h1 id="recoveryTitle">@UiText.L("Auth.ForgotHeading")</h1>
        <p>@UiText.L("Auth.ForgotIntro")</p>
        <div class="pp-info-banner" role="note"><span class="pp-alert__icon" aria-hidden="true">i</span><div class="pp-alert__content"><strong>@UiText.L("Auth.ForgotProtectionTitle")</strong><p>@UiText.L("Auth.ForgotProtectionBody")</p></div></div>
        <form asp-action="ForgotPassword" method="post" class="pp-form" novalidate data-focus-invalid>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" tabindex="-1"></div>
            <div class="pp-form-field"><label asp-for="Email" class="pp-form-label">@UiText.L("Auth.ForgotEmailLabel") <span class="pp-required-marker" aria-hidden="true">*</span></label><input asp-for="Email" class="form-control form-control-lg" type="email" autocomplete="email" inputmode="email" aria-describedby="recoveryEmailHelp" required /><small id="recoveryEmailHelp" class="pp-field-help">@UiText.L("Auth.ForgotEmailHelp")</small><span asp-validation-for="Email" class="pp-form-error" data-valmsg-for="Email"></span></div>
            <button class="btn btn-primary btn-lg" type="submit"><app-icon name="Check" size="18" /> @UiText.L("Auth.ForgotSubmit")</button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
