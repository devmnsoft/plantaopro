@model PlantaoPro.Web.Models.OrcamentoFormViewModel
@{
    ViewData["Title"] = $"Editar Orçamento {ViewBag.Numero} — Administrativo 360";
    var situacao = (string)ViewBag.Situacao;
    var isRascunho = situacao == "RASCUNHO";
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">Editar Orçamento Cirúrgico <span class="text-info">@ViewBag.Numero</span></h2>
            <p class="text-muted small mb-0">
                Situação Atual: <span class="badge @(isRascunho ? "bg-warning text-dark" : "bg-success")">@situacao</span>
                (Revisão @ViewBag.Revisao)
            </p>
        </div>
        <a asp-action="OrcamentoDetalhes" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Voltar aos Detalhes
        </a>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-2"><i class="bi bi-info-circle me-2"></i>Como editar um orçamento</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">1. Para que serve</strong>
                    Ajustar dados ou materiais de um orçamento já criado sem precisar recomeçar tudo do zero.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">2. Como utilizar</strong>
                    Altere o que for necessário e salve. Os produtos continuam sendo escolhidos pelo nome, com o preço preenchido sozinho.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">3. O que acontece ao salvar</strong>
                    Se o orçamento já estava aprovado, o salvamento cria uma nova versão numerada e devolve o orçamento para Rascunho, para aprovação novamente.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">4. Próxima ação</strong>
                    Depois de editar, volte aos detalhes e aprove a nova versão do orçamento.
                </div>
            </div>
        </div>
    </div>

    @if (!isRascunho)
    {
        <div class="alert alert-warning d-flex align-items-center mb-3">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                <strong>Atenção:</strong> Este orçamento já foi aprovado. Qualquer alteração gerará uma <strong>nova revisão histórica</strong> (R@(ViewBag.Revisao + 1)) e retornará o orçamento para conferência em Rascunho.
            </div>
        </div>
    }

    <form asp-action="OrcamentoEditar" asp-route-id="@Model.Id" method="post" id="formOrcamento">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card bg-dark border-secondary mb-3">
                    <div class="card-header border-secondary text-info fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Parâmetros do Orçamento
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @if (!isRascunho)
                            {
                                <div class="col-12">
                                    <label class="form-label text-warning small fw-bold">Motivo da Revisão Comercial *</label>
                                    <input type="text" name="MotivoRevisao" value="@Model.MotivoRevisao" class="form-control form-control-sm bg-black text-light border-warning" placeholder="Informe o motivo da alteração dos materiais ou preços aprovados" required>
                                </div>
                            }
                            <div class="col-md-6">
                                <label class="form-label text-light small fw-bold">Hospital *</label>
                                <select name="HospitalId" class="form-select form-select-sm bg-black text-light border-secondary" required aria-label="Hospital">
                                    <option value="">-- Selecione o Hospital --</option>
                                    @foreach (var h in Model.Hospitais)
                                    {
                                        <option value="@h.Id" selected="@(h.Id == Model.HospitalId ? "selected" : null)">@h.Nome (@(h.Documento ?? "Sem doc"))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-light small fw-bold">Responsável Financeiro *</label>
                                <select name="ResponsavelFinanceiroId" class="form-select form-select-sm bg-black text-light border-secondary" required aria-label="Responsável financeiro">
                                    <option value="">-- Selecione o Pagador / Convênio --</option>
                                    @foreach (var p in Model.Pagadores)
                                    {
                                        <option value="@p.Id" selected="@(p.Id == Model.ResponsavelFinanceiroId ? "selected" : null)">@p.Nome (@(p.Documento ?? "Sem doc"))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label text-light small fw-bold">Procedimento Cirúrgico *</label>
                                <input type="text" name="Procedimento" value="@Model.Procedimento" class="form-control form-control-sm bg-black text-light border-secondary" required maxlength="180" aria-label="Procedimento">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-light small">Médico Cirurgião</label>
                                <select name="MedicoId" class="form-select form-select-sm bg-black text-light border-secondary" aria-label="Medicoid">
                                    <option value="">-- Selecione o Médico (Opcional) --</option>
                                    @foreach (var m in Model.Medicos)
                                    {
                                        <option value="@m.Id" selected="@(m.Id == Model.MedicoId ? "selected" : null)">@m.Nome</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-light small fw-bold">Data Prevista da Cirurgia *</label>
                                <input type="date" name="DataPrevista" value="@Model.DataPrevista.ToString("yyyy-MM-dd")" class="form-control form-control-sm bg-black text-light border-secondary" required aria-label="Data prevista">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-light small fw-bold">Validade da Proposta *</label>
                                <input type="date" name="Validade" value="@Model.Validade.ToString("yyyy-MM-dd")" class="form-control form-control-sm bg-black text-light border-secondary" required aria-label="Validade">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-light small">Vendedor</label>
                                <input type="text" name="VendedorId" value="@Model.VendedorId" class="form-control form-control-sm bg-black text-light border-secondary" maxlength="36" aria-label="Vendedor">
                            </div>
                            <div class="col-12">
                                <label class="form-label text-light small">Observações</label>
                                <textarea name="Observacoes" class="form-control form-control-sm bg-black text-light border-secondary" rows="2" aria-label="Observações">@Model.Observacoes</textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabela de Itens -->
                <div class="card bg-dark border-secondary">
                    <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                        <span class="text-info fw-bold"><i class="bi bi-box me-2"></i>Itens do Orçamento</span>
                        <button type="button" class="btn btn-xs btn-outline-info" id="btnAddItem"><i class="bi bi-plus"></i> Adicionar Item</button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark mb-0 align-middle small" id="tabelaItens">
                                <thead class="table-black text-secondary">
                                    <tr>
                                        <th style="width: 45%;" scope="col">Produto</th>
                                        <th style="width: 15%;" scope="col">Quantidade</th>
                                        <th style="width: 20%;" scope="col">Preço Unitário (R$)</th>
                                        <th style="width: 15%;" scope="col">Desconto (R$)</th>
                                        <th style="width: 5%;" scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Itens.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <select name="Itens[@i].ProdutoId" class="form-select form-select-sm bg-black text-light border-secondary select-produto" required aria-label="Produto">
                                                    <option value="">-- Selecione o Produto --</option>
                                                    @foreach (var prod in Model.ProdutosDisponiveis)
                                                    {
                                                        <option value="@prod.Id" selected="@(prod.Id == Model.Itens[i].ProdutoId ? "selected" : null)" data-preco="@prod.PrecoCusto?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? """>@prod.Sku - @prod.Nome (@prod.Unidade)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input type="number" step="0.0001" min="0.0001" name="Itens[@i].Quantidade" value="@Model.Itens[i].Quantidade" class="form-control form-control-sm bg-black text-light border-secondary" required aria-label="Quantidade">
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" min="0" name="Itens[@i].PrecoUnitario" value="@Model.Itens[i].PrecoUnitario" class="form-control form-control-sm bg-black text-light border-secondary input-preco" required aria-label="Precounitario">
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" min="0" name="Itens[@i].Desconto" value="@Model.Itens[i].Desconto" class="form-control form-control-sm bg-black text-light border-secondary" aria-label="Desconto">
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger btnRemoveItem" aria-label="Remover item"><i class="bi bi-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card bg-dark border-secondary text-light">
                    <div class="card-body">
                        <button type="submit" class="btn @(isRascunho ? "btn-success" : "btn-warning") w-100 py-2 fw-bold mb-2">
                            <i class="bi bi-save me-1"></i> @(isRascunho ? "Salvar Alterações" : "Gravar Nova Revisão")
                        </button>
                        <a asp-action="OrcamentoDetalhes" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100">Cancelar</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<template id="produtoOptionsTemplate">
    <option value="">-- Selecione o Produto --</option>
    @foreach (var prod in Model.ProdutosDisponiveis)
    {
        <option value="@prod.Id" data-preco="@prod.PrecoCusto?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? """>@prod.Sku - @prod.Nome (@prod.Unidade)</option>
    }
</template>

<script>
    function bindProdutoChange(select) {
        select.addEventListener('change', function() {
            var selected = select.options[select.selectedIndex];
            var preco = selected.getAttribute('data-preco');
            if (preco) {
                var row = select.closest('tr');
                var precoInput = row.querySelector('.input-preco');
                if (precoInput && (!precoInput.value || precoInput.value === '0.00' || precoInput.value === '0')) {
                    precoInput.value = preco;
                }
            }
        });
    }

    document.querySelectorAll('.select-produto').forEach(bindProdutoChange);

    document.getElementById('btnAddItem').addEventListener('click', function() {
        var tbody = document.querySelector('#tabelaItens tbody');
        var index = tbody.querySelectorAll('tr').length;
        var options = document.getElementById('produtoOptionsTemplate').innerHTML;
        var tr = document.createElement('tr');
        tr.innerHTML = `
            <td>
                <select name="Itens[${index}].ProdutoId" class="form-select form-select-sm bg-black text-light border-secondary select-produto" required aria-label="Produto">
                    ${options}
                </select>
            </td>
            <td>
                <input type="number" step="0.0001" min="0.0001" name="Itens[${index}].Quantidade" value="1" class="form-control form-control-sm bg-black text-light border-secondary" required aria-label="Quantidade">
            </td>
            <td>
                <input type="number" step="0.01" min="0" name="Itens[${index}].PrecoUnitario" value="0.00" class="form-control form-control-sm bg-black text-light border-secondary input-preco" required aria-label="Precounitario">
            </td>
            <td>
                <input type="number" step="0.01" min="0" name="Itens[${index}].Desconto" value="0.00" class="form-control form-control-sm bg-black text-light border-secondary" aria-label="Desconto">
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger btnRemoveItem" aria-label="Remover item"><i class="bi bi-trash"></i></button>
            </td>
        `;
        tbody.appendChild(tr);
        bindRemoveButtons();
        bindProdutoChange(tr.querySelector('.select-produto'));
    });

    function bindRemoveButtons() {
        document.querySelectorAll('.btnRemoveItem').forEach(btn => {
            btn.onclick = function() {
                var trs = document.querySelectorAll('#tabelaItens tbody tr');
                if (trs.length > 1) {
                    btn.closest('tr').remove();
                }
            };
        });
    }
    bindRemoveButtons();
</script>
