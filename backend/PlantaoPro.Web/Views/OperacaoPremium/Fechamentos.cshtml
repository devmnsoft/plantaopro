@model PlantaoPro.Web.Models.FechamentoOperacionalPageViewModel
@{ ViewData["Title"]="Fechamento Operacional"; var f=Model.Selecionado; string Money(decimal v)=>v.ToString("C"); var steps=new[]{"Plantão realizado","Conferência","Divergências","Aprovação","Financeiro","Pagamento","Conclusão"}; var step=f?.Status switch{"ABERTO"=>0,"EM_CONFERENCIA"=>1,"COM_DIVERGENCIA"=>2,"AGUARDANDO_APROVACAO"=>3,"APROVADO"=>4,"FINANCEIRO_GERADO"=>5,"CONCLUIDO"=>6,_=>0};
 var totalPrevisto=Model.Fechamentos.Sum(x=>x.ValorPrevisto); var totalAprovado=Model.Fechamentos.Where(x=>x.Status is "APROVADO" or "FINANCEIRO_GERADO" or "CONCLUIDO").Sum(x=>x.ValorApurado); var totalPendente=Model.Fechamentos.Where(x=>x.Status is "ABERTO" or "EM_CONFERENCIA" or "AGUARDANDO_APROVACAO").Sum(x=>x.ValorApurado); var totalDivergente=Model.Fechamentos.Where(x=>x.DivergenciasAbertas>0).Sum(x=>x.ValorApurado); var conferidos=Model.Fechamentos.Count(x=>x.Status is "AGUARDANDO_APROVACAO" or "APROVADO" or "FINANCEIRO_GERADO" or "CONCLUIDO"); var aguardando=Model.Fechamentos.Count(x=>x.Status is "ABERTO" or "EM_CONFERENCIA" or "COM_DIVERGENCIA"); }
<section class="pp-page premium-workspace v1420-workspace" data-closing-business-rules aria-labelledby="closing-title">
 <header class="pp-financial-command"><div><span class="pp-eyebrow">Apuração · Operação financeira auditável</span><h1 id="closing-title">Apuração de plantões</h1><p>Revise execução, valores e divergências antes de liberar cada competência para aprovação e pagamento.</p></div><div class="hero-actions"><a class="btn btn-primary" asp-action="Index"><i class="bi bi-arrow-clockwise"></i> Atualizar</a><a class="btn btn-secondary" asp-action="Pendentes">Pendentes</a></div></header>
 @if(!string.IsNullOrWhiteSpace(Model.Error)){<div class="alert alert-danger" role="alert">@Model.Error</div>}
 @if(f is null){<form method="get" class="pp-premium-filter" aria-label="Filtros da apuração"><div class="pp-section-heading"><div><span class="pp-eyebrow">Filtros profissionais</span><h2>Refine a competência</h2><p>Use período e seletores para localizar a fila certa, sem informar códigos.</p></div></div><div class="filter-grid">
  <div><label for="inicio">Data inicial</label><input class="form-control" id="inicio" name="inicio" type="date" value="@Model.Inicio?.ToString("yyyy-MM-dd")" /></div>
  <div><label for="fim">Data final</label><input class="form-control" id="fim" name="fim" type="date" value="@Model.Fim?.ToString("yyyy-MM-dd")" /></div>
  <div><label for="unidadeId">Unidade</label><select class="form-select" id="unidadeId" name="unidadeId"><option value="">Todas</option>@foreach(var x in Model.Fechamentos.DistinctBy(x=>x.HospitalId).OrderBy(x=>x.Hospital)){<option value="@x.HospitalId" selected="@(Model.UnidadeId==x.HospitalId)">@x.Hospital</option>}</select></div>
  <div><label for="profissional">Profissional</label><input class="form-control" id="profissional" name="profissional" list="profissionais" value="@Model.Profissional" placeholder="Busque pelo nome"/><datalist id="profissionais">@foreach(var nome in Model.Fechamentos.SelectMany(x=>x.Profissionais.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)).Distinct().Order()){<option value="@nome"></option>}</datalist></div>
  <div><label for="especialidadeId">Especialidade</label><select class="form-select" id="especialidadeId" name="especialidadeId"><option value="">Todas</option>@foreach(var x in Model.Fechamentos.DistinctBy(x=>x.EspecialidadeId).OrderBy(x=>x.Especialidade)){<option value="@x.EspecialidadeId" selected="@(Model.EspecialidadeId==x.EspecialidadeId)">@x.Especialidade</option>}</select></div>
  <div><label for="status">Status</label><select class="form-select" id="status" name="status"><option value="">Todos</option>@foreach(var s in new[]{"ABERTO","EM_CONFERENCIA","COM_DIVERGENCIA","AGUARDANDO_APROVACAO","APROVADO","DEVOLVIDO","REJEITADO","FINANCEIRO_GERADO","CONCLUIDO","CANCELADO"}){<option value="@s" selected="@(Model.Status==s)">@s.Replace('_',' ')</option>}</select></div>
  <div class="hero-actions"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> Aplicar filtros</button><a class="btn btn-secondary" asp-action="Index">Limpar</a><a class="btn btn-secondary" asp-action="Exportar" asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")" asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")" asp-route-unidadeId="@Model.UnidadeId" asp-route-especialidadeId="@Model.EspecialidadeId" asp-route-profissional="@Model.Profissional" asp-route-status="@Model.Status"><i class="bi bi-download"></i> Exportar CSV</a></div>
 </div><div class="pp-filter-summary" aria-live="polite"><strong>Filtros ativos:</strong><span>@(Model.Inicio?.ToString("dd/MM/yyyy") ?? "início livre") a @(Model.Fim?.ToString("dd/MM/yyyy") ?? "hoje")</span><span>· @(string.IsNullOrWhiteSpace(Model.Status)?"todos os status":Model.Status.Replace('_',' '))</span></div></form>}
 <section class="pp-financial-summary" aria-label="Indicadores da apuração"><article class="pp-kpi-card"><span>Total previsto</span><strong>@Money(totalPrevisto)</strong><small>Registros retornados</small></article><article class="pp-kpi-card"><span>Total aprovado</span><strong>@Money(totalAprovado)</strong><small>Liberado após conferência</small></article><article class="pp-kpi-card tone-warning"><span>Total pendente</span><strong>@Money(totalPendente)</strong><small>Requer próxima ação</small></article><article class="pp-kpi-card tone-danger"><span>Com divergência</span><strong>@Money(totalDivergente)</strong><small>@Model.Fechamentos.Sum(x=>x.DivergenciasAbertas) ocorrência(s)</small></article><article class="pp-kpi-card tone-success"><span>Plantões conferidos</span><strong>@conferidos</strong><small>Conferência concluída</small></article><article class="pp-kpi-card tone-info"><span>Aguardando conferência</span><strong>@aguardando</strong><small>Fila de revisão</small></article></section>
 <section class="operational-card" aria-labelledby="pipeline-title"><div class="pp-section-heading"><div><span class="pp-eyebrow">Esteira financeira</span><h2 id="pipeline-title">Situação da competência</h2><p>Cada etapa aplica um atalho para a fila correspondente.</p></div></div><div class="pp-financial-pipeline">@foreach(var stage in new[]{new{Label="Executado",Status="ABERTO",Tone="info"},new{Label="Pendente de conferência",Status="EM_CONFERENCIA",Tone="warning"},new{Label="Com divergência",Status="COM_DIVERGENCIA",Tone="danger"},new{Label="Conferido",Status="AGUARDANDO_APROVACAO",Tone="info"},new{Label="Aprovado",Status="APROVADO",Tone="success"},new{Label="Pago",Status="CONCLUIDO",Tone="success"},new{Label="Rejeitado",Status="REJEITADO",Tone="neutral"}}){var group=Model.Fechamentos.Where(x=>x.Status==stage.Status).ToList();<a class="pp-pipeline-stage pp-pipeline-stage--@stage.Tone" asp-action="Index" asp-route-status="@stage.Status" aria-label="Filtrar por @stage.Label"><span>@stage.Label</span><strong>@group.Count</strong><small>@Money(group.Sum(x=>x.ValorApurado)) · Ver lista</small></a>}</div></section>
 <div class="kpi-strip"><article class="kpi-card tone-warning"><span>Pendentes</span><strong>@Model.Fechamentos.Count(x=>x.Status is not ("CONCLUIDO" or "CANCELADO" or "REJEITADO"))</strong><small>Exigem ação operacional</small></article><article class="kpi-card tone-info"><span>Em conferência</span><strong>@Model.Fechamentos.Count(x=>x.Status is "EM_CONFERENCIA" or "COM_DIVERGENCIA")</strong><small>Escalas em apuração</small></article><article class="kpi-card tone-danger"><span>Divergências abertas</span><strong>@Model.Fechamentos.Sum(x=>x.DivergenciasAbertas)</strong><small>Impedem aprovação</small></article><article class="kpi-card tone-success"><span>Aguardando pagamento</span><strong>@Money(Model.Fechamentos.Where(x=>x.Status is "APROVADO" or "FINANCEIRO_GERADO").Sum(x=>x.ValorApurado))</strong><small>Fonte financeira real</small></article></div>
 @if(f is not null){
 <nav class="clinical-journey pp-operational-journey" aria-label="Etapas do fechamento">@for(var i=0;i<steps.Length;i++){<span class="@(i<=step?"is-complete":"")" aria-current="@(i==step?"step":null)"><i class="bi @(i<step?"bi-check-circle-fill":"bi-circle")"></i>@steps[i]</span>}</nav>
 <section class="operational-card"><div class="d-flex justify-content-between flex-wrap gap-3"><div><span class="status-badge">@f.Status.Replace('_',' ')</span><h2>@f.Hospital</h2><p>@f.Especialidade · @f.Inicio.ToString("dd/MM/yyyy HH:mm")–@f.Fim.ToString("HH:mm")</p></div><form asp-action="Acao" asp-route-id="@f.Id" method="post" class="hero-actions" data-submit-lock>@Html.AntiForgeryToken()@if(f.Status is "ABERTO" or "DEVOLVIDO"){<button type="submit" class="btn btn-primary" name="acao" value="iniciar-conferencia"><i class="bi bi-clipboard-check"></i> Iniciar conferência</button>}@if(f.Status=="EM_CONFERENCIA"&&f.DivergenciasAbertas==0){<button type="submit" class="btn btn-primary" name="acao" value="concluir-conferencia">Enviar para aprovação</button>}@if(f.Status=="AGUARDANDO_APROVACAO"){<button type="submit" class="btn btn-primary" name="acao" value="aprovar"><i class="bi bi-shield-check"></i> Aprovar</button><label for="motivo">Motivo</label><select class="form-select" id="motivo" name="motivo"><option value="">Selecione</option><option value="EXECUCAO_NAO_COMPROVADA">Execução não comprovada</option><option value="DIVERGENCIA_FINANCEIRA">Divergência financeira</option><option value="DOCUMENTACAO_INCOMPLETA">Documentação incompleta</option><option value="NAO_CONFORMIDADE">Não conformidade</option></select><label class="visually-hidden" for="observacao">Observação</label><input class="form-control" id="observacao" name="observacao" maxlength="500" placeholder="Observação opcional"/><button type="submit" class="btn btn-secondary" name="acao" value="devolver">Devolver para ajuste</button><button type="submit" class="btn btn-danger" name="acao" value="rejeitar">Rejeitar</button>}@if(f.Status=="APROVADO"){<button type="submit" class="btn btn-primary" name="acao" value="gerar-financeiro"><i class="bi bi-cash-stack"></i> Gerar financeiro</button>}</form></div>
 <div class="kpi-strip"><article class="kpi-card"><span>Valor previsto</span><strong>@Money(f.ValorPrevisto)</strong></article><article class="kpi-card"><span>Valor apurado</span><strong>@Money(f.ValorApurado)</strong></article><article class="kpi-card"><span>Diferença</span><strong>@Money(f.ValorApurado-f.ValorPrevisto)</strong></article><article class="kpi-card"><span>Horas</span><strong>@f.HorasRealizadas.ToString("0.##") / @f.HorasPrevistas.ToString("0.##")</strong></article></div>
 </section>}
 <div class="operational-grid"><section class="operational-card"><h2>@(f is null?"Fechamentos":"Conferência das escalas")</h2>
 @if(f is null){if(Model.Fechamentos.Count==0){<div class="empty-state"><i class="bi bi-clipboard-check"></i><strong>Nenhum fechamento no período</strong><p>Ajuste os filtros ou aguarde a execução dos plantões.</p></div>}else{<div class="table-responsive"><table class="pp-data-table"><thead><tr><th>Data / horário</th><th>Unidade</th><th>Profissional</th><th>Especialidade</th><th>Status</th><th>Previsto</th><th>Aprovado</th><th>Ocorrência</th><th>Ação</th></tr></thead><tbody>@foreach(var x in Model.Fechamentos){<tr><td data-label="Data / horário"><strong>@x.Inicio.ToString("dd/MM/yyyy")</strong><small>@x.Inicio.ToString("HH:mm")–@x.Fim.ToString("HH:mm")</small></td><td data-label="Unidade">@x.Hospital</td><td data-label="Profissional">@x.Profissionais</td><td data-label="Especialidade">@x.Especialidade</td><td data-label="Status"><partial name="_StatusBadge" model="x.Status" /></td><td data-label="Previsto">@Money(x.ValorPrevisto)</td><td data-label="Aprovado">@(x.Status is "APROVADO" or "FINANCEIRO_GERADO" or "CONCLUIDO"?Money(x.ValorApurado):"—")</td><td data-label="Ocorrência">@(x.DivergenciasAbertas>0?$"{x.DivergenciasAbertas} divergência(s)":"Sem divergência")</td><td data-label="Ação"><a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@x.Id">Conferir</a></td></tr>}</tbody></table></div>}}
 else{<div class="table-responsive"><table class="pp-data-table"><thead><tr><th>Médico</th><th>Previsto</th><th>Realizado</th><th>Horas</th><th>Presença</th><th>Previsto</th><th>Final</th><th>Divergência</th><th>Pagamento</th></tr></thead><tbody>@foreach(var i in f.Itens){<tr><td data-label="Médico"><strong>@i.Medico</strong><small>CRM @i.Crm</small></td><td data-label="Previsto">@i.InicioPrevisto.ToString("HH:mm")–@i.FimPrevisto.ToString("HH:mm")</td><td data-label="Realizado">@(i.StatusEscala=="realizado"?$"{i.InicioPrevisto:HH:mm}–{i.FimPrevisto:HH:mm}":"—")</td><td data-label="Horas">@i.HorasRealizadas.ToString("0.##") / @i.HorasPrevistas.ToString("0.##")</td><td data-label="Presença">@(i.StatusEscala=="realizado"?"Presente":"Ausente")</td><td data-label="Valor previsto">@Money(i.ValorPrevisto)</td><td data-label="Valor final">@Money(i.ValorApurado)</td><td data-label="Divergência"><span class="status-badge">@(i.PossuiDivergencia?"Aberta":"Sem divergência")</span></td><td data-label="Pagamento">@if(i.PagamentoId.HasValue){<a asp-controller="Pagamentos" asp-action="Details" asp-route-id="@i.PagamentoId">@i.PagamentoStatus</a>}else{<span>Não gerado</span>}</td></tr>}</tbody></table></div>}</section>
 <aside class="context-drawer is-static"><h2>Timeline e auditoria</h2>@if(Model.Timeline.Count==0){<div class="empty-state"><strong>Selecione um fechamento</strong><p>Eventos e responsáveis serão exibidos sem dados clínicos sensíveis.</p></div>}else{<ol class="timeline-list">@foreach(var e in Model.Timeline){<li><strong>@e.Evento.Replace('_',' ')</strong><span>@e.Descricao</span><time datetime="@e.ExecutadoEm.ToString("O")">@e.ExecutadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></li>}</ol>}</aside></div>
</section>
@section Scripts{<script>document.querySelectorAll('[data-submit-lock]').forEach(f=>f.addEventListener('submit',()=>f.querySelectorAll('button').forEach(b=>{b.disabled=true;b.setAttribute('aria-busy','true')})));</script>}
