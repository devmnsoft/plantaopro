@model PlantaoPro.Web.Models.FechamentoOperacionalPageViewModel
@{ ViewData["Title"]="Fechamento Operacional"; var f=Model.Selecionado; string Money(decimal v)=>v.ToString("C"); var steps=new[]{"Plantão","Conferência","Divergências","Aprovação","Financeiro","Pagamento","Conclusão"}; var step=f?.Status switch{"ABERTO"=>0,"EM_CONFERENCIA"=>1,"COM_DIVERGENCIA"=>2,"AGUARDANDO_APROVACAO"=>3,"APROVADO"=>4,"FINANCEIRO_GERADO"=>5,"CONCLUIDO"=>6,_=>0}; }
<section class="pp-page premium-workspace v1420-workspace" aria-labelledby="closing-title">
 <header class="page-hero v1420-hero"><div><span class="eyebrow">Operação financeira auditável</span><h1 id="closing-title">Fechamento Operacional</h1><p>Da conferência das escalas realizadas ao pagamento médico, com divergências e aprovação rastreáveis.</p></div><div class="hero-actions"><a class="btn btn-primary" asp-action="Index"><i class="bi bi-arrow-clockwise"></i> Atualizar</a><a class="btn btn-secondary" asp-action="Pendentes">Pendentes</a></div></header>
 @if(!string.IsNullOrWhiteSpace(Model.Error)){<div class="alert alert-danger" role="alert">@Model.Error</div>}
 <div class="kpi-strip"><article class="kpi-card tone-warning"><span>Pendentes</span><strong>@Model.Fechamentos.Count(x=>x.Status is not ("CONCLUIDO" or "CANCELADO"))</strong><small>Exigem ação operacional</small></article><article class="kpi-card tone-info"><span>Em conferência</span><strong>@Model.Fechamentos.Count(x=>x.Status is "EM_CONFERENCIA" or "COM_DIVERGENCIA")</strong><small>Escalas em apuração</small></article><article class="kpi-card tone-danger"><span>Divergências abertas</span><strong>@Model.Fechamentos.Sum(x=>x.DivergenciasAbertas)</strong><small>Impedem aprovação</small></article><article class="kpi-card tone-success"><span>Aguardando pagamento</span><strong>@Money(Model.Fechamentos.Where(x=>x.Status is "APROVADO" or "FINANCEIRO_GERADO").Sum(x=>x.ValorApurado))</strong><small>Fonte financeira real</small></article></div>
 @if(f is not null){
 <nav class="clinical-journey pp-operational-journey" aria-label="Etapas do fechamento">@for(var i=0;i<steps.Length;i++){<span class="@(i<=step?"is-complete":"")" aria-current="@(i==step?"step":null)"><i class="bi @(i<step?"bi-check-circle-fill":"bi-circle")"></i>@steps[i]</span>}</nav>
 <section class="operational-card"><div class="d-flex justify-content-between flex-wrap gap-3"><div><span class="status-badge">@f.Status.Replace('_',' ')</span><h2>@f.Hospital</h2><p>@f.Especialidade · @f.Inicio.ToString("dd/MM/yyyy HH:mm")–@f.Fim.ToString("HH:mm")</p></div><form asp-action="Acao" asp-route-id="@f.Id" method="post" class="hero-actions" data-submit-lock>@Html.AntiForgeryToken()@if(f.Status is "ABERTO" or "DEVOLVIDO"){<button class="btn btn-primary" name="acao" value="iniciar-conferencia"><i class="bi bi-clipboard-check"></i> Iniciar conferência</button>}@if(f.Status=="EM_CONFERENCIA"&&f.DivergenciasAbertas==0){<button class="btn btn-primary" name="acao" value="concluir-conferencia">Enviar para aprovação</button>}@if(f.Status=="AGUARDANDO_APROVACAO"){<button class="btn btn-primary" name="acao" value="aprovar"><i class="bi bi-shield-check"></i> Aprovar</button><label class="visually-hidden" for="motivo">Motivo da devolução</label><input id="motivo" name="motivo" minlength="10" maxlength="500" placeholder="Motivo da devolução"/><button class="btn btn-secondary" name="acao" value="devolver">Devolver</button>}@if(f.Status=="APROVADO"){<button class="btn btn-primary" name="acao" value="gerar-financeiro"><i class="bi bi-cash-stack"></i> Gerar financeiro</button>}</form></div>
 <div class="kpi-strip"><article class="kpi-card"><span>Valor previsto</span><strong>@Money(f.ValorPrevisto)</strong></article><article class="kpi-card"><span>Valor apurado</span><strong>@Money(f.ValorApurado)</strong></article><article class="kpi-card"><span>Diferença</span><strong>@Money(f.ValorApurado-f.ValorPrevisto)</strong></article><article class="kpi-card"><span>Horas</span><strong>@f.HorasRealizadas.ToString("0.##") / @f.HorasPrevistas.ToString("0.##")</strong></article></div>
 </section>}
 <div class="operational-grid"><section class="operational-card"><h2>@(f is null?"Fechamentos":"Conferência das escalas")</h2>
 @if(f is null){if(Model.Fechamentos.Count==0){<div class="empty-state"><i class="bi bi-clipboard-check"></i><strong>Nenhum fechamento no período</strong><p>Fechamentos gerados a partir de plantões realizados aparecerão aqui.</p></div>}else{<div class="table-responsive"><table class="pp-data-table"><thead><tr><th>Hospital / plantão</th><th>Status</th><th>Escalas</th><th>Divergências</th><th>Valor</th><th></th></tr></thead><tbody>@foreach(var x in Model.Fechamentos){<tr><td><strong>@x.Hospital</strong><small>@x.Especialidade · @x.Inicio.ToString("dd/MM HH:mm")</small></td><td><span class="status-badge">@x.Status.Replace('_',' ')</span></td><td>@x.QuantidadeEscalas</td><td>@x.DivergenciasAbertas</td><td>@Money(x.ValorApurado)</td><td><a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@x.Id">Conferir</a></td></tr>}</tbody></table></div>}}
 else{<div class="table-responsive"><table class="pp-data-table"><thead><tr><th>Médico</th><th>Previsto</th><th>Realizado</th><th>Horas</th><th>Presença</th><th>Previsto</th><th>Final</th><th>Divergência</th><th>Pagamento</th></tr></thead><tbody>@foreach(var i in f.Itens){<tr><td><strong>@i.Medico</strong><small>CRM @i.Crm</small></td><td>@i.InicioPrevisto.ToString("HH:mm")–@i.FimPrevisto.ToString("HH:mm")</td><td>@(i.StatusEscala=="realizado"?$"{i.InicioPrevisto:HH:mm}–{i.FimPrevisto:HH:mm}":"—")</td><td>@i.HorasRealizadas.ToString("0.##") / @i.HorasPrevistas.ToString("0.##")</td><td>@(i.StatusEscala=="realizado"?"Presente":"Ausente")</td><td>@Money(i.ValorPrevisto)</td><td>@Money(i.ValorApurado)</td><td><span class="status-badge">@(i.PossuiDivergencia?"Aberta":"Sem divergência")</span></td><td>@if(i.PagamentoId.HasValue){<a asp-controller="Pagamentos" asp-action="Details" asp-route-id="@i.PagamentoId">@i.PagamentoStatus</a>}else{<span>Não gerado</span>}</td></tr>}</tbody></table></div>}</section>
 <aside class="context-drawer is-static"><h2>Timeline e auditoria</h2>@if(Model.Timeline.Count==0){<div class="empty-state"><strong>Selecione um fechamento</strong><p>Eventos e responsáveis serão exibidos sem dados clínicos sensíveis.</p></div>}else{<ol class="timeline-list">@foreach(var e in Model.Timeline){<li><strong>@e.Evento.Replace('_',' ')</strong><span>@e.Descricao</span><time datetime="@e.ExecutadoEm.ToString("O")">@e.ExecutadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></li>}</ol>}</aside></div>
</section>
@section Scripts{<script>document.querySelectorAll('[data-submit-lock]').forEach(f=>f.addEventListener('submit',()=>f.querySelectorAll('button').forEach(b=>{b.disabled=true;b.setAttribute('aria-busy','true')})));</script>}
