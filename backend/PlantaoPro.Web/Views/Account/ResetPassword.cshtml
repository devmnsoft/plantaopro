@model ResetPasswordViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = UiText.L("Auth.ResetTitle"); }
@* R7-D-F2: redefinicao de senha em recursos localizados (UiTexts.resx x4). *@
<div class="auth-experience auth-experience--compact"><section class="auth-form-panel auth-recovery-card" aria-labelledby="resetTitle">
    <span class="pp-page-intro__eyebrow">@UiText.L("Auth.ResetEyebrow")</span><h1 id="resetTitle">@UiText.L("Auth.ResetHeading")</h1><p>@UiText.L("Auth.ResetIntro")</p>
    <div class="pp-warning-banner" role="note"><span class="pp-alert__icon" aria-hidden="true">!</span><div class="pp-alert__content"><strong>@UiText.L("Auth.ResetNoReuseTitle")</strong><p>@UiText.L("Auth.ResetNoReuseBody")</p></div></div>
    <form asp-action="ResetPassword" method="post" class="pp-form" novalidate data-focus-invalid>@Html.AntiForgeryToken()<input asp-for="Email" type="hidden"/><input asp-for="Token" type="hidden"/>
        <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" tabindex="-1"></div>
        <div class="pp-form-field"><label asp-for="NovaSenha" class="pp-form-label">@UiText.L("Auth.ResetNewPasswordLabel") <span class="pp-required-marker" aria-hidden="true">*</span></label><input asp-for="NovaSenha" class="form-control form-control-lg" type="password" autocomplete="new-password" aria-describedby="newPasswordHelp" required/><small id="newPasswordHelp" class="pp-field-help">@UiText.L("Auth.ResetNewPasswordHelp")</small><span asp-validation-for="NovaSenha" class="pp-form-error" data-valmsg-for="NovaSenha"></span></div>
        <div class="pp-form-field"><label asp-for="ConfirmarSenha" class="pp-form-label">@UiText.L("Auth.ResetConfirmLabel") <span class="pp-required-marker" aria-hidden="true">*</span></label><input asp-for="ConfirmarSenha" class="form-control form-control-lg" type="password" autocomplete="new-password" required/><span asp-validation-for="ConfirmarSenha" class="pp-form-error" data-valmsg-for="ConfirmarSenha"></span></div>
        <button class="btn btn-primary btn-lg" type="submit"><app-icon name="Check" size="18" /> @UiText.L("Auth.ResetSubmit")</button>
    </form>
</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
