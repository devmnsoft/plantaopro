@model PlantaoPro.Web.Models.DespesaManualFormViewModel
@{
    ViewData["Title"] = "Nova Despesa Manual — Contas a Pagar";
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="TitulosPagar" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
                <h2 class="h4 mb-0 text-light fw-bold">Cadastrar Despesa Manual</h2>
            </div>
            <p class="text-muted small mb-0 mt-1">Registrar obrigações operacionais avulsas, contratos de serviços ou despesas fixas.</p>
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-3"><i class="bi bi-info-circle me-2"></i>Inclusão de Obrigação Manual</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-4">
                    <strong class="text-light d-block mb-1">Para que serve</strong>
                    Permite lançar despesas administrativas e operacionais que não se originam de pedidos de compra ou comissões.
                </div>
                <div class="col-md-4">
                    <strong class="text-light d-block mb-1">Fluxo de Aprovação</strong>
                    A obrigação é criada no estado <em>Pendente de Aprovação</em> e necessita de autorização antes de ser paga.
                </div>
                <div class="col-md-4">
                    <strong class="text-light d-block mb-1">Próximo passo</strong>
                    Aprovar o título gerado e proceder com o pagamento manual no vencimento.
                </div>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="card bg-dark border-secondary text-light">
        <div class="card-header bg-dark border-secondary text-info fw-bold">
            <i class="bi bi-pencil-square me-1"></i> Formulário de Despesa
        </div>
        <div class="card-body">
            <form asp-action="NovaDespesa" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small text-secondary" for="fornecedorId">Fornecedor / Beneficiário</label>
                        <select id="fornecedorId" name="fornecedorId" class="form-select form-select-sm bg-dark text-light border-secondary" required>
                            <option value="">Selecione um fornecedor...</option>
                            @foreach (var f in Model.Fornecedores)
                            {
                                <option value="@f.Value" selected="@(Model.FornecedorId.ToString() == f.Value)">@f.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-secondary" for="documento">Nº Documento / Nota / Recibo</label>
                        <input type="text" id="documento" name="documento" class="form-control form-control-sm bg-dark text-light border-secondary"
                               value="@Model.Documento" placeholder="Ex: NF-e 4589" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-secondary" for="competencia">Competência</label>
                        <input type="date" id="competencia" name="competencia" class="form-control form-control-sm bg-dark text-light border-secondary"
                               value="@Model.Competencia.ToString("yyyy-MM-01")" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small text-secondary" for="dataVencimento">Data de Vencimento</label>
                        <input type="date" id="dataVencimento" name="dataVencimento" class="form-control form-control-sm bg-dark text-light border-secondary"
                               value="@Model.DataVencimento.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-secondary" for="valorPrincipal">Valor Total (R$)</label>
                        <input type="number" step="0.01" min="0.01" id="valorPrincipal" name="valorPrincipal"
                               class="form-control form-control-sm bg-dark text-light border-secondary font-monospace"
                               value="@(Model.ValorPrincipal > 0 ? Model.ValorPrincipal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")"
                               placeholder="0,00" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-secondary" for="centroCusto">Centro de Custo</label>
                        <input type="text" id="centroCusto" name="centroCusto" class="form-control form-control-sm bg-dark text-light border-secondary"
                               value="@Model.CentroCusto" placeholder="Ex: ADMINISTRATIVO, LOGÍSTICA, TI" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small text-secondary" for="observacoes">Observações / Detalhes</label>
                    <input type="text" id="observacoes" name="observacoes" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@Model.Observacoes" placeholder="Informações adicionais para conferência" />
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="TitulosPagar" class="btn btn-sm btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-save me-1"></i> Salvar Despesa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
