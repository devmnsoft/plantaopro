@model CommercialDemoPageViewModel
@{ ViewData["Title"] = "Admin SaaS e Governança"; }
<div class="pp-page pp-admin-governance pp-strategic-surface" data-admin-governance data-admin-next-action>
    <header class="pp-page-hero" aria-labelledby="admin-title">
        <div class="pp-page-hero__copy"><span class="pp-eyebrow">Admin SaaS e Governança</span><h1 id="admin-title">Central administrativa</h1><p>Consulte as fontes responsáveis pelo contrato, configuração, acessos e rastreabilidade. Ausência de integração nunca é apresentada como dado do tenant.</p></div>
        <div class="pp-hero-actions"><a class="btn btn-primary" asp-controller="Configuracoes" asp-action="Index">Abrir configurações</a><a class="btn btn-outline-primary" asp-controller="MinhaAssinatura" asp-action="Index">Minha assinatura</a></div>
    </header>

    <section class="pp-v2141-global-banner" role="note" aria-label="Contexto global ativo">
        <span class="pp-v2141-global-banner__icon"><app-icon name="Security" size="22" /></span>
        <div><span class="pp-eyebrow">Contexto atual</span><strong>Cockpit MNSOFT · visão global auditável</strong><p>Você está fora do contexto de um cliente. Selecione explicitamente a instituição antes de consultar ou alterar dados; a autorização permanece validada no servidor.</p></div>
        <a class="btn btn-light btn-sm" asp-controller="Auditoria" asp-action="Index"><app-icon name="Audit" size="17" /> Ver auditoria</a>
    </section>

    <section class="pp-v2141-tenant-switcher" aria-labelledby="tenant-switcher-title">
        <div><span class="pp-eyebrow">Acesso assistido</span><h2 id="tenant-switcher-title">Localizar cliente ou tenant</h2><p>A busca abre a fonte oficial de clientes. Entrar em um contexto exige permissão e deve gerar trilha de auditoria.</p></div>
        <form asp-controller="Clientes" asp-action="Index" method="get" role="search" class="pp-v2141-tenant-search">
            <label for="tenantSearch">Nome, documento ou tenant</label>
            <div><input id="tenantSearch" name="q" class="form-control" type="search" autocomplete="off" placeholder="Ex.: nome da instituição" /><button class="btn btn-primary" type="submit"><app-icon name="Search" size="18" /> Buscar cliente</button></div>
            <small>Nenhum contexto será alterado somente pela pesquisa.</small>
        </form>
    </section>

    <section aria-labelledby="global-overview-title">
        <div class="pp-section-header"><div><span class="pp-eyebrow">Visão executiva</span><h2 id="global-overview-title">Indicadores globais por fonte</h2><p>Os cartões direcionam para dados persistidos; valores não carregados nunca são substituídos por estimativas.</p></div><span class="pp-status-badge pp-status-badge--source">Dados sob demanda</span></div>
        <div class="pp-v2141-kpi-grid">
            <a asp-controller="Clientes" asp-action="Index"><span>Clientes cadastrados</span><strong>Consultar</strong><small>Ativos, bloqueados e contexto</small></a>
            <a asp-controller="Usuarios" asp-action="Index"><span>Usuários por cliente</span><strong>Consultar</strong><small>Perfis, acessos e bloqueios</small></a>
            <a asp-controller="Modulos" asp-action="Dashboard"><span>Módulos e funcionalidades</span><strong>Consultar</strong><small>Ativos e bloqueados por tenant</small></a>
            <a asp-controller="FaturamentoSaas" asp-action="Inadimplencia"><span>Cobranças</span><strong>Consultar</strong><small>Pendentes e vencidas</small></a>
            <a asp-controller="Observabilidade" asp-action="Index"><span>Status operacional</span><strong>Ver saúde</strong><small>Serviços, erros e integrações</small></a>
            <a asp-controller="Auditoria" asp-action="Index"><span>Últimos eventos</span><strong>Ver trilha</strong><small>Acessos e alterações globais</small></a>
        </div>
    </section>

    <div class="pp-governance-notice" role="note"><i class="bi bi-database-check" aria-hidden="true"></i><div><strong>Estado administrativo sob demanda</strong><p>Tenant, plano, consumo, limites, módulos e usuários são exibidos apenas nas respectivas telas quando retornados pelo backend.</p></div></div>

    <details class="pp-screen-guide"><summary><span><i class="bi bi-compass" aria-hidden="true"></i><strong>Como usar esta tela</strong></span><span class="pp-screen-guide__hint">Escopo global MNSOFT</span></summary><div class="pp-screen-guide__body"><p>Use esta central para navegar entre contrato, configuração, acessos e auditoria sem misturar dados de clientes.</p><ol><li>Escolha a fonte administrativa correspondente à sua tarefa.</li><li>Confirme o tenant antes de qualquer ação de suporte.</li><li>Consulte a auditoria após mudanças de plano, bloqueio ou permissão.</li></ol><div class="pp-screen-guide__note"><i class="bi bi-eye" aria-hidden="true"></i> O modo de suporte deve ser explícito, temporário e auditável; a interface não presume privilégios globais.</div></div></details>

    <section aria-labelledby="next-actions-title"><div class="pp-section-header"><div><span class="pp-eyebrow">Próximas ações do administrador</span><h2 id="next-actions-title">Governança por fonte</h2><p>Cada ação abaixo abre uma rota existente e preserva a autorização do servidor.</p></div></div>
        <div class="pp-governance-grid">
            <article class="pp-governance-card"><span class="pp-status-badge pp-status-badge--source">Fonte contratual</span><h3>Assinatura e plano</h3><p>Plano, status, cobrança, uso e módulos somente quando informados pela API.</p><div class="pp-card-actions"><a class="btn btn-outline-primary" asp-controller="MinhaAssinatura" asp-action="Index">Consultar assinatura</a><a class="btn btn-link" asp-controller="Planos" asp-action="Index">Catálogo real</a></div></article>
            <article class="pp-governance-card"><span class="pp-status-badge pp-status-badge--source">Rotas existentes</span><h3>Configuração do tenant</h3><p>Organize identidade, jornadas, segurança, integrações e preferências sem presumir status.</p><div class="pp-card-actions"><a class="btn btn-outline-primary" asp-controller="Configuracoes" asp-action="Index">Abrir configurações</a></div></article>
            <article class="pp-governance-card"><span class="pp-status-badge pp-status-badge--source">Autorização no servidor</span><h3>Usuários, perfis e permissões</h3><p>A lista depende da API. A interface não concede nem substitui permissões.</p><div class="pp-card-actions"><a class="btn btn-outline-primary" asp-controller="Usuarios" asp-action="Index">Gerenciar usuários</a><a class="btn btn-link" asp-controller="AdminSaas" asp-action="Index" asp-fragment="permissions-matrix">Ver matriz de referência</a></div></article>
            <article class="pp-governance-card"><span class="pp-status-badge pp-status-badge--source">Eventos reais</span><h3>Auditoria e LGPD</h3><p>Consulte somente eventos, solicitações e evidências persistidos pelas fontes de governança.</p><div class="pp-card-actions"><a class="btn btn-outline-primary" asp-controller="Auditoria" asp-action="Index">Auditoria</a><a class="btn btn-link" asp-controller="Lgpd" asp-action="Index">LGPD</a></div></article>
            <article class="pp-governance-card"><span class="pp-status-badge pp-status-badge--source">Geração contratada</span><h3>Relatórios administrativos</h3><p>Relatórios com endpoint podem ser abertos; implantações permanecem identificadas e inativas.</p><div class="pp-card-actions"><a class="btn btn-outline-primary" asp-controller="Relatorios" asp-action="Index">Abrir relatórios</a></div></article>
            <article class="pp-governance-card pp-governance-card--muted"><span class="pp-status-badge pp-status-badge--unavailable">Backend necessário</span><h3>Visão consolidada do tenant</h3><p>Não existe um agregado confiável para prontidão, pendências, usuários, módulos e contrato.</p><button class="btn btn-outline-secondary" type="button" disabled title="Depende de endpoint agregado e auditável do tenant.">Gerar diagnóstico consolidado</button></article>
        </div>
    </section>

    <section id="permissions-matrix" class="pp-governance-panel" aria-labelledby="permissions-title" data-permissions-matrix>
        <div class="pp-section-header"><div><span class="pp-eyebrow">Perfis e permissões</span><h2 id="permissions-title">Matriz de referência</h2><p>Perfis esperados no produto: Admin, Coordenação, Médico, Hospital, Financeiro e Operador. As permissões efetivas dependem das claims e policies devolvidas pelo backend.</p></div></div>
        <div class="pp-inline-empty"><i class="bi bi-shield-lock" aria-hidden="true"></i><div><strong>Matriz efetiva não disponibilizada</strong><p>Para evitar permissões fictícias, nenhuma capacidade é marcada como concedida. Consulte o artefato de governança e valide a autorização no servidor.</p></div></div>
        <button class="btn btn-outline-secondary" type="button" disabled title="A edição depende de endpoints de policies, perfis e auditoria.">Editar permissões</button>
    </section>
</div>
