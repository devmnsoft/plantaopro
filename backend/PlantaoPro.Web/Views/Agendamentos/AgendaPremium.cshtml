@model PlantaoPro.Web.Models.AgendaClinicaViewModel
@{
    ViewData["Title"] = Model.Titulo;
}
<div class="pp-page pp-clinical-page">
@Html.AntiForgeryToken()
<section class="pp-page-hero">
    <span class="pp-eyebrow">Saúde 360 · agenda assistencial</span>
    <h1>@Model.Titulo</h1>
    <p>Agenda clínica por cards, filtros, status e ações rápidas. Fonte: <code>@Model.Endpoint</code>.</p>
    <span class="pp-badge">Fonte: @Model.Fonte</span>
</section>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="pp-alert pp-alert--warning" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
}
<form class="pp-filter-bar pp-form" method="get" role="search" aria-label="Filtros da agenda">
    <div class="pp-filter-grid">
    <div class="pp-form-field"><label for="agendaData">Data</label><input id="agendaData" class="pp-form-control" name="data" type="date" /></div>
    <div class="pp-form-field"><label for="agendaMedico">Médico</label><input id="agendaMedico" class="pp-form-control" name="medico" autocomplete="off" /></div>
    <div class="pp-form-field"><label for="agendaUnidade">Unidade</label><input id="agendaUnidade" class="pp-form-control" name="unidade" autocomplete="off" /></div>
    <div class="pp-form-field"><label for="agendaEspecialidade">Especialidade</label><input id="agendaEspecialidade" class="pp-form-control" name="especialidade" autocomplete="off" /></div>
    <div class="pp-form-field"><label for="agendaStatus">Status</label><input id="agendaStatus" class="pp-form-control" name="status" autocomplete="off" /></div>
    </div><div class="pp-filter-bar__actions"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Aplicar filtros</button></div>
</form>
<div class="pp-status-summary" aria-label="Totais por status">
@foreach (var card in Model.StatusCards)
{
    <span class="badge @card.CssClass p-2">@card.Status: @card.Total</span>
}
@if (!Model.StatusCards.Any())
{
    <span class="badge bg-secondary p-2">Sem status retornado</span>
}
</div>
@if (!Model.Itens.Any())
{
    <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-calendar-check", "Agenda sem registros", "Nenhum agendamento real retornado para os filtros atuais. A tela não exibe pacientes demonstrativos por padrão.")' />
}
else
{
    <div class="pp-clinical-grid">
    @foreach (var grupo in Model.Itens.GroupBy(i => i.Horario.ToString("HH:mm")).OrderBy(g => g.Key))
    {
        <div class="pp-section-heading"><div><span class="pp-section-kicker">Horário</span><h2>@(grupo.First().Horario == default ? "Horário não informado" : grupo.Key)</h2></div></div>
        @foreach (var item in grupo)
        {
            <article class="pp-action-card clinical-appointment-card" data-patient-context data-next-action>
                <span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(item.Status) ? "Status não informado" : item.Status)</span>
                <h3 class="h5 mt-2">@(string.IsNullOrWhiteSpace(item.Paciente) ? "Paciente não informado" : item.Paciente)</h3>
                <p class="mb-1"><strong>Profissional:</strong> @(string.IsNullOrWhiteSpace(item.Medico) ? "Não informado" : item.Medico)</p>
                <p class="mb-1"><strong>Especialidade:</strong> @(string.IsNullOrWhiteSpace(item.Especialidade) ? "Não informada" : item.Especialidade)</p>
                <p class="mb-3"><strong>Unidade:</strong> @(string.IsNullOrWhiteSpace(item.Unidade) ? "Não informada pela API" : item.Unidade)</p>
                <dl class="pp-data-meta">
                    <div><dt>Atendimento</dt><dd>@(string.IsNullOrWhiteSpace(item.TipoAtendimento) ? "Não informado" : item.TipoAtendimento)</dd></div>
                    <div><dt>Convênio</dt><dd>@(string.IsNullOrWhiteSpace(item.Convenio) ? "Não informado" : item.Convenio)</dd></div>
                    <div><dt>Sala</dt><dd>@(string.IsNullOrWhiteSpace(item.Sala) ? "Não informada" : item.Sala)</dd></div>
                    <div><dt>Tempo de espera</dt><dd>@item.TempoEspera</dd></div>
                    <div><dt>Atraso</dt><dd>@item.Atraso</dd></div>
                    <div><dt>Próxima ação</dt><dd>@item.ProximaAcao</dd></div>
                </dl>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-primary btn-sm" data-detail-open data-detail-kind="Agendamento" data-detail-title="@(string.IsNullOrWhiteSpace(item.Paciente) ? "Paciente não informado" : item.Paciente)" data-detail-status="@item.Status" data-detail-summary="@item.TipoAtendimento" data-detail-origin="@item.Unidade" data-detail-period="@item.Horario.ToString("dd/MM/yyyy HH:mm")" data-detail-owner="@item.Medico" data-detail-composition="@item.Convenio · sala @item.Sala" data-detail-reference="@item.Id" data-detail-primary-url="@Url.Action("Details", "Agendamentos", new { id = item.Id })">Ver jornada</button>
                    @if (item.PodeConfirmar) { <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#agendaActionModal" data-agenda-id="@item.Id" data-agenda-operation="confirmar" data-agenda-label="Confirmar agendamento">Confirmar</button> }
                    else { <button type="button" class="btn btn-outline-primary btn-sm" disabled title="O status retornado pela API não permite confirmar este agendamento.">Confirmar</button> }
                    @if (item.PodeCheckIn) { <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#agendaActionModal" data-agenda-id="@item.Id" data-agenda-operation="checkin" data-agenda-label="Realizar check-in">Check-in</button> }
                    else { <button type="button" class="btn btn-outline-success btn-sm" disabled title="O check-in só é liberado para agendamento confirmado ou ainda agendado.">Check-in</button> }
                    @if (item.PodeAlterarAgenda) { <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Reagendar</a> }
                    else { <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="O status retornado não permite reagendamento.">Reagendar</button> }
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Vincule o agendamento à fila do painel antes de realizar a chamada.">Chamar no painel</button>
                    @if (item.PodeAbrirTriagem) { <a class="btn btn-outline-secondary btn-sm" asp-controller="Triagem" asp-action="Create" asp-route-agendamentoId="@item.Id">Abrir triagem</a> }
                    else { <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="A triagem exige check-in ou status de espera retornado pela API.">Abrir triagem</button> }
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="A consulta será habilitada quando a API retornar o vínculo da consulta deste agendamento.">Abrir consulta</button>
                    @if (item.PodeAlterarAgenda) { <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#agendaActionModal" data-agenda-id="@item.Id" data-agenda-operation="cancelar" data-agenda-label="Cancelar agendamento">Cancelar</button> }
                    else { <button type="button" class="btn btn-outline-danger btn-sm" disabled title="O status retornado não permite cancelamento.">Cancelar</button> }
                </div>
            </article>
        }
    }
    </div>
}
<div class="modal fade" id="agendaActionModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="agendaActionTitle" aria-describedby="agendaActionDescription" data-action-url="@Url.Action("ExecutarAcao", "Agendamentos")"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="agendaActionTitle">Confirmar ação</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><p id="agendaActionDescription">Confirme para registrar a ação no agendamento.</p><div class="pp-form-field" data-agenda-reason hidden><label for="agendaActionReason">Motivo do cancelamento</label><textarea id="agendaActionReason" class="pp-form-control" rows="3" maxlength="500" aria-describedby="agendaActionReasonHelp"></textarea><small id="agendaActionReasonHelp">Obrigatório para manter o histórico auditável.</small></div><div class="pp-alert pp-alert--danger mt-3" role="alert" data-agenda-error hidden></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button><button type="button" class="btn btn-primary" data-agenda-confirm>Confirmar</button></div></div></div></div>
<div class="toast-container position-fixed bottom-0 end-0 p-3"><div class="toast" id="agendaActionToast" role="status" aria-live="polite" aria-atomic="true"><div class="toast-body"></div></div></div>

</div>
@section Scripts { <script src="~/js/pages/agendamentos.js" asp-append-version="true"></script> }
