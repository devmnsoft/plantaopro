@model PlantaoPro.Web.Models.TitulosPagarIndexViewModel
@{
    ViewData["Title"] = "Contas a Pagar — Administrativo 360";
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
    var totalPrincipal = Model.Titulos.Sum(t => t.ValorPrincipal);
    var totalPago = Model.Titulos.Sum(t => t.ValorPago);
    var totalSaldo = Model.Titulos.Sum(t => t.SaldoAberto);
    var totalVencido = Model.Titulos.Where(t => t.Vencido && t.SaldoAberto > 0).Sum(t => t.SaldoAberto);
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">Contas a Pagar</h2>
            <p class="text-muted small mb-0">Gestão de obrigações financeiras: compras recebidas, despesas manuais e comissões.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="NovaDespesa" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Nova Despesa Manual
            </a>
            <a asp-action="ComissoesPendentes" class="btn btn-outline-info btn-sm">
                <i class="bi bi-person-badge me-1"></i> Comissões a Pagar
            </a>
            <a asp-action="ExportarTitulosPagarCsv"
               asp-route-situacao="@Model.Situacao"
               asp-route-inicio="@Model.Inicio?.ToString("yyyy-MM-dd")"
               asp-route-fim="@Model.Fim?.ToString("yyyy-MM-dd")"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
            </a>
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-3"><i class="bi bi-info-circle me-2"></i>Gestão de Obrigações a Pagar</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-4 col-lg-2">
                    <strong class="text-light d-block mb-1">Para que serve</strong>
                    Controla o ciclo de liquidação de obrigações com fornecedores, despesas operacionais e comissões de vendas.
                </div>
                <div class="col-md-4 col-lg-2">
                    <strong class="text-light d-block mb-1">Quem pode usar</strong>
                    Tesouraria, contas a pagar, gerência financeira e diretoria.
                </div>
                <div class="col-md-4 col-lg-3">
                    <strong class="text-light d-block mb-1">Como executar</strong>
                    Consulte os títulos pendentes, aprove quando necessário e efetue o registro manual do pagamento indicando a conta de saída.
                </div>
                <div class="col-md-6 col-lg-3">
                    <strong class="text-light d-block mb-1">Efeito da confirmação</strong>
                    Atualiza o saldo do título, gera movimento de saída no caixa e audita a operação. Pagamento não gera transferência bancária automática.
                </div>
                <div class="col-md-6 col-lg-2">
                    <strong class="text-light d-block mb-1">Próximo passo</strong>
                    Acompanhar o impacto no <em>Fluxo de Caixa</em> e realizar o <em>Fechamento de Caixa</em>.
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- Cards de Totais -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card bg-dark border-secondary text-light p-3 text-center h-100">
                <span class="text-muted small">Total Principal</span>
                <span class="fs-5 fw-bold font-monospace">@totalPrincipal.ToString("C2", ptBr)</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-dark border-secondary text-light p-3 text-center h-100 border-success">
                <span class="text-muted small">Total Pago</span>
                <span class="fs-5 fw-bold font-monospace text-success">@totalPago.ToString("C2", ptBr)</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-dark border-secondary text-light p-3 text-center h-100 border-warning">
                <span class="text-muted small">Saldo a Pagar</span>
                <span class="fs-5 fw-bold font-monospace text-warning">@totalSaldo.ToString("C2", ptBr)</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-dark border-secondary text-light p-3 text-center h-100 border-danger">
                <span class="text-muted small">Vencido em Aberto</span>
                <span class="fs-5 fw-bold font-monospace text-danger">@totalVencido.ToString("C2", ptBr)</span>
            </div>
        </div>
    </div>

    <!-- Filtros de Pesquisa -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label small text-secondary" for="filtroBusca">Busca (Título, Fornecedor, Doc)</label>
                    <input type="text" id="filtroBusca" name="busca" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@Model.Busca" placeholder="Ex: PAG-000001, NF 123..." />
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label small text-secondary" for="filtroSituacao">Situação</label>
                    <select id="filtroSituacao" name="situacao" class="form-select form-select-sm bg-dark text-light border-secondary">
                        <option value="">Todas</option>
                        <option value="PENDENTE_APROVACAO" selected="@(Model.Situacao == "PENDENTE_APROVACAO")">Pendente Aprovação</option>
                        <option value="APROVADO" selected="@(Model.Situacao == "APROVADO")">Aprovado</option>
                        <option value="PARCIALMENTE_PAGO" selected="@(Model.Situacao == "PARCIALMENTE_PAGO")">Parcialmente Pago</option>
                        <option value="PAGO" selected="@(Model.Situacao == "PAGO")">Pago</option>
                        <option value="CANCELADO" selected="@(Model.Situacao == "CANCELADO")">Cancelado</option>
                    </select>
                </div>
                <div class="col-6 col-md-2 col-lg-2">
                    <label class="form-label small text-secondary" for="filtroVencInicio">Vencimento De</label>
                    <input type="date" id="filtroVencInicio" name="inicio" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@Model.Inicio?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-2 col-lg-2">
                    <label class="form-label small text-secondary" for="filtroVencFim">Vencimento Até</label>
                    <input type="date" id="filtroVencFim" name="fim" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@Model.Fim?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-1 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
                    <a asp-action="TitulosPagar" class="btn btn-sm btn-outline-secondary">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Títulos -->
    <div class="card bg-dark border-secondary text-light">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
            <span class="fw-bold">Títulos a Pagar</span>
            <span class="badge bg-secondary">@Model.Titulos.Count registros</span>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped align-middle mb-0" style="min-width: 900px;">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th scope="col">Número</th>
                        <th scope="col">Fornecedor / Beneficiário</th>
                        <th scope="col">Origem</th>
                        <th scope="col">Doc / Nota</th>
                        <th scope="col">Vencimento</th>
                        <th scope="col">Parcela</th>
                        <th scope="col" class="text-end">Principal</th>
                        <th scope="col" class="text-end">Pago</th>
                        <th scope="col" class="text-end">Saldo</th>
                        <th scope="col">Situação</th>
                        <th scope="col" class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Titulos.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">
                                Nenhum título a pagar encontrado para os filtros selecionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Model.Titulos)
                        {
                            <tr>
                                <td>
                                    <strong class="text-light font-monospace">@t.Numero</strong>
                                </td>
                                <td>
                                    <span class="text-light">@t.Fornecedor</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@t.OrigemTipo</span>
                                </td>
                                <td>@(t.Documento ?? "—")</td>
                                <td>
                                    <span>@t.DataVencimento.ToString("dd/MM/yyyy")</span>
                                    @if (t.Vencido && t.SaldoAberto > 0)
                                    {
                                        <span class="badge bg-danger ms-1">Vencido</span>
                                    }
                                </td>
                                <td>@(t.Parcela)/@(t.TotalParcelas)</td>
                                <td class="text-end font-monospace">@t.ValorPrincipal.ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace text-success">@t.ValorPago.ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace fw-bold @(t.SaldoAberto > 0 ? "text-warning" : "text-muted")">
                                    @t.SaldoAberto.ToString("C2", ptBr)
                                </td>
                                <td>
                                    @if (t.Situacao == "PAGO")
                                    {
                                        <span class="badge bg-success">Pago</span>
                                    }
                                    else if (t.Situacao == "PARCIALMENTE_PAGO")
                                    {
                                        <span class="badge bg-info text-dark">Parcial</span>
                                    }
                                    else if (t.Situacao == "APROVADO")
                                    {
                                        <span class="badge bg-primary">Aprovado</span>
                                    }
                                    else if (t.Situacao == "PENDENTE_APROVACAO")
                                    {
                                        <span class="badge bg-warning text-dark">Pendente</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@t.Situacao</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="TituloPagarDetalhes" asp-route-id="@t.Id" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye me-1"></i> Abrir
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
