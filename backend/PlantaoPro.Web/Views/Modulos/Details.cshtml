@using PlantaoPro.Web.Security
@model PlantaoPro.Web.Models.SaasModuleViewModel
@{ ViewData["Title"] = Model.Nome; ViewData["Subtitle"] = "Detalhes comerciais e de adoção do módulo."; var isGlobal = User.IsInRole(RolesConstants.AdministradorGlobal); }
<div class="pp-page">
    <header class="pp-page-hero"><div class="pp-page-hero__copy"><span class="pp-eyebrow">@Model.Categoria.Replace('_', ' ')</span><h2>@Model.Nome</h2><p>@Model.Descricao</p></div><div class="pp-hero-actions">@if (isGlobal) { <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar módulo</a> }<a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div></header>
    <details class="pp-screen-guide"><summary><span><i class="bi bi-compass"></i><strong>Como usar esta tela</strong></span></summary><div class="pp-screen-guide__body"><p>Revise o preço-base e a adoção. Para habilitar ou bloquear, abra o cliente correspondente e use a área de módulos contratados.</p></div></details>
    <section class="pp-kpi-grid"><article class="pp-kpi-card"><span>Preço base</span><strong>@Model.PrecoBase.ToString("C")</strong><small>por mês</small></article><article class="pp-kpi-card"><span>Clientes ativos</span><strong>@Model.ClientesAtivos</strong><small>contratos habilitados</small></article><article class="pp-kpi-card"><span>Tipo</span><strong>@(Model.Essencial ? "Essencial" : "Opcional")</strong><small>@Model.Status</small></article><article class="pp-kpi-card"><span>Limite padrão</span><strong>@(Model.LimitePadrao?.ToString() ?? "Sem limite")</strong><small>ajustável por contrato</small></article></section>
    <section class="pp-card"><h3>Identificação e integração</h3><dl class="row mb-0"><dt class="col-sm-3">Código</dt><dd class="col-sm-9"><code>@Model.Codigo</code></dd><dt class="col-sm-3">Categoria</dt><dd class="col-sm-9">@Model.Categoria.Replace('_', ' ')</dd><dt class="col-sm-3">Funcionalidades</dt><dd class="col-sm-9"><pre class="mb-0 text-wrap">@Model.FuncionalidadesJson</pre></dd></dl></section>
</div>
