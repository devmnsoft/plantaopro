@{
    ViewData["Title"] = "BI Executivo";
}
<div class="page-header mb-4"><h1>BI Executivo</h1><p class="text-muted">Indicadores estratégicos do SaaS.</p></div>
<div id="bi-status" class="alert alert-warning d-none mb-3" role="alert"></div>
<div class="row g-3 mb-2" id="bi-periodo-fuso">
    <div class="col-md-3"><div class="card border-info"><div class="card-body py-2"><h6 class="mb-0 text-muted">Competência exibida</h6><h5 class="mb-0" id="kpi-periodo">-</h5></div></div></div>
    <div class="col-md-3"><div class="card border-info"><div class="card-body py-2"><h6 class="mb-0 text-muted">Fuso horário aplicado</h6><h5 class="mb-0" id="kpi-fuso">-</h5></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body py-2"><h6 class="mb-0 text-muted">Escalas confirmadas no período</h6><h5 class="mb-0" id="kpi-escalas-periodo">-</h5><p class="small text-muted mb-0">Acumulado (histórico): <span id="kpi-escalas-acumulado">-</span></p></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body py-2"><h6 class="mb-0 text-muted">Valor pago no período</h6><h5 class="mb-0" id="kpi-pago-periodo">-</h5></div></div></div>
</div>
<div class="row g-3">
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Clientes Ativos</h6><h3 id="kpi-clientes">-</h3></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Receita Estimada</h6><h3 id="kpi-receita">-</h3></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Receita Vencida</h6><h3 id="kpi-vencida">-</h3></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Cobertura</h6><h3 id="kpi-cobertura">-</h3></div></div></div>
</div>
<details class="card mt-2 bi-definicoes"><summary class="card-header py-2 bg-transparent d-block"><strong><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Como cada indicador é calculado</strong> <span class="text-muted small">(fórmula · fonte · período · fuso)</span></summary><div class="card-body py-2"><p class="small text-muted mb-2" id="bi-timecriterion"></p><ul class="mb-0 small" id="bi-definicoes"><li class="text-muted">Carregando definições…</li></ul></div></details>
@section Scripts {
<script>
fetch('/api/bi/resumo-executivo').then(r=>{if(!r.ok){throw new Error('bi-resumo-'+r.status);}return r.json();}).then(x=>{const d=x.data||{};document.getElementById('kpi-clientes').innerText=d.totalClientesAtivos??0;document.getElementById('kpi-receita').innerText=(d.receitaMensalEstimada??0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});document.getElementById('kpi-vencida').innerText=(d.receitaVencida??0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});document.getElementById('kpi-cobertura').innerText=((d.percentualCobertura??0).toFixed(1))+'%';document.getElementById('kpi-periodo').innerText=d.periodo??'atual';document.getElementById('kpi-fuso').innerText=d.fuso??'servidor';document.getElementById('kpi-escalas-acumulado').innerText=d.escalasConfirmadas??0;document.getElementById('kpi-escalas-periodo').innerText=d.escalasConfirmadasPeriodo??0;document.getElementById('kpi-pago-periodo').innerText=(d.valorPagoPeriodo??0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});const okBar=document.getElementById('bi-status');if(okBar){okBar.classList.add('d-none');}const tc=document.getElementById('bi-timecriterion');if(tc){tc.textContent=d.timeCriterion||'';}const defsEl=document.getElementById('bi-definicoes');if(defsEl){const esc=s=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');const defs=Array.isArray(d.definicoes)?d.definicoes:[];defsEl.innerHTML=defs.length?defs.map(x=>'<li><strong>'+esc(x.label)+'</strong>: '+esc(x.definicao)+'</li>').join(''):'<li class="text-muted">Sem definições informadas pela fonte para os indicadores.</li>';}}).catch(()=>{['kpi-clientes','kpi-receita','kpi-vencida','kpi-cobertura','kpi-periodo','kpi-fuso','kpi-escalas-acumulado','kpi-escalas-periodo','kpi-pago-periodo'].forEach(id=>{const el=document.getElementById(id);if(el){el.innerText='-';el.classList.add('text-muted');}});const bar=document.getElementById('bi-status');if(bar){bar.classList.remove('d-none');bar.textContent='Indicadores indisponíveis no momento: não foi possível consultar o serviço BI neste instante.';}const tc2=document.getElementById('bi-timecriterion');if(tc2){tc2.textContent='';}const dfl=document.getElementById('bi-definicoes');if(dfl){dfl.innerHTML='<li class="text-muted">Definições indisponíveis no momento.</li>';}});
</script>
}
