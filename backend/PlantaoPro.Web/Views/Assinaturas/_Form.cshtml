@model PlantaoPro.Web.Models.AssinaturaSaasViewModel
<div asp-validation-summary="All" class="pp-error-panel" role="alert" aria-live="assertive" tabindex="-1"></div>
<div class="card shadow-sm border-0">
    <div class="card-body">
        <p class="text-muted">Defina cliente, plano, vigência e condições comerciais da assinatura.</p>
        <div class="row g-3">
            <div class="col-md-6">
                @await Html.PartialAsync("_LookupSelect", new PlantaoPro.Web.Models.LookupSelectViewModel { FieldName = nameof(Model.ClienteId), Label = "Cliente", Endpoint = "/api/clientes", Value = Model.ClienteId == Guid.Empty ? string.Empty : Model.ClienteId.ToString(), Placeholder = "Selecione o cliente pelo nome", HelpText = "Somente clientes reais disponíveis no seu contexto de acesso são listados." })
                <span asp-validation-for="ClienteId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                @await Html.PartialAsync("_LookupSelect", new PlantaoPro.Web.Models.LookupSelectViewModel { FieldName = nameof(Model.PlanoId), Label = "Plano", Endpoint = "/api/planos", Value = Model.PlanoId == Guid.Empty ? string.Empty : Model.PlanoId.ToString(), Placeholder = "Selecione o plano contratado", HelpText = "A lista respeita os planos disponíveis para contratação." })
                <span asp-validation-for="PlanoId" class="text-danger small"></span>
            </div>
            <div class="col-md-4"><label class="form-label form-required" asp-for="DataInicio">Início da vigência</label><input class="form-control" asp-for="DataInicio" type="date" /><span asp-validation-for="DataInicio" class="text-danger small"></span></div>
            <div class="col-md-4"><label class="form-label form-required" asp-for="DataFim">Fim da vigência</label><input class="form-control" asp-for="DataFim" type="date" /><span asp-validation-for="DataFim" class="text-danger small"></span></div>
            <div class="col-md-4"><label class="form-label form-required" asp-for="DiaVencimento">Dia do vencimento</label><input class="form-control" asp-for="DiaVencimento" type="number" min="1" max="31" inputmode="numeric" /><span asp-validation-for="DiaVencimento" class="text-danger small"></span></div>
            <div class="col-md-4"><label class="form-label form-required" asp-for="ValorContratado">Valor contratado</label><div class="input-group"><span class="input-group-text">R$</span><input class="form-control" asp-for="ValorContratado" min="0" max="10000000" step="0.01" inputmode="decimal" /></div><span asp-validation-for="ValorContratado" class="text-danger small"></span></div>
            <div class="col-12"><label class="form-label" asp-for="Observacoes">Observações</label><textarea class="form-control" asp-for="Observacoes" rows="4" maxlength="1000" placeholder="Registre condições comerciais relevantes" aria-describedby="ObservacoesHelp"></textarea><span id="ObservacoesHelp" class="form-help">Não inclua senhas, tokens ou dados pessoais sensíveis.</span><span asp-validation-for="Observacoes" class="text-danger small"></span></div>
        </div>
    </div>
    <div class="card-footer bg-white d-flex gap-2 justify-content-end flex-wrap">
        <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
        <button class="btn btn-primary btn-submit" type="submit"><span data-submit-label>Salvar assinatura</span><span class="spinner-border spinner-border-sm d-none" data-submit-spinner aria-hidden="true"></span></button>
    </div>
</div>
