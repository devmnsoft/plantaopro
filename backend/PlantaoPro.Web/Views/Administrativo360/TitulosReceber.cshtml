@model PlantaoPro.Web.Models.TitulosIndexViewModel
@{
    ViewData["Title"] = "Contas a Receber — Administrativo 360";
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
    var totalPrincipal = Model.Titulos.Sum(t => t.ValorPrincipal);
    var totalRecebido = Model.Titulos.Sum(t => t.ValorRecebido);
    var totalSaldo = Model.Titulos.Sum(t => t.SaldoAberto);
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">Contas a Receber</h2>
            <p class="text-muted small mb-0">Controle financeiro de parcelas, liquidação manual e controle de inadimplência.</p>
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-3"><i class="bi bi-info-circle me-2"></i>Gestão de Títulos Financeiros</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-4 col-lg-2">
                    <strong class="text-light d-block mb-1">Para que serve</strong>
                    Gerencia o ciclo de cobrança das parcelas originadas de cirurgias faturadas.
                </div>
                <div class="col-md-4 col-lg-2">
                    <strong class="text-light d-block mb-1">Quem pode usar</strong>
                    Tesouraria, faturamento e contas a receber.
                </div>
                <div class="col-md-4 col-lg-3">
                    <strong class="text-light d-block mb-1">Como executar</strong>
                    Consulte os títulos pendentes, clique em <em>Abrir Título</em> e informe o valor recebido e a conta bancária de destino.
                </div>
                <div class="col-md-6 col-lg-3">
                    <strong class="text-light d-block mb-1">Efeito da confirmação</strong>
                    Atualiza o saldo do título, gera lançamento no extrato da conta bancária e apropria proporcionalmente a comissão do vendedor.
                </div>
                <div class="col-md-6 col-lg-2">
                    <strong class="text-light d-block mb-1">Próximo passo</strong>
                    Consultar a conciliação bancária em <em>Fluxo de Caixa</em>.
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- Cards de Totais -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card bg-dark border-secondary text-light p-3 text-center">
                <span class="text-muted small">Total Principal</span>
                <span class="fs-5 fw-bold font-monospace">@totalPrincipal.ToString("C2", ptBr)</span>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card bg-dark border-secondary text-light p-3 text-center border-success">
                <span class="text-muted small">Total Recebido</span>
                <span class="fs-5 fw-bold font-monospace text-success">@totalRecebido.ToString("C2", ptBr)</span>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card bg-dark border-secondary text-light p-3 text-center border-warning">
                <span class="text-muted small">Saldo a Receber</span>
                <span class="fs-5 fw-bold font-monospace text-warning">@totalSaldo.ToString("C2", ptBr)</span>
            </div>
        </div>
    </div>

    <!-- Filtros de Pesquisa -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label small text-secondary" for="filtroBusca">Busca (Título, Venda ou Pagador)</label>
                    <input type="text" id="filtroBusca" name="busca" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@Model.Busca" placeholder="Ex: TIT-000001, VEN-..." />
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label small text-secondary" for="filtroSituacao">Situação</label>
                    <select id="filtroSituacao" name="situacao" class="form-select form-select-sm bg-dark text-light border-secondary">
                        <option value="">Todas</option>
                        <option value="EM_ABERTO" selected="@(Model.Situacao == "EM_ABERTO")">Em Aberto</option>
                        <option value="PARCIAL" selected="@(Model.Situacao == "PARCIAL")">Parcial</option>
                        <option value="QUITADO" selected="@(Model.Situacao == "QUITADO")">Quitado</option>
                        <option value="CANCELADO" selected="@(Model.Situacao == "CANCELADO")">Cancelado</option>
                    </select>
                </div>
                <div class="col-6 col-md-2 col-lg-2">
                    <label class="form-label small text-secondary" for="filtroInicio">Vencimento De</label>
                    <input type="date" id="filtroInicio" name="inicio" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@(Model.Inicio?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-6 col-md-2 col-lg-2">
                    <label class="form-label small text-secondary" for="filtroFim">Até</label>
                    <input type="date" id="filtroFim" name="fim" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@(Model.Fim?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-6 col-md-1 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-fill">
                        <i class="bi bi-search me-1"></i> Filtrar
                    </button>
                    <a asp-action="TitulosReceber" class="btn btn-sm btn-outline-secondary">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Títulos -->
    <div class="card bg-dark border-secondary text-light">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
            <span class="fw-bold">Títulos a Receber</span>
            <span class="badge bg-secondary">@Model.Titulos.Count títulos</span>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped align-middle mb-0" style="min-width: 860px;">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th scope="col">Título</th>
                        <th scope="col">Venda</th>
                        <th scope="col">Pagador</th>
                        <th scope="col">Parcela</th>
                        <th scope="col">Vencimento</th>
                        <th scope="col" class="text-end">Principal</th>
                        <th scope="col" class="text-end">Recebido</th>
                        <th scope="col" class="text-end">Saldo Aberto</th>
                        <th scope="col">Situação</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Titulos.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Nenhum título a receber encontrado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Model.Titulos)
                        {
                            <tr>
                                <td class="fw-bold text-info">@t.Numero</td>
                                <td>
                                    <a asp-action="VendaDetalhes" asp-route-id="@t.VendaId" class="text-decoration-none text-light">
                                        @t.VendaNumero
                                    </a>
                                </td>
                                <td>@t.Pagador</td>
                                <td>@t.Parcela / @t.TotalParcelas</td>
                                <td class="@(t.Vencido ? "text-danger fw-bold" : "")">
                                    @t.DataVencimento.ToString("dd/MM/yyyy")
                                    @if (t.Vencido)
                                    {
                                        <span class="badge bg-danger ms-1">Vencido</span>
                                    }
                                </td>
                                <td class="text-end font-monospace">@t.ValorPrincipal.ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace text-success">@t.ValorRecebido.ToString("C2", ptBr)</td>
                                <td class="text-end font-monospace fw-bold @(t.SaldoAberto > 0 ? "text-warning" : "text-muted")">
                                    @t.SaldoAberto.ToString("C2", ptBr)
                                </td>
                                <td>
                                    @if (t.Situacao == "QUITADO")
                                    {
                                        <span class="badge bg-success">Quitado</span>
                                    }
                                    else if (t.Situacao == "PARCIAL")
                                    {
                                        <span class="badge bg-info text-dark">Parcial</span>
                                    }
                                    else if (t.Situacao == "CANCELADO")
                                    {
                                        <span class="badge bg-danger">Cancelado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Em Aberto</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="TituloDetalhes" asp-route-id="@t.Id" class="btn btn-sm btn-outline-info" title="Abrir Título e Registrar Recebimento">
                                        <i class="bi bi-wallet2 me-1"></i> Abrir
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
