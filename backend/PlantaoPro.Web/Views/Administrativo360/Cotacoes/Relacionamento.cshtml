@model PlantaoPro.Web.Models.RelacionamentoMapeamentoViewModel
@{
    ViewData["Title"] = "Mapeamento De/Para — Administrativo 360";
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">
                <i class="bi bi-diagram-3 text-warning me-2"></i>Mapeamento De/Para (Correspondências Externas)
            </h2>
            <p class="text-muted small mb-0">Cadastros persistidos de correspondência entre portais (OPMENEXO, INPART) e entidades do PlantãoPro.</p>
        </div>
        <div>
            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalNovoMapeamento">
                <i class="bi bi-plus-circle me-1"></i> Novo Mapeamento
            </button>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body p-3">
            <form method="get" action="/Administrativo360/Cotacoes/Relacionamento" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-light small">Provedor</label>
                    <select name="provedor" class="form-select form-select-sm bg-dark text-light border-secondary">
                        <option value="">Todos</option>
                        <option value="OPMENEXO" selected="@(Model.Provedor == "OPMENEXO")">OPMENEXO</option>
                        <option value="INPART" selected="@(Model.Provedor == "INPART")">INPART Saúde</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-light small">Tipo de Entidade</label>
                    <select name="tipoEntidade" class="form-select form-select-sm bg-dark text-light border-secondary">
                        <option value="">Todos</option>
                        <option value="PRODUTO" selected="@(Model.TipoEntidade == "PRODUTO")">Produto / Material</option>
                        <option value="HOSPITAL" selected="@(Model.TipoEntidade == "HOSPITAL")">Hospital / Solicitante</option>
                        <option value="MEDICO" selected="@(Model.TipoEntidade == "MEDICO")">Médico</option>
                        <option value="UNIDADE_MEDIDA" selected="@(Model.TipoEntidade == "UNIDADE_MEDIDA")">Unidade de Medida</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-sm btn-primary me-2">
                        <i class="bi bi-filter me-1"></i> Filtrar
                    </button>
                    <a href="/Administrativo360/Cotacoes/Relacionamento" class="btn btn-sm btn-outline-secondary">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela De/Para -->
    <div class="card bg-dark border-secondary">
        <div class="card-header bg-dark border-secondary">
            <h5 class="card-title text-light mb-0 h6">
                Correspondências Cadastradas (@Model.Mapeamentos.Count)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th>Provedor</th>
                            <th>Tipo Entidade</th>
                            <th>Código Externo</th>
                            <th>Descrição Externa</th>
                            <th>Entidade Interna Mapeada</th>
                            <th>Fator Conversão</th>
                            <th>Situação</th>
                            <th>Cadastrado Em</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Mapeamentos.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Nenhuma correspondência cadastrada.
                                </td>
                            </tr>
                        }
                        @foreach (var m in Model.Mapeamentos)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@m.Provedor</span></td>
                                <td><span class="badge bg-info text-dark">@m.TipoEntidade</span></td>
                                <td><code>@m.CodigoExterno</code></td>
                                <td class="text-light">@m.DescricaoExterna</td>
                                <td>
                                    <strong class="text-warning">@m.EntidadeInternaDescricao</strong>
                                    @if (m.EntidadeInternaId.HasValue)
                                    {
                                        <div class="small text-muted font-monospace">@m.EntidadeInternaId</div>
                                    }
                                </td>
                                <td>@m.FatorConversao.ToString("N4")</td>
                                <td>
                                    <span class="badge @(m.Situacao == "ATIVO" ? "bg-success" : "bg-danger")">@m.Situacao</span>
                                </td>
                                <td class="text-muted small">@m.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Novo Mapeamento -->
<div class="modal fade" id="modalNovoMapeamento" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary">
            <form method="post" action="/Administrativo360/Cotacoes/SalvarMapeamento">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title h6" id="modalLabel">Novo Mapeamento De/Para</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small">Provedor</label>
                            <select name="Provedor" class="form-select form-select-sm bg-dark text-light border-secondary">
                                <option value="OPMENEXO">OPMENEXO</option>
                                <option value="INPART">INPART Saúde</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Tipo de Entidade</label>
                            <select name="TipoEntidade" class="form-select form-select-sm bg-dark text-light border-secondary">
                                <option value="PRODUTO">Produto / Material</option>
                                <option value="HOSPITAL">Hospital / Solicitante</option>
                                <option value="MEDICO">Médico</option>
                                <option value="UNIDADE_MEDIDA">Unidade de Medida</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Código Externo</label>
                        <input type="text" name="CodigoExterno" class="form-control form-control-sm bg-dark text-light border-secondary" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Descrição Externa</label>
                        <input type="text" name="DescricaoExterna" class="form-control form-control-sm bg-dark text-light border-secondary" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Descrição Interna (Entidade PlantãoPro)</label>
                        <input type="text" name="EntidadeInternaDescricao" class="form-control form-control-sm bg-dark text-light border-secondary" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <label class="form-label small">ID Interno UUID (Opcional)</label>
                            <input type="text" name="EntidadeInternaId" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="00000000-0000-0000-0000-000000000000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Fator Conversão</label>
                            <input type="number" step="0.0001" name="FatorConversao" class="form-control form-control-sm bg-dark text-light border-secondary" value="1.0000" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-warning">Salvar Mapeamento</button>
                </div>
            </form>
        </div>
    </div>
</div>
