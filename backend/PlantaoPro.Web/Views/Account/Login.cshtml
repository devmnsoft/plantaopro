@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";
}
<div class="login-shell container py-4 auth-experience">
    @await Html.PartialAsync("_ToastMessages")
    <div class="login-card-modern">
        <section class="auth-story" aria-labelledby="authStoryTitle"><img src="~/media/brand/logo-horizontal-color.svg" width="360" height="86" alt="PlantãoPro" /><h1 id="authStoryTitle">Sua operação de saúde, conectada de ponta a ponta.</h1><p>Escalas, assistência e gestão em um ambiente seguro e preparado para decisões em tempo real.</p><img class="auth-illustration" src="~/media/illustrations/login-operations.svg" width="640" height="480" alt="Organização visual da operação médica" /></section>
        <div class="auth-form-panel"><h2>Acesse sua central</h2><p class="text-muted mb-4">Continue de onde parou com segurança.</p>
        <form asp-action="Login" method="post" id="loginForm" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" aria-live="assertive"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label">E-mail</label><input asp-for="Email" class="form-control form-control-lg" autocomplete="username email" inputmode="email" placeholder="voce@empresa.com" /><span asp-validation-for="Email" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="Senha" class="form-label">Senha</label><div class="input-group"><input asp-for="Senha" class="form-control form-control-lg" type="password" id="senha" autocomplete="current-password" placeholder="Sua senha" aria-describedby="capsLockWarning" /><button class="btn btn-outline-secondary" type="button" data-password-toggle aria-label="Mostrar senha" title="Mostrar senha"><app-icon name="View" size="20" /></button></div><div id="capsLockWarning" class="form-text text-warning d-none" aria-live="polite"><app-icon name="Warning" size="18" /> Caps Lock ativado.</div><span asp-validation-for="Senha" class="text-danger small"></span></div>
            <button id="btnLogin" class="btn btn-primary btn-lg w-100" type="submit"><span class="label">Entrar</span><span class="spinner-border spinner-border-sm d-none"></span></button>
            <a asp-action="ForgotPassword" class="d-inline-block mt-3">Esqueci a senha</a>
        </form></div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth-login.js" asp-append-version="true"></script>
}
