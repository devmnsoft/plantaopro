@model PlantaoPro.Web.Models.CadastroSelfServiceWebViewModel
@{
    ViewData["Title"] = "Cadastro self-service";
}
<div class="pp-public-page pp-selfservice-page">
    <header class="pp-selfservice-hero">
        <span class="pp-kicker">Cadastro self-service</span>
        <h1>Crie sua conta PlantãoPro</h1>
        <p>Preencha empresa, plano e administrador para iniciar sua operação médica.</p>
    </header>

    <ol class="pp-stepper" aria-label="Etapas do cadastro">
        <li><strong>1</strong><span>Empresa</span></li><li><strong>2</strong><span>Plano</span></li><li><strong>3</strong><span>Administrador</span></li><li><strong>4</strong><span>Termos e LGPD</span></li><li><strong>5</strong><span>Revisão</span></li>
    </ol>

    <section class="pp-onboarding-shell">
        <aside class="pp-onboarding-summary" aria-labelledby="cadastroResumo">
            <span class="pp-kicker">Implantação guiada</span>
            <h2 id="cadastroResumo">Comece com uma base segura</h2>
            <p>Os dados informados configuram a organização, o acesso administrador e a jornada inicial.</p>
            <ul><li>Ambiente separado por organização</li><li>Administrador responsável identificado</li><li>Consentimentos registrados</li></ul>
        </aside>

        <form asp-controller="Cadastro" asp-action="Confirmar" method="post" class="pp-form pp-onboarding-form" data-focus-invalid data-unsaved-form data-submit-feedback>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert"></div>

            <section class="pp-form-card pp-form-section" aria-labelledby="empresaTitle">
                <div class="pp-form-heading"><span>Etapa 1</span><h2 id="empresaTitle">Empresa</h2><p>Identifique a organização e o porte da operação.</p></div>
                <div class="pp-form-grid">
                    <div class="pp-form-field"><label asp-for="NomeFantasia" class="pp-form-label">Nome fantasia</label><input asp-for="NomeFantasia" class="pp-form-control" autocomplete="organization" /><span asp-validation-for="NomeFantasia" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="RazaoSocial" class="pp-form-label">Razão social</label><input asp-for="RazaoSocial" class="pp-form-control" /><span asp-validation-for="RazaoSocial" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="Cnpj" class="pp-form-label">CNPJ</label><input asp-for="Cnpj" class="pp-form-control" inputmode="numeric" data-mask="cnpj" /><span asp-validation-for="Cnpj" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="Segmento" class="pp-form-label">Segmento</label><input asp-for="Segmento" class="pp-form-control" /><span asp-validation-for="Segmento" class="pp-form-error"></span></div>
                    <div class="pp-form-field pp-form-field--wide"><label asp-for="EmailCorporativo" class="pp-form-label">E-mail corporativo</label><input asp-for="EmailCorporativo" class="pp-form-control" type="email" autocomplete="email" /><span class="pp-form-help">Usaremos este endereço para comunicações sobre a implantação.</span><span asp-validation-for="EmailCorporativo" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="QuantidadeMedicos" class="pp-form-label">Médicos estimados</label><input asp-for="QuantidadeMedicos" class="pp-form-control" inputmode="numeric" /><span asp-validation-for="QuantidadeMedicos" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="QuantidadeHospitais" class="pp-form-label">Unidades</label><input asp-for="QuantidadeHospitais" class="pp-form-control" inputmode="numeric" /><span asp-validation-for="QuantidadeHospitais" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="VolumePlantoesMes" class="pp-form-label">Plantões por mês</label><input asp-for="VolumePlantoesMes" class="pp-form-control" inputmode="numeric" /><span asp-validation-for="VolumePlantoesMes" class="pp-form-error"></span></div>
                </div>
            </section>

            <section class="pp-form-card pp-form-section" aria-labelledby="planoTitle">
                <div class="pp-form-heading"><span>Etapa 2</span><h2 id="planoTitle">Plano</h2><p>Escolha a modalidade adequada à operação.</p></div>
                <div class="pp-form-grid">
                    <div class="pp-form-field"><label asp-for="PlanoId" class="pp-form-label">Plano</label><select asp-for="PlanoId" class="pp-form-control">@foreach (var plano in Model.Planos) { <option value="@plano.Id">@plano.Nome — @(plano.ValorMensal <= 0 ? "Sob proposta" : plano.ValorMensal.ToString("C"))</option> }</select><span asp-validation-for="PlanoId" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="Periodicidade" class="pp-form-label">Periodicidade</label><select asp-for="Periodicidade" class="pp-form-control"><option value="MENSAL">Mensal</option><option value="ANUAL">Anual</option></select><span asp-validation-for="Periodicidade" class="pp-form-error"></span></div>
                </div>
            </section>

            <section class="pp-form-card pp-form-section" aria-labelledby="adminTitle">
                <div class="pp-form-heading"><span>Etapa 3</span><h2 id="adminTitle">Administrador</h2><p>Defina quem conduzirá a configuração inicial.</p></div>
                <div class="pp-form-grid">
                    <div class="pp-form-field"><label asp-for="ResponsavelNome" class="pp-form-label">Nome</label><input asp-for="ResponsavelNome" class="pp-form-control" autocomplete="name" /><span asp-validation-for="ResponsavelNome" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="ResponsavelEmail" class="pp-form-label">E-mail</label><input asp-for="ResponsavelEmail" class="pp-form-control" type="email" autocomplete="email" /><span asp-validation-for="ResponsavelEmail" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="ResponsavelTelefone" class="pp-form-label">Telefone</label><input asp-for="ResponsavelTelefone" class="pp-form-control" inputmode="tel" autocomplete="tel" data-mask="phone" /><span asp-validation-for="ResponsavelTelefone" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="ResponsavelCargo" class="pp-form-label">Cargo</label><input asp-for="ResponsavelCargo" class="pp-form-control" autocomplete="organization-title" /><span asp-validation-for="ResponsavelCargo" class="pp-form-error"></span></div>
                    <div class="pp-form-field pp-form-field--wide"><label asp-for="Senha" class="pp-form-label">Senha</label><input asp-for="Senha" class="pp-form-control" type="password" autocomplete="new-password" /><span class="pp-form-help">Use uma senha exclusiva para este acesso.</span><span asp-validation-for="Senha" class="pp-form-error"></span></div>
                </div>
            </section>

            <section class="pp-form-card pp-form-section" aria-labelledby="termosTitle">
                <div class="pp-form-heading"><span>Etapas 4 e 5</span><h2 id="termosTitle">Termos, LGPD e revisão</h2><p>Revise os dados e confirme os consentimentos antes de finalizar.</p></div>
                <div class="pp-consent-list">
                    <label class="pp-checkbox"><input asp-for="AceiteTermos" /><span>Aceito os termos de uso.</span></label>
                    <label class="pp-checkbox"><input asp-for="AceitePrivacidade" /><span>Aceito a política de privacidade.</span></label>
                    <label class="pp-checkbox"><input asp-for="ConsentimentoLgpd" /><span>Autorizo o tratamento de dados conforme a LGPD.</span></label>
                </div>
                <div class="pp-form-actions pp-form-sticky-footer">
                    <a class="btn btn-outline-secondary" asp-controller="PlanosPublicos" asp-action="Index">Voltar aos planos</a>
                    <button class="btn btn-primary" type="submit">
                        <span data-submit-label>Finalizar cadastro</span>
                        <span class="spinner-border spinner-border-sm d-none" data-submit-spinner aria-hidden="true"></span>
                    </button>
                </div>
            </section>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
