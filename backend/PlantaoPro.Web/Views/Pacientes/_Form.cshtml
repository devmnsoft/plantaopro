@model PlantaoPro.Web.Models.PacienteFormViewModel
<form asp-action="Save" method="post" class="pp-form" novalidate data-focus-invalid data-unsaved-form>
    @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" aria-live="assertive" tabindex="-1"></div>
    <section class="pp-info-banner" role="note"><span class="pp-alert__icon" aria-hidden="true">i</span><div class="pp-alert__content"><strong>Privacidade assistencial</strong><p>Registre somente os dados necessários para o atendimento. O acesso e as alterações ficam disponíveis para auditoria.</p></div></section>
    <section class="pp-form-section" aria-labelledby="patientIdentity"><header class="pp-form-section__header"><app-icon name="User" size="24" /><div><h2 id="patientIdentity">Identificação do paciente</h2><p>Dados usados para localizar corretamente o prontuário e evitar duplicidades.</p></div></header><div class="pp-form-grid">
        <div class="pp-form-field pp-form-field--half"><label asp-for="Nome" class="pp-form-label">Nome completo <span class="pp-required-marker">*</span></label><input asp-for="Nome" class="form-control" autocomplete="name" required/><span asp-validation-for="Nome" class="pp-form-error" data-valmsg-for="Nome"></span></div>
        <div class="pp-form-field pp-form-field--half"><label asp-for="NomeSocial" class="pp-form-label">Nome social</label><input asp-for="NomeSocial" class="form-control" autocomplete="off"/><small class="pp-field-help">Será priorizado na comunicação e no acolhimento.</small></div>
        <div class="pp-form-field pp-form-field--third"><label asp-for="DataNascimento" class="pp-form-label">Data de nascimento</label><input asp-for="DataNascimento" class="form-control" type="date"/></div><div class="pp-form-field pp-form-field--third"><label asp-for="SexoGenero" class="pp-form-label">Sexo/gênero</label><input asp-for="SexoGenero" class="form-control"/></div><div class="pp-form-field pp-form-field--third"><label asp-for="Cpf" class="pp-form-label">CPF</label><input asp-for="Cpf" class="form-control" inputmode="numeric" data-mask="cpf" autocomplete="off"/></div>
        <div class="pp-form-field pp-form-field--half"><label asp-for="Cns" class="pp-form-label">Cartão Nacional de Saúde</label><input asp-for="Cns" class="form-control" inputmode="numeric"/><small class="pp-field-help">Informe apenas números.</small></div>
    </div></section>
    <section class="pp-form-section" aria-labelledby="patientContact"><header class="pp-form-section__header"><app-icon name="User" size="24" /><div><h2 id="patientContact">Contato e responsabilidade</h2><p>Canais para lembretes, orientações e contato do responsável.</p></div></header><div class="pp-form-grid">
        <div class="pp-form-field pp-form-field--half"><label asp-for="Telefone" class="pp-form-label">Telefone</label><input asp-for="Telefone" class="form-control" type="tel" inputmode="tel" data-mask="phone" autocomplete="tel"/></div><div class="pp-form-field pp-form-field--half"><label asp-for="Email" class="pp-form-label">E-mail</label><input asp-for="Email" class="form-control" type="email" inputmode="email" autocomplete="email"/></div><div class="pp-form-field"><label asp-for="Endereco" class="pp-form-label">Endereço</label><input asp-for="Endereco" class="form-control" autocomplete="street-address"/></div><div class="pp-form-field pp-form-field--half"><label asp-for="ResponsavelNome" class="pp-form-label">Responsável</label><input asp-for="ResponsavelNome" class="form-control"/></div>
        <div class="pp-form-field"><div class="form-check"><input asp-for="ConsentimentoLgpd" class="form-check-input"/><label asp-for="ConsentimentoLgpd" class="form-check-label">Consentimento LGPD registrado</label></div><span asp-validation-for="ConsentimentoLgpd" class="pp-form-error" data-valmsg-for="ConsentimentoLgpd"></span></div>
    </div></section>
    <footer class="pp-form-sticky-footer"><div class="pp-form-status"><app-icon name="Security" size="18" /><span>Dados protegidos e alterações auditadas.</span></div><div class="pp-form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary" type="submit"><app-icon name="Check" size="18" /> Salvar paciente</button></div></footer>
</form>
