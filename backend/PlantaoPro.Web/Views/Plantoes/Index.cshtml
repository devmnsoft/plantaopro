@model PlantaoPro.Web.Models.ListPageViewModel<PlantaoPro.Web.Models.PlantaoResumoDto>
@{ ViewData["Title"] = "Plantões"; var items = Model?.Items ?? Enumerable.Empty<PlantaoPro.Web.Models.PlantaoResumoDto>(); }
<partial name="_PageIntroduction" model='new PlantaoPro.Web.Models.PageIntroductionViewModel(
    "Plantões",
    "Crie, publique e acompanhe oportunidades de plantão, vagas disponíveis, cobertura e situação operacional.",
    "Centralize a cobertura e reduza conflitos antes da publicação.",
    "Novo plantão", "Create", "Plantoes",
    new[] { "Cadastre hospital, especialidade, período, vagas e valor.", "Publique o plantão e convide profissionais.", "Confirme as escalas e acompanhe a realização.", "Conclua o fechamento operacional e financeiro." })' />
<form method="get" class="pp-section-card pp-filter-actions mb-3" role="search" aria-label="Filtrar plantões">
    <div><label class="form-label" for="plantaoSearch">Hospital ou cidade</label><input class="form-control" id="plantaoSearch" name="hospital" value="@Context.Request.Query["hospital"]" /></div>
    <div><label class="form-label" for="plantaoStatus">Status</label><select class="form-select" id="plantaoStatus" name="status"><option value="">Todos</option><option value="ABERTO">Aberto</option><option value="CONFIRMADO">Confirmado</option><option value="REALIZADO">Realizado</option></select></div>
    <button class="btn btn-primary" type="submit">Aplicar filtros</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Limpar filtros</a>
    <span class="ms-auto text-muted" role="status">@(Model?.Total ?? 0) resultado(s)</span>
</form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0 pp-responsive-table"><thead class="table-light"><tr><th>Hospital</th><th>Especialidade</th><th>Período</th><th>Valor</th><th>Vagas</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody>
@if(items.Any()){foreach(var p in items){
    var disponibilidadeCritica = p.Vagas > 0 && p.VagasDisponiveis <= Math.Max(1, (int)Math.Ceiling(p.Vagas * 0.25m));
<tr><td><div class="fw-semibold">@p.HospitalNome</div><div class="text-muted small">@p.HospitalCidade/@p.HospitalEstado</div></td><td>@p.EspecialidadeNome</td><td><div>@p.DataInicio.ToString("dd/MM/yyyy HH:mm")</div><div class="text-muted small">até @p.DataFim.ToString("dd/MM/yyyy HH:mm")</div></td><td>@p.Valor.ToString("C")</td><td><span class="badge @(disponibilidadeCritica ? "text-bg-warning" : "text-bg-light border")">@p.VagasDisponiveis/@p.Vagas</span>@if(disponibilidadeCritica){<div class="small text-warning-emphasis mt-1"><i class="bi bi-exclamation-triangle"></i> Vagas limitadas</div>}</td><td><partial name="_StatusBadge" model="p.Status" /></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@p.Id">Detalhes</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Editar</a> <span class="pp-locked-action"><button class="btn btn-sm btn-outline-danger" disabled aria-describedby="cancelReason-@p.Id">Cancelar</button><span id="cancelReason-@p.Id">Disponível no detalhe quando o status permitir.</span></span></td></tr>}} else {<tr><td colspan="7" class="py-5"><partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-calendar-x","Nenhum plantão encontrado","Crie um novo plantão para começar a alocação.","Novo Plantão","Create","Plantoes")' /></td></tr>}
</tbody></table></div><div class="card-footer bg-white"><partial name="_Pagination" model="Model" /></div></div>
