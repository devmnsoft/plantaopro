@model IReadOnlyList<PlantaoPro.Web.Models.CirurgiaResumoViewModel>
@{
    ViewData["Title"] = "Cirurgias Operacionais — Administrativo 360";
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">Cirurgias Operacionais</h2>
            <p class="text-muted small mb-0">Coordenação logística de procedimentos cirúrgicos, cronograma no hospital e despacho de kits consignados.</p>
        </div>
        <div>
            <a asp-action="CirurgiaNova" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Agendar Cirurgia
            </a>
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-2"><i class="bi bi-info-circle me-2"></i>Como funciona a Cirurgia Logística</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">1. Para que serve</strong>
                    Controlar o agendamento hospitalar do procedimento, integrando o orçamento aprovado com o local de custódia e destino do material.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">2. Como utilizar</strong>
                    Cadastre ou selecione uma cirurgia vinculada ao orçamento aprovado. Ajustes na data revalidam a validade dos lotes reservados.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">3. Efeito da confirmação</strong>
                    A cirurgia agendada habilita a criação dos Vales de Consignação e orienta a separação de materiais na expedição.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">4. Próxima ação</strong>
                    Emitir o vale de consignação para os materiais reservados, realizar a separação e conferência de saída.
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-secondary">Busca (Número, Procedimento ou Hospital)</label>
                    <input type="text" name="busca" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@ViewBag.Busca" placeholder="Ex: CIR-000001, Artroplastia..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-secondary">Situação</label>
                    <select name="situacao" class="form-select form-select-sm bg-dark text-light border-secondary">
                        <option value="">Todas as situações</option>
                        <option value="AGENDADA" selected="@(ViewBag.Situacao == "AGENDADA")">Agendada</option>
                        <option value="EM_ANDAMENTO" selected="@(ViewBag.Situacao == "EM_ANDAMENTO")">Em Andamento</option>
                        <option value="REALIZADA" selected="@(ViewBag.Situacao == "REALIZADA")">Realizada</option>
                        <option value="CANCELADA" selected="@(ViewBag.Situacao == "CANCELADA")">Cancelada</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-secondary">De</label>
                    <input type="date" name="inicio" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@(ViewBag.Inicio != null ? ((DateOnly)ViewBag.Inicio).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-secondary">Até</label>
                    <input type="date" name="fim" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@(ViewBag.Fim != null ? ((DateOnly)ViewBag.Fim).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-outline-info w-100" title="Filtrar">
                        <i class="bi bi-search"></i>
                    </button>
                    <a asp-action="Cirurgias" class="btn btn-sm btn-outline-secondary" title="Limpar filtros">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Cirurgias -->
    <div class="card bg-dark border-secondary text-light">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped align-middle mb-0">
                    <thead class="table-secondary text-secondary small">
                        <tr>
                            <th>Número</th>
                            <th>Data & Hora</th>
                            <th>Hospital</th>
                            <th>Procedimento</th>
                            <th>Médico</th>
                            <th>Orçamento</th>
                            <th>Destino (Custódia)</th>
                            <th>Situação</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    Nenhuma cirurgia operacional encontrada com os filtros informados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var c in Model)
                            {
                                var badgeClass = c.Situacao switch
                                {
                                    "AGENDADA" => "bg-primary",
                                    "EM_ANDAMENTO" => "bg-warning text-dark",
                                    "REALIZADA" => "bg-success",
                                    "CANCELADA" => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td class="fw-bold">
                                        <a asp-action="CirurgiaDetalhes" asp-route-id="@c.Id" class="text-info text-decoration-none">
                                            @c.Numero
                                        </a>
                                    </td>
                                    <td>
                                        @c.DataPrevista.ToString("dd/MM/yyyy")
                                        @if (c.HoraPrevista.HasValue)
                                        {
                                            <span class="text-muted d-block small">@c.HoraPrevista.Value.ToString("HH:mm")</span>
                                        }
                                    </td>
                                    <td>@c.Hospital</td>
                                    <td>@c.Procedimento</td>
                                    <td>@(string.IsNullOrWhiteSpace(c.Medico) ? "—" : c.Medico)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(c.OrcamentoNumero))
                                        {
                                            <span class="badge bg-secondary">@c.OrcamentoNumero</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@c.LocalDestino</td>
                                    <td>
                                        <span class="badge @badgeClass">@c.Situacao</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="CirurgiaDetalhes" asp-route-id="@c.Id" class="btn btn-outline-info" title="Detalhes da Cirurgia">
                                                <i class="bi bi-eye"></i> Detalhes
                                            </a>
                                            @if (c.Situacao == "AGENDADA")
                                            {
                                                <a asp-action="ValeNovo" asp-route-cirurgiaId="@c.Id" class="btn btn-outline-warning" title="Gerar Vale de Consignação">
                                                    <i class="bi bi-box-arrow-right"></i> Criar Vale
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
