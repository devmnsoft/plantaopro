@{
    ViewData["Title"] = "Atendimento médico";
    var consultaId = ViewData["ConsultaId"];
}
<link rel="stylesheet" href="~/css/design-system/clinical-workspace.css" asp-append-version="true" />
<main class="clinical-workspace" data-clinical-workspace data-consulta-id="@consultaId" data-versao="@ViewData["Versao"]">
    <header class="patient-context" aria-label="Contexto do paciente">
        <p class="text-uppercase text-primary fw-semibold small">Prontuário médico</p>
        <h1>Atendimento em curso</h1>
        <p>Os dados de identificação, alergias, plano, risco e espera são carregados do workspace protegido da consulta.</p>
    </header>
    <div class="clinical-grid">
        <nav class="clinical-nav" aria-label="Seções do prontuário">
            <a href="#anamnese">Anamnese</a><a href="#exame-fisico">Exame físico</a><a href="#diagnostico">Diagnóstico</a>
            <a href="#conduta">Conduta</a><a asp-controller="Prescricoes" asp-action="Editor" asp-route-consultaId="@consultaId">Prescrição</a>
        </nav>
        <form novalidate>
            <section id="anamnese" class="consultation-section"><label for="anamnese-field">Anamnese</label><textarea id="anamnese-field" name="anamnese" maxlength="12000"></textarea></section>
            <section id="exame-fisico" class="consultation-section"><label for="exame-field">Exame físico</label><textarea id="exame-field" name="exameFisico" maxlength="12000"></textarea></section>
            <section id="diagnostico" class="consultation-section"><label for="hipotese-field">Hipótese diagnóstica</label><textarea id="hipotese-field" name="hipoteseDiagnostica"></textarea><label for="diagnostico-field">Diagnóstico</label><textarea id="diagnostico-field" name="diagnostico"></textarea></section>
            <section id="conduta" class="consultation-section"><label for="conduta-field">Conduta</label><textarea id="conduta-field" name="conduta"></textarea><label for="orientacoes-field">Orientações</label><textarea id="orientacoes-field" name="orientacoes"></textarea><label for="observacoes-field">Observações</label><textarea id="observacoes-field" name="observacoes"></textarea></section>
        </form>
    </div>
    <footer class="sticky-clinical-actions"><a asp-action="Index" class="btn btn-outline-secondary">Voltar para fila</a><span class="save-status" data-save-status aria-live="polite">Alterações não salvas</span><button type="button" class="btn btn-primary" data-action="save">Salvar rascunho</button><button type="button" class="btn btn-success" data-action="finalize">Finalizar consulta</button></footer>
</main>
<dialog id="finalizationChecklistModal" aria-labelledby="finalization-title"><h2 id="finalization-title">Conferir finalização</h2><ul data-finalization-pending></ul><form method="dialog"><button type="submit">Voltar</button></form><button type="button" data-confirm-finalization>Confirmar finalização</button></dialog>
<dialog id="concurrencyConflictModal" aria-labelledby="conflict-title"><h2 id="conflict-title">Este atendimento foi atualizado</h2><p>Recarregue os dados antes de salvar novamente para não perder informações.</p><button type="button" data-action="reload">Recarregar</button></dialog>
<script src="~/js/clinical-workspace.js" asp-append-version="true"></script>
