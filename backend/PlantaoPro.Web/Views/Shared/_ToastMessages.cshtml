@using System.Text.Json

@{
    var toasts = new List<object>();

    // Chave canônica primeiro; "SuccessMessage"/"ErrorMessage" são aliases
    // herdados de 15 ações financeiras/comerciais (Financeiro.cs, Vendas.cs,
    // AssinaturasController, CommercialDemoWebController) que escreveram com
    // esse nome antes da consolidação do contrato de toast. A unificação
    // dos pontos de escrita fica no backlog pós-MVP.
    static string? Pick(Microsoft.AspNetCore.Mvc.ViewFeatures.ITempDataDictionary tempData, params string[] keys)
    {
        foreach (var key in keys)
        {
            if (tempData[key] is string value && !string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        return null;
    }

    var successMessage = Pick(TempData, "Success", "SuccessMessage");

    if (successMessage != null)
    {
        toasts.Add(new { Type = "success", Message = successMessage });
    }

    var errorMessage = Pick(TempData, "Error", "ErrorMessage");

    if (errorMessage != null)
    {
        toasts.Add(new { Type = "error", Message = errorMessage });
    }

    if (TempData["Warning"] is string warning && !string.IsNullOrWhiteSpace(warning))
    {
        toasts.Add(new { Type = "warning", Message = warning });
    }

    if (TempData["Info"] is string info && !string.IsNullOrWhiteSpace(info))
    {
        toasts.Add(new { Type = "info", Message = info });
    }

    var toastJson = JsonSerializer.Serialize(toasts);
}

@if (toasts.Count > 0)
{
    <script type="application/json" id="pp-toast-data" data-visual-tone="calm">@Html.Raw(toastJson)</script>
    <script>
        window.addEventListener('DOMContentLoaded', function () {
            const el = document.getElementById('pp-toast-data');

            if (!el || !window.PlantaoProToast) {
                return;
            }

            let parsedToasts = new Array();

            try {
                parsedToasts = JSON.parse(el.textContent || 'null') || new Array();
            } catch (e) {
                parsedToasts = new Array();
            }

            parsedToasts.forEach(function (toast) {
                if (!toast) {
                    return;
                }

                const type = String(toast.type || toast.Type || 'info').toLowerCase();
                const message = toast.message || toast.Message || '';

                if (!message) {
                    return;
                }

                if (typeof window.PlantaoProToast[type] === 'function') {
                    window.PlantaoProToast[type](message);
                } else {
                    window.PlantaoProToast.info(message);
                }
            });
        });
    </script>
}
