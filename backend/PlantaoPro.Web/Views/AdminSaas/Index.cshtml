@model CommercialDemoPageViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Subtitle"] = Model.Subtitle;
    var cards = Model.Cards?.ToArray() ?? Array.Empty<CommercialCardViewModel>();
    var checklist = Model.Checklist?.ToArray() ?? Array.Empty<string>();
}
<div class="pp-page pp-admin-saas-page">
    <section class="pp-page-hero pp-admin-hero" aria-labelledby="adminSaasTitle">
        <div class="pp-page-hero__copy">
            <span class="pp-eyebrow">Cockpit SaaS</span>
            <h2 id="adminSaasTitle">Governança do ambiente</h2>
            <p>@Model.Subtitle</p>
        </div>
        <div class="pp-hero-actions" aria-label="Ações rápidas">
            <a class="btn btn-outline-primary" asp-controller="Planos" asp-action="Index"><app-icon name="Settings" size="18" /> Planos e limites</a>
            <a class="btn btn-primary" asp-controller="Onboarding" asp-action="NovoCliente"><app-icon name="Hospital" size="18" /> Iniciar onboarding</a>
        </div>
    </section>

    <section class="pp-kpi-grid pp-kpi-grid--admin" aria-label="Resumo da administração SaaS">
        <article class="pp-kpi-card"><span>Áreas disponíveis</span><strong>@cards.Length</strong><small>Atalhos retornados para o seu perfil</small></article>
        <article class="pp-kpi-card"><span>Frentes para revisão</span><strong>@checklist.Length</strong><small>Itens de configuração disponíveis</small></article>
        <article class="pp-kpi-card"><span>Tenant</span><strong>Contexto atual</strong><small>Consulte o contexto seguro exibido na topbar</small></article>
        <article class="pp-kpi-card"><span>Plano e uso</span><strong>Dados do ambiente</strong><small>Consulte limites sem estimativas ou dados fictícios</small></article>
    </section>

    <section class="pp-admin-layout">
        <div class="pp-admin-main">
        <section class="pp-section" aria-labelledby="saasAreasTitle">
            <div class="pp-section-heading"><div><span class="pp-eyebrow">Organização</span><h2 id="saasAreasTitle">Áreas de gestão</h2><p>Abra a fonte responsável por planos, billing, white label, módulos ou auditoria.</p></div></div>
            @if (cards.Length == 0)
            {
                <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-grid", "Nenhuma área disponível", "Seu perfil ainda não recebeu atalhos administrativos.")' />
            }
            else
            {
                <div class="pp-clinical-grid">
                    @foreach (var card in cards)
                    {
                        <article class="pp-action-card">
                            <span class="pp-icon-surface" aria-hidden="true"><app-icon name="Settings" size="22" /></span>
                            <h3>@card.Title</h3><p>@card.Description</p>
                            <div class="pp-card-actions"><a class="btn btn-outline-primary" asp-controller="@card.ActionController" asp-action="@card.ActionName">@card.ActionText <app-icon name="ChevronRight" size="17" /></a></div>
                        </article>
                    }
                </div>
            }
        </section>
        </div>

        <aside class="pp-section pp-admin-side pp-admin-review" aria-labelledby="adminReviewTitle">
            <div class="pp-section-heading"><div><span class="pp-eyebrow">Onboarding e conformidade</span><h2 id="adminReviewTitle">Revisões necessárias</h2><p>Valide as configurações reais antes de ampliar a operação.</p></div></div>
            @if (checklist.Length == 0)
            {
                <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-check2-circle", "Sem revisões disponíveis", "Não há itens de onboarding retornados neste momento.")' />
            }
            else
            {
                <div class="pp-checklist-grid">
                    @foreach (var item in checklist)
                    {
                        <article class="pp-checklist-card">
                            <div class="pp-checklist-card__head"><span class="pp-icon-surface" aria-hidden="true"><app-icon name="Check" size="20" /></span><h3>@item</h3></div>
                            <p>Abra a implantação para conferir responsáveis, evidências e pendências.</p>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Implantacao" asp-action="Index">Revisar configuração</a>
                        </article>
                    }
                </div>
            }
            <nav class="pp-admin-shortcuts" aria-label="Governança e configuração">
                <a asp-controller="Parametrizacoes" asp-action="WhiteLabel">White label</a>
                <a asp-controller="FaturamentoSaas" asp-action="Index">Billing</a>
                <a asp-controller="Lgpd" asp-action="Index">LGPD</a>
                <a asp-controller="Auditoria" asp-action="Index">Auditoria</a>
            </nav>
        </aside>
    </section>
</div>
