@model PlantaoPro.Web.Models.CentralAtendimentoViewModel
@{
    ViewData["Title"] = "Central de Atendimento";
    ViewData["Subtitle"] = "Acompanhe a jornada assistencial e atue nas prioridades do dia.";
}
<section class="container-fluid pp-operation-page" aria-labelledby="central-title">
    <header class="pp-operation-header">
        <div class="pp-operation-header__copy">
            <span class="eyebrow">Operação assistencial</span>
            <h1 id="central-title">Central de Atendimento</h1>
            <p>Recepção, chamada, triagem e consulta em uma visão única, com a próxima ação sempre visível.</p>
        </div>
        <div class="pp-data-source" role="status">Dados da operação em @Model.Data.ToString("dd/MM/yyyy")</div>
    </header>

    <form method="get" class="pp-filter-panel" aria-labelledby="filter-title">
        <h2 id="filter-title" class="pp-filter-panel__title">Refinar fila</h2>
        <div class="row g-3 align-items-end">
            <div class="col-6 col-lg"><label class="form-label" for="data">Data</label><input class="form-control" id="data" name="data" type="date" value="@Model.Data.ToString("yyyy-MM-dd")" /></div>
            <div class="col-6 col-lg"><label class="form-label" for="status">Status</label><input class="form-control" id="status" name="status" value="@Model.Status" /></div>
            <div class="col-6 col-lg"><label class="form-label" for="prioridade">Prioridade</label><input class="form-control" id="prioridade" name="prioridade" value="@Model.Prioridade" /></div>
            <div class="col-6 col-lg"><label class="form-label" for="paciente">Paciente</label><input class="form-control" id="paciente" name="paciente" value="@Model.Paciente" /></div>
            <div class="col-12 col-lg-auto"><button type="submit" class="btn btn-primary w-100">Aplicar filtros</button></div>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert"><strong>Não foi possível atualizar toda a fila.</strong><div>@Model.ErrorMessage</div></div>
    }
    <div class="pp-kpi-grid" aria-label="Indicadores da operação">
        <article class="pp-kpi-card"><span class="pp-kpi-card__label">Agendados</span><strong class="pp-kpi-card__value">@Model.Kpis.TotalAgendado</strong><span class="pp-kpi-card__context">Previsão total do dia</span></article>
        <article class="pp-kpi-card"><span class="pp-kpi-card__label">Presentes</span><strong class="pp-kpi-card__value">@Model.Kpis.Presentes</strong><span class="pp-kpi-card__context">Check-ins realizados</span></article>
        <article class="pp-kpi-card pp-kpi-card--attention"><span class="pp-kpi-card__label">Aguardando</span><strong class="pp-kpi-card__value">@Model.Kpis.PacientesAguardando</strong><span class="pp-kpi-card__context">Na fila neste momento</span></article>
        <article class="pp-kpi-card pp-kpi-card--critical"><span class="pp-kpi-card__label">Atrasos</span><strong class="pp-kpi-card__value">@Model.Kpis.AtrasosAcimaLimite</strong><span class="pp-kpi-card__context">Acima do limite esperado</span></article>
    </div>

    <div class="pp-workboard" data-refresh-url="@Url.Action("Index", "CentralAtendimento")">
        @foreach (var grupo in Model.Grupos)
        {
            <article class="pp-workboard__lane" aria-labelledby="grupo-@grupo.Status">
                <header class="pp-workboard__header"><h2 id="grupo-@grupo.Status">@grupo.Titulo</h2><span class="badge bg-secondary" aria-label="@grupo.Itens.Count() itens">@grupo.Itens.Count()</span></header>
                <div class="list-group list-group-flush">
                    @if (!grupo.Itens.Any())
                    {
                        <div class="pp-empty-compact"><div><strong>Fila livre neste status</strong><div>Nenhum paciente requer ação agora.</div></div></div>
                    }
                    @foreach (var item in grupo.Itens)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex justify-content-between gap-2"><strong>@(string.IsNullOrWhiteSpace(item.NomeSocial) ? item.Paciente : item.NomeSocial)</strong><span class="badge bg-info text-dark">@item.Prioridade</span></div>
                            <div class="small text-muted mt-1">@item.Horario.ToString("HH:mm") · @item.TempoEsperaMinutos min · @item.Medico</div>
                            <div class="small mt-1">@item.Especialidade · @item.Unidade · @item.Sala · @item.Convenio</div>
                            <a class="btn btn-sm btn-outline-primary mt-3" asp-controller="Agendamentos" asp-action="Details" asp-route-id="@item.AgendamentoId">@item.ProximaAcaoPermitida</a>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
</section>
