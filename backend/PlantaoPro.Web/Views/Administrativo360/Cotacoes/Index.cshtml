@model PlantaoPro.Web.Models.CotacoesIndexViewModel
@{
    ViewData["Title"] = UiText.L("Adm360.Cotacoes.PageTitle");
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">
                <i class="bi bi-inbox-fill text-warning me-2"></i>@UiText.L("Adm360.Cotacoes.Heading")
            </h2>
            <p class="text-muted small mb-0">@UiText.L("Adm360.Cotacoes.Subheading")</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Administrativo360/Cotacoes/Relacionamento" class="btn btn-outline-warning">
                <i class="bi bi-diagram-3 me-1"></i> @UiText.L("Adm360.Cotacoes.ButtonDeParaGeral")
            </a>
            <a href="/Administrativo360/Cotacoes/ContasPortal" class="btn btn-outline-light">
                <i class="bi bi-gear me-1"></i> @UiText.L("Adm360.Cotacoes.ButtonConfigContas")
            </a>
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-warning h6 mb-2"><i class="bi bi-info-circle me-2"></i>@UiText.L("Adm360.Cotacoes.GuideTitle")</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">1. @UiText.L("Adm360.Cotacoes.GuideStep1Title")</strong>
                    @UiText.L("Adm360.Cotacoes.GuideStep1Body")
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">2. @UiText.L("Adm360.Cotacoes.GuideStep2Title")</strong>
                    @UiText.L("Adm360.Cotacoes.GuideStep2Body")
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">3. @UiText.L("Adm360.Cotacoes.GuideStep3Title")</strong>
                    @UiText.L("Adm360.Cotacoes.GuideStep3Body")
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">4. @UiText.L("Adm360.Cotacoes.GuideStep4Title")</strong>
                    @UiText.L("Adm360.Cotacoes.GuideStep4Body")
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Erro))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.Erro
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@UiText.L("Implantacao.CloseAria")"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body p-3">
            <form method="get" action="/Administrativo360/Cotacoes" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-light small">@UiText.L("Adm360.LabelProvedor")</label>
                    <select name="provedor" class="form-select form-select-sm bg-dark text-light border-secondary" aria-label="Provedor">
                        <option value="">@UiText.L("Adm360.Cotacoes.OptAllPortals")</option>
                        <option value="OPMENEXO" selected="@(Model.Provedor == "OPMENEXO")">OPMENEXO</option>
                        <option value="INPART" selected="@(Model.Provedor == "INPART")">INPART Saúde</option>
                        <option value="IMPORTACAO_MANUAL" selected="@(Model.Provedor == "IMPORTACAO_MANUAL")">@UiText.L("Adm360.Cotacoes.OptManualImport")</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-light small">@UiText.L("Adm360.LabelStatusInterno")</label>
                    <select name="status" class="form-select form-select-sm bg-dark text-light border-secondary" aria-label="Status">
                        <option value="">@UiText.L("Adm360.Cotacoes.OptAllStatuses")</option>
                        <option value="RECEBIDA" selected="@(Model.Status == "RECEBIDA")">@UiText.L("Adm360.Cotacoes.StatusRecebida")</option>
                        <option value="EM_RELACIONAMENTO" selected="@(Model.Status == "EM_RELACIONAMENTO")">@UiText.L("Adm360.Cotacoes.StatusEmRelacionamento")</option>
                        <option value="EM_ORCAMENTO" selected="@(Model.Status == "EM_ORCAMENTO")">@UiText.L("Adm360.Cotacoes.StatusEmOrcamento")</option>
                        <option value="AGUARDANDO_APROVACAO" selected="@(Model.Status == "AGUARDANDO_APROVACAO")">@UiText.L("Adm360.Cotacoes.StatusAguardandoAprovacao")</option>
                        <option value="PRONTA_PARA_ENVIO" selected="@(Model.Status == "PRONTA_PARA_ENVIO")">@UiText.L("Adm360.Cotacoes.StatusProntaEnvio")</option>
                        <option value="RESPONDIDA" selected="@(Model.Status == "RESPONDIDA")">@UiText.L("Adm360.Cotacoes.StatusRespondida")</option>
                        <option value="EXPIRADA" selected="@(Model.Status == "EXPIRADA")">@UiText.L("Adm360.Cotacoes.StatusExpirada")</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-sm btn-primary me-2">
                        <i class="bi bi-filter me-1"></i> @UiText.L("Adm360.ButtonFiltrar")
                    </button>
                    <a href="/Administrativo360/Cotacoes" class="btn btn-sm btn-outline-secondary">@UiText.L("Adm360.ButtonLimpar")</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Cotações -->
    <div class="card bg-dark border-secondary">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
            <h5 class="card-title text-light mb-0 h6">
                <i class="bi bi-list-task me-2"></i>@UiText.L("Adm360.Cotacoes.RegisteredTitle") (@Model.Cotacoes.Count)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th>@UiText.L("Adm360.LabelProvedor")</th>
                            <th>@UiText.L("Adm360.Cotacoes.ThIdExternalRev")</th>
                            <th>@UiText.L("Adm360.Cotacoes.ThHospitalRequester")</th>
                            <th>@UiText.L("Adm360.Cotacoes.ThProcedure")</th>
                            <th>@UiText.L("Adm360.Cotacoes.ThResponseDeadline")</th>
                            <th>@UiText.L("Adm360.Cotacoes.ThItems")</th>
                            <th>@UiText.L("Adm360.LabelStatusInterno")</th>
                            <th>@UiText.L("Adm360.Cotacoes.ThQuote")</th>
                            <th class="text-end">@UiText.L("Shift.ThActions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Cotacoes.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-white-50">
                                    @UiText.L("Adm360.Cotacoes.EmptyState")
                                </td>
                            </tr>
                        }
                        @foreach (var c in Model.Cotacoes)
                        {
                            var expirado = c.PrazoResposta < DateTime.UtcNow && c.StatusInterno != "RESPONDIDA";
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">@c.Provedor</span>
                                </td>
                                <td>
                                    <strong class="text-light">@c.IdentificadorExterno</strong>
                                    <span class="badge bg-dark border border-secondary ms-1">v@(c.RevisaoExterna)</span>
                                    <div class="small text-white-50">@c.Origem</div>
                                </td>
                                <td>
                                    <div class="text-light">@c.HospitalNome</div>
                                </td>
                                <td>
                                    <span class="text-white-50 small">@(c.Procedimento ?? UiText.L("Adm360.Cotacoes.NotSpecified"))</span>
                                </td>
                                <td>
                                    <div class="@(expirado ? "text-danger fw-bold" : "text-light")">
                                        @c.PrazoResposta.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                    @if (expirado)
                                    {
                                        <span class="badge bg-danger small">@UiText.L("Adm360.Cotacoes.BadgeDeadlineExpired")</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">@c.TotalItens @UiText.L("Adm360.Cotacoes.UnitItems")</span>
                                    @if (c.ItensPendentes > 0)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">@c.ItensPendentes @UiText.L("Adm360.Cotacoes.UnitPending")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success ms-1">@UiText.L("Adm360.Cotacoes.BadgeMatchingComplete")</span>
                                    }
                                </td>
                                <td>
                                    @switch (c.StatusInterno)
                                    {
                                        case "RECEBIDA":
                                            <span class="badge bg-secondary">@UiText.L("Adm360.Cotacoes.StatusRecebida")</span>
                                            break;
                                        case "EM_RELACIONAMENTO":
                                            <span class="badge bg-warning text-dark">@UiText.L("Adm360.Cotacoes.StatusEmRelacionamento")</span>
                                            break;
                                        case "EM_ORCAMENTO":
                                            <span class="badge bg-primary">@UiText.L("Adm360.Cotacoes.StatusEmOrcamento")</span>
                                            break;
                                        case "AGUARDANDO_APROVACAO":
                                            <span class="badge bg-info text-dark">@UiText.L("Adm360.Cotacoes.StatusAguardandoAprovacao")</span>
                                            break;
                                        case "PRONTA_PARA_ENVIO":
                                            <span class="badge bg-success">@UiText.L("Adm360.Cotacoes.StatusBadgeProntaEnvio")</span>
                                            break;
                                        case "RESPONDIDA":
                                            <span class="badge bg-success">@UiText.L("Adm360.Cotacoes.StatusRespondida")</span>
                                            break;
                                        case "EXPIRADA":
                                            <span class="badge bg-danger">@UiText.L("Adm360.Cotacoes.StatusExpirada")</span>
                                            break;
                                        default:
                                            <span class="badge bg-dark border">@c.StatusInterno</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (c.OrcamentoId.HasValue)
                                    {
                                        <span class="badge bg-outline-info text-info border border-info">@UiText.L("Adm360.Cotacoes.QuoteLinked")</span>
                                    }
                                    else
                                    {
                                        <span class="text-white-50 small">@UiText.L("Adm360.Cotacoes.QuotePending")</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Administrativo360/Cotacoes/Detalhes/@c.Id" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-eye me-1"></i> @UiText.L("Adm360.Cotacoes.ButtonOpenQuote")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
