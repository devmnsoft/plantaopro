@{
    ViewData["Title"] = "Não encontrado";
}
<section class="pp-error-page" aria-labelledby="notFoundTitle">
    <span class="pp-error-page__icon" aria-hidden="true"><app-icon name="Search" size="30" /></span>
    <div>
        <span class="pp-eyebrow">Conteúdo indisponível</span>
        <h1 id="notFoundTitle">Página ou registro não encontrado</h1>
        <p>O endereço pode ter mudado, o registro pode não existir ou seu perfil pode não ter acesso a este contexto.</p>
        <div class="pp-error-page__actions"><a class="btn btn-primary" asp-controller="MinhaCentral" asp-action="Index">Ir para Minha Central</a><a class="btn btn-outline-secondary" asp-controller="Ajuda" asp-action="Index">Consultar ajuda</a></div>
    </div>
</section>
