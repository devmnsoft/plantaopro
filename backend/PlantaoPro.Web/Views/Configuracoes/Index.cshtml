@model PlantaoPro.Web.Controllers.UserSettingsSummaryViewModel
@{
 ViewData["Title"] = "Configurações";
 var groups = new[] {
  new { Title="Organização e unidade", Text="Identidade institucional e parâmetros do tenant.", Controller="Parametrizacoes", Action="Index", Available=true },
  new { Title="Usuários, perfis e permissões", Text="Acessos sujeitos às policies do servidor.", Controller="Usuarios", Action="Index", Available=true },
  new { Title="Jornada clínica", Text="Parâmetros assistenciais disponíveis na Saúde 360.", Controller="Saude360", Action="Index", Available=true },
  new { Title="Jornada operacional", Text="Plantões, escalas e regras da operação.", Controller="Plantoes", Action="Index", Available=true },
  new { Title="Jornada financeira", Text="Lançamentos e pagamentos conforme autorização.", Controller="Financeiro", Action="Index", Available=true },
  new { Title="Notificações", Text="Preferências persistidas para a conta autenticada.", Controller="Notificacoes", Action="Preferencias", Available=true },
  new { Title="Segurança", Text="Políticas, credenciais e controles de acesso.", Controller="Seguranca", Action="Index", Available=true },
  new { Title="Auditoria e LGPD", Text="Eventos reais, privacidade e rastreabilidade.", Controller="Auditoria", Action="Index", Available=true },
  new { Title="Integrações", Text="Conectores e credenciais disponibilizados pelo ambiente.", Controller="Integracoes", Action="Index", Available=true },
  new { Title="Aparência e preferências", Text="Identidade visual e preferências do ambiente.", Controller="WhiteLabel", Action="Index", Available=true }
 };
}
<div class="pp-page pp-settings-page" data-configuration-groups>
 <header class="pp-page-hero" aria-labelledby="settings-title"><div class="pp-page-hero__copy"><span class="pp-eyebrow">Central administrativa</span><h1 id="settings-title">Configurações por domínio</h1><p>Dez frentes operacionais com acesso às rotas existentes. “Disponível” indica navegação, não presume que o tenant esteja configurado.</p></div><div class="pp-hero-actions"><a class="btn btn-primary" asp-controller="Usuario" asp-action="Edit">Editar meu perfil</a></div></header>
 @if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage as string)) { <div class="pp-notice" role="alert"><strong>Não foi possível consultar a conta.</strong> @ViewBag.ErrorMessage</div> }
 <section class="pp-card pp-account-card" aria-labelledby="account-title"><div><span class="pp-eyebrow">Conta autenticada</span><h2 id="account-title">@(string.IsNullOrWhiteSpace(Model.Nome) ? "Dados da conta indisponíveis" : Model.Nome)</h2><p>@(string.IsNullOrWhiteSpace(Model.Email) ? "O perfil não foi retornado pela API." : Model.Email)</p></div></section>
 <section aria-labelledby="domains-title"><div class="pp-section-header"><div><h2 id="domains-title">Domínios de configuração</h2><p>O status de configuração permanece não informado até existir uma fonte específica.</p></div></div><div class="pp-governance-grid">
 @foreach (var group in groups) { <article class="pp-governance-card"><span class="pp-status-badge pp-status-badge--unknown">Status não informado</span><h3>@group.Title</h3><p>@group.Text</p><a class="btn btn-outline-primary" asp-controller="@group.Controller" asp-action="@group.Action">Abrir área</a></article> }
 </div></section>
 <section class="pp-governance-notice" role="note"><i class="bi bi-shield-exclamation" aria-hidden="true"></i><div><strong>Configurações sensíveis</strong><p>Credenciais, segurança, integrações e dados pessoais exigem autorização, proteção e trilha de auditoria no backend.</p></div></section>
</div>
