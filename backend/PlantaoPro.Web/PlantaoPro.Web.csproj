    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

<ItemGroup><ProjectReference Include="../PlantaoPro.CrossCutting/PlantaoPro.CrossCutting.csproj" />
