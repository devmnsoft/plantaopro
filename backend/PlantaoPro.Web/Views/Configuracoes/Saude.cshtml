@model PlantaoPro.Web.Models.HealthViewModel
@{
    ViewData["Title"] = "Saúde do Sistema";
}
<header class="page-header mb-4">
    <div><span class="eyebrow">Operação e confiabilidade</span><h1>Saúde do sistema</h1><p>Visão sanitizada das dependências essenciais do PlantãoPro.</p></div>
    <span class="badge @(Model?.Status == "SAUDÁVEL" ? "text-bg-success" : Model?.Status == "DEGRADADO" ? "text-bg-warning" : "text-bg-danger")">@(Model?.Status ?? "INDISPONÍVEL")</span>
</header>

@if (TempData["Error"] is string erro && !string.IsNullOrWhiteSpace(erro))
{
    <div class="alert alert-warning" role="alert">
        <strong>Atenção:</strong> @erro
    </div>
}

@if (Model is null)
{
    <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("Sem dados de saúde", "Não foi possível obter dados de monitoramento.", "Voltar para Configurações", Url.Action("Index", "Configuracoes"))' />
}
else
{
    <div class="row g-3" aria-label="Dependências do sistema">
        @foreach (var componente in Model.Componentes)
        {
            <div class="col-12 col-md-6 col-xl-4"><article class="card h-100 border-0 shadow-sm"><div class="card-body">
                <div class="d-flex justify-content-between gap-3"><h2 class="h6 mb-2">@componente.Nome</h2><span class="badge @(componente.Status == "DISPONÍVEL" || componente.Status == "CONFIGURADO" ? "text-bg-success" : componente.Status == "NÃO CONFIGURADO" ? "text-bg-warning" : "text-bg-danger")">@componente.Status</span></div>
                <p class="text-secondary mb-0">@componente.Detalhe</p>
            </div></article></div>
        }
    </div>
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-md-3">Data/Hora (UTC)</dt><dd class="col-md-9">@Model.DataHora.ToString("dd/MM/yyyy HH:mm:ss")</dd>
                <dt class="col-md-3">Versão</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.Versao) ? "N/D" : Model.Versao)</dd>
                <dt class="col-md-3">Ambiente</dt><dd class="col-md-9">@(Model.Ambiente ?? "N/D")</dd>
            </dl>
        </div>
    </div>
}
