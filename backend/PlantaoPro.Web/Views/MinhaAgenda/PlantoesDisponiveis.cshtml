@model PlantaoPro.Web.Models.ListPageViewModel<PlantaoPro.Web.Models.MedicoPlantaoDisponivelDto>
@{ ViewData["Title"]="Plantões disponíveis"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/professional-portal.css" asp-append-version="true" /> }
<main class="professional-portal"><header class="page-intro"><span class="eyebrow">Oportunidades compatíveis</span><h1>Plantões disponíveis</h1><p>Escolha uma oportunidade sem conflitos na sua agenda. A coordenação receberá sua solicitação.</p></header>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="portal-state" role="alert"><strong>Não foi possível carregar</strong><span>@Model.ErrorMessage</span></div>}
else if(!Model.Items.Any()){<div class="portal-state"><strong>Nenhum plantão disponível</strong><span>Novas oportunidades compatíveis aparecerão aqui.</span></div>}
else{<section class="payment-list" aria-label="Plantões disponíveis">@foreach(var p in Model.Items){var disabled=p.JaSolicitado||p.TemConflitoHorario||p.VagasDisponiveis<=0;<article><div><span class="eyebrow">@p.DataInicio.ToString("ddd, dd MMM · HH:mm")–@p.DataFim.ToString("HH:mm")</span><h2>@p.HospitalNome</h2><p>@p.HospitalCidade/@p.HospitalEstado · @p.EspecialidadeNome</p><strong>@p.Valor.ToString("C")</strong> <span class="status-badge">@(p.TemConflitoHorario?"Conflito":p.JaSolicitado?"Solicitado":"Disponível")</span></div><form asp-action="SolicitarPlantao" method="post">@Html.AntiForgeryToken()<input type="hidden" name="plantaoId" value="@p.PlantaoId"/><button class="btn btn-primary btn-lg" disabled="@disabled" type="submit">@(p.JaSolicitado?"Solicitação enviada":p.TemConflitoHorario?"Horário indisponível":"Tenho interesse")</button></form></article>}</section>}
<partial name="_Pagination" model="Model" /></main>
