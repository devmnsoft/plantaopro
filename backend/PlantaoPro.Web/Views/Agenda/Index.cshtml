@model PlantaoPro.Web.Models.AgendaOperacionalViewModel
@{
    var vm = Model ?? new PlantaoPro.Web.Models.AgendaOperacionalViewModel();
    ViewData["Title"] = "Agenda Operacional";
    var modo = ViewData["AgendaModo"]?.ToString() ?? "semana";
    var grouped = (vm.Itens ?? Array.Empty<PlantaoPro.Web.Models.PlantaoResumoDto>())
        .OrderBy(x => x.DataInicio)
        .GroupBy(x => x.DataInicio.Date)
        .ToList();
}

<div class="pp-page"><section class="agenda-hero pp-hero pp-hero--operation" aria-labelledby="agenda-title">
  <div>
    <span class="agenda-eyebrow">Operação em tempo real</span>
    <h1 id="agenda-title">Agenda operacional</h1>
    <p>Plantões, coberturas e conflitos em uma visão única para antecipar decisões.</p>
  </div>
  <div class="agenda-actions">
    <button type="button" class="btn btn-light" data-agenda-print aria-describedby="agenda-print-help">
      <i class="bi bi-printer me-1" aria-hidden="true"></i>Imprimir
    </button>
    <span id="agenda-print-help" class="visually-hidden">Abre a caixa de impressão com uma versão profissional da agenda filtrada.</span>
    <a asp-controller="Plantoes" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Novo plantão</a>
  </div>
</section>

<nav class="agenda-switcher mb-3" aria-label="Visualização da agenda">
  <a href="/agenda/dia" class="@(modo == "dia" ? "active" : null)">Timeline</a>
  <a href="/agenda/calendario" class="@(modo == "calendario" ? "active" : null)">Calendário</a>
  <a href="/agenda/medicos" class="@(modo == "medicos" ? "active" : null)">Por médico</a>
  <a href="/agenda/hospitais" class="@(modo == "hospitais" ? "active" : null)">Por hospital</a>
  <a href="/agenda/semana" class="@(modo == "semana" ? "active" : null)">Semana</a>
  <a href="/agenda/mes" class="@(modo == "mes" ? "active" : null)">Mês</a>
  <a href="/agenda/conflitos" class="@(modo == "conflitos" ? "active danger" : null)"><i class="bi bi-exclamation-triangle me-1"></i>Conflitos</a>
</nav>

<form method="get" class="agenda-filter pp-filter-panel">
    <div class="card-body row g-2">
        <div class="col-md-3"><label class="form-label">Início</label><input type="date" name="inicio" value="@vm.Inicio.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Fim</label><input type="date" name="fim" value="@vm.Fim.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">Todos os status</option><option value="ABERTO" selected="@(vm.Status == "ABERTO")">Aberto</option><option value="CONFIRMADO" selected="@(vm.Status == "CONFIRMADO")">Confirmado</option><option value="CONFLITO" selected="@(vm.Status == "CONFLITO")">Conflito</option></select></div>
        <div class="col-md-3 d-flex align-items-end"><button class="btn btn-outline-primary w-100" type="submit">Filtrar</button></div>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(vm.ErrorMessage))
{
    <div class="alert alert-danger">@vm.ErrorMessage</div>
}

@section Scripts {
    <script src="~/js/agenda-operacional.js" asp-append-version="true" defer></script>
}

@if (!grouped.Any())
{
    @await Html.PartialAsync("_EmptyState", new PlantaoPro.Web.Models.EmptyStateViewModel("bi-calendar-x", "Sem eventos no período", "Ajuste os filtros para visualizar plantões na agenda."))
}
else
{
        <div class="agenda-summary mb-3"><strong>@vm.Total</strong><span>eventos no período</span><span class="agenda-live"><i></i>Dados operacionais</span></div>
    @foreach (var day in grouped)
    {
        <div class="agenda-day pp-data-card">
            <div class="card-header"><time datetime="@day.Key.ToString("yyyy-MM-dd")">@day.Key.ToString("dddd, dd/MM/yyyy")</time><span>@day.Count() eventos</span></div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var item in day)
                    {
                        var statusClass = (item.Status ?? string.Empty).ToLowerInvariant();
                        <div class="col-12 col-lg-6">
                            <article class="agenda-event status-@statusClass h-100" data-agenda-event data-event-id="@item.Id" data-title="@item.HospitalNome" data-hospital="@item.HospitalNome · @item.HospitalCidade/@item.HospitalEstado" data-specialty="@item.EspecialidadeNome" data-period="@item.DataInicio.ToString("dd/MM HH:mm") – @item.DataFim.ToString("dd/MM HH:mm")" data-value="@item.Valor.ToString("C")" data-coverage="@(item.Vagas-item.VagasDisponiveis)/@item.Vagas vagas preenchidas" data-status="@item.Status" tabindex="0" aria-label="@item.HospitalNome, @item.EspecialidadeNome, @item.DataInicio.ToString("dd/MM HH:mm")">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">@item.HospitalNome</div>
                                        <div class="text-muted small">@item.EspecialidadeNome · @item.HospitalCidade/@item.HospitalEstado</div>
                                    </div>
                                    <span class="badge status-@statusClass">@item.Status</span>
                                </div>
                                <div class="mt-2 small">@item.DataInicio.ToString("HH:mm") - @item.DataFim.ToString("HH:mm") · @item.Valor.ToString("C")</div>
                                <button type="button" class="btn btn-sm btn-context mt-3" data-agenda-detail>Ver contexto <i class="bi bi-arrow-right ms-1"></i></button>
                            </article>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
<section class="app-drawer agenda-detail-drawer" data-agenda-drawer role="dialog" aria-modal="true" aria-labelledby="agendaDrawerTitle" hidden>
  <header><div><span class="eyebrow">Contexto operacional</span><h2 id="agendaDrawerTitle" data-agenda-title>Detalhe da agenda</h2></div><button type="button" data-agenda-close aria-label="Fechar detalhe"><i class="bi bi-x-lg"></i></button></header>
  <div class="drawer-body"><partial name="_StatusBadge" model='"Carregando"' /><dl class="agenda-context-grid"><div><dt>Hospital</dt><dd data-agenda-hospital>—</dd></div><div><dt>Especialidade</dt><dd data-agenda-specialty>—</dd></div><div><dt>Período</dt><dd data-agenda-period>—</dd></div><div><dt>Valor</dt><dd data-agenda-value>—</dd></div><div><dt>Cobertura</dt><dd data-agenda-coverage>—</dd></div></dl><div class="agenda-drawer-timeline"><span></span><div><strong>Evento na agenda operacional</strong><small>Contexto obtido dos dados reais do plantão selecionado.</small></div></div></div>
  <footer><a asp-controller="Plantoes" asp-action="Index" class="btn btn-primary" data-agenda-full>Abrir operação completa</a><button type="button" class="btn btn-outline-secondary" data-agenda-close>Voltar</button></footer>
</section>
</div>
