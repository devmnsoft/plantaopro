@model ResetPasswordViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Redefinir senha"; }
<div class="auth-experience auth-experience--compact"><section class="auth-form-panel auth-recovery-card" aria-labelledby="resetTitle">
    <span class="pp-page-intro__eyebrow">Nova credencial</span><h1 id="resetTitle">Crie uma senha segura</h1><p>Escolha uma senha exclusiva. A confirmação precisa ser idêntica para proteger seu acesso.</p>
    <div class="pp-warning-banner" role="note"><span class="pp-alert__icon" aria-hidden="true">!</span><div class="pp-alert__content"><strong>Não reutilize senhas</strong><p>Evite nomes, datas e credenciais usadas em outros serviços.</p></div></div>
    <form asp-action="ResetPassword" method="post" class="pp-form" novalidate data-focus-invalid>@Html.AntiForgeryToken()<input asp-for="Email" type="hidden"/><input asp-for="Token" type="hidden"/>
        <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" tabindex="-1"></div>
        <div class="pp-form-field"><label asp-for="NovaSenha" class="pp-form-label">Nova senha <span class="pp-required-marker" aria-hidden="true">*</span></label><input asp-for="NovaSenha" class="form-control form-control-lg" type="password" autocomplete="new-password" aria-describedby="newPasswordHelp" required/><small id="newPasswordHelp" class="pp-field-help">Use a combinação de caracteres exigida pela política da organização.</small><span asp-validation-for="NovaSenha" class="pp-form-error" data-valmsg-for="NovaSenha"></span></div>
        <div class="pp-form-field"><label asp-for="ConfirmarSenha" class="pp-form-label">Confirme a nova senha <span class="pp-required-marker" aria-hidden="true">*</span></label><input asp-for="ConfirmarSenha" class="form-control form-control-lg" type="password" autocomplete="new-password" required/><span asp-validation-for="ConfirmarSenha" class="pp-form-error" data-valmsg-for="ConfirmarSenha"></span></div>
        <button class="btn btn-primary btn-lg" type="submit"><app-icon name="Check" size="18" /> Redefinir senha</button>
    </form>
</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
