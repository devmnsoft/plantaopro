@model PlantaoPro.Web.Models.WorkItemViewModel
<article class="central-work-item" data-work-item data-key="@Model.StableKey" data-priority="@Model.Priority" data-type="@Model.Type" data-owner="@(Model.ResponsibleId?.ToString() ?? string.Empty)" data-due="@(Model.DueAt?.ToString("O") ?? string.Empty)">
 <div class="central-work-item__main"><div class="central-work-item__badges"><span class="status-with-icon" aria-label="Situação @Model.Status"><span aria-hidden="true">●</span> @Model.Status.Replace('_',' ').ToLowerInvariant()</span><span class="priority priority-@Model.Priority.ToLowerInvariant()">@Model.Priority</span></div><h3>@Model.Title</h3><p>@Model.Description</p></div>
 <dl><div><dt>Tipo</dt><dd>@Model.Type</dd></div><div><dt>Origem</dt><dd>@Model.OriginLabel</dd></div><div><dt>Unidade</dt><dd>@(Model.UnitId.HasValue ? "Unidade do registro" : "Não aplicável")</dd></div><div><dt>Prazo</dt><dd>@if(Model.DueAt.HasValue){<time datetime="@Model.DueAt.Value.ToString("O")">@Model.DueAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>}else{<span>Sem prazo definido</span>}</dd></div><div><dt>Responsável</dt><dd>@(Model.ResponsibleId.HasValue ? "Responsável definido" : "Não definido")</dd></div></dl>
 <div class="central-work-item__actions"><a class="button button-secondary" href="@Model.OriginUrl">Ver registro de origem</a>@if(!string.IsNullOrWhiteSpace(Model.ActionUrl)){<a class="button button-primary" href="@Model.ActionUrl">@Model.NextAction</a>}else{<span class="action-unavailable">Sem ação autorizada neste contexto</span>}</div>
</article>
