@model PlantaoPro.Web.Models.DashboardGestaoViewModel
@{
    ViewData["Title"] = UiText.L("Adm360.Dash.PageTitle");
    var c = Model.Dashboard.Cotacoes;
    var x = Model.Dashboard.DocumentosXml;
    var i = Model.Dashboard.Integracoes;
    var definicoesDash = Model.Dashboard?.Definicoes ?? Array.Empty<PlantaoPro.Web.Models.KpiDefinicaoDto>();
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">
                <i class="bi bi-graph-up text-success me-2"></i>@UiText.L("Adm360.Dash.Heading")
            </h2>
            <p class="text-muted small mb-0">@UiText.L("Adm360.Dash.Subheading")</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/api/administrativo360/gestao/exportar-cotacoes" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-filetype-csv me-1"></i> @UiText.L("Adm360.Dash.ButtonExportQuotes")
            </a>
            <a href="/api/administrativo360/gestao/exportar-documentos" class="btn btn-outline-info btn-sm">
                <i class="bi bi-filetype-csv me-1"></i> @UiText.L("Adm360.Dash.ButtonExportDocuments")
            </a>
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-2"><i class="bi bi-info-circle me-2"></i>Como ler o painel de gestão</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">1. Para que serve</strong>
                    Ver em um só lugar como andam as cotações, os documentos fiscais e as integrações da instituição.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">2. Como utilizar</strong>
                    Use os filtros de período para delimitar o que aparece; os dois botões de exportação baixam as listas em arquivo CSV.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">3. O que mostram os números</strong>
                    Atividade real no período selecionado; passando o mouse em cada indicador aparece o que ele mede de fato.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">4. Próxima ação</strong>
                    Cotação ou documento sinalizando atenção deve ser tratada na própria tela da área antes de virar problema na entrega.
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros de Dashboard -->
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body p-3">
            <form method="get" action="/Administrativo360/Gestao/Dashboard" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-light small">@UiText.L("Adm360.LabelProvedor")</label>
                    <select name="provedor" class="form-select form-select-sm bg-dark text-light border-secondary" aria-label="Provedor">
                        <option value="">@UiText.L("Adm360.Cotacoes.OptAllPortals")</option>
                        <option value="OPMENEXO" selected="@(Model.Provedor == "OPMENEXO")">OPMENEXO</option>
                        <option value="INPART" selected="@(Model.Provedor == "INPART")">INPART Saúde</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-light small">@UiText.L("Adm360.Dash.LabelStartDate")</label>
                    <input type="date" name="dataInicio" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@(Model.DataInicio?.ToString("yyyy-MM-dd"))" aria-label="Início">
                </div>
                <div class="col-md-3">
                    <label class="form-label text-light small">@UiText.L("Adm360.Dash.LabelEndDate")</label>
                    <input type="date" name="dataFim" class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@(Model.DataFim?.ToString("yyyy-MM-dd"))" aria-label="Fim">
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-sm btn-primary me-2">
                        <i class="bi bi-filter me-1"></i> @UiText.L("Adm360.ButtonFiltrar")
                    </button>
                    <a href="/Administrativo360/Gestao/Dashboard" class="btn btn-sm btn-outline-secondary">@UiText.L("Adm360.ButtonLimpar")</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Capacidades Contratadas do Tenant -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
            <h5 class="card-title text-light mb-0 h6">
                <i class="bi bi-toggle-on text-info me-2"></i>@UiText.L("Adm360.Dash.CapabilitiesTitle")
            </h5>
            <span class="badge bg-secondary">@UiText.L("Adm360.Dash.CapabilitiesIsolationBadge")</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 rounded border @(Model.CapacidadesAtivas.Contains("PORTAIS_COTACAO") ? "border-success bg-black" : "border-secondary bg-dark")">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="text-light">@UiText.L("Adm360.Dash.CapQuotePortalsTitle")</strong>
                            <span class="badge @(Model.CapacidadesAtivas.Contains("PORTAIS_COTACAO") ? "bg-success" : "bg-secondary")">
                                @(Model.CapacidadesAtivas.Contains("PORTAIS_COTACAO") ? UiText.L("Adm360.Dash.CapabilityEnabled") : UiText.L("Adm360.Dash.CapabilityDisabled"))
                            </span>
                        </div>
                        <p class="small text-white-50 mb-2">@UiText.L("Adm360.Dash.CapQuotePortalsDesc")</p>
                        <form method="post" action="/Administrativo360/Gestao/HabilitarCapacidade" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="capacidade" value="PORTAIS_COTACAO" />
                            <input type="hidden" name="habilitado" value="@(!Model.CapacidadesAtivas.Contains("PORTAIS_COTACAO"))" />
                            <button type="submit" class="btn btn-sm @(Model.CapacidadesAtivas.Contains("PORTAIS_COTACAO") ? "btn-outline-danger" : "btn-outline-success")">
                                @(Model.CapacidadesAtivas.Contains("PORTAIS_COTACAO") ? UiText.L("Adm360.Dash.ButtonDisable") : UiText.L("Adm360.Dash.ButtonEnable"))
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 rounded border @(Model.CapacidadesAtivas.Contains("XML_RECEBIDOS") ? "border-success bg-black" : "border-secondary bg-dark")">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="text-light">@UiText.L("Adm360.Dash.CapXmlCenterTitle")</strong>
                            <span class="badge @(Model.CapacidadesAtivas.Contains("XML_RECEBIDOS") ? "bg-success" : "bg-secondary")">
                                @(Model.CapacidadesAtivas.Contains("XML_RECEBIDOS") ? UiText.L("Adm360.Dash.CapabilityEnabled") : UiText.L("Adm360.Dash.CapabilityDisabled"))
                            </span>
                        </div>
                        <p class="small text-white-50 mb-2">@UiText.L("Adm360.Dash.CapXmlCenterDesc")</p>
                        <form method="post" action="/Administrativo360/Gestao/HabilitarCapacidade" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="capacidade" value="XML_RECEBIDOS" />
                            <input type="hidden" name="habilitado" value="@(!Model.CapacidadesAtivas.Contains("XML_RECEBIDOS"))" />
                            <button type="submit" class="btn btn-sm @(Model.CapacidadesAtivas.Contains("XML_RECEBIDOS") ? "btn-outline-danger" : "btn-outline-success")">
                                @(Model.CapacidadesAtivas.Contains("XML_RECEBIDOS") ? UiText.L("Adm360.Dash.ButtonDisable") : UiText.L("Adm360.Dash.ButtonEnable"))
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 rounded border @(Model.CapacidadesAtivas.Contains("DASHBOARD_GERENCIAL") ? "border-success bg-black" : "border-secondary bg-dark")">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="text-light">@UiText.L("Adm360.Dash.CapDashboardTitle")</strong>
                            <span class="badge @(Model.CapacidadesAtivas.Contains("DASHBOARD_GERENCIAL") ? "bg-success" : "bg-secondary")">
                                @(Model.CapacidadesAtivas.Contains("DASHBOARD_GERENCIAL") ? UiText.L("Adm360.Dash.CapabilityEnabled") : UiText.L("Adm360.Dash.CapabilityDisabled"))
                            </span>
                        </div>
                        <p class="small text-white-50 mb-2">@UiText.L("Adm360.Dash.CapDashboardDesc")</p>
                        <form method="post" action="/Administrativo360/Gestao/HabilitarCapacidade" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="capacidade" value="DASHBOARD_GERENCIAL" />
                            <input type="hidden" name="habilitado" value="@(!Model.CapacidadesAtivas.Contains("DASHBOARD_GERENCIAL"))" />
                            <button type="submit" class="btn btn-sm @(Model.CapacidadesAtivas.Contains("DASHBOARD_GERENCIAL") ? "btn-outline-danger" : "btn-outline-success")">
                                @(Model.CapacidadesAtivas.Contains("DASHBOARD_GERENCIAL") ? UiText.L("Adm360.Dash.ButtonDisable") : UiText.L("Adm360.Dash.ButtonEnable"))
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- GRUPO 1: COTAÇÕES -->
    <h5 class="text-warning h6 mb-3 fw-bold">
        <i class="bi bi-inbox-fill me-2"></i>@UiText.L("Adm360.Dash.GroupQuotesTitle")
    </h5>
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiQuotesReceived")</div>
                    <h3 class="fw-bold text-light mb-0">@c.TotalRecebidas</h3>
                    <div class="small text-white-50 mt-2">
                        <a href="/Administrativo360/Cotacoes" class="text-warning text-decoration-none">@UiText.L("Adm360.Dash.LinkViewFullList") &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiAwaitingMatching")</div>
                    <h3 class="fw-bold text-warning mb-0">@c.AguardandoRelacionamento</h3>
                    <div class="small text-white-50 mt-2">@UiText.L("Adm360.Dash.KpiAwaitingMatchingDesc")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiDueSoon24h")</div>
                    <h3 class="fw-bold @(c.ProximasDoPrazo > 0 ? "text-danger" : "text-light") mb-0">@c.ProximasDoPrazo</h3>
                    <div class="small text-white-50 mt-2">@UiText.L("Adm360.Dash.KpiDueSoonDesc")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiLinkedQuotes")</div>
                    <h3 class="fw-bold text-info mb-0">@c.OrcamentosGerados</h3>
                    <div class="small text-white-50 mt-2">@UiText.L("Adm360.Dash.KpiLinkedQuotesDesc")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiAcceptedResponses")</div>
                    <h3 class="fw-bold text-success mb-0">@c.RespostasAceitas</h3>
                    <div class="small text-white-50 mt-2">@UiText.L("Adm360.Dash.KpiAcceptedResponsesDesc")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiWinningProposals")</div>
                    <h3 class="fw-bold text-success mb-0">@c.PropostasVencedoras</h3>
                    <div class="small text-white-50 mt-2">@UiText.L("Adm360.Dash.LostLabel") @c.PropostasPerdidas</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiSuccessRate")</div>
                    <h3 class="fw-bold text-primary mb-0">@c.TaxaSucessoPercentual.ToString("N1")%</h3>
                    <div class="small text-white-50 mt-2">@UiText.L("Adm360.Dash.KpiSuccessRateDesc")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiAvgResponseTime")</div>
                    <h3 class="fw-bold text-light mb-0">@c.TempoMedioRespostaHoras.ToString("N1") h</h3>
                    <div class="small text-white-50 mt-2">@UiText.L("Adm360.Dash.IntegrationFailuresLabel") @c.FalhasIntegracao</div>
                </div>
            </div>
        </div>
    </div>

    <!-- GRUPO 2: DOCUMENTOS XML -->
    <h5 class="text-info h6 mb-3 fw-bold">
        <i class="bi bi-file-earmark-code me-2"></i>@UiText.L("Adm360.Dash.GroupXmlTitle")
    </h5>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiTotalDocuments")</div>
                    <h3 class="fw-bold text-light mb-0">@x.TotalRecebidos</h3>
                    <div class="small text-white-50 mt-2">
                        <span class="badge bg-success">@x.Completos @UiText.L("Adm360.Dash.UnitCompleteDocs")</span>
                        <span class="badge bg-secondary ms-1">@x.Resumos @UiText.L("Adm360.Dash.UnitSummaryDocs")</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiPendingVerification")</div>
                    <h3 class="fw-bold text-warning mb-0">@x.PendentesConferencia</h3>
                    <div class="small text-white-50 mt-2">
                        <a href="/Administrativo360/DocumentosXml?status=PENDENTE" class="text-info text-decoration-none">@UiText.L("Adm360.Dash.LinkRunVerification") &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiLinkedQuarantine")</div>
                    <h3 class="fw-bold text-success mb-0">@x.Vinculados</h3>
                    <div class="small text-white-50 mt-2">
                        @if (x.Quarentenados > 0)
                        {
                            <span class="badge bg-danger">@x.Quarentenados @UiText.L("Adm360.Dash.UnitInQuarantine")</span>
                        }
                        else
                        {
                            <span class="badge bg-dark border text-white-50">0 @UiText.L("Adm360.Dash.UnitInQuarantine")</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- GRUPO 3: INTEGRAÇÕES -->
    <h5 class="text-success h6 mb-3 fw-bold">
        <i class="bi bi-activity me-2"></i>@UiText.L("Adm360.Dash.GroupIntegrationsTitle")
    </h5>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiActivePortalAccounts")</div>
                    <h3 class="fw-bold text-success mb-0">@i.ContasAtivas</h3>
                    <div class="small text-white-50 mt-2">@UiText.L("Adm360.Dash.BlockedLabel") @i.ConexoesBloqueadas</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiFailuresLast24h")</div>
                    <h3 class="fw-bold @(i.FalhasUltimas24h > 0 ? "text-danger" : "text-light") mb-0">@i.FalhasUltimas24h</h3>
                    <div class="small text-white-50 mt-2">@UiText.L("Adm360.Dash.KpiFailuresLast24hDesc")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <div class="text-white-50 small">@UiText.L("Adm360.Dash.KpiLastGlobalSync")</div>
                    <h4 class="fw-bold text-light mb-0">
                        @(i.UltimaSincronizacaoGeral?.ToString("dd/MM/yyyy HH:mm") ?? UiText.L("Adm360.Dash.NoneValue"))
                    </h4>
                    <div class="small text-white-50 mt-2">
                        <a href="/Administrativo360/Gestao/Monitor" class="text-success text-decoration-none">@UiText.L("Adm360.Dash.LinkOpenFullMonitor") &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (string.IsNullOrEmpty(Model.Erro))
    {
        @* R8-B25 (§27): exibe as definições fiéis ao SQL dos indicadores do dashboard gerencial (mesmo critério "definição e rastreabilidade"; sem nova consulta/número/regra). *@
        <details class="dash-definicoes mt-4">
            <summary class="fw-semibold small">Como cada indicador é calculado (fórmula · fonte · período · fuso)</summary>
            <p class="small text-muted mb-2">@Model.Dashboard.TimeCriterion</p>
            @if (definicoesDash.Count > 0)
            {
                <ul class="small mb-0">@foreach (var item in definicoesDash) { <li><strong>@item.Label</strong>: @item.Definicao</li> }</ul>
            }
            else
            {
                <p class="small text-muted mb-0">Sem definições informadas pela fonte para os indicadores.</p>
            }
        </details>
    }
</div>
