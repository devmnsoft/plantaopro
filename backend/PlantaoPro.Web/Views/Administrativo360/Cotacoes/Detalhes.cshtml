@model PlantaoPro.Web.Models.CotacaoDetalhesPageViewModel
@{
    ViewData["Title"] = $"{UiText.L("Adm360.CotDet.LabelCotacao")}{Model.Cotacao.IdentificadorExterno}{UiText.L("Adm360.CotDet.TitleSuffix")}";
    ViewData["BreadcrumbLabel"] = UiText.L("Adm360.CotDet.BreadcrumbLabel");
    ViewData["BreadcrumbLeaf"] = Model.Cotacao.IdentificadorExterno;
    var expirado = Model.Cotacao.PrazoResposta < DateTime.UtcNow && Model.Cotacao.StatusInterno != "RESPONDIDA";
    var itensPendentes = Model.Cotacao.Itens.Count(i => i.StatusRelacionamento == "PENDENTE");
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-0 text-light fw-bold">
                @UiText.L("Adm360.CotDet.LabelCotacao")@Model.Cotacao.IdentificadorExterno <span class="pp-badge pp-badge--neutral ms-1">v@(Model.Cotacao.RevisaoExterna)</span>
            </h2>
        </div>
        <div class="d-flex gap-2">
            <a href="/Administrativo360/Cotacoes" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> @UiText.L("Shift.Back")
            </a>

            @if (!Model.Cotacao.OrcamentoId.HasValue && itensPendentes == 0)
            {
                <form method="post" action="/Administrativo360/Cotacoes/GerarOrcamento/@Model.Cotacao.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-calculator me-1"></i> @UiText.L("Adm360.CotDet.BtnGerarOrcamento")
                    </button>
                </form>
            }

            @if (Model.Cotacao.StatusInterno is "EM_ORCAMENTO" or "AGUARDANDO_APROVACAO" && !expirado)
            {
                <form method="post" action="/Administrativo360/Cotacoes/AprovarResposta/@Model.Cotacao.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> @UiText.L("Adm360.CotDet.BtnAprovarEnfileirar")
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.Cotacao.CanceladoEm.HasValue)
    {
        <div class="alert alert-warning d-flex align-items-start" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
            <div>
                <strong>@UiText.L("Adm360.CotDet.CanceladoEmPrefix")@Model.Cotacao.CanceladoEm.Value.ToString("dd/MM/yyyy HH:mm")@UiText.L("Adm360.CotDet.CanceladoEmSuffix")</strong>
                <div class="small mt-1">@UiText.L("Adm360.CotDet.MotivoLabel")@(Model.Cotacao.MotivoCancelamento ?? UiText.L("Adm360.CotDet.MotivoNaoInformado"))</div>
                <div class="small text-muted mt-1">@UiText.L("Adm360.CotDet.CanceladoEstadoTerminal")</div>
            </div>
        </div>
    }

    <details class="screen-guide-card">
        <summary><i class="bi bi-compass" aria-hidden="true"></i>@UiText.L("Login.HelpSummary")</summary>
        <div>
            <p>@Html.Raw(UiText.L("Adm360.CotDet.GuiaCiclo"))</p>
            <p>@Html.Raw(UiText.L("Adm360.CotDet.GuiaStatus"))</p>
            <p>@Html.Raw(UiText.L("Adm360.CotDet.GuiaAssistente"))</p>
            <p>@Html.Raw(UiText.L("Adm360.CotDet.GuiaDocumentos"))</p>
            <p>@Html.Raw(UiText.L("Adm360.CotDet.GuiaAnvisa"))</p>
        </div>
    </details>

    @if (!string.IsNullOrWhiteSpace(Model.Erro))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.Erro
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@UiText.L("Implantacao.CloseAria")"></button>
        </div>
    }

    @if (itensPendentes > 0)
    {
        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div>
                <strong>@UiText.L("Adm360.CotDet.PendingItemsIntro")@itensPendentes@UiText.L("Adm360.CotDet.PendingItemsOutro")</strong>
                <p class="mb-0 small">@UiText.L("Adm360.CotDet.PendingItemsBloqueio")</p>
            </div>
        </div>
    }

    <!-- Cabeçalho Informativo -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <span class="text-white-50 small">@UiText.L("Adm360.CotDet.CardProvedorOrigem")</span>
                    <h5 class="fw-bold text-warning mb-1">@Model.Cotacao.Provedor</h5>
                    <span class="pp-badge pp-badge--neutral">@Model.Cotacao.Origem</span>
                    <div class="mt-2 small text-white-50">@UiText.L("Adm360.CotDet.LblEstabelecimento")@Model.Cotacao.EstabelecimentoNome</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <span class="text-white-50 small">@UiText.L("Adm360.CotDet.CardHospitalSolicitante")</span>
                    <h5 class="fw-bold text-light mb-1">@(Model.Cotacao.HospitalNome ?? Model.Cotacao.HospitalSolicitanteExterno ?? UiText.L("Adm360.CotDet.HospitalNaoIdentificado"))</h5>
                    <div class="small text-white-50">@UiText.L("Adm360.CotDet.LblProcedimento")@(Model.Cotacao.Procedimento ?? UiText.L("Adm360.CotDet.Nd"))</div>
                    <div class="small text-white-50">@UiText.L("Adm360.CotDet.LblDataPrevista")@(Model.Cotacao.DataPrevista?.ToString("dd/MM/yyyy") ?? UiText.L("Adm360.CotDet.Nd"))</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <span class="text-white-50 small">@UiText.L("Adm360.Cotacoes.ThResponseDeadline")</span>
                    <h5 class="fw-bold @(expirado ? "text-danger" : "text-light") mb-1">
                        @Model.Cotacao.PrazoResposta.ToString("dd/MM/yyyy HH:mm")
                    </h5>
                    <span class="pp-badge @(expirado ? "pp-badge--danger" : "pp-badge--info")">
                        @(expirado ? UiText.L("Adm360.Cotacoes.StatusExpirada") : UiText.L("Adm360.CotDet.PrazoDentro"))
                    </span>
                    <div class="small text-white-50 mt-1">@UiText.L("Adm360.CotDet.LblFuso")@Model.Cotacao.FusoHorario</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-light h-100">
                <div class="card-body">
                    <span class="text-white-50 small">@UiText.L("Adm360.CotDet.CardStatusOrcamento")</span>
                    <h5 class="fw-bold text-light mb-1">@Model.Cotacao.StatusInterno</h5>
                    <div class="small text-white-50">@UiText.L("Adm360.CotDet.LblPortal")@Model.Cotacao.StatusExterno</div>
                    @if (Model.Cotacao.OrcamentoId.HasValue)
                    {
                        <div class="mt-1">
                            <span class="pp-badge pp-badge--success">@UiText.L("Adm360.CotDet.OrcamentoPrefix")@Model.Cotacao.OrcamentoNumero</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Itens e De/Para -->
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
            <h5 class="card-title text-light mb-0 h6">
                <i class="bi bi-box-seam me-2"></i>@UiText.L("Adm360.CotDet.ItensTableTitulo") (@Model.Cotacao.Itens.Count)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">@UiText.L("Adm360.CotDet.ThItemExterno")</th>
                            <th scope="col">@UiText.L("Adm360.CotDet.ThQtdUnid")</th>
                            <th scope="col">@UiText.L("Adm360.CotDet.ThProdutoOfertado")</th>
                            <th scope="col">@UiText.L("Adm360.CotDet.ThConversao")</th>
                            <th scope="col">@UiText.L("Adm360.CotDet.ThPrecoUnit")</th>
                            <th scope="col">@UiText.L("Adm360.CotDet.ThDescontoUnit")</th>
                            <th scope="col">@UiText.L("Adm360.CotDet.ThTotalOfertado")</th>
                            <th scope="col">@UiText.L("Adm360.CotDet.ThStatusDePara")</th>
                            <th class="text-end" scope="col">@UiText.L("Adm360.CotDet.ThAcao")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Cotacao.Itens)
                        {
                            <tr>
                                <td>@item.NumeroItem</td>
                                <td>
                                    <strong class="text-light">@item.DescricaoExterna</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.CodigoExterno))
                                    {
                                        <div class="small text-white-50">@UiText.L("Adm360.CotDet.LblCodigo")@item.CodigoExterno</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.FabricanteExterno))
                                    {
                                        <div class="small text-secondary">@UiText.L("Adm360.CotDet.LblFabricante")@item.FabricanteExterno / @UiText.L("Adm360.CotDet.LblModelo")@item.ModeloExterno</div>
                                    }
                                </td>
                                <td>
                                    @item.QuantidadeSolicitada.ToString("N2") <span class="pp-badge pp-badge--neutral">@item.UnidadeSolicitada</span>
                                </td>
                                <td>
                                    @if (item.ProdutoId.HasValue)
                                    {
                                        <div class="text-light fw-bold">@item.ProdutoNome</div>
                                        @* s8 (rodada 9): regulação ANVISA por item — estado do cadastro do produto ofertado *@
                                        @if (!string.IsNullOrWhiteSpace(item.AnvisaNumero))
                                        {
                                            <div class="small"><span class="pp-badge pp-badge--success" title="@UiText.L("Adm360.CotDet.AnvisaBadgeTit")">ANVISA @item.AnvisaNumero</span></div>
                                        }
                                        else if (item.AnvisaAplicabilidade == "NAO_APLICAVEL")
                                        {
                                            <div class="small"><span class="pp-badge pp-badge--neutral" title="@item.AnvisaJustificacao">@UiText.L("Adm360.CotDet.AnvisaBadgeNaTxt")</span></div>
                                        }
                                        else
                                        {
                                            <div class="small"><span class="pp-badge pp-badge--warning" title="@UiText.L("Adm360.CotDet.AnvisaBadgePendTit")">@UiText.L("Adm360.CotDet.AnvisaBadgePendTxt")</span></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.JustificativaSubstituicao))
                                        {
                                            <div class="small text-info">@UiText.L("Adm360.CotDet.LblSubst")@item.JustificativaSubstituicao</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-danger small"><i class="bi bi-x-circle me-1"></i>@UiText.L("Adm360.CotDet.BadgePendenteMapeamento")</span>
                                    }
                                </td>
                                <td>
                                    @if (item.ProdutoId.HasValue)
                                    {
                                        <div>@UiText.L("Adm360.CotDet.LblFator")@item.FatorConversao.ToString("N4")</div>
                                        <strong>@item.QuantidadeConvertida.ToString("N2")</strong> <span class="pp-badge pp-badge--neutral">@item.UnidadeInterna</span>
                                    }
                                    else
                                    {
                                        <span class="text-white-50">-</span>
                                    }
                                </td>
                                <td>R$ @item.PrecoUnitarioOfertado.ToString("N2")</td>
                                <td>R$ @item.Desconto.ToString("N2")</td>
                                <td>
                                    <strong class="text-warning">R$ @item.PrecoTotalOfertado.ToString("N2")</strong>
                                </td>
                                <td>
                                    @switch (item.StatusRelacionamento)
                                    {
                                        case "RELACIONADO":
                                            <span class="pp-badge pp-badge--success">@UiText.L("Adm360.CotDet.StatusRelacionado")</span>
                                            break;
                                        case "PENDENTE":
                                            <span class="pp-badge pp-badge--warning">@UiText.L("Adm360.CotDet.StatusPendente")</span>
                                            break;
                                        case "NAO_ATENDIDO":
                                            <span class="pp-badge pp-badge--danger">@UiText.L("Adm360.CotDet.StatusNaoAtendido")</span>
                                            break;
                                        default:
                                            <span class="pp-badge pp-badge--neutral">@item.StatusRelacionamento</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#modalItem-@item.Id">
                                        <i class="bi bi-pencil-square me-1"></i> @UiText.L("Adm360.CotDet.BtnMapear")
                                    </button>
                                </td>
                            </tr>

                            <!-- Modal de Mapeamento do Item -->
                            <div class="modal fade" id="modalItem-@item.Id" tabindex="-1" aria-labelledby="modalLabel-@item.Id" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content bg-dark text-light border-secondary">
                                        <form method="post" action="/Administrativo360/Cotacoes/RelacionarItem">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="CotacaoId" value="@Model.Cotacao.Id" />
                                            <input type="hidden" name="CotacaoItemId" value="@item.Id" />
                                            <div class="modal-header border-secondary">
                                                <h5 class="modal-title h6" id="modalLabel-@item.Id">
                                                    @UiText.L("Adm360.CotDet.ModalMapearPrefix")@item.NumeroItem: @item.DescricaoExterna
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@UiText.L("Implantacao.CloseAria")"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label small">@UiText.L("Adm360.CotDet.LblStatusAtendimento")</label>
                                                    <select name="StatusRelacionamento" class="form-select form-select-sm bg-dark text-light border-secondary" aria-label="Status do relacionamento">
                                                        <option value="RELACIONADO" selected="@(item.StatusRelacionamento == "RELACIONADO")">@UiText.L("Adm360.CotDet.OptRelacionadoInterno")</option>
                                                        <option value="NAO_ATENDIDO" selected="@(item.StatusRelacionamento == "NAO_ATENDIDO")">@UiText.L("Adm360.CotDet.StatusNaoAtendido")</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small" for="selProduto-@item.Id">@UiText.L("Adm360.CotDet.LblProdutoInterno")</label>
                                                     @* s8 (rodada 9): seleção pelo catálogo — cada candidato exibe a regulação ANVISA do seu cadastro; entrada manual por UUID continua disponível. *@
                                                     <select id="selProduto-@item.Id" class="form-select form-select-sm bg-dark text-light border-secondary" onchange="selecionarProduto('@item.Id', this)">
                                                         <option value="">@UiText.L("Adm360.CotDet.OptSelecioneProduto")</option>
                                                         @foreach (var prod in Model.Produtos)
                                                         {
                                                             var anvisaVigStr = prod.AnvisaVigencia?.ToString("yyyy-MM-dd");
                                                             <option value="@prod.Id" data-anvisa-numero="@prod.AnvisaNumero" data-anvisa-aplic="@prod.AnvisaAplicabilidade" data-anvisa-justif="@prod.AnvisaJustificacao" data-anvisa-vigencia="@anvisaVigStr" selected="@((item.ProdutoId == prod.Id) ? "selected" : "")">@prod.Sku - @prod.Nome (@prod.Unidade)</option>
                                                         }
                                                     </select>
                                                     <div id="anvisaInfo-@item.Id" class="form-text small mt-1" aria-live="polite"></div>
                                                     <label class="form-label small mt-2" for="uuidProduto-@item.Id">@UiText.L("Adm360.CotDet.LblIdentificadorManual")</label>
                                                    <input type="text" id="uuidProduto-@item.Id" name="ProdutoId" class="form-control form-control-sm bg-dark text-light border-secondary" oninput="atualizarAnvisaInfo('@item.Id', this.value)"
                                                           value="@item.ProdutoId" placeholder="Ex: d3f6584c-2c64-4e5a-9ea9-4e1428647520" />
                                                    <div class="form-text text-white-50 small">@UiText.L("Adm360.CotDet.SelectAjuda")</div>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label small">@UiText.L("Adm360.CotDet.LblFatorConversao")</label>
                                                        <input type="number" step="0.0001" name="FatorConversao" class="form-control form-control-sm bg-dark text-light border-secondary"
                                                               aria-label="Fator de conversão" value="@(item.FatorConversao > 0 ? item.FatorConversao : 1.0000m)" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label small">@UiText.L("Adm360.CotDet.LblPrecoUnitario")</label>
                                                        <input type="number" step="0.01" name="PrecoUnitarioOfertado" class="form-control form-control-sm bg-dark text-light border-secondary"
                                                               value="@item.PrecoUnitarioOfertado" aria-label="Precounitarioofertado">
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small">@UiText.L("Adm360.CotDet.LblDesconto")</label>
                                                    <input type="number" step="0.01" name="Desconto" class="form-control form-control-sm bg-dark text-light border-secondary"
                                                           value="@item.Desconto" aria-label="Desconto">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small">@UiText.L("Adm360.CotDet.LblJustSubstituicao")</label>
                                                    <input type="text" name="JustificativaSubstituicao" class="form-control form-control-sm bg-dark text-light border-secondary"
                                                           value="@item.JustificativaSubstituicao" placeholder="@UiText.L("Adm360.CotDet.PhJustSubstituicao")" />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small">@UiText.L("Adm360.CotDet.LblMotivoNaoAtendimento")</label>
                                                    <input type="text" name="MotivoNaoAtendimento" class="form-control form-control-sm bg-dark text-light border-secondary"
                                                           value="@item.MotivoNaoAtendimento" placeholder="@UiText.L("Adm360.CotDet.PhMotivoNaoAtendimento")" />
                                                </div>
                                            </div>
                                            <div class="modal-footer border-secondary">
                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@UiText.L("Clinical.ButtonCancel")</button>
                                                <button type="submit" class="btn btn-sm btn-warning">@UiText.L("Adm360.CotDet.BtnSalvarMapeamento")</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- s8 (rodada 9): seleção de produto com regulação ANVISA — o select preenche o campo de
         UUID e o painel mostra o estado do cadastro do candidato (número / não aplicável / pendente).
         O valor oficial é o do cadastro do produto; a aprovação congela o estado no snapshot. -->
    <script>
        (function () {
            var itens = [
                @foreach (var item in Model.Cotacao.Itens)
                {
                    <text>{ id: "@item.Id", produtoId: "@item.ProdutoId" },</text>
                }
            ];

            function atualizarAnvisaInfo(itemId, produtoId) {
                var info = document.getElementById('anvisaInfo-' + itemId);
                if (!info) { return; }
                var op = null;
                var selEl = document.getElementById('selProduto-' + itemId);
                if (selEl) {
                    for (var k = 0; k < selEl.options.length; k++) {
                        if (selEl.options[k].value === produtoId) { op = selEl.options[k]; break; }
                    }
                }
                if (!produtoId || !op) {
                    info.innerHTML = '<span class="text-muted">' + '@UiText.L("Adm360.CotDet.JsSemProduto")' + '</span>';
                    return;
                }
                var num = op.getAttribute('data-anvisa-numero') || '';
                var apl = op.getAttribute('data-anvisa-aplic') || '';
                var just = op.getAttribute('data-anvisa-justif') || '';
                var vig = op.getAttribute('data-anvisa-vigencia') || '';
                if (num) {
                    info.innerHTML = '<span class="pp-badge pp-badge--success">ANVISA ' + num + '</span>'
                        + (vig ? ' <span class="text-muted">' + '@UiText.L("Adm360.CotDet.JsVigenciaLbl")' + vig + '</span>' : '')
                        + ' <span class="text-muted">' + '@UiText.L("Adm360.CotDet.JsRegistroManual")' + '</span>';
                } else if (apl === 'NAO_APLICAVEL') {
                    info.innerHTML = '<span class="pp-badge pp-badge--neutral">' + '@UiText.L("Adm360.CotDet.JsAnvisaNaTxt")' + '</span>' + (just ? ' <span class="text-muted">' + just + '</span>' : '');
                } else {
                    info.innerHTML = '<span class="pp-badge pp-badge--warning">' + '@UiText.L("Adm360.CotDet.AnvisaBadgePendTxt")' + '</span> <span class="text-muted">' + '@UiText.L("Adm360.CotDet.JsPendenteTexto")' + '</span>';
                }
            }

            function selecionarProduto(itemId, selEl) {
                var input = document.getElementById('uuidProduto-' + itemId);
                if (input) { input.value = selEl.value; }
                atualizarAnvisaInfo(itemId, selEl.value);
            }

            window.selecionarProduto = selecionarProduto;
            window.atualizarAnvisaInfo = atualizarAnvisaInfo;

            itens.forEach(function (it) { atualizarAnvisaInfo(it.id, it.produtoId); });
        })();
    </script>

    <!-- Anexos e Respostas Outbox -->
    <div class="row g-4">
        <!-- Anexos -->
        <div class="col-md-6">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header bg-dark border-secondary">
                    <h5 class="card-title text-light mb-0 h6">
                        <i class="bi bi-paperclip me-2"></i>@UiText.L("Adm360.CotDet.AnexosTitulo") (@Model.Cotacao.Anexos.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush bg-dark">
                        @if (!Model.Cotacao.Anexos.Any())
                        {
                            <li class="list-group-item bg-dark text-white-50 py-3">@UiText.L("Adm360.CotDet.AnexosVazio")</li>
                        }
                        @foreach (var anexo in Model.Cotacao.Anexos)
                        {
                            <li class="list-group-item bg-dark text-light border-secondary d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">@anexo.NomeArquivo</div>
                                    <div class="small text-white-50">@((anexo.TamanhoBytes / 1024.0).ToString("N1")) KB — SHA256: @anexo.Sha256Hash[..8]...</div>
                                </div>
                                <a href="/Administrativo360/Cotacoes/@Model.Cotacao.Id/Anexos/@anexo.Id" class="btn btn-sm btn-outline-light">
                                    <i class="bi bi-download me-1"></i> @UiText.L("Adm360.CotDet.BtnBaixar")
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Fila de Respostas / Outbox -->
        <div class="col-md-6">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header bg-dark border-secondary">
                    <h5 class="card-title text-light mb-0 h6">
                        <i class="bi bi-send-check me-2"></i>@UiText.L("Adm360.CotDet.OutboxTitulo") (@Model.Respostas.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush bg-dark">
                        @if (!Model.Respostas.Any())
                        {
                            <li class="list-group-item bg-dark text-white-50 py-3">@UiText.L("Adm360.CotDet.OutboxVazio")</li>
                        }
                        @foreach (var resp in Model.Respostas)
                        {
                            var badgeClass = resp.StatusTransmissao switch
                            {
                                "NA_FILA" => "pp-badge--info",
                                "ENVIANDO" => "pp-badge--warning",
                                "EXPORTADA_MANUALMENTE" => "pp-badge--success",
                                "CONFIGURACAO_PENDENTE" => "pp-badge--info",
                                "ACEITA_PELO_PORTAL" => "pp-badge--success",
                                "REJEITADA_PELO_PORTAL" => "pp-badge--danger",
                                "RESULTADO_DESCONHECIDO" => "pp-badge--neutral",
                                _ => "pp-badge--neutral"
                            };
                            var badgeTexto = resp.StatusTransmissao switch
                            {
                                "NA_FILA" => UiText.L("Adm360.CotDet.OutboxNaFila"),
                                "ENVIANDO" => UiText.L("Adm360.CotDet.OutboxEnviando"),
                                "EXPORTADA_MANUALMENTE" => UiText.L("Adm360.CotDet.OutboxExportada"),
                                "CONFIGURACAO_PENDENTE" => UiText.L("Adm360.CotDet.OutboxConfigPendente"),
                                "ACEITA_PELO_PORTAL" => UiText.L("Adm360.CotDet.OutboxAceita"),
                                "REJEITADA_PELO_PORTAL" => UiText.L("Adm360.CotDet.OutboxRejeitada"),
                                "RESULTADO_DESCONHECIDO" => UiText.L("Adm360.CotDet.OutboxDesconhecido"),
                                _ => resp.StatusTransmissao
                            };
                            var proximaAcao = resp.StatusTransmissao switch
                            {
                                "NA_FILA" => UiText.L("Adm360.CotDet.OutboxAcaoNaFila"),
                                "ENVIANDO" => UiText.L("Adm360.CotDet.OutboxAcaoEnviando"),
                                "ACEITA_PELO_PORTAL" => UiText.L("Adm360.CotDet.OutboxAcaoAceita"),
                                "REJEITADA_PELO_PORTAL" => UiText.L("Adm360.CotDet.OutboxAcaoRejeitada"),
                                "CONFIGURACAO_PENDENTE" => UiText.L("Adm360.CotDet.OutboxAcaoConfig"),
                                "RESULTADO_DESCONHECIDO" => UiText.L("Adm360.CotDet.OutboxAcaoDesconhecida"),
                                "EXPORTADA_MANUALMENTE" => UiText.L("Adm360.CotDet.OutboxAcaoExportada"),
                                _ => string.Empty
                            };

                            <li class="list-group-item bg-dark text-light border-secondary">
                                <div class="d-flex justify-content-between align-items-center mb-1 gap-2 flex-wrap">
                                    <div>
                                        <strong class="text-light">@UiText.L("Adm360.CotDet.TransmissaoPrefix")v@(resp.Revisao)</strong>
                                        <span class="pp-badge @badgeClass ms-1">@badgeTexto</span>
                                    </div>
                                    <div>
                                        @if (resp.StatusTransmissao == "NA_FILA")
                                        {
                                            <form method="post" action="/Administrativo360/Cotacoes/TransmitirResposta/@resp.Id?cotacaoId=@Model.Cotacao.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-send me-1"></i> @UiText.L("Adm360.CotDet.BtnTransmitirResposta")
                                                </button>
                                            </form>
                                        }
                                        else if (resp.StatusTransmissao is "REJEITADA_PELO_PORTAL" or "CONFIGURACAO_PENDENTE" or "EXPORTADA_MANUALMENTE")
                                        {
                                            <form method="post" action="/Administrativo360/Cotacoes/TransmitirResposta/@resp.Id?cotacaoId=@Model.Cotacao.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-arrow-repeat me-1"></i> @(resp.StatusTransmissao == "EXPORTADA_MANUALMENTE" ? UiText.L("Adm360.CotDet.BtnRetransmitir") : UiText.L("Adm360.CotDet.BtnRetentarEnvio"))
                                                </button>
                                            </form>
                                        }
                                        else if (resp.StatusTransmissao == "RESULTADO_DESCONHECIDO")
                                        {
                                            <form method="post" action="/Administrativo360/Cotacoes/TransmitirResposta/@resp.Id?cotacaoId=@Model.Cotacao.Id&confirmarRetransmissaoDesconhecido=true" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-arrow-repeat me-1"></i> @UiText.L("Adm360.CotDet.BtnConfirmarRetransmissao")
                                                </button>
                                            </form>
                                        }
                                        @if (Model.Cotacao.CanceladoEm is null
                                            && resp.StatusTransmissao is "ACEITA_PELO_PORTAL" or "REJEITADA_PELO_PORTAL" or "RESULTADO_DESCONHECIDO" or "EXPORTADA_MANUALMENTE")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#modalEstorno-@resp.Id">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> @UiText.L("Adm360.CotDet.BtnEstornar")
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="small text-white-50">
                                    @UiText.L("Adm360.CotDet.LblTentativas")@resp.Tentativas | @UiText.L("Adm360.CotDet.LblProtocolo")@(resp.ProtocoloExterno ?? UiText.L("Adm360.CotDet.StatusPendente"))
                                </div>
                                @if (!string.IsNullOrWhiteSpace(resp.MensagemRetorno))
                                {
                                    <div class="small text-info mt-1">@resp.MensagemRetorno</div>
                                }
                                @if (!string.IsNullOrEmpty(proximaAcao))
                                {
                                    <div class="small text-light opacity-75 mt-1">@proximaAcao</div>
                                }
                                @if (resp.ExportacaoId.HasValue)
                                {
                                    <div class="mt-2 d-flex align-items-center flex-wrap gap-2">
                                        <span class="pp-badge pp-badge--success"><i class="bi bi-file-earmark-lock me-1"></i>@UiText.L("Adm360.CotDet.BadgeArquivoImutavel")</span>
                                        <a href="/Administrativo360/Cotacoes/@Model.Cotacao.Id/Exportacao/@resp.Id" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-download me-1"></i> @UiText.L("Adm360.CotDet.BtnBaixarExportado")
                                        </a>
                                        <span class="small text-white-50" title="@resp.ExportacaoSha256Hash">SHA256: @(string.IsNullOrEmpty(resp.ExportacaoSha256Hash) ? "-" : resp.ExportacaoSha256Hash[..8])…</span>
                                        <div class="small text-white-50 w-100">@resp.ExportacaoNomeArquivo</div>
                                    </div>
                                }

                                <!-- C11.4: estorno da transmissão (somente resposta com resultado do portal e cotação ativa) -->
                                @if (Model.Cotacao.CanceladoEm is null
                                    && resp.StatusTransmissao is "ACEITA_PELO_PORTAL" or "REJEITADA_PELO_PORTAL" or "RESULTADO_DESCONHECIDO" or "EXPORTADA_MANUALMENTE")
                                {
                                    <div class="modal fade" id="modalEstorno-@resp.Id" tabindex="-1" aria-labelledby="modalEstornoLabel-@resp.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content bg-dark text-light border-secondary">
                                                <form method="post" action="/Administrativo360/Cotacoes/EstornarResposta/@resp.Id?cotacaoId=@Model.Cotacao.Id">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header border-secondary">
                                                        <h5 class="modal-title h6" id="modalEstornoLabel-@resp.Id">@UiText.L("Adm360.CotDet.EstornoModalTitulo")v@(resp.Revisao)</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@UiText.L("Implantacao.CloseAria")"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="small text-white-50 mb-3">@UiText.L("Adm360.CotDet.EstornoModalCorpo")</p>
                                                        <label for="estornoJustificativa-@resp.Id" class="form-label small fw-bold">@UiText.L("Adm360.CotDet.EstornoLblJustificativa")</label>
                                                        <textarea id="estornoJustificativa-@resp.Id" name="justificativa" rows="3" required minlength="10" maxlength="500" autofocus
                                                            class="form-control bg-dark text-light border-secondary"
                                                            placeholder="@UiText.L("Adm360.CotDet.EstornoPhJustificativa")"></textarea>
                                                        <div class="form-text text-white-50 small">@UiText.L("Adm360.CotDet.EstornoAjuda")</div>
                                                    </div>
                                                    <div class="modal-footer border-secondary">
                                                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@UiText.L("Shift.Back")</button>
                                                        <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-arrow-counterclockwise me-1"></i> @UiText.L("Adm360.CotDet.BtnConfirmarEstorno")</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <section class="pp-ai-panel" data-ai-panel data-ai-url="/Administrativo360/Cotacoes/@Model.Cotacao.Id/AnaliseIa" data-ai-method="POST" aria-labelledby="ppAiCotacaoTitulo">
            <div class="pp-ai-panel__head">
                <div><span class="pp-ai-panel__kicker">@UiText.L("Adm360.CotDet.AiKicker")</span><h2 id="ppAiCotacaoTitulo" class="pp-ai-panel__title"><i class="bi bi-stars me-1" aria-hidden="true"></i>@UiText.L("Adm360.CotDet.AiTituloPrefix")@Model.Cotacao.IdentificadorExterno</h2></div>
                <button type="button" class="btn btn-sm btn-primary" data-ai-run><i class="bi bi-lightning me-1" aria-hidden="true"></i>@UiText.L("Adm360.CotDet.AiBtnGerar")</button>
            </div>
            <p class="small text-muted">@UiText.L("Adm360.CotDet.AiDescricao")</p>
            <p class="pp-ai-panel__meta" data-ai-meta aria-live="polite"></p>
            <p class="pp-ai-panel__output" data-ai-output role="status">@UiText.L("Adm360.CotDet.AiVazio")</p>
            <pre class="pp-ai-panel__text" data-ai-text hidden></pre>
            <p class="pp-ai-panel__note">@Html.Raw(UiText.L("Adm360.CotDet.AiAjusteHtml"))</p>
        </section>
    </div>
</div>
@section Styles { <link rel="stylesheet" href="~/css/design-system/assistente-ia.css" asp-append-version="true" /> }
@section Scripts { <script type="module" src="~/js/ai-assistant-panel.js" asp-append-version="true"></script> }
