@model PlantaoPro.Web.Models.ConvitesPageViewModel
@{ ViewData["Title"] = "Central de convites"; var itens = Model.Items.ToList(); var pendentes = itens.Count(x => x.Status.Equals("pendente", StringComparison.OrdinalIgnoreCase)); var aceitos = itens.Count(x => x.Status.Equals("aceito", StringComparison.OrdinalIgnoreCase)); var recusados = itens.Count(x => x.Status.Equals("recusado", StringComparison.OrdinalIgnoreCase)); var respondidos = aceitos + recusados; var taxa = respondidos == 0 ? 0 : Math.Round(aceitos * 100m / respondidos); }
<div class="pp-page pp-operational-page">
  <header class="pp-hero pp-hero--operation">
    <div><span class="pp-eyebrow">Operação · Cobertura</span><h1>Central de convites</h1><p>Acompanhe respostas e mantenha cada plantão coberto em tempo real.</p><span class="pp-live-status"><i aria-hidden="true"></i> Operação monitorada</span></div>
    <div class="pp-hero__actions"><a class="button button-primary" asp-controller="CentralEscala" asp-action="Index"><app-icon name="Add" size="18" /> Convidar médicos</a></div>
  </header>
  <section class="pp-kpi-grid" aria-label="Indicadores de convites">
    @foreach (var kpi in new[] { ("Pendentes", pendentes.ToString(), "Aguardando resposta", "warning"), ("Aceitos", aceitos.ToString(), "Coberturas confirmadas", "success"), ("Recusados", recusados.ToString(), "Requerem nova ação", "danger"), ("Taxa de aceite", $"{taxa}%", "Sobre convites respondidos", "info") }) { <article class="pp-kpi-card pp-kpi-card--@kpi.Item4"><span>@kpi.Item1</span><strong>@kpi.Item2</strong><small>@kpi.Item3</small></article> }
  </section>
  <section class="pp-filter-panel" aria-labelledby="invite-filter-title">
    <div class="pp-section-heading"><div><span class="pp-eyebrow">Filtro inteligente</span><h2 id="invite-filter-title">Escolha o plantão</h2><p>O convite nasce na Cobertura Inteligente; aqui você acompanha o plantão selecionado.</p></div><a class="button button-subtle" asp-controller="CentralEscala" asp-action="Index">Localizar pela cobertura</a></div>
    <form method="get" class="pp-filter-form"><div><label class="form-label" for="plantaoId">Código do plantão</label><input class="form-control" id="plantaoId" name="plantaoId" type="text" value="@Model.PlantaoId" placeholder="Cole o código ao abrir por link" aria-describedby="plantao-help" required /><small id="plantao-help">Prefira selecionar o plantão pela Central de Escala.</small></div><button class="button button-primary" type="submit"><app-icon name="Filter" size="17" /> Aplicar</button></form>
  </section>
  @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
  @if (!Model.PlantaoId.HasValue || itens.Count == 0) { <section class="pp-empty-state"><div class="pp-empty-state__visual"><app-icon name="Coverage" size="30" /></div><span class="pp-eyebrow">Cobertura organizada</span><h2>Nenhum convite para acompanhar</h2><p>Selecione um plantão pela Central de Escala para convidar profissionais e acompanhar respostas.</p><a class="button button-primary" asp-controller="CentralEscala" asp-action="Index">Abrir Cobertura Inteligente</a></section> }
  else { <section aria-labelledby="invite-list-title"><div class="pp-section-heading"><div><span class="pp-eyebrow">Respostas</span><h2 id="invite-list-title">Convites deste plantão</h2></div><span class="pp-result-count">@itens.Count registro(s)</span></div><div class="pp-data-grid">@foreach (var item in itens) { <article class="pp-data-card"><div class="pp-data-card__top"><partial name="_StatusBadge" model="item.Status" /><time datetime="@item.DataEnvio.ToString("O")">Enviado @item.DataEnvio.ToString("dd/MM · HH:mm")</time></div><div class="pp-person"><span class="pp-avatar" aria-hidden="true">@(!string.IsNullOrWhiteSpace(item.MedicoNome) ? item.MedicoNome[0] : 'M')</span><div><h3>@item.MedicoNome</h3><small>Médico convidado</small></div></div><p class="pp-data-card__message">@item.Mensagem</p><dl class="pp-data-meta"><div><dt>Plantão</dt><dd>@item.PlantaoId.ToString()[..8]</dd></div><div><dt>Resposta</dt><dd>@(item.DataResposta?.ToString("dd/MM · HH:mm") ?? "Aguardando")</dd></div></dl><div class="pp-data-card__actions"><a class="button button-subtle" asp-controller="Plantoes" asp-action="Details" asp-route-id="@item.PlantaoId"><app-icon name="View" size="17" /> Abrir plantão</a><a class="button button-ghost" asp-controller="CentralEscala" asp-action="Index">Convidar outro</a></div></article> }</div></section> }
</div>
