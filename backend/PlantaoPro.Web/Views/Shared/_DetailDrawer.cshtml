<aside class="app-drawer pp-detail-drawer pp-future-drawer" data-pp-detail-drawer role="dialog" aria-modal="true" aria-labelledby="ppDetailDrawerTitle" aria-describedby="ppDetailDrawerSummary" tabindex="-1" hidden>
    <header><div><span class="pp-eyebrow" data-detail-kind>Detalhe operacional</span><h2 id="ppDetailDrawerTitle" data-detail-title>Detalhes</h2><span class="pp-detail-drawer__status" data-detail-status></span></div><button type="button" data-detail-close aria-label="Fechar painel de detalhes"><i class="bi bi-x-lg" aria-hidden="true"></i></button></header>
    <div class="drawer-body" data-detail-body aria-live="polite" aria-busy="false">
        <div class="pp-detail-drawer__loading" data-detail-loading role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Carregando contexto operacional…</div>
        <div data-detail-error role="alert" hidden>Não foi possível abrir os detalhes. Tente novamente.</div>
        <div data-detail-content hidden>
            <section aria-labelledby="ppDetailSummaryTitle"><h3 id="ppDetailSummaryTitle">Resumo</h3><p id="ppDetailDrawerSummary" data-detail-summary></p><dl class="pp-detail-drawer__metadata" data-detail-metadata></dl></section>
            <section aria-labelledby="ppDetailTimelineTitle"><h3 id="ppDetailTimelineTitle">Timeline e histórico</h3><ol class="pp-detail-drawer__timeline" data-detail-timeline></ol></section>
            <section aria-labelledby="ppDetailActionsTitle"><h3 id="ppDetailActionsTitle">Ações disponíveis</h3><div class="pp-detail-drawer__actions" data-detail-actions></div></section>
        </div>
    </div>
</aside>
