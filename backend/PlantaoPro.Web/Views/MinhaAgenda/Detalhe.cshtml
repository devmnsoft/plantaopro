@model PlantaoPro.Web.Models.DetailsPageViewModel<PlantaoPro.Web.Models.ProfessionalShiftDetailDto>
@using System.Globalization
@{ViewData["Title"]="Detalhe do plantão";var d=Model.Data;var back=ViewData["Retorno"] as string??Url.Action("Agenda");var culture=CultureInfo.GetCultureInfo("pt-BR");}
@section Styles { <link rel="stylesheet" href="~/css/pages/professional-portal.css" asp-append-version="true" /> }
<main class="professional-portal"><header class="page-intro"><span class="eyebrow">Agenda · detalhe autorizado</span><h1>Detalhe do plantão</h1><p>Revise participação, execução e financeiro sem confundir confirmação futura com trabalho executado.</p><a class="btn btn-outline-secondary" href="@back">Voltar à agenda com filtros</a></header>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
@if(d is null){<div class="portal-state portal-state--error" role="alert"><strong>Não foi possível carregar</strong><span>@Model.ErrorMessage</span></div>}else{
<section class="detail-sections"><article><h2>Resumo</h2><dl><div><dt>Unidade</dt><dd>@d.Plantao.HospitalNome</dd></div><div><dt>Função / especialidade</dt><dd>@d.Plantao.EspecialidadeNome</dd></div><div><dt>Início e término</dt><dd>@(d.Plantao.DataInicio?.ToString("dd/MM/yyyy HH:mm zzz")??"Não informado") – @(d.Plantao.DataFim?.ToString("dd/MM/yyyy HH:mm zzz")??"Não informado")</dd></div><div><dt>Situação operacional</dt><dd><span class="status-badge">@d.Plantao.Status</span></dd></div></dl></article>
<article><h2>Participação</h2><p>Esta alocação pertence ao profissional autenticado no cliente selecionado.</p><p>Confirmação: @(d.Plantao.ConfirmadoEm?.ToString("dd/MM/yyyy HH:mm zzz")??"ainda não registrada")</p>@if(d.Plantao.PodeConfirmar){<form asp-action="Confirmar" method="post" data-submit-once>@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.Plantao.EscalaId"/><input type="hidden" name="retorno" value="@back"/><p>Ao confirmar, você assume este compromisso futuro. Isso não registra execução nem gera pagamento.</p><button class="btn btn-primary btn-lg" type="submit">Confirmar plantão</button></form>}else{<p class="context-help">A confirmação não está disponível no estado atual. Atualize a página se a escala tiver sido alterada.</p>}</article>
<article><h2>Execução</h2>@if(d.Execucao is null){<p>Nenhum check-in ou check-out persistido.</p>}else{<dl><div><dt>Check-in</dt><dd>@(d.Execucao.CheckInEm?.ToString("dd/MM/yyyy HH:mm zzz")??"Pendente")</dd></div><div><dt>Check-out</dt><dd>@(d.Execucao.CheckOutEm?.ToString("dd/MM/yyyy HH:mm zzz")??"Pendente")</dd></div><div><dt>Conferência</dt><dd>@d.Execucao.StatusConferencia.Replace('_',' ')</dd></div></dl><a asp-action="Presencas" class="btn btn-outline-primary">Abrir execução e correções</a>}</article>
<article><h2>Financeiro</h2>@if(d.Financeiro is null){<p>Nenhum demonstrativo disponível. Confirmação e execução não comprovam apuração ou pagamento.</p>}else{<dl><div><dt>Previsto</dt><dd>@d.Financeiro.ValorPrevisto.ToString("C",culture)</dd></div><div><dt>Apurado</dt><dd>@d.Financeiro.ValorApurado.ToString("C",culture)</dd></div><div><dt>Pago</dt><dd>@(d.Financeiro.ValorPago?.ToString("C",culture)??"Não pago")</dd></div></dl><a asp-action="MeusPagamentos" class="btn btn-outline-primary">Abrir demonstrativos</a>}</article>
<article><h2>Histórico</h2>@if(!d.Historico.Any()){<p>Nenhum evento persistido com visibilidade para o profissional.</p>}else{<ol>@foreach(var e in d.Historico){<li><time datetime="@e.Data.ToString("O")">@e.Data.ToString("dd/MM/yyyy HH:mm zzz")</time> — @e.Acao · @e.Autoria</li>}</ol>}</article></section>}
<aside class="usage-help"><h2>Como usar</h2><p>Confira os horários antes da ação principal. Solicitações não removem sua responsabilidade até decisão do fluxo responsável; valores previstos não significam pagamento.</p></aside></main>
@section Scripts{<script>document.querySelectorAll('[data-submit-once]').forEach(f=>f.addEventListener('submit',()=>{const b=f.querySelector('button');b.disabled=true;b.setAttribute('aria-busy','true');b.textContent='Confirmando…'}));</script>}
