@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="@UiText.HtmlLang(Context)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09243c" />
    <title>@(ViewData["Title"] ?? UiText.L("Auth.LoginTitle")) - PlantãoPro</title>
    <link rel="icon" type="image/svg+xml" href="~/media/brand/favicon.svg" />
    <link rel="stylesheet" href="~/css/plantaopro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2000-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2010-screen-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2120-premium-final-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2121-saas-guided.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2130-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-login-v2127.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/demo-access.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2132-premium-global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2133-real-screens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2134-premium-qa.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2137-global-ux.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2141-premium-cockpit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2142-guided-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2143-qa-visual.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2144-responsive-safe-actions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2145-onboarding-help.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2148-operational-premium.css" asp-append-version="true" />
    <!-- R49: paridade com _Layout — linha canonica v2150 + azul AA do v2151 (#1d6fe9, ~4,7:1 p/ tinta branca) -->
    <link rel="stylesheet" href="~/css/design-system/v2150-bloco-c-canonical.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/v2151-wp-c-ajuste-canonical.css" asp-append-version="true" />
    <!-- R49: fundacao de acessibilidade (skip-link css, :focus-visible, prefers-reduced-motion) -->
    <link rel="stylesheet" href="~/css/design-system/accessibility.css" asp-append-version="true" />
</head>
<body class="pp-body pp-auth-body app-body">
    <a class="skip-link" href="#mainContent">@UiText.L("Common.SkipLink")</a>
    @if (Configuration.GetValue<bool>("Demo:Enabled") || Configuration.GetValue<bool>("DemoSeed:Enabled"))
    {
        <div class="auth-environment-notice" role="status"><span aria-hidden="true">●</span> @UiText.L("Auth.DemoNotice")</div>
    }
    <main id="mainContent" class="auth-main" tabindex="-1">
        <partial name="_ToastMessages" />
        @RenderBody()
    </main>
    <div class="pp-live-region" id="appLiveRegion" role="status" aria-live="polite" aria-atomic="true"></div>
    <script src="~/js/plantaopro-toast.js" asp-append-version="true"></script>
    <script src="~/js/plantaopro-ui.js" asp-append-version="true"></script>
    <script src="~/js/form-experience.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
