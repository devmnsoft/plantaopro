@model IEnumerable<PlantaoPro.Web.Models.PerfilWebViewModel>
@{ ViewData["Title"] = "Perfis e permissões"; ViewData["Subtitle"] = "Funções por cliente com acesso limitado ao contrato."; var profiles = Model.ToArray(); }
<div class="pp-page">
    <header class="pp-page-hero"><div class="pp-page-hero__copy"><span class="pp-eyebrow">Segurança por tenant</span><h2>Perfis de acesso</h2><p>Organize responsabilidades e aplique o princípio do menor privilégio por módulo.</p></div><a class="btn btn-primary" asp-action="Create"><app-icon name="Add" size="18" /> Novo perfil</a></header>
    <details class="pp-screen-guide"><summary><span><i class="bi bi-compass"></i><strong>Como usar esta tela</strong></span><span class="pp-screen-guide__hint">Orientação rápida</span></summary><div class="pp-screen-guide__body"><p>Perfis base são protegidos. Crie perfis personalizados, selecione somente permissões necessárias e atribua-os aos usuários do mesmo cliente.</p></div></details>
    @if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage as string)) { <div class="alert alert-danger" role="alert">@ViewBag.ErrorMessage</div> }
    <section class="pp-kpi-grid"><article class="pp-kpi-card"><span>Total</span><strong>@profiles.Length</strong><small>perfis visíveis</small></article><article class="pp-kpi-card"><span>Personalizados</span><strong>@profiles.Count(x => x.Customizado)</strong><small>gerenciados pelo cliente</small></article><article class="pp-kpi-card"><span>Base</span><strong>@profiles.Count(x => x.BaseSistema)</strong><small>protegidos pelo sistema</small></article><article class="pp-kpi-card"><span>Ativos</span><strong>@profiles.Count(x => x.Status == "ATIVO")</strong><small>disponíveis para atribuição</small></article></section>
    <section class="pp-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Perfil</th><th>Código</th><th>Tipo</th><th>Status</th><th class="text-end">Ações</th></tr></thead><tbody>
    @if (profiles.Length == 0) { <tr><td colspan="5"><div class="pp-empty-state"><h3>Nenhum perfil disponível</h3><p>Crie o primeiro perfil personalizado do cliente.</p><a class="btn btn-primary" asp-action="Create">Criar perfil</a></div></td></tr> }
    @foreach (var profile in profiles)
    {
        <tr><td><strong>@profile.Nome</strong><div class="text-muted small">@profile.Descricao</div></td><td><code>@profile.Codigo</code></td><td>@(profile.BaseSistema ? "Base" : "Personalizado")</td><td><span class="badge @(profile.Status == "ATIVO" ? "text-bg-success" : "text-bg-secondary")">@profile.Status</span></td><td><div class="pp-table-actions justify-content-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@profile.Id">Detalhes</a><a class="btn btn-sm btn-primary" asp-action="Permissoes" asp-route-id="@profile.Id">Permissões</a>@if (!profile.BaseSistema) { <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@profile.Id">Editar</a><form asp-action="Inativar" asp-route-id="@profile.Id" method="post" data-confirm="true" data-confirm-title="Inativar perfil" data-confirm-message="Usuários vinculados podem perder acesso no próximo login.">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" type="submit">Inativar</button></form> }</div></td></tr>
    }
    </tbody></table></div></section>
</div>
