@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";
    var loginReason = Context.Request.Query["reason"].ToString().ToLowerInvariant();
    var sessionMessage = loginReason switch
    {
        "expired" or "session-expired" => "Sua sessão expirou por segurança. Entre novamente para continuar.",
        "tenant-required" => "Não foi possível identificar sua instituição. Procure a administração do seu cliente.",
        "user-blocked" => "Seu acesso está temporariamente bloqueado. Procure a administração da sua instituição.",
        "tenant-blocked" => "O acesso da instituição está temporariamente indisponível. Procure a administração responsável.",
        "feature-blocked" => "Esta funcionalidade não está liberada para o seu perfil ou instituição.",
        "access-denied" => "Você não tem permissão para acessar o destino solicitado.",
        _ => null
    };
}
<div class="pp-auth-page pp-auth auth-experience">
    <div class="pp-auth-shell pp-auth__shell login-card-modern">
        <section class="pp-auth-brand-panel pp-auth-brand auth-story" aria-labelledby="authStoryTitle">
            <div class="auth-logo-surface">
                <img class="pp-auth-logo auth-logo" src="~/media/brand/logo-horizontal-color.svg" width="360" height="86" alt="PlantãoPro" />
            </div>
            <span class="pp-auth-kicker auth-product-tag">PlantãoPro por MNSOFT</span>
            <h1 id="authStoryTitle">Acesse sua central PlantãoPro</h1>
            <p>Escalas, plantões, equipes e financeiro em uma plataforma segura da MNSOFT.</p>
            <ul class="pp-auth-benefit-grid auth-benefits" aria-label="Benefícios da plataforma">
                <li><strong>Operação conectada</strong><span>Escalas, coberturas e convites sem perder contexto.</span></li>
                <li><strong>Jornada assistencial</strong><span>Do agendamento ao financeiro em um fluxo contínuo.</span></li>
                <li><strong>Governança nativa</strong><span>Permissões, segurança e rastreabilidade por tenant.</span></li>
            </ul>
            <div class="pp-auth-trust-row" aria-label="Compromissos da plataforma"><span><app-icon name="Lock" size="17" /> Acesso protegido</span><span><app-icon name="Triage" size="17" /> Jornada integrada</span><span><app-icon name="Coverage" size="17" /> Operação contínua</span></div>
        </section>
        <section class="pp-auth-form-panel pp-auth-panel auth-form-panel" aria-labelledby="loginTitle">
          <div class="pp-auth-card">
            <span class="pp-page-intro__eyebrow">Acesso seguro</span>
            <h2 id="loginTitle">Acesse sua central PlantãoPro</h2>
            <p>Use seu identificador cadastrado. Validaremos sua conta, perfil e instituição antes de abrir a área autorizada.</p>
            @if (!string.IsNullOrWhiteSpace(sessionMessage))
            {
                <div class="pp-auth-context-message" role="status" aria-live="polite"><app-icon name="Info" size="20" /><div><strong>Atenção ao seu acesso</strong><span>@sessionMessage</span></div></div>
            }
            <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" class="pp-form pp-login-form" novalidate data-login-form data-submit-loading="manual" data-focus-invalid>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1" data-login-errors></div>
                @if (ViewData.ModelState.ErrorCount == 0 && TempData["Error"] is string loginError && !string.IsNullOrWhiteSpace(loginError))
                {
                    <div class="pp-error-panel" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1" data-login-errors>@loginError</div>
                }
                <div class="pp-login-delay d-none" role="status" aria-live="polite" data-login-delay>
                    <app-icon name="Warning" size="20" />
                    <span><strong>A resposta está demorando.</strong> Seus dados foram preservados; confira sua conexão e tente novamente.</span>
                </div>
                <div class="pp-login-connection" role="status" aria-live="polite" data-connection-status hidden>
                    <span class="pp-login-connection__dot" aria-hidden="true"></span>
                    <span>Sem conexão. Reconecte-se para entrar com segurança.</span>
                </div>
                <div class="pp-login-progress" role="status" aria-live="polite" aria-atomic="true" data-login-progress hidden>
                    <span class="pp-login-progress__icon" aria-hidden="true"><app-icon name="Lock" size="18" /></span>
                    <span><strong data-login-progress-title>Acesso pronto</strong><small data-login-progress-detail>Preencha suas credenciais para validar conta, instituição e permissões.</small></span>
                </div>
                <div class="pp-form-field">
                    <label asp-for="Email" class="pp-form-label form-required">E-mail, CPF ou CNPJ</label>
                    <input asp-for="Email" class="pp-form-control" autocomplete="username" inputmode="text" maxlength="254" aria-describedby="emailHelp Email-error" required data-login-identifier />
                    <small id="emailHelp" class="form-help">Informe o identificador habilitado pela sua instituição, sem compartilhar suas credenciais.</small>
                    <span asp-validation-for="Email" class="pp-form-error" data-valmsg-for="Email" id="Email-error"></span>
                </div>
                <div class="pp-form-field">
                    <label asp-for="Senha" class="pp-form-label form-required">Senha</label>
                    <div class="pp-password-field">
                        <input asp-for="Senha" class="pp-form-control" type="password" id="senha" autocomplete="current-password" aria-describedby="passwordHelp capsLockWarning Senha-error" required />
                        <button class="btn auth-password-toggle" type="button" data-password-toggle aria-label="Mostrar senha" aria-pressed="false"><app-icon name="View" size="20" /></button>
                    </div>
                    <small id="passwordHelp" class="form-help">A senha diferencia letras maiúsculas e minúsculas.</small>
                    <div id="capsLockWarning" class="form-help d-none" role="status"><app-icon name="Warning" size="18" /> Caps Lock está ativado.</div>
                    <span asp-validation-for="Senha" class="pp-form-error" data-valmsg-for="Senha" id="Senha-error"></span>
                </div>
                <div class="pp-login-actions">
                    <button id="btnLogin" class="btn btn-primary btn-lg" type="submit" aria-busy="false" data-idle-label="Entrar">
                        <span class="label">Entrar</span><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                    </button>
                    <a asp-action="ForgotPassword" class="auth-recovery-link">Esqueci minha senha</a>
                </div>
            </form>
            <details class="pp-login-help">
                <summary>Como usar esta tela</summary>
                <p>Preencha os dois campos obrigatórios e selecione <strong>Entrar</strong>. O sistema abrirá somente os módulos do seu perfil e da sua instituição. Em caso de bloqueio ou contexto incorreto, procure a administração; nunca envie sua senha ao suporte.</p>
            </details>
            <div class="auth-security"><app-icon name="Lock" size="18" /><span>Acesso individual: não compartilhe sua senha. Eventos de autenticação podem ser registrados para segurança e auditoria.</span></div>
            <footer class="pp-login-footer"><span>MNSOFT · PlantãoPro v2.14.3</span><a asp-controller="Lgpd" asp-action="Politica">Privacidade</a></footer>
          </div>
        </section>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth-login.js" asp-append-version="true"></script>
}
