@model IReadOnlyList<PlantaoPro.Web.Models.WorkItemViewModel>
<section aria-labelledby="kanbanTitle"><div class="section-heading"><div><span class="eyebrow">Fluxo operacional</span><h2 id="kanbanTitle">Quadro de trabalho</h2></div><p>Arraste uma tarefa ou use “Mover para” pelo teclado.</p></div><div class="kanban-board" data-kanban-board>@foreach(var column in new[]{("ENTRADA","Entrada"),("PRIORIDADE","Prioridade"),("EM_ANDAMENTO","Em andamento"),("AGUARDANDO","Aguardando"),("CONCLUIDO","Concluído")}){<partial name="_KanbanColumn" model="(column.Item1,column.Item2,Model.Where(x=>x.Status==column.Item1).ToList())"/>}</div><p class="sr-only" data-kanban-live aria-live="polite"></p></section>
