@model PlantaoPro.Web.Models.PageIntroductionViewModel
<header class="pp-page-intro" aria-labelledby="pageTitle">
    <div class="pp-page-intro__copy">
        <span class="pp-page-intro__eyebrow">@Model.Eyebrow</span>
        <h1 id="pageTitle">@Model.Title</h1>
        <p>@Model.Description</p>
        <p class="pp-page-intro__benefit">@Model.Benefit</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ActionText))
    {
        <div class="pp-page-intro__actions">
            <a class="btn btn-primary" asp-controller="@Model.ActionController" asp-action="@Model.ActionName">@Model.ActionText</a>
        </div>
    }
    @if (Model.Steps is { Count: > 0 })
    {
        <details class="pp-how-it-works">
            <summary><span aria-hidden="true">?</span> Como usar esta tela</summary>
            <ol>
                @foreach (var step in Model.Steps) { <li>@step</li> }
            </ol>
        </details>
    }
</header>
