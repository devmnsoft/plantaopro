@model PlantaoPro.Web.Models.ListPageViewModel<PlantaoPro.Web.Models.MedicoPagamentoDto>
@using System.Globalization
@{ ViewData["Title"]="Meus demonstrativos"; var cultura=CultureInfo.GetCultureInfo("pt-BR"); string Money(decimal? v)=>v.HasValue?v.Value.ToString("C",cultura):"—"; var apurado=Model.Items.Sum(x=>x.ValorApurado);var aprovado=Model.Items.Sum(x=>x.ValorAprovado??0);var pago=Model.Items.Sum(x=>x.ValorPago??0);var saldo=Model.Items.Sum(x=>x.Saldo); }
@section Styles { <link rel="stylesheet" href="~/css/pages/professional-portal.css" asp-append-version="true" /><style>.statement-actions{display:flex;gap:.5rem;flex-wrap:wrap}.statement-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin-top:1rem}.statement-meta span{display:block;color:#526175;font-size:.8rem}.statement-meta strong{display:block;text-align:right}.usage-help{margin-top:1.5rem;background:#f5f8fc;border:1px solid #dce4ee;border-radius:.75rem;padding:1rem}.divergence-form{margin-top:1rem;display:grid;grid-template-columns:1fr auto;gap:.5rem}.payment-list article{break-inside:avoid}@@media(max-width:720px){.statement-meta{grid-template-columns:1fr 1fr}.divergence-form{grid-template-columns:1fr}}@@media print{header,nav,footer,.statement-actions,.divergence-form,.usage-help,.btn{display:none!important}.professional-portal{max-width:none!important}.payment-list article{border:1px solid #bbb!important;page-break-inside:avoid}.payment-list:before{content:'Demonstrativo financeiro do profissional — documento não fiscal';display:block;font-weight:700;margin-bottom:1rem}}</style> }
<main class="professional-portal"><header class="page-intro"><span class="eyebrow">Financeiro individual · dados persistidos</span><h1>Meus demonstrativos</h1><p>Origem, cálculo, fechamento e pagamento dos seus plantões. O período exibido é a <strong>data de execução do plantão</strong>.</p><div class="statement-actions"><button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir / salvar PDF</button></div></header>
@if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>}
<section class="metric-grid" aria-label="Resumo do conjunto carregado"><article><span>Apurado</span><strong>@Money(apurado)</strong></article><article><span>Aprovado para pagamento</span><strong>@Money(aprovado)</strong></article><article><span>Pago</span><strong>@Money(pago)</strong></article><article><span>Saldo persistido</span><strong>@Money(saldo)</strong></article></section>
@if (!Model.Items.Any()) { <div class="portal-state"><strong>Nenhum demonstrativo encontrado</strong><span>Itens aparecem somente depois que a apuração aprovada gera uma obrigação financeira.</span></div> }
else { <section class="payment-list" aria-label="Itens do demonstrativo">@foreach(var p in Model.Items){var status=p.Status?.ToLowerInvariant() switch{"pago"=>"Pago","aprovado"=>"Aprovado para pagamento","pendente"=>"Apurado",_=>p.Status??"Sem situação"};<article><div><span class="eyebrow">Execução em @p.DataPlantao.ToString("dd/MM/yyyy") · @p.EspecialidadeNome</span><h2>@p.HospitalNome</h2><p>Plantão considerado no fechamento <strong>@(p.FechamentoId.HasValue?p.FechamentoId.Value.ToString("N")[..8]:"ainda não vinculado")</strong>.</p><div class="statement-meta"><div><span>Horas/unidades</span><strong>@p.HorasReferencia.ToString("0.##",cultura)</strong></div><div><span>Valor/hora histórico</span><strong>@Money(p.ValorHora)</strong></div><div><span>Valor base</span><strong>@Money(p.ValorPrevisto)</strong></div><div><span>Valor apurado</span><strong>@Money(p.ValorApurado)</strong></div><div><span>Aprovado</span><strong>@Money(p.ValorAprovado)</strong></div><div><span>Pago / saldo</span><strong>@Money(p.ValorPago) / @Money(p.Saldo)</strong></div></div></div><div class="payment-value"><strong>@Money(p.ValorAprovado??p.ValorApurado)</strong><span class="status-badge">@status</span>@if(!string.IsNullOrWhiteSpace(p.FechamentoStatus)){<span class="status-badge">Fechamento: @p.FechamentoStatus.Replace('_',' ')</span>}@if(!string.IsNullOrWhiteSpace(p.ContestacaoStatus)){<span class="status-badge">Solicitação: @p.ContestacaoStatus</span>}</div>
@if(string.IsNullOrWhiteSpace(p.ContestacaoStatus)||p.ContestacaoStatus is "RESOLVIDA" or "CANCELADA"){<form asp-action="SolicitarAnalise" method="post" class="divergence-form" data-submit-lock>@Html.AntiForgeryToken()<input type="hidden" name="pagamentoId" value="@p.PagamentoId"/><div><label for="justificativa-@p.PagamentoId">Informar divergência neste item</label><textarea class="form-control" id="justificativa-@p.PagamentoId" name="justificativa" minlength="10" maxlength="500" required placeholder="Explique a divergência sem inserir dados sensíveis"></textarea></div><button class="btn btn-secondary" type="submit">Enviar para análise</button></form>}</article>}</section> }
<aside class="usage-help"><h2>Como usar esta página</h2><ol><li>Confira a execução, horas e valores persistidos de cada item.</li><li>Diferencie “apurado”, “aprovado para pagamento” e “pago”; previsão não comprova recebimento.</li><li>Se houver diferença, envie uma justificativa no próprio item. A solicitação não altera valores automaticamente e uma solicitação ativa impede duplicidade.</li><li>Use imprimir para gerar a visualização sem menus. Este demonstrativo não é comprovante bancário nem documento fiscal.</li></ol></aside>
</main>
@section Scripts{<script>document.querySelectorAll('[data-submit-lock]').forEach(f=>f.addEventListener('submit',()=>f.querySelectorAll('button').forEach(b=>{b.disabled=true;b.setAttribute('aria-busy','true')})));</script>}
