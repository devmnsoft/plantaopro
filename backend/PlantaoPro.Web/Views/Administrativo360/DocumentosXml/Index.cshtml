@model PlantaoPro.Web.Models.DocumentosXmlIndexViewModel
@{
    ViewData["Title"] = "Central de XML Recebidos — Administrativo 360";
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">
                <i class="bi bi-file-earmark-code text-info me-2"></i>Central de XML Recebidos (NF-e Modelo 55)
            </h2>
            <p class="text-muted small mb-0">Recepção de documentos fiscais emitidos contra o CNPJ, conferência com compras e recebimentos, e controle de quarentena.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Administrativo360/DocumentosXml/Importar" class="btn btn-primary">
                <i class="bi bi-upload me-1"></i> Importar XML Manual
            </a>
            <a href="/Administrativo360/DocumentosXml/Sincronizacao" class="btn btn-outline-info">
                <i class="bi bi-cloud-arrow-down me-1"></i> Sincronização DF-e
            </a>
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-2"><i class="bi bi-shield-check me-2"></i>Controle e Segurança de Documentos Fiscais</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">1. Validação Estrita</strong>
                    Apenas documentos com modelo 55 emitidos contra CNPJ autorizado do tenant são aceitos. DTD e entidades externas são desabilitados.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">2. Quarentena Automática</strong>
                    Documentos divergentes, sem destinatário autorizado ou com falhas de integridade entram em quarentena sem efeito operacional.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">3. Sem Duplicidade</strong>
                    A importação não duplica recebimentos nem contas a pagar automaticamente. Cada vínculo é auditado e idempotente.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">4. DF-e Sefaz</strong>
                    O transporte oficial respeita o NSU progressivo e o tempo de espera do Sefaz, prevenindo consumo indevido.
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body p-3">
            <form method="get" action="/Administrativo360/DocumentosXml" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-light small">Status Conferência</label>
                    <select name="status" class="form-select form-select-sm bg-dark text-light border-secondary">
                        <option value="">Todos</option>
                        <option value="PENDENTE" selected="@(Model.Status == "PENDENTE")">Pendente</option>
                        <option value="CONFERIDO" selected="@(Model.Status == "CONFERIDO")">Conferido</option>
                        <option value="VINCULADO" selected="@(Model.Status == "VINCULADO")">Vinculado a Recebimento</option>
                        <option value="DIVERGENTE" selected="@(Model.Status == "DIVERGENTE")">Divergente</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-light small">Quarentena</label>
                    <select name="quarentena" class="form-select form-select-sm bg-dark text-light border-secondary">
                        <option value="">Todos</option>
                        <option value="true" selected="@(Model.Quarentena == true)">Apenas em Quarentena</option>
                        <option value="false" selected="@(Model.Quarentena == false)">Apenas Válidos</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-sm btn-primary me-2">
                        <i class="bi bi-filter me-1"></i> Filtrar
                    </button>
                    <a href="/Administrativo360/DocumentosXml" class="btn btn-sm btn-outline-secondary">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Documentos -->
    <div class="card bg-dark border-secondary">
        <div class="card-header bg-dark border-secondary">
            <h5 class="card-title text-light mb-0 h6">
                Documentos Recebidos (@Model.Documentos.Count)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th>Chave de Acesso</th>
                            <th>Número / Série</th>
                            <th>Emissão</th>
                            <th>Emitente</th>
                            <th>Destinatário (CNPJ)</th>
                            <th>Valor Total</th>
                            <th>Tipo / Origem</th>
                            <th>Status Conferência</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Documentos.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    Nenhum documento fiscal encontrado.
                                </td>
                            </tr>
                        }
                        @foreach (var d in Model.Documentos)
                        {
                            <tr>
                                <td>
                                    <code class="text-info font-monospace small">@d.ChaveAcesso</code>
                                    @if (d.Quarentena)
                                    {
                                        <div><span class="badge bg-danger small">Quarentena: @d.MotivoQuarentena</span></div>
                                    }
                                </td>
                                <td>
                                    <strong class="text-light">@d.Numero</strong> / @d.Serie
                                    <div class="small text-muted">Mod @d.Modelo</div>
                                </td>
                                <td class="text-light small">@d.DataEmissao.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="text-light fw-bold">@d.EmitenteNome</div>
                                    <div class="small text-muted">@d.EmitenteCnpj</div>
                                </td>
                                <td>
                                    <div class="text-light">@d.DestinatarioNome</div>
                                    <div class="small text-warning">@d.DestinatarioCnpj</div>
                                </td>
                                <td>
                                    <strong class="text-light">R$ @d.ValorTotal.ToString("N2")</strong>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@d.TipoDocumento</span>
                                    <div class="small text-muted">@d.Origem</div>
                                </td>
                                <td>
                                    @switch (d.StatusConferencia)
                                    {
                                        case "VINCULADO":
                                            <span class="badge bg-success">Vinculado</span>
                                            break;
                                        case "CONFERIDO":
                                            <span class="badge bg-info text-dark">Conferido</span>
                                            break;
                                        case "DIVERGENTE":
                                            <span class="badge bg-danger">Divergente</span>
                                            break;
                                        default:
                                            <span class="badge bg-warning text-dark">Pendente</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Administrativo360/DocumentosXml/Detalhes/@d.Id" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye me-1"></i> Abrir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
