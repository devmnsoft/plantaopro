@model PlantaoPro.Web.Models.ListPageViewModel<PlantaoPro.Web.Models.PagamentoResumoDto>
@{ ViewData["Title"] = "Central de pagamentos"; var itens = Model?.Items?.ToList() ?? new(); var previsto = itens.Sum(x => x.ValorPrevisto); var valoresPagos = itens.Where(x => x.ValorPago.HasValue).Select(x => x.ValorPago!.Value).ToList(); var pago = valoresPagos.Sum(); var saldoConhecido = itens.Count > 0 && itens.All(x => x.ValorPago.HasValue); }
<div class="pp-page pp-finance-page">
 <header class="pp-hero pp-hero--finance"><div><span class="pp-eyebrow">Financeiro · Plantões realizados</span><h1>Central de pagamentos</h1><p>Visibilidade da origem à liquidação, com valores e prazos em um só lugar.</p><span class="pp-live-status"><i aria-hidden="true"></i> Conciliação acompanhada</span></div><div class="pp-hero__spotlight"><small>Saldo em aberto</small><strong>@(saldoConhecido ? (previsto - pago).ToString("C") : "Não informado")</strong><span>@(saldoConhecido ? "na página atual" : "há pagamentos sem valor liquidado informado")</span></div></header>
 <section class="row g-3 mb-4" aria-label="Indicadores financeiros">
  <div class="col-md-4"><article class="pp-kpi-card pp-kpi-card--info"><span>Previsto</span><strong>@previsto.ToString("C")</strong><small>Valor bruto da página</small></article></div>
  <div class="col-md-4"><article class="pp-kpi-card pp-kpi-card--warning"><span>Pendente</span><strong>@itens.Where(x => string.Equals(x.Status, "pendente", StringComparison.OrdinalIgnoreCase)).Sum(x => x.ValorPrevisto).ToString("C")</strong><small>Aguardando liquidação</small></article></div>
  <div class="col-md-4"><article class="pp-kpi-card pp-kpi-card--success"><span>Pago</span><strong>@(valoresPagos.Count > 0 ? pago.ToString("C") : "Não informado")</strong><small>Somente valores de liquidação retornados</small></article></div>
 </section>
 <section class="pp-filter-panel"><div class="pp-section-heading"><div><span class="pp-eyebrow">Competência e situação</span><h2>Refine a visão financeira</h2></div></div><form method="get" class="pp-filter-form pp-filter-form--finance"><div><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status"><option value="">Todos</option><option value="pendente">Pendente</option><option value="pago">Pago</option><option value="cancelado">Cancelado</option></select></div><div><label class="form-label" for="inicio">Início</label><input class="form-control" id="inicio" name="inicio" type="date" /></div><div><label class="form-label" for="fim">Fim</label><input class="form-control" id="fim" name="fim" type="date" /></div><button class="button button-primary" type="submit" aria-label="Filtrar pagamentos"><app-icon name="Filter" size="17" /> Filtrar</button></form></section>
 @if (itens.Count == 0) { <section class="pp-empty-state"><div class="pp-empty-state__visual"><app-icon name="Payment" size="30" /></div><span class="pp-eyebrow">Sem dados retornados</span><h2>Nenhum pagamento nesta competência</h2><p>A API financeira não retornou pagamentos para os filtros atuais. Nenhum valor, liquidação ou histórico foi estimado.</p><a class="btn btn-outline-primary" asp-controller="Financeiro" asp-action="Index">Revisar financeiro</a></section> }
 else { <section class="pp-table-panel" aria-labelledby="payment-table-title"><div class="pp-section-heading"><div><span class="pp-eyebrow">Composição</span><h2 id="payment-table-title">Pagamentos encontrados</h2></div><span class="pp-result-count">@itens.Count registro(s)</span></div><div class="table-responsive"><table class="pp-data-table"><thead><tr><th>Médico</th><th>Hospital / plantão</th><th>Competência</th><th class="pp-money">Previsto</th><th class="pp-money">Pago</th><th>Status</th><th>Previsão</th></tr></thead><tbody>@foreach(var item in itens){<tr><td data-label="Médico"><strong>@item.MedicoNome</strong><small>@item.MedicoCrm</small></td><td data-label="Hospital / plantão"><strong>@item.HospitalNome</strong><small>@item.EspecialidadeNome · @item.DataPlantao.ToString("dd/MM/yyyy")</small></td><td data-label="Competência">@item.DataPlantao.ToString("MM/yyyy")</td><td data-label="Previsto" class="pp-money"><strong>@item.ValorPrevisto.ToString("C")</strong></td><td data-label="Pago" class="pp-money">@(item.ValorPago.HasValue ? item.ValorPago.Value.ToString("C") : "Não informado")</td><td data-label="Status"><partial name="_StatusBadge" model="item.Status" /></td><td data-label="Previsão">@(item.DataPrevista?.ToString("dd/MM/yyyy") ?? "—")</td></tr>}</tbody></table></div></section> }
</div>
