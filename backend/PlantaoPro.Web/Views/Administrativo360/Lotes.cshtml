@model PlantaoPro.Web.Models.LotesIndexViewModel
@{
    ViewData["Title"] = "Lotes e Validades — Administrativo 360";
    var hoje = DateOnly.FromDateTime(DateTime.Today);
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    @if (!string.IsNullOrWhiteSpace(Model.Erro))
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><strong>Erro:</strong> @Model.Erro</div>
        </div>
    }

    <!-- Header Executivo -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 mb-1 text-dark fw-bold">Consulta de Lotes &amp; Rastreabilidade</h1>
            <p class="text-muted mb-0 small">
                Rastreamento cirúrgico de OPME por lote do fabricante, monitoramento de prazos de validade e controle de quarentena.
            </p>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#comoUsarLotes" aria-expanded="false">
                <i class="bi bi-info-circle me-1"></i> Como Usar
            </button>
        </div>
    </div>

    <!-- Guia Como Usar -->
    <div class="collapse mb-4" id="comoUsarLotes">
        <div class="card card-body bg-light border-0 shadow-sm rounded-3">
            <h6 class="fw-bold mb-2 text-primary"><i class="bi bi-shield-lock me-1"></i> Diretrizes de Rastreabilidade e Validade</h6>
            <ul class="mb-0 small text-secondary">
                <li><strong>Geração de Lote:</strong> Novos lotes são criados e registrados formalmente durante a etapa de Recebimento Físico de Compras.</li>
                <li><strong>Bloqueio de Validade:</strong> Lotes vencidos têm seu saldo disponível zerado automaticamente e são impedidos de expedição cirúrgica.</li>
                <li><strong>Filtros:</strong> Selecione um produto para auditar o histórico de lotes recebidos pela sua instituição.</li>
            </ul>
        </div>
    </div>

    <!-- Filtro por Produto -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Lotes" class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <select name="produtoId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todos os Produtos e Materiais</option>
                        @foreach (var prod in Model.Produtos)
                        {
                            <option value="@prod.Id" selected="@(Model.ProdutoId == prod.Id)">@prod.Sku — @prod.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-1">
                    <button type="submit" class="btn btn-secondary btn-sm flex-fill">Filtrar</button>
                    <a asp-action="Lotes" class="btn btn-outline-secondary btn-sm">Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Lotes -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                Lotes Registrados <span class="badge bg-secondary ms-1">@Model.Lotes.Count</span>
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th style="min-width: 140px;">Número do Lote</th>
                        <th style="min-width: 250px;">Produto / Material</th>
                        <th>Data de Fabricação</th>
                        <th>Data de Validade</th>
                        <th>Condição</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Lotes.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-tag fs-2 d-block mb-2 text-secondary"></i>
                                Nenhum lote registrado para o filtro selecionado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var lote in Model.Lotes)
                        {
                            bool vencido = lote.Validade.HasValue && lote.Validade.Value < hoje;
                            bool proximoVencimento = lote.Validade.HasValue && !vencido && lote.Validade.Value <= hoje.AddDays(30);

                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark font-monospace border">@lote.Codigo</span>
                                </td>
                                <td>
                                    <strong class="text-dark">@lote.ProdutoNome</strong>
                                </td>
                                <td class="text-muted">
                                    @(lote.Fabricacao.HasValue ? lote.Fabricacao.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td class="font-monospace">
                                    @if (lote.Validade.HasValue)
                                    {
                                        <span class="@(vencido ? "text-danger fw-bold" : (proximoVencimento ? "text-warning fw-bold" : "text-dark"))">
                                            @lote.Validade.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (vencido)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-x-circle me-1"></i> Vencido (Bloqueado)
                                        </span>
                                    }
                                    else if (proximoVencimento)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            <i class="bi bi-clock-history me-1"></i> Próximo do Vencimento
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i> Válido para Uso
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
