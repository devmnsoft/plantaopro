@model PlantaoPro.Web.Models.AdminSaasCockpitViewModel
@{
    ViewData["Title"] = "Cockpit SaaS MNSOFT";
    var resumo = Model.Resumo;
    var faturamento = Model.Faturamento;
    var alertas = (Model.Alertas ?? Array.Empty<PlantaoPro.Web.Models.ClienteAlertaSaasViewModel>()).ToArray();
    var modulos = (Model.Modulos ?? Array.Empty<PlantaoPro.Web.Models.SaasModuleViewModel>()).OrderByDescending(x => x.ClientesAtivos).ThenBy(x => x.Nome).ToArray();
    var totalClientes = resumo.ClientesAtivos + resumo.ClientesTrial + resumo.ClientesSuspensos + resumo.ClientesCancelados;
    var clientesBloqueados = resumo.ClientesSuspensos + resumo.ClientesCancelados;
    var statusOperacional = string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "Operacional" : "Atenção";
}

<div class="container-fluid py-3 pp-strategic-surface">
    <header class="pp-page-hero mb-3" aria-labelledby="admin-saas-title">
        <div class="pp-page-hero__copy">
            <span class="pp-eyebrow">Administração SaaS MNSOFT</span>
            <h1 id="admin-saas-title" class="h2 mb-2">Cockpit global</h1>
            <p class="mb-0">Visão consolidada de clientes, cobrança, módulos contratados, alertas e saúde operacional com escopo global auditável.</p>
        </div>
        <div class="pp-hero-actions">
            <a class="btn btn-outline-primary" asp-controller="Clientes" asp-action="Index"><app-icon name="Hospital" size="18" /> Clientes</a>
            <a class="btn btn-primary" asp-controller="FaturamentoSaas" asp-action="Index"><app-icon name="Finance" size="18" /> Cobranças</a>
        </div>
    </header>

    <section class="pp-global-scope-banner mb-3" role="note" aria-label="Contexto global ativo">
        <app-icon name="Security" size="20" />
        <div>
            <strong>Contexto global MNSOFT</strong>
            <span>Somente o Super Administrador visualiza todos os tenants. Ao selecionar um cliente, mantenha o banner de contexto em foco e registre a justificativa operacional.</span>
        </div>
        <a class="btn btn-sm btn-light" asp-controller="Auditoria" asp-action="Index"><app-icon name="Audit" size="17" /> Auditoria</a>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="status">@Model.ErrorMessage</div>
    }

    <details class="pp-screen-guide mb-3">
        <summary><span><i class="bi bi-compass" aria-hidden="true"></i><strong>Como usar esta tela</strong></span><span class="pp-screen-guide__hint">Escopo global MNSOFT</span></summary>
        <div class="pp-screen-guide__body">
            <p>Use o cockpit para priorizar clientes, módulos e cobranças que exigem ação administrativa. A tela é exclusiva para perfis globais autorizados e não deve ser aberta em operação comum do tenant.</p>
            <ol>
                <li>Revise KPIs de clientes, faturamento e faturas vencidas.</li>
                <li>Abra módulos ou cobranças antes de bloquear, desbloquear, cancelar ou contestar.</li>
                <li>Consulte auditoria após ações globais, troca de contexto ou alteração contratual.</li>
            </ol>
            <div class="pp-screen-guide__note">Não exponha dados sensíveis sem necessidade. Cliente bloqueado mantém acesso a faturas e suporte, mas operações normais ficam protegidas pelo guard SaaS.</div>
        </div>
    </details>

    <section class="row g-3 mb-4" aria-label="Indicadores SaaS globais">
        @foreach (var kpi in new[]
        {
            new { Label = "Total de clientes", Value = totalClientes.ToString(), Tone = "text-primary", Link = "Clientes", Action = "Index" },
            new { Label = "Clientes ativos", Value = resumo.ClientesAtivos.ToString(), Tone = "text-success", Link = "Clientes", Action = "Index" },
            new { Label = "Clientes bloqueados", Value = clientesBloqueados.ToString(), Tone = "text-warning", Link = "Clientes", Action = "Index" },
            new { Label = "Clientes inadimplentes", Value = resumo.ClientesRisco.ToString(), Tone = "text-danger", Link = "FaturamentoSaas", Action = "Inadimplencia" },
            new { Label = "Faturamento previsto", Value = (resumo.ReceitaPrevistaMes > 0 ? resumo.ReceitaPrevistaMes : faturamento.ReceitaPrevista).ToString("C"), Tone = "text-primary", Link = "FaturamentoSaas", Action = "Index" },
            new { Label = "Faturamento recebido", Value = (resumo.ReceitaRecebidaMes > 0 ? resumo.ReceitaRecebidaMes : faturamento.ReceitaRecebida).ToString("C"), Tone = "text-success", Link = "FaturamentoSaas", Action = "Index" },
            new { Label = "Faturas vencidas", Value = Math.Max(resumo.FaturasVencidas, faturamento.FaturasVencidas).ToString(), Tone = "text-danger", Link = "FaturamentoSaas", Action = "Inadimplencia" },
            new { Label = "Status operacional", Value = statusOperacional, Tone = statusOperacional == "Operacional" ? "text-success" : "text-warning", Link = "Observabilidade", Action = "Index" }
        })
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <a class="card h-100 text-decoration-none text-reset" asp-controller="@kpi.Link" asp-action="@kpi.Action">
                    <div class="card-body">
                        <span class="text-muted small">@kpi.Label</span>
                        <h2 class="h4 mb-0 @kpi.Tone">@kpi.Value</h2>
                    </div>
                </a>
            </div>
        }
    </section>

    <div class="row g-3">
        <section class="col-12 col-xl-7" aria-labelledby="modules-title">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 id="modules-title" class="h5 mb-0">Módulos mais contratados</h2>
                        <small class="text-muted">Catálogo, preço e adoção por tenant.</small>
                    </div>
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Modulos" asp-action="Index">Gerenciar módulos</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Módulo</th><th>Categoria</th><th class="text-end">Clientes</th><th class="text-end">Preço base</th><th>Status</th></tr></thead>
                        <tbody>
                        @if (!modulos.Any())
                        {
                            <tr><td colspan="5" class="text-muted p-4">Nenhum módulo retornado pela API.</td></tr>
                        }
                        else
                        {
                            foreach (var modulo in modulos.Take(8))
                            {
                                <tr>
                                    <td><strong>@modulo.Nome</strong><br /><small class="text-muted">@modulo.Codigo</small></td>
                                    <td>@modulo.Categoria</td>
                                    <td class="text-end">@modulo.ClientesAtivos</td>
                                    <td class="text-end">@modulo.PrecoBase.ToString("C")</td>
                                    <td><span class="badge bg-secondary">@modulo.Status</span></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="col-12 col-xl-5" aria-labelledby="alerts-title">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 id="alerts-title" class="h5 mb-0">Eventos críticos recentes</h2>
                        <small class="text-muted">Alertas de cobrança, segurança e operação.</small>
                    </div>
                    <span class="badge bg-light text-dark border">@alertas.Length abertos</span>
                </div>
                <div class="list-group list-group-flush">
                    @if (!alertas.Any())
                    {
                        <div class="list-group-item text-muted">Nenhum alerta aberto.</div>
                    }
                    else
                    {
                        foreach (var alerta in alertas.Take(8))
                        {
                            <a class="list-group-item list-group-item-action" asp-controller="Clientes" asp-action="Inteligencia" asp-route-id="@alerta.ClienteId">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong>@alerta.Titulo</strong>
                                    <span class="badge bg-secondary">@alerta.Severidade</span>
                                </div>
                                <small class="text-muted">@alerta.ClienteNome · @alerta.Tipo</small>
                            </a>
                        }
                    }
                </div>
            </div>
        </section>
    </div>

    <section class="row g-3 mt-1" aria-label="Ações de governança">
        <div class="col-12 col-md-4"><a class="card h-100 text-decoration-none text-reset" asp-controller="Usuarios" asp-action="Index"><div class="card-body"><h2 class="h6">Usuários por cliente</h2><p class="text-muted mb-0">Gerencie bloqueio, perfis e acesso por tenant.</p></div></a></div>
        <div class="col-12 col-md-4"><a class="card h-100 text-decoration-none text-reset" asp-controller="Auditoria" asp-action="Index"><div class="card-body"><h2 class="h6">Auditoria recente</h2><p class="text-muted mb-0">Revise ações críticas, bloqueios, billing e contexto assistido.</p></div></a></div>
        <div class="col-12 col-md-4"><a class="card h-100 text-decoration-none text-reset" asp-controller="Observabilidade" asp-action="Index"><div class="card-body"><h2 class="h6">Alertas de segurança</h2><p class="text-muted mb-0">Acompanhe negações, sessões e saúde operacional.</p></div></a></div>
    </section>
</div>
