@model PlantaoPro.Web.Models.NovaNotaPreEmissoesViewModel
@{
    ViewData["Title"] = "Nova Pré-Nota Fiscal — Administrativo 360";
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">
                <i class="bi bi-receipt me-2 text-warning"></i>Nova Pré-Nota Fiscal
            </h2>
            <p class="text-muted small mb-0">
                Criação em <strong>RASCUNHO</strong> com conferência de referências (A29): origem não-manual exige o
                documento de origem existente neste cliente.
            </p>
        </div>
        <a href="/Administrativo360/Fiscal/Notas" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Voltar para a Lista
        </a>
    </div>

    @if (Model.Erro is not null)
    {
        <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Erro</div>
    }

    <form method="post" action="/Administrativo360/Fiscal/SalvarNota" class="card bg-dark border-secondary mb-4">
        @Html.AntiForgeryToken()
        <div class="card-body p-3">
            <h6 class="text-light small fw-bold text-uppercase mb-2"><i class="bi bi-link-45deg me-1"></i>Origem do Documento</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label text-light small">Tipo de origem</label>
                    <select name="OrigemTipo" class="form-select form-select-sm bg-black text-light border-secondary">
                        @foreach (var origem in new[] { "MANUAL", "VENDA", "ORCAMENTO", "COTACAO" })
                        {
                            var selecionada = Model.OrigemTipo == origem;
                            <option value="@origem" selected="@(selecionada ? "selected" : null)">@origem</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label text-light small">Identificador do documento de origem (GUID)</label>
                    <input type="text" name="OrigemId" maxlength="36" value="@Model.OrigemId"
                           placeholder="00000000-0000-0000-0000-000000000000" class="form-control form-control-sm bg-black text-light border-secondary font-monospace" />
                    <div class="form-text text-secondary">Obrigatório quando a origem não for MANUAL — conferido no banco antes de criar (A29).</div>
                </div>
            </div>

            <h6 class="text-light small fw-bold text-uppercase mb-2"><i class="bi bi-person me-1"></i>Destinatário</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label text-light small">Nome / Razão Social *</label>
                    <input type="text" name="DestinatarioNome" maxlength="200" value="@Model.DestinatarioNome" required
                           placeholder="Hospital São Lucas Ltda" class="form-control form-control-sm bg-black text-light border-secondary" />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-light small">CPF/CNPJ do destinatário</label>
                    <input type="text" name="DestinatarioDocumento" maxlength="18" value="@Model.DestinatarioDocumento"
                           placeholder="Somente dígitos (opcional)" class="form-control form-control-sm bg-black text-light border-secondary font-monospace" />
                </div>
            </div>

            <h6 class="text-light small fw-bold text-uppercase mb-2">
                <i class="bi bi-list-ul me-1"></i>Itens da Pré-Nota
                <span class="text-secondary fw-normal">(linhas sem descrição são ignoradas; itens só são editáveis em rascunho)</span>
            </h6>
            <div class="row g-2 mb-1">
                <div class="col text-light small fw-bold">Descrição</div>
                <div class="col-2 text-light small fw-bold text-end">Qtd.</div>
                <div class="col-2 text-light small fw-bold text-end">Preço Unit.</div>
            </div>
            @for (var i = 0; i < Model.Itens.Count; i++)
            {
                var indice = i;
                <div class="row g-2 mb-1">
                    <div class="col">
                        <input type="text" name="Itens[@indice].Descricao" maxlength="200" value="@Model.Itens[indice].Descricao"
                               class="form-control form-control-sm bg-black text-light border-secondary" placeholder="Item @(indice + 1)" />
                    </div>
                    <div class="col-2">
                        <input type="number" step="any" min="0" name="Itens[@indice].Quantidade"
                               value="@Model.Itens[indice].Quantidade.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                               class="form-control form-control-sm bg-black text-light border-secondary text-end" />
                    </div>
                    <div class="col-2">
                        <input type="number" step="any" min="0" name="Itens[@indice].PrecoUnitario"
                               value="@Model.Itens[indice].PrecoUnitario.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)"
                               class="form-control form-control-sm bg-black text-light border-secondary text-end" />
                    </div>
                </div>
            }
        </div>
        <div class="card-footer bg-dark p-2 d-flex justify-content-between align-items-center">
            <span class="text-secondary small">Sem valores de tributos automáticos (A30) — apenas descrição, quantidade e preço.</span>
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-save me-1"></i>Criar Pré-Nota em Rascunho
            </button>
        </div>
    </form>
</div>
