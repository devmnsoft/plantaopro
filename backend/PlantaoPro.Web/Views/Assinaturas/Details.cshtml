@model PlantaoPro.Web.Models.AssinaturaSaasViewModel
@{ ViewData["Title"] = "Detalhes da assinatura"; }
<div class="pp-page">
    <header class="pp-page-hero">
        <div class="pp-page-hero__copy"><span class="pp-eyebrow">Assinatura SaaS</span><h1>@Model.ClienteNome</h1><p>Acompanhe plano, situação contratual e ações administrativas auditáveis.</p></div>
        <div class="pp-hero-actions"><a class="btn btn-outline-secondary" asp-action="Index">Voltar</a><a class="btn btn-outline-primary" asp-action="Uso" asp-route-id="@Model.Id">Ver uso do plano</a><a class="btn btn-primary" asp-action="AlterarPlano" asp-route-id="@Model.Id">Alterar plano</a></div>
    </header>
    <section class="pp-kpi-grid" aria-label="Resumo da assinatura">
        <article class="pp-kpi-card"><span>Plano contratado</span><strong>@Model.PlanoNome</strong><small>Catálogo comercial vigente</small></article>
        <article class="pp-kpi-card"><span>Status</span><strong>@Model.Status</strong><small>Situação atual do contrato</small></article>
        <article class="pp-kpi-card"><span>Valor contratado</span><strong>@Model.ValorContratado.ToString("C")</strong><small>Condição registrada na assinatura</small></article>
    </section>
    <section class="pp-card" aria-labelledby="sensitive-actions-title">
        <div class="pp-section-header"><div><span class="pp-eyebrow">Zona administrativa</span><h2 id="sensitive-actions-title">Ações sensíveis</h2><p>Cada mudança exige justificativa e confirmação antes do processamento.</p></div></div>
        <div class="row g-3">
            <div class="col-lg-4"><form asp-action="AlterarStatus" method="post" class="card h-100" data-confirm="true" data-confirm-title="Suspender assinatura" data-confirm-message="A assinatura ficará temporariamente indisponível. Deseja continuar?" data-confirm-type="warning">@Html.AntiForgeryToken()<div class="card-body"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="acao" value="suspender" /><label class="form-label" for="reason-suspend">Motivo da suspensão</label><textarea class="form-control mb-3" id="reason-suspend" name="justificativa" required maxlength="500"></textarea><button class="btn btn-outline-warning w-100" type="submit">Suspender assinatura</button></div></form></div>
            <div class="col-lg-4"><form asp-action="AlterarStatus" method="post" class="card h-100" data-confirm="true" data-confirm-title="Reativar assinatura" data-confirm-message="Confirma a retomada desta assinatura?" data-confirm-type="success">@Html.AntiForgeryToken()<div class="card-body"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="acao" value="reativar" /><label class="form-label" for="reason-reactivate">Motivo da reativação</label><textarea class="form-control mb-3" id="reason-reactivate" name="justificativa" required maxlength="500"></textarea><button class="btn btn-outline-success w-100" type="submit">Reativar assinatura</button></div></form></div>
            <div class="col-lg-4"><form asp-action="AlterarStatus" method="post" class="card h-100 border-danger-subtle" data-confirm="true" data-confirm-title="Cancelar assinatura" data-confirm-message="O cancelamento afeta o acesso aos módulos contratados. Revise a justificativa antes de continuar." data-confirm-type="danger">@Html.AntiForgeryToken()<div class="card-body"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="acao" value="cancelar" /><label class="form-label" for="reason-cancel">Motivo do cancelamento</label><textarea class="form-control mb-3" id="reason-cancel" name="justificativa" required maxlength="500"></textarea><button class="btn btn-outline-danger w-100" type="submit">Cancelar assinatura</button></div></form></div>
        </div>
    </section>
</div>
