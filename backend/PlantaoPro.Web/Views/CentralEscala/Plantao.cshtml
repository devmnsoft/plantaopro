@model PlantaoPro.Web.Models.PlantaoDetailsDto?
@* R7-D-F3: detalhe de plantão da Central de Escala em recursos localizados (UiTexts.resx x4). *@
@{
    ViewData["Title"] = UiText.L("Shift.DetailsTitle");
}

<div class="mb-3">
    <a asp-controller="CentralEscala" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> @UiText.L("Shift.Back")</a>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage</div>
}

@if (Model != null)
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@Model.HospitalNome</strong>
            <span class="badge text-bg-primary">@Model.Status</span>
        </div>
        <div class="card-body">
            <h4>@Model.EspecialidadeNome</h4>
            <p class="text-muted mb-2">@Model.HospitalCidade/@Model.HospitalEstado</p>
            <div class="row g-3">
                <div class="col-md-3"><small>@UiText.L("Shift.Start")</small><div>@Model.DataInicio.ToString("dd/MM/yyyy HH:mm")</div></div>
                <div class="col-md-3"><small>@UiText.L("Shift.End")</small><div>@Model.DataFim.ToString("dd/MM/yyyy HH:mm")</div></div>
                <div class="col-md-3"><small>@UiText.L("Shift.Vacancies")</small><div>@Model.VagasDisponiveis / @Model.Vagas</div></div>
                <div class="col-md-3"><small>@UiText.L("Shift.Value")</small><div>@Model.Valor.ToString("C")</div></div>
            </div>
            <hr />
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Plantoes" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">@UiText.L("Shift.FullDetails")</a>
                <a asp-controller="Escalas" asp-action="Index" asp-route-plantaoId="@Model.Id" class="btn btn-outline-success">@UiText.L("Shift.ShiftsLink")</a>
                <a asp-controller="Agenda" asp-action="Index" class="btn btn-outline-secondary">@UiText.L("Shift.AgendaLink")</a>
            </div>
        </div>
    </div>
}
