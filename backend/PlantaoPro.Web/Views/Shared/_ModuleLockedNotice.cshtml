@model string
<div class="alert alert-warning pp-access-notice d-flex align-items-start gap-3" role="status">
    <i class="bi bi-lock-fill fs-4" aria-hidden="true"></i>
    <div>
        <strong>Esta funcionalidade não está disponível no plano atual.</strong>
        <div>@(string.IsNullOrWhiteSpace(Model) ? "Compare os planos ou solicite a liberação comercial para continuar." : Model)</div>
        <a class="btn btn-sm btn-warning mt-2" asp-controller="MinhaAssinatura" asp-action="Upgrade">Solicitar upgrade</a>
    </div>
</div>
