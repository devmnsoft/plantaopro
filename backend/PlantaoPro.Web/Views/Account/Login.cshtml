@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";
}
<div class="pp-auth-page pp-auth auth-experience">
    <div class="pp-auth-shell pp-auth__shell login-card-modern">
        <section class="pp-auth-brand-panel pp-auth-brand auth-story" aria-labelledby="authStoryTitle">
            <div class="auth-logo-surface">
                <img class="pp-auth-logo auth-logo" src="~/media/brand/logo-horizontal-color.svg" width="360" height="86" alt="PlantãoPro" />
            </div>
            <span class="pp-auth-kicker auth-product-tag">Operação de saúde, sem ruído</span>
            <h1 id="authStoryTitle">Controle plantões, escalas e jornadas assistenciais em uma única central.</h1>
            <p>Uma plataforma médica para operação, atendimento e financeiro com segurança e rastreabilidade.</p>
            <ul class="pp-auth-benefit-grid auth-benefits" aria-label="Benefícios da plataforma">
                <li><strong>Operação conectada</strong><span>Escalas, coberturas e convites sem perder contexto.</span></li>
                <li><strong>Jornada assistencial</strong><span>Do agendamento ao financeiro em um fluxo contínuo.</span></li>
                <li><strong>Governança nativa</strong><span>Permissões, segurança e rastreabilidade por tenant.</span></li>
            </ul>
            <div class="pp-auth-trust-row" aria-label="Compromissos da plataforma"><span><app-icon name="Lock" size="17" /> Acesso protegido</span><span><app-icon name="Triage" size="17" /> Jornada integrada</span><span><app-icon name="Coverage" size="17" /> Operação contínua</span></div>
        </section>
        <section class="pp-auth-form-panel pp-auth-panel auth-form-panel" aria-labelledby="loginTitle">
          <div class="pp-auth-card">
            <span class="pp-page-intro__eyebrow">Acesso seguro</span>
            <h2 id="loginTitle">Entre na sua central</h2>
            <p>Use sua identidade individual. A instituição define o contexto, mas nunca substitui o seu usuário.</p>
            <div class="pp-login-context" aria-label="Contextos de acesso ao PlantãoPro">
                <div class="pp-login-context__status"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Acesso disponível: identidade individual por e-mail</div>
                <div class="pp-login-context__item is-current"><app-icon name="User" size="18" /><span><strong>Profissional ou gestor</strong>E-mail individual e senha</span></div>
                <div class="pp-login-context__item"><app-icon name="Hospital" size="18" /><span><strong>Contexto institucional</strong>O CNPJ identifica a organização; nunca funciona como senha ou usuário compartilhado</span></div>
                <div class="pp-login-context__item"><app-icon name="Lock" size="18" /><span><strong>Administração MNSOFT</strong>Identidade administrativa individual, autorizada e auditável</span></div>
            </div>
            <form asp-action="Login" method="post" id="loginForm" class="pp-form pp-login-form" novalidate data-focus-invalid>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" aria-live="assertive" tabindex="-1"></div>
                <div class="pp-form-field">
                    <label asp-for="Email" class="pp-form-label form-required">E-mail</label>
                    <input asp-for="Email" class="pp-form-control" autocomplete="username email" inputmode="email" maxlength="254" placeholder="nome@empresa.com.br" aria-describedby="emailHelp Email-error" />
                    <small id="emailHelp" class="form-help">Informe o e-mail vinculado ao seu acesso.</small>
                    <span asp-validation-for="Email" class="pp-form-error" data-valmsg-for="Email" id="Email-error"></span>
                </div>
                <div class="pp-form-field">
                    <label asp-for="Senha" class="pp-form-label form-required">Senha</label>
                    <div class="pp-password-field">
                        <input asp-for="Senha" class="pp-form-control" type="password" id="senha" autocomplete="current-password" aria-describedby="passwordHelp capsLockWarning Senha-error" />
                        <button class="btn auth-password-toggle" type="button" data-password-toggle aria-label="Mostrar senha" aria-pressed="false"><app-icon name="View" size="20" /></button>
                    </div>
                    <small id="passwordHelp" class="form-help">A senha diferencia letras maiúsculas e minúsculas.</small>
                    <div id="capsLockWarning" class="form-help d-none" role="status"><app-icon name="Warning" size="18" /> Caps Lock está ativado.</div>
                    <span asp-validation-for="Senha" class="pp-form-error" data-valmsg-for="Senha" id="Senha-error"></span>
                </div>
                <div class="pp-login-actions">
                    <button id="btnLogin" class="btn btn-primary btn-lg" type="submit">
                        <span class="label">Entrar com segurança</span><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                    </button>
                    <a asp-action="ForgotPassword" class="auth-recovery-link">Esqueci minha senha</a>
                </div>
            </form>
            <details class="pp-login-help">
                <summary>Como acessar com segurança</summary>
                <p>Entre com o e-mail cadastrado para você. CPF e CNPJ só serão solicitados quando o fluxo corporativo seguro estiver habilitado pelo servidor — nunca use credenciais compartilhadas.</p>
            </details>
            <div class="auth-security"><app-icon name="Lock" size="18" /><span>Acesso individual: não compartilhe sua senha. Eventos de autenticação podem ser registrados para segurança e auditoria.</span></div>
          </div>
        </section>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth-login.js" asp-append-version="true"></script>
}
