@{ ViewData["Title"] = "Produto"; }
<section class="pp-public-product" aria-labelledby="produto-title">
  <div class="pp-public-product__hero">
    <span class="pp-eyebrow">PlantãoPro</span>
    <h1 id="produto-title">Uma central para acompanhar a operação médica de ponta a ponta</h1>
    <p>Organize jornadas clínicas, escalas, rotinas financeiras e governança com os dados reais da sua organização.</p>
    <div class="pp-public-product__actions"><a class="btn btn-primary" asp-controller="Cadastro" asp-action="Empresa">Iniciar cadastro</a><a class="btn btn-outline-primary" asp-controller="PlanosPublicos" asp-action="Index">Consultar opções disponíveis</a></div>
  </div>
  <div class="pp-public-product__journey" aria-label="Jornada do produto">
    <article><span>01</span><h2>Configure</h2><p>Cadastre a organização e o administrador responsável.</p></article>
    <article><span>02</span><h2>Organize</h2><p>Centralize fluxos clínicos, operacionais e financeiros permitidos ao seu perfil.</p></article>
    <article><span>03</span><h2>Acompanhe</h2><p>Consulte estados e próximos passos gerados pelo backend, sem indicadores fabricados.</p></article>
  </div>
  <p class="pp-public-trust"><strong>Segurança desde o primeiro acesso.</strong> Use somente dados autorizados e credenciais individuais; disponibilidade de recursos depende da configuração e contratação reais.</p>
</section>
