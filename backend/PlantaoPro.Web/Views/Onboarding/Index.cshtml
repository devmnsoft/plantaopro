@{ ViewData["Title"] = "Onboarding SaaS"; }
<div class="pp-page">
<header class="pp-page-hero"><div class="pp-page-hero__copy"><span class="pp-eyebrow">Implantação orientada</span><h2>Onboarding de clientes</h2><p>Prepare a operação do tenant com uma sequência clara, segura e auditável.</p></div><div class="pp-hero-actions"><button type="button" class="btn btn-outline-primary" data-tour-start="implementation">Conhecer fluxo</button><a asp-action="NovoCliente" class="btn btn-primary"><i class="bi bi-plus-circle" aria-hidden="true"></i> Iniciar onboarding</a></div></header>
<details class="pp-screen-guide mb-3"><summary><span><i class="bi bi-compass" aria-hidden="true"></i><strong>Como usar esta tela</strong></span><span class="pp-screen-guide__hint">Implantação do cliente</span></summary><div class="pp-screen-guide__body"><p>Use o checklist na ordem sugerida; dados do cliente, unidade, plano e administrador são obrigatórios para ativar a operação.</p><ol><li>Cadastre o cliente e confirme o tenant.</li><li>Configure equipe, operação e financeiro.</li><li>Revise permissões, notificações e pendências antes da liberação.</li></ol><div class="pp-screen-guide__note"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Status “atenção” exige revisão; “bloqueado” depende de uma etapa anterior ou autorização MNSOFT.</div></div></details>
<section class="pp-implementation-summary" aria-labelledby="implementationTitle" data-tour-step="Visão da implantação|Acompanhe o que está concluído, o que exige atenção e qual é o próximo passo."><div><span class="pp-eyebrow">Checklist do cliente</span><h2 id="implementationTitle">Pronto para iniciar</h2><p>O progresso será vinculado ao cliente selecionado no fluxo, sem digitação manual de ID.</p></div><div class="pp-progress-ring" aria-label="0 por cento concluído"><strong>0%</strong><span>concluído</span></div></section>
<div class="pp-checklist-legend" aria-label="Legenda de status"><span><i class="bi bi-check-circle-fill text-success"></i> Concluído</span><span><i class="bi bi-circle text-secondary"></i> Pendente</span><span><i class="bi bi-exclamation-triangle-fill text-warning"></i> Atenção</span><span><i class="bi bi-lock-fill text-secondary"></i> Bloqueado</span></div>
<ol class="pp-implementation-list" aria-label="Etapas de implantação">
@foreach (var etapa in new[] { ("Dados do cliente", "Razão social, CNPJ, contatos e contrato.", "Disponível"), ("Unidades e hospitais", "Locais da operação e responsáveis.", "Bloqueado"), ("Especialidades", "Áreas atendidas em cada unidade.", "Bloqueado"), ("Usuários", "Contas individuais da equipe.", "Bloqueado"), ("Perfis e permissões", "Acesso mínimo necessário por função.", "Bloqueado"), ("Médicos e profissionais", "Documentação e disponibilidade.", "Bloqueado"), ("Escalas", "Períodos, equipes e regras.", "Bloqueado"), ("Plantões", "Vagas, valores e publicação.", "Bloqueado"), ("Financeiro", "Regras de pagamento e conferência.", "Bloqueado"), ("Notificações", "Canais e eventos importantes.", "Bloqueado"), ("Revisão final", "Validação de segurança e operação.", "Bloqueado") }) { <li class="pp-implementation-item @(etapa.Item3 == "Disponível" ? "is-next" : "is-locked")"><span class="pp-implementation-item__icon"><i class="bi @(etapa.Item3 == "Disponível" ? "bi-arrow-right" : "bi-lock")" aria-hidden="true"></i></span><span><strong>@etapa.Item1</strong><small>@etapa.Item2</small></span><span class="pp-status-pill">@etapa.Item3</span></li> }
</ol>
<aside class="pp-next-step" data-tour-step="Próximo passo recomendado|Inicie pelos dados oficiais do cliente; as etapas dependentes serão liberadas progressivamente."><i class="bi bi-stars" aria-hidden="true"></i><div><strong>Próximo passo recomendado</strong><p>Selecione “Iniciar onboarding” para cadastrar os dados oficiais do cliente e liberar as próximas configurações.</p></div><a asp-action="NovoCliente" class="btn btn-primary">Cadastrar cliente</a></aside>
</div>
