@model DashboardOverviewDto
@using PlantaoPro.Web.Security
@{
    ViewData["Title"] = "Painel operacional";
    var dadosDisponiveis = ViewData["DashboardDataAvailable"] as bool? == true;
    var indicadores = dadosDisponiveis ? Model?.Indicadores : null;
    var plantoes = (Model?.ProximosPlantoes ?? Enumerable.Empty<PlantaoPro.Web.Models.PlantaoResumoDto>()).OrderBy(x => x.DataInicio).ToArray();
    var pagamentos = (Model?.UltimosPagamentos ?? Enumerable.Empty<PagamentoResumoDto>()).ToArray();
    var notificacoes = (Model?.UltimasNotificacoes ?? Enumerable.Empty<NotificacaoDto>()).ToArray();
    var agora = DateTime.Now;
    var agendaHoje = plantoes.Where(x => x.DataInicio.Date == agora.Date).ToArray();
    var riscosCobertura = plantoes.Where(x => x.DataInicio >= agora && x.VagasDisponiveis > 0).ToArray();
    var nome = User.Identity?.Name;
    var perfil = User.IsAdmin() ? "Administração" : User.IsCoordenacao() ? "Coordenação" : User.IsMedico() ? "Médico" : User.IsFinanceiro() ? "Financeiro" : User.IsHospital() ? "Unidade hospitalar" : "Operação";
    var contextoPerfil = User.IsAdmin() ? "Governança SaaS, configurações e assinatura" : User.IsCoordenacao() ? "Cobertura, escalas, convites e fechamentos" : User.IsMedico() ? "Agenda, plantões e pagamentos vinculados" : User.IsFinanceiro() ? "Faturamento, glosas, repasses e pagamentos" : User.IsHospital() ? "Cobertura, equipes e solicitações da unidade" : "Agenda, check-in e triagem";
}

<div class="pp-page pp-dashboard-workspace">
    <header class="pp-page-hero" aria-labelledby="dashboard-title">
        <div class="pp-page-hero__copy">
            <span class="pp-eyebrow"><app-icon name="Dashboard" size="17" /> @perfil · @agora.ToString("dd 'de' MMMM")</span>
            <h1 id="dashboard-title">@(string.IsNullOrWhiteSpace(nome) ? "Visão operacional do dia" : $"Olá, {nome}. Veja sua operação hoje.")</h1>
            <p>Priorize coberturas, agenda e financeiro com indicadores retornados pela operação.</p>
        </div>
        <div class="pp-hero-actions">
            <a asp-controller="MeuDia" asp-action="Index" class="btn btn-outline-primary"><app-icon name="Check" size="18" /> Abrir Meu Dia</a>
            <a asp-controller="Agenda" asp-action="Index" class="btn btn-primary"><app-icon name="Calendar" size="18" /> Ver agenda</a>
        </div>
    </header>

    <section class="pp-profile-focus" aria-labelledby="profile-focus-title" data-profile-dashboard="@perfil">
        <div><span class="pp-section-kicker">Prioridade do perfil</span><h2 id="profile-focus-title">@perfil</h2><p>@contextoPerfil. As ações continuam condicionadas às permissões e aos dados retornados pelo servidor.</p></div>
        <a asp-controller="MinhaCentral" asp-action="Index" class="btn btn-primary">Ver próximas ações</a>
    </section>

    <form class="pp-filter-bar" method="get" asp-action="Dashboard" role="search" aria-label="Filtros do painel operacional">
        <div class="pp-filter-bar__heading"><div><span class="pp-section-kicker">Período e contexto</span><h2 class="h6 mb-0">Refine os indicadores</h2></div><a asp-action="Dashboard" class="btn btn-sm btn-link">Limpar filtros</a></div>
        <div class="pp-filter-grid">
            <div><label for="inicio" class="form-label">Data inicial</label><input id="inicio" type="date" name="inicio" value="@Context.Request.Query["inicio"]" class="form-control" /></div>
            <div><label for="fim" class="form-label">Data final</label><input id="fim" type="date" name="fim" value="@Context.Request.Query["fim"]" class="form-control" /></div>
            <div><label for="hospital" class="form-label">Hospital</label><input id="hospital" name="hospital" value="@Context.Request.Query["hospital"]" class="form-control" placeholder="Nome do hospital" /></div>
            <div><label for="especialidade" class="form-label">Especialidade</label><input id="especialidade" name="especialidade" value="@Context.Request.Query["especialidade"]" class="form-control" placeholder="Nome da especialidade" /></div>
        </div>
        <div class="pp-filter-bar__actions"><button type="submit" class="btn btn-primary"><app-icon name="Filter" size="18" /> Aplicar filtros</button></div>
    </form>

    <section class="pp-section" aria-labelledby="resumo-title">
        <div class="pp-section-heading"><div><h2 id="resumo-title">Resumo operacional</h2><p>Dados consolidados para o recorte selecionado.</p></div></div>
        @if (indicadores is null)
        {
            <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-bar-chart", "Resumo ainda não disponível", "A operação não retornou indicadores para o recorte selecionado. Nenhum valor foi presumido.")' />
        }
        else
        {
            <div class="pp-kpi-strip" aria-label="Indicadores retornados pela operação">
                <article class="pp-kpi-card"><span>Plantões</span><strong>@indicadores.TotalPlantoes</strong><small>@indicadores.PlantoesConfirmados confirmados</small></article>
                <article class="pp-kpi-card pp-kpi-card--warning"><span>Pagamentos pendentes</span><strong>@indicadores.PagamentosPendentes</strong><small>@indicadores.ValorPendente.ToString("C") previstos pela fonte</small></article>
                <article class="pp-kpi-card @(riscosCobertura.Any() ? "pp-kpi-card--danger" : "")"><span>Coberturas em risco</span><strong>@riscosCobertura.Length</strong><small>entre os plantões retornados</small></article>
                <article class="pp-kpi-card"><span>Agenda de hoje</span><strong>@agendaHoje.Length</strong><small>eventos retornados</small></article>
            </div>
        }
    </section>

    <div class="row g-4">
        <section class="col-12 col-xl-8" aria-labelledby="agenda-title">
            <div class="pp-section h-100"><div class="pp-section-heading"><div><h2 id="agenda-title">Agenda de hoje</h2><p>Plantões ordenados pelo próximo horário.</p></div><a asp-controller="Agenda" asp-action="Index" class="btn btn-sm btn-outline-primary">Agenda completa</a></div>
            @if (!agendaHoje.Any()) { <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-calendar2-check", "Nenhum plantão na agenda de hoje", "Não há plantões retornados para hoje. Consulte a agenda completa ou ajuste o período.", "Abrir agenda", "Index", "Agenda")' /> }
            else {
                <div class="pp-data-table d-none d-md-block"><div class="table-responsive"><table class="table align-middle mb-0"><caption class="visually-hidden">Plantões de hoje</caption><thead><tr><th>Horário</th><th>Hospital</th><th>Especialidade</th><th>Cobertura</th><th>Status</th><th></th></tr></thead><tbody>
                @foreach (var item in agendaHoje) { <tr><td><strong>@item.DataInicio.ToString("HH:mm")</strong><small>até @item.DataFim.ToString("HH:mm")</small></td><td>@item.HospitalNome</td><td>@item.EspecialidadeNome</td><td>@(item.Vagas - item.VagasDisponiveis)/@item.Vagas</td><td><partial name="_StatusBadge" model="item.Status" /></td><td><a asp-controller="Plantoes" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Abrir</a></td></tr> }
                </tbody></table></div></div>
                <div class="pp-mobile-card-list d-md-none">@foreach (var item in agendaHoje) { <article class="pp-operational-card"><header><div><span class="pp-section-kicker">@item.DataInicio.ToString("HH:mm")–@item.DataFim.ToString("HH:mm")</span><h3>@item.HospitalNome</h3><p>@item.EspecialidadeNome</p></div><partial name="_StatusBadge" model="item.Status" /></header><dl><div><dt>Cobertura</dt><dd>@(item.Vagas - item.VagasDisponiveis)/@item.Vagas</dd></div><div><dt>Valor</dt><dd>@item.Valor.ToString("C")</dd></div></dl><footer><a asp-controller="Plantoes" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary w-100">Abrir plantão</a></footer></article> }</div>
            }</div>
        </section>

        <section class="col-12 col-xl-4" aria-labelledby="risco-title">
            <div class="pp-section h-100"><div class="pp-section-heading"><div><h2 id="risco-title">Riscos e pendências</h2><p>Próximas coberturas incompletas.</p></div></div>
            @if (!riscosCobertura.Any()) { <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-shield-check", "Nenhum risco de cobertura identificado", "Os próximos plantões retornados não possuem vagas pendentes.")' /> }
            else { <div class="pp-stack-list">@foreach (var item in riscosCobertura.Take(5)) { <article class="pp-stack-item"><div><span class="pp-section-kicker">@item.DataInicio.ToString("dd/MM HH:mm")</span><h3 class="h6">@item.HospitalNome</h3><p class="mb-0">@item.VagasDisponiveis vaga(s) · @item.EspecialidadeNome</p></div><a asp-controller="Plantoes" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Resolver</a></article> }</div> }
            </div>
        </section>
    </div>

    <section class="pp-section" aria-labelledby="atalhos-title">
        <div class="pp-section-heading"><div><h2 id="atalhos-title">Operação médica</h2><p>Ações disponíveis nos módulos reais da jornada.</p></div></div>
        <div class="pp-action-grid">
            @if (User.IsAdmin()) { <a class="pp-action-card" asp-controller="AdminSaas" asp-action="Index"><span class="pp-action-card__icon"><app-icon name="Settings" size="22" /></span><h3>Admin SaaS</h3><p>Revise tenants, assinatura e saúde administrativa.</p><span class="pp-action-card__meta">Abrir administração <app-icon name="ChevronRight" size="17" /></span></a> }
            @if (User.IsCoordenacao() || User.IsHospital() || User.IsAdmin()) { <a class="pp-action-card" asp-controller="Plantoes" asp-action="Index"><span class="pp-action-card__icon"><app-icon name="Schedule" size="22" /></span><h3>Cobertura e escalas</h3><p>Priorize vagas, convites, substituições e fechamentos.</p><span class="pp-action-card__meta">Abrir plantões <app-icon name="ChevronRight" size="17" /></span></a> }
            @if (User.IsMedico() || (!User.IsAdmin() && !User.IsCoordenacao() && !User.IsHospital() && !User.IsFinanceiro())) { <a class="pp-action-card" asp-controller="Saude360" asp-action="Index"><span class="pp-action-card__icon"><app-icon name="Triage" size="22" /></span><h3>Jornada assistencial</h3><p>Acesse agenda, triagem, consulta e seus próximos passos.</p><span class="pp-action-card__meta">Abrir Saúde 360 <app-icon name="ChevronRight" size="17" /></span></a> }
            @if (User.IsFinanceiro() || User.IsAdmin() || User.IsHospital()) { <a class="pp-action-card" asp-controller="Financeiro" asp-action="Index"><span class="pp-action-card__icon"><app-icon name="Finance" size="22" /></span><h3>Financeiro</h3><p>Revise faturamento, divergências, fechamentos e pagamentos.</p><span class="pp-action-card__meta">Abrir financeiro <app-icon name="ChevronRight" size="17" /></span></a> }
            <a class="pp-action-card" asp-controller="MinhaCentral" asp-action="Index"><span class="pp-action-card__icon"><app-icon name="Dashboard" size="22" /></span><h3>Minha Central</h3><p>Priorize somente os itens reais atribuídos ao seu perfil.</p><span class="pp-action-card__meta">Ver pendências <app-icon name="ChevronRight" size="17" /></span></a>
        </div>
    </section>

    <div class="row g-4">
        <section class="col-12 col-lg-6" aria-labelledby="financeiro-title"><div class="pp-section h-100"><div class="pp-section-heading"><div><h2 id="financeiro-title">Movimentação financeira</h2><p>Últimos pagamentos retornados.</p></div><a asp-controller="Financeiro" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todos</a></div>
        @if (!pagamentos.Any()) { <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-receipt", "Nenhuma movimentação financeira", "Não há pagamentos disponíveis no recorte atual.")' /> } else { <div class="pp-stack-list">@foreach (var item in pagamentos.Take(5)) { <article class="pp-stack-item"><div><strong>@item.MedicoNome</strong><p class="mb-0">@item.HospitalNome · @item.DataPlantao.ToString("dd/MM")</p></div><div class="text-end"><strong>@item.ValorPrevisto.ToString("C")</strong><br /><partial name="_StatusBadge" model="item.Status" /></div></article> }</div> }</div></section>
        <section class="col-12 col-lg-6" aria-labelledby="timeline-title"><div class="pp-section h-100"><div class="pp-section-heading"><div><h2 id="timeline-title">Linha do tempo operacional</h2><p>Notificações recentes da sua operação.</p></div><a asp-controller="Notificacoes" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todas</a></div>
        @if (!notificacoes.Any()) { <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-bell-slash", "Nenhuma atualização recente", "Novas movimentações da operação aparecerão aqui.")' /> } else { <ol class="pp-timeline">@foreach (var item in notificacoes.Take(5)) { <li><span aria-hidden="true"></span><div><div class="d-flex justify-content-between gap-2"><strong>@item.Titulo</strong><time datetime="@item.RegDate.ToString("O")">@item.RegDate.ToString("dd/MM HH:mm")</time></div><p>@item.Mensagem</p><small>@(item.Lida ? "Lida" : "Não lida")</small></div></li> }</ol> }</div></section>
    </div>
</div>
