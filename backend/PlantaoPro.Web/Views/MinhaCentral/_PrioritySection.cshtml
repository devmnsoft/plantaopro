@model IReadOnlyList<PlantaoPro.Web.Models.WorkItemViewModel>
@{var priorities=Model.Where(x=>x.Priority is "CRITICA" or "URGENTE").Take(4).ToList();}
<section class="priority-strip" aria-labelledby="priorityTitle"><div><span class="eyebrow">Decisões</span><h2 id="priorityTitle">Prioridades</h2></div>@if(priorities.Count==0){<p>Nenhuma pendência crítica exige uma decisão agora.</p>}else{<ul>@foreach(var item in priorities){<li><button type="button" data-work-item-open="@item.Id">@item.Title <span>@item.Priority</span></button></li>}</ul>}</section>
