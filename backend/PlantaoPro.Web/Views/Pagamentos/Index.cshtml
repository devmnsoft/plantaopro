@model PlantaoPro.Web.Models.ListPageViewModel<PlantaoPro.Web.Models.PagamentoResumoDto>
@{ ViewData["Title"] = "Central de pagamentos"; var itens = Model?.Items?.ToList() ?? new(); var previsto = itens.Sum(x => x.ValorPrevisto); var valoresPagos = itens.Where(x => x.ValorPago.HasValue).Select(x => x.ValorPago!.Value).ToList(); var pago = valoresPagos.Sum(); var saldoConhecido = itens.Count > 0 && itens.All(x => x.ValorPago.HasValue); }
<div class="pp-page pp-finance-page">
 <nav class="pp-financial-journey" aria-label="Jornada financeira" data-financial-mvp-journey><span>Faturamento</span><span>Financeiro</span><span>Glosa / contestação</span><span class="is-current">Pagamento</span><span>Repasse</span><span>Relatório</span></nav>
 <header class="pp-hero pp-hero--finance"><div><span class="pp-eyebrow">Financeiro · Plantões realizados</span><h1>Central de pagamentos</h1><p>Visibilidade da origem à liquidação, com valores e prazos em um só lugar.</p><span class="pp-live-status"><i aria-hidden="true"></i> Conciliação acompanhada</span></div><div class="pp-hero__spotlight"><small>Saldo em aberto</small><strong>@(saldoConhecido ? (previsto - pago).ToString("C") : "Não informado")</strong><span>@(saldoConhecido ? "na página atual" : "há pagamentos sem valor liquidado informado")</span></div></header>
 <section class="pp-financial-summary" aria-label="Indicadores financeiros">
  <article class="pp-kpi-card pp-kpi-card--info"><span>Previsto</span><strong>@previsto.ToString("C")</strong><small>Valor bruto da página</small></article>
  <article class="pp-kpi-card pp-kpi-card--warning"><span>Pendente</span><strong>@itens.Where(x => string.Equals(x.Status, "pendente", StringComparison.OrdinalIgnoreCase)).Sum(x => x.ValorPrevisto).ToString("C")</strong><small>Aguardando liquidação</small></article>
  <article class="pp-kpi-card pp-kpi-card--success"><span>Pago</span><strong>@(valoresPagos.Count > 0 ? pago.ToString("C") : "Não informado")</strong><small>Liquidações retornadas</small></article>
  <article class="pp-kpi-card"><span>Rejeitado</span><strong>@itens.Count(x => string.Equals(x.Status, "rejeitado", StringComparison.OrdinalIgnoreCase))</strong><small>Sem continuidade</small></article>
 </section>
 <section class="pp-premium-filter"><div class="pp-section-heading"><div><span class="pp-eyebrow">Competência e situação</span><h2>Refine a visão financeira</h2><p>Selecione período, profissional, unidade e status.</p></div></div><form method="get" class="filter-grid"><div><label for="inicio">Data inicial</label><input class="form-control" id="inicio" name="inicio" type="date" value="@Context.Request.Query["inicio"]" /><small class="form-text">Início da competência</small></div><div><label for="fim">Data final</label><input class="form-control" id="fim" name="fim" type="date" value="@Context.Request.Query["fim"]" /><small class="form-text">Fim da competência</small></div><div><label for="medicoId">Profissional</label><select class="form-select" id="medicoId" name="medicoId"><option value="">Todos</option>@foreach(var p in itens.DistinctBy(x=>x.MedicoId).OrderBy(x=>x.MedicoNome)){<option value="@p.MedicoId">@p.MedicoNome</option>}</select></div><div><label for="hospitalId">Unidade</label><select class="form-select" id="hospitalId" name="hospitalId"><option value="">Todas</option>@foreach(var h in itens.DistinctBy(x=>x.HospitalId).OrderBy(x=>x.HospitalNome)){<option value="@h.HospitalId">@h.HospitalNome</option>}</select></div><div><label for="status">Status</label><select class="form-select" id="status" name="status"><option value="">Todos</option><option value="pendente">Pendente</option><option value="pago">Pago</option><option value="rejeitado">Rejeitado</option><option value="cancelado">Cancelado</option></select></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit"><app-icon name="Filter" size="17" /> Aplicar</button><a class="btn btn-outline-secondary" asp-action="Index">Limpar</a></div></form><div class="pp-filter-summary" aria-live="polite"><strong>Resumo:</strong><span>@(string.IsNullOrWhiteSpace(Context.Request.Query["status"])?"todos os status":Context.Request.Query["status"].ToString())</span><span>· período @(string.IsNullOrWhiteSpace(Context.Request.Query["inicio"])?"não limitado":"selecionado")</span></div></section>
 @if (itens.Count == 0) { <section class="pp-empty-state" data-payment-value-honest data-glosa-rules data-repasse-rules><div class="pp-empty-state__visual"><app-icon name="Payment" size="30" /></div><span class="pp-eyebrow">Sem dados retornados</span><h2>Nenhum pagamento nesta competência</h2><p>A ausência de registros não é convertida em pagamento pendente, pago ou saldo zero. Glosas, comprovantes e repasses também só aparecem quando retornados pela API.</p><a class="btn btn-outline-primary" asp-controller="Financeiro" asp-action="Index">Revisar financeiro</a></section> }
 else { <section class="pp-table-panel" aria-labelledby="payment-table-title" data-payment-value-honest data-financial-next-action><div class="pp-section-heading"><div><span class="pp-eyebrow">Composição</span><h2 id="payment-table-title">Pagamentos encontrados</h2></div><span class="pp-result-count">@itens.Count registro(s)</span></div><div class="table-responsive"><table class="pp-data-table"><thead><tr><th>Médico</th><th>Hospital / plantão</th><th>Competência</th><th class="pp-money">Previsto</th><th class="pp-money">Pago</th><th>Status</th><th>Previsão</th></tr></thead><tbody>@foreach(var item in itens){<tr><td data-label="Médico"><strong>@item.MedicoNome</strong><small>@item.MedicoCrm</small></td><td data-label="Hospital / plantão"><strong>@item.HospitalNome</strong><small>@item.EspecialidadeNome · @item.DataPlantao.ToString("dd/MM/yyyy")</small></td><td data-label="Competência">@item.DataPlantao.ToString("MM/yyyy")</td><td data-label="Previsto" class="pp-money"><strong>@item.ValorPrevisto.ToString("C")</strong></td><td data-label="Pago" class="pp-money">@(item.ValorPago.HasValue ? item.ValorPago.Value.ToString("C") : "Não informado")</td><td data-label="Status"><partial name="_StatusBadge" model="item.Status" /></td><td data-label="Previsão">@(item.DataPrevista?.ToString("dd/MM/yyyy") ?? "—")</td></tr>}</tbody></table></div></section> }
</div>
