@model PlantaoPro.Web.Models.ListPageViewModel<PlantaoPro.Web.Models.ProfessionalCheckInDto>
@{ ViewData["Title"]="Execução dos meus plantões"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/professional-portal.css" asp-append-version="true" /> }
<main class="professional-portal" aria-labelledby="page-title">
 <header class="page-intro"><span class="eyebrow">Espaço do profissional</span><h1 id="page-title">Execução dos meus plantões</h1><p>Registre entrada e saída da sua alocação. Esses registros são operacionais e somente se tornam horas aprovadas após conferência.</p><p class="context-help"><strong>Como funciona:</strong> o servidor registra o recebimento. Correções preservam o original e dependem da decisão de um gestor autorizado.</p></header>
 @if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="portal-state portal-state--error" role="alert"><strong>Falha ao consultar execuções</strong><span>@Model.ErrorMessage</span><a class="btn btn-outline-primary" asp-action="Presencas">Tentar novamente</a></div>}
 else if(!Model.Items.Any()){<div class="portal-state"><strong>Nenhum plantão elegível</strong><span>Plantões confirmados aparecem aqui perto do horário de início.</span></div>}
 <section class="payment-list" aria-label="Plantões confirmados">
 @foreach(var p in Model.Items){var action=p.PodeCheckOut?"checkout":"checkin";<article class="execution-card">
  <header class="execution-card__header"><div><span class="eyebrow">@p.DataInicio.ToString("dd/MM/yyyy")</span><h2>@p.HospitalNome</h2><p>@p.EspecialidadeNome</p></div><span class="status-badge">@p.StatusConferencia.Replace('_',' ')</span></header>
  <dl class="execution-times"><div><dt>Horário previsto</dt><dd>@p.DataInicio.ToString("HH:mm zzz") – @p.DataFim.ToString("dd/MM HH:mm zzz")</dd></div><div><dt>Horário registrado</dt><dd>@(p.CheckInEm?.ToString("dd/MM HH:mm zzz")??"Entrada pendente") – @(p.CheckOutEm?.ToString("dd/MM HH:mm zzz")??"Saída pendente")</dd></div><div><dt>Horário proposto</dt><dd>@(p.InicioPropostoEm?.ToString("dd/MM HH:mm zzz")??"—") – @(p.FimPropostoEm?.ToString("dd/MM HH:mm zzz")??"—")</dd></div><div><dt>Horário aprovado</dt><dd>@(p.InicioAprovadoEm?.ToString("dd/MM HH:mm zzz")??"Aguardando conferência") – @(p.FimAprovadoEm?.ToString("dd/MM HH:mm zzz")??"—")</dd></div></dl>
  <form asp-action="RegistrarPresenca" method="post" class="primary-operation" data-submit-once>@Html.AntiForgeryToken()<input type="hidden" name="escalaId" value="@p.EscalaId"/><input type="hidden" name="operacao" value="@action"/><button class="btn btn-primary btn-lg" type="submit" disabled="@(!p.PodeCheckIn&&!p.PodeCheckOut)">@(p.PodeCheckOut?"Registrar saída":p.PodeCheckIn?"Registrar entrada":p.StatusConferencia=="CORRECAO_PENDENTE"?"Acompanhar conferência":"Aguardando horário")</button></form>
  @if(p.CheckInEm.HasValue&&p.StatusConferencia!="CORRECAO_PENDENTE"&&p.StatusConferencia!="APROVADA"){<details class="correction-panel"><summary>Solicitar correção</summary><form asp-action="SolicitarCorrecao" method="post" data-submit-once>@Html.AntiForgeryToken()<input type="hidden" name="escalaId" value="@p.EscalaId"/><input type="hidden" name="versao" value="@p.Versao"/><div class="field-row"><label>Entrada proposta<input name="inicioPropostoEm" type="datetime-local" /></label><label>Saída proposta<input name="fimPropostoEm" type="datetime-local" /></label></div><label>Justificativa<textarea name="justificativa" maxlength="1000" required aria-describedby="correction-help"></textarea></label><small id="correction-help">O registro original será preservado. O gestor comparará os valores antes de decidir.</small><button class="btn btn-outline-primary" type="submit">Enviar para conferência</button></form></details>}
 </article>}
 </section>
</main>
@section Scripts {<script>document.querySelectorAll('[data-submit-once]').forEach(form=>form.addEventListener('submit',()=>{const button=form.querySelector('button[type="submit"]');if(button){button.disabled=true;button.setAttribute('aria-busy','true');button.textContent='Processando…';setTimeout(()=>{button.disabled=false;button.removeAttribute('aria-busy')},15000)}}));</script>}
