@model PlantaoPro.Web.Models.Administrativo360PageViewModel
@{ ViewData["Title"]="Administrativo 360"; }
<div class="container-fluid py-4">
 <div class="d-flex justify-content-between align-items-start mb-4"><div><span class="badge bg-primary mb-2">Base administrativa</span><h1 class="h2 mb-1">Administrativo 360</h1><p class="text-muted">Cadastros organizacionais e contratos de trabalho da sua empresa.</p></div></div>
 @if(!string.IsNullOrWhiteSpace(Model.Erro)){<div class="alert alert-danger" role="alert">@Model.Erro</div>}
 <div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card shadow-sm h-100"><div class="card-body"><small class="text-muted">Departamentos</small><div class="display-6">@Model.Resumo.Departamentos</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card shadow-sm h-100"><div class="card-body"><small class="text-muted">Cargos</small><div class="display-6">@Model.Resumo.Cargos</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card shadow-sm h-100"><div class="card-body"><small class="text-muted">Colaboradores ativos</small><div class="display-6">@Model.Resumo.ColaboradoresAtivos</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card shadow-sm h-100"><div class="card-body"><small class="text-muted">Contratos vigentes</small><div class="display-6">@Model.Resumo.ContratosVigentes</div></div></div></div>
 </div>
 <div class="row g-4">
  <div class="col-xl-7"><div class="card shadow-sm"><div class="card-header"><strong>Colaboradores</strong></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Matrícula</th><th>Nome</th><th>Cargo</th><th>Departamento</th><th>Status</th></tr></thead><tbody>@foreach(var item in Model.Colaboradores){<tr><td>@item.Matricula</td><td><strong>@item.Nome</strong><br/><small class="text-muted">@item.Email</small></td><td>@item.Cargo</td><td>@(item.Departamento??"—")</td><td><span class="badge bg-success">@item.Status</span></td></tr>} @if(Model.Colaboradores.Count==0){<tr><td colspan="5" class="text-center text-muted py-4">Nenhum colaborador cadastrado.</td></tr>}</tbody></table></div></div></div>
  <div class="col-xl-5"><div class="card shadow-sm"><div class="card-header"><strong>Contratos</strong></div><div class="list-group list-group-flush">@foreach(var item in Model.Contratos){<div class="list-group-item"><div class="d-flex justify-content-between"><strong>@item.Colaborador</strong><span class="badge bg-primary">@item.Tipo</span></div><small class="text-muted">Desde @item.Inicio.ToString("dd/MM/yyyy") · @item.CargaHorariaSemanal h/semana</small><div>@item.Salario.ToString("C")</div></div>} @if(Model.Contratos.Count==0){<div class="p-4 text-center text-muted">Nenhum contrato cadastrado.</div>}</div></div></div>
 </div>
 <div class="card shadow-sm mt-4"><div class="card-header"><strong>Novos cadastros</strong></div><div class="card-body"><div class="row g-4">
  <form asp-action="Departamento" method="post" class="col-lg-3"><h2 class="h6">Departamento</h2><input class="form-control mb-2" name="codigo" maxlength="30" placeholder="Código" required/><input class="form-control mb-2" name="nome" maxlength="120" placeholder="Nome" required/><button class="btn btn-primary w-100">Cadastrar</button></form>
  <form asp-action="Cargo" method="post" class="col-lg-3"><h2 class="h6">Cargo</h2><input class="form-control mb-2" name="codigo" maxlength="30" placeholder="Código" required/><input class="form-control mb-2" name="nome" maxlength="120" placeholder="Nome" required/><select class="form-select mb-2" name="departamentoId"><option value="">Sem departamento</option>@foreach(var d in Model.Departamentos){<option value="@d.Id">@d.Nome</option>}</select><button class="btn btn-primary w-100">Cadastrar</button></form>
  <form asp-action="Colaborador" method="post" class="col-lg-3"><h2 class="h6">Colaborador</h2><input class="form-control mb-2" name="matricula" placeholder="Matrícula" required/><input class="form-control mb-2" name="nome" placeholder="Nome" required/><input class="form-control mb-2" name="cpf" pattern="[0-9]{11}" placeholder="CPF (11 dígitos)" required/><input class="form-control mb-2" type="email" name="email" placeholder="E-mail" required/><select class="form-select mb-2" name="cargoId" required><option value="">Cargo</option>@foreach(var c in Model.Cargos.Where(x=>x.Ativo)){<option value="@c.Id">@c.Nome</option>}</select><button class="btn btn-primary w-100">Cadastrar</button></form>
  <form asp-action="Contrato" method="post" class="col-lg-3"><h2 class="h6">Contratação</h2><select class="form-select mb-2" name="colaboradorId" required><option value="">Colaborador</option>@foreach(var p in Model.Colaboradores.Where(x=>x.Status=="ATIVO")){<option value="@p.Id">@p.Nome</option>}</select><select class="form-select mb-2" name="tipo"><option>CLT</option><option>PJ</option><option>ESTAGIO</option><option>TEMPORARIO</option></select><input class="form-control mb-2" type="date" name="inicio" required/><input class="form-control mb-2" type="number" name="salario" min="0.01" step="0.01" placeholder="Salário" required/><input class="form-control mb-2" type="number" name="cargaHorariaSemanal" min="1" max="60" value="40" required/><button class="btn btn-success w-100">Contratar</button></form>
 </div></div></div>
</div>
