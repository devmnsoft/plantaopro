@model OnboardingJornadaWebViewModel
@{ ViewData["Title"] = "Onboarding SaaS"; }
<div class="pp-page">
<header class="pp-page-hero"><div class="pp-page-hero__copy"><span class="pp-eyebrow">Implantação orientada ao contrato</span><h2>Onboarding de clientes</h2><p>O checklist abaixo é gerado dos módulos efetivamente contratados e só é concluído quando os dados correspondentes existem no ambiente — nada de etapa marcada por clique vazio.</p></div><div class="pp-hero-actions">@if (!Model.SemContextoCliente && !Model.SemOnboarding){<form asp-action="Reavaliar" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-primary"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Reavaliar agora</button></form>}<a asp-action="NovoCliente" class="btn btn-primary"><i class="bi bi-plus-circle" aria-hidden="true"></i> Novo cliente com plano</a></div></header>

@if (Model.SuccessMessage is not null){<div class="alert alert-success" role="status">@Model.SuccessMessage</div>}
@if (Model.ErrorMessage is not null){<div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>}
@if (Model.InfoMessage is not null){<div class="alert alert-info" role="note">@Model.InfoMessage</div>}

@if (Model.SemContextoCliente)
{
    <aside class="pp-next-step"><i class="bi bi-building" aria-hidden="true"></i><div><strong>Sem cliente selecionado</strong><p>O onboarding pertence a um cliente (tenant). Crie um novo cliente com plano para gerar a jornada adaptada ao contrato, ou selecione um cliente existente em AdminSaaS.</p></div><a asp-action="NovoCliente" class="btn btn-primary">Cadastrar cliente</a></aside>
}
else if (Model.SemOnboarding)
{
    <section class="pp-section"><div><span class="pp-eyebrow">Ponto de partida</span><h2>Onboarding ainda não iniciado</h2><p>Ao iniciar, o sistema monta o checklist a partir do catálogo canônico: etapas gerais da implantação mais as etapas dos módulos que este cliente realmente contratou. A conclusão de cada etapa é verificada em dados persistidos.</p></div>
        <form asp-action="Iniciar" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-primary"><i class="bi bi-play-circle" aria-hidden="true"></i> Iniciar onboarding</button></form>
    </section>
}
else
{
    var finalizado = Model.Status == "FINALIZADO";
    <section class="pp-section pp-implementation-summary">
        <div><span class="pp-eyebrow">Checklist do cliente</span><h2>@(finalizado ? "Onboarding finalizado" : "Jornada em andamento")</h2><p>@if (!finalizado && !string.IsNullOrEmpty(Model.ProximaAcao)){<text>Próximo passo: <strong>@Model.ProximaAcao</strong>.</text>}else{<text>Todas as etapas obrigatórias foram verificadas em dados reais.</text>}</p></div>
        <div class="pp-progress-ring" aria-label="@Model.Progresso por cento concluído"><strong>@Model.Progresso%</strong><span>concluído</span></div>
    </section>
    <div class="pp-checklist-legend" aria-label="Legenda de status"><span><i class="bi bi-check-circle-fill text-success"></i> Concluída (verificada em dados)</span><span><i class="bi bi-circle text-warning"></i> Pendente</span><span><i class="bi bi-lock-fill text-secondary"></i> Bloqueada por pré-requisito</span><span><i class="bi bi-skip-end-circle-fill text-info"></i> Pulada (opcional)</span></div>

    @foreach (var grupo in Model.Grupos)
    {
        <h3 class="mt-4"><i class="bi @(grupo.Geral ? "bi-clipboard-check" : "bi-boxes")" aria-hidden="true"></i> @grupo.ModuloNome</h3>
        <ol class="pp-implementation-list" aria-label="Etapas de @grupo.ModuloNome">
            @foreach (var e in grupo.Itens)
            {
                <li class="pp-implementation-item @(e.Status == "PENDENTE" ? "is-next" : e.Status == "BLOQUEADO" ? "is-locked" : "")">
                    <span class="pp-implementation-item__icon">
                        @if (e.Status == "CONCLUIDO"){<i class="bi bi-check-circle-fill text-success" aria-hidden="true"></i>}
                        else if (e.Status == "PULADA"){<i class="bi bi-skip-end-circle-fill text-info" aria-hidden="true"></i>}
                        else if (e.Status == "BLOQUEADO"){<i class="bi bi-lock-fill text-secondary" aria-hidden="true"></i>}
                        else {<i class="bi bi-circle text-warning" aria-hidden="true"></i>}
                    </span>
                    <span>
                        <strong>@e.Titulo</strong>
                        <small class="d-block">@e.Objetivo</small>
                        @if (!string.IsNullOrWhiteSpace(e.Descricao) && e.Descricao != e.Objetivo){<small class="d-block">@e.Descricao</small>}
                        <small class="d-block text-muted"><i class="bi bi-person-badge" aria-hidden="true"></i> Responsável: @(e.Responsavel == "MNSOFT" ? "MNSOFT (implantação)" : "cliente")@(e.Obrigatorio ? "" : " · opcional")</small>
                        @if (!e.PreRequisitoAtendido){<small class="d-block text-secondary"><i class="bi bi-lock" aria-hidden="true"></i> Depende da etapa anterior deste módulo.</small>}
                        @if (!string.IsNullOrWhiteSpace(e.CriterioDescricao)){<small class="d-block text-muted"><i class="bi bi-clipboard2-check" aria-hidden="true"></i> Critério: @e.CriterioDescricao</small>}
                        @if (!string.IsNullOrWhiteSpace(e.Evidencia)){<small class="d-block"><em>@e.Evidencia</em></small>}
                    </span>
                    <span class="d-flex flex-column gap-1 align-items-end">
                        <span class="pp-status-pill">@(e.Status == "CONCLUIDO" ? "Concluída" : e.Status == "PULADA" ? "Pulada" : e.Status == "BLOQUEADO" ? "Bloqueada" : "Pendente")</span>
                        @if (!string.IsNullOrEmpty(e.LinkAcao) && (e.Status == "PENDENTE" || e.Status == "BLOQUEADO")){<a class="btn btn-sm btn-outline-primary" href="@e.LinkAcao">Abrir tela</a>}
                        @if (e.Status == "PENDENTE"){
                            <form asp-action="ConcluirEtapa" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><button type="submit" class="btn btn-sm btn-success">Concluir</button></form>
                        }
                        @if (!e.Obrigatorio && (e.Status == "PENDENTE" || e.Status == "BLOQUEADO")){
                            <form asp-action="PularEtapa" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><input type="text" name="justificativa" class="form-control form-control-sm" style="max-width:180px" placeholder="Justificativa" aria-label="Justificativa para pular"/><button type="submit" class="btn btn-sm btn-outline-secondary">Pular</button></form>
                        }
                        @if (e.Pulada){
                            <form asp-action="RestaurarEtapa" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><button type="submit" class="btn btn-sm btn-outline-secondary">Restaurar</button></form>
                        }
                    </span>
                </li>
            }
        </ol>
    }
}
</div>
