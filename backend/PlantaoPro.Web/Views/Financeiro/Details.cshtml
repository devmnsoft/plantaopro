@model PlantaoPro.Web.Models.DetailsPageViewModel<PlantaoPro.Web.Models.PagamentoDetailsDto>
@{
    var pg = Model.Data;
    ViewData["Title"] = "Detalhes do pagamento";
    var status = (pg?.Status ?? "pendente").Trim().ToLowerInvariant();
    var statusIcon = status switch { "pago" => "bi-check-circle-fill", "cancelado" or "recusado" => "bi-x-octagon-fill", _ => "bi-clock-history" };
    var statusText = string.IsNullOrWhiteSpace(pg?.Status) ? "Pendente" : pg.Status;
    var pixSeguro = string.IsNullOrWhiteSpace(pg?.ChavePix) ? "Não informada" : $"•••• •••• {pg.ChavePix[^Math.Min(4, pg.ChavePix.Length)..]}";
}

<main class="pp-finance-page pp-payment-detail" aria-labelledby="payment-title">
    <partial name="_PageHeader" model='new PlantaoPro.Web.Models.PageHeaderViewModel("Detalhes do pagamento", "Visão completa, segura e rastreável do lançamento financeiro.", "bi-cash-coin")' />

    @if (pg is null)
    {
        if (!string.IsNullOrWhiteSpace(Model.ErrorMessage) && Model.ErrorMessage != "Detalhamento em preparação.")
        {
            <section class="pp-payment-state pp-payment-state--error" role="alert">
                <i class="bi bi-cloud-slash" aria-hidden="true"></i>
                <div><h2>Não foi possível carregar o pagamento</h2><p>@Model.ErrorMessage</p></div>
                <a asp-action="Index" class="btn btn-outline-primary">Voltar ao financeiro</a>
            </section>
        }
        else
        {
            <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-receipt", "Pagamento não encontrado", "O lançamento não existe ou não está disponível no tenant selecionado.", "Voltar ao financeiro", "Index", "Financeiro")' />
        }
        return;
    }

    <section class="pp-payment-hero pp-payment-hero--@status" aria-labelledby="payment-title">
        <div>
            <span class="pp-payment-eyebrow">Lançamento financeiro</span>
            <h1 id="payment-title">@pg.MedicoNome</h1>
            <p><i class="bi bi-hospital" aria-hidden="true"></i> @pg.HospitalNome · @pg.EspecialidadeNome</p>
        </div>
        <div class="pp-payment-status-block">
            <span class="pp-payment-status status-@status"><i class="bi @statusIcon" aria-hidden="true"></i> @statusText</span>
            <small>Registrado em @pg.RegDate.ToString("dd/MM/yyyy 'às' HH:mm")</small>
        </div>
    </section>

    <div class="pp-financial-detail-grid mt-3">
        <div class="d-grid gap-3">
            <section class="pp-payment-card" aria-labelledby="payment-values-title">
                <div class="pp-payment-card__heading"><i class="bi bi-wallet2" aria-hidden="true"></i><div><h2 id="payment-values-title">Resumo financeiro</h2><p>Valores e datas deste pagamento.</p></div></div>
                <dl class="pp-payment-values">
                    <div><dt>Valor bruto</dt><dd>@pg.ValorBruto.ToString("C")</dd></div>
                    <div><dt>Valor previsto</dt><dd>@pg.ValorPrevisto.ToString("C")</dd></div>
                    <div><dt>Descontos</dt><dd>@pg.Descontos.ToString("C")</dd></div>
                    <div><dt>Acréscimos</dt><dd>@pg.Acrescimos.ToString("C")</dd></div>
                    <div><dt>Valor líquido</dt><dd>@(pg.ValorLiquido?.ToString("C") ?? "Ainda não calculado")</dd></div>
                    <div class="@(pg.ValorPago.HasValue ? "is-paid" : "is-pending")"><dt>Valor pago</dt><dd>@(pg.ValorPago?.ToString("C") ?? "Aguardando pagamento")</dd></div>
                    <div><dt>Data prevista</dt><dd>@(pg.DataPrevista?.ToString("dd/MM/yyyy") ?? "Não definida")</dd></div>
                    <div><dt>Data do pagamento</dt><dd>@(pg.DataPagamento?.ToString("dd/MM/yyyy") ?? "Ainda não pago")</dd></div>
                </dl>
            </section>

            <section class="pp-payment-card" aria-labelledby="payment-shift-title">
                <div class="pp-payment-card__heading"><i class="bi bi-calendar2-week" aria-hidden="true"></i><div><h2 id="payment-shift-title">Plantão e profissional</h2><p>Origem operacional do lançamento.</p></div></div>
                <dl class="pp-financial-facts">
                    <div><dt>Médico</dt><dd>@(pg.MedicoNome ?? "Não informado")</dd></div>
                    <div><dt>CRM / UF</dt><dd>@(string.IsNullOrWhiteSpace(pg.MedicoCrm) ? "Não informado" : $"{pg.MedicoCrm}/{pg.MedicoUfCrm}")</dd></div>
                    <div><dt>Hospital / unidade</dt><dd>@(pg.HospitalNome ?? "Não informado")<small>@pg.HospitalCidade / @pg.HospitalEstado</small></dd></div>
                    <div><dt>Especialidade</dt><dd>@(pg.EspecialidadeNome ?? "Não informada")</dd></div>
                    <div><dt>Início do plantão</dt><dd>@pg.DataInicioPlantao.ToString("dd/MM/yyyy 'às' HH:mm")</dd></div>
                    <div><dt>Término do plantão</dt><dd>@pg.DataFimPlantao.ToString("dd/MM/yyyy 'às' HH:mm")</dd></div>
                </dl>
            </section>

            <section class="pp-payment-card" aria-labelledby="payment-notes-title">
                <div class="pp-payment-card__heading"><i class="bi bi-card-text" aria-hidden="true"></i><div><h2 id="payment-notes-title">Pagamento e observações</h2><p>Dados da liquidação e contexto adicional.</p></div></div>
                <dl class="pp-financial-facts">
                    <div><dt>Forma de pagamento</dt><dd>@(string.IsNullOrWhiteSpace(pg.FormaPagamento) ? "Não informada" : pg.FormaPagamento)</dd></div>
                    <div><dt>Chave Pix</dt><dd class="pp-sensitive-value" title="Dado mascarado por privacidade">@pixSeguro</dd></div>
                    <div class="pp-fact-wide"><dt>Observações</dt><dd>@(string.IsNullOrWhiteSpace(pg.Observacoes) ? "Nenhuma observação registrada." : pg.Observacoes)</dd></div>
                </dl>
            </section>
        </div>

        <aside class="d-grid gap-3" aria-label="Ações e histórico do pagamento">
            @if (status == "pendente")
            {
                <form asp-action="ConfirmarPagamento" asp-route-id="@pg.Id" method="post" class="pp-payment-card pp-payment-action" data-ajax-form="true" data-confirm="true" data-confirm-title="Confirmar pagamento" data-confirm-message="Confirma a baixa deste pagamento? A ação será auditada e atualizará o financeiro do médico." data-confirm-type="success">
                    @Html.AntiForgeryToken()
                    <div class="pp-payment-card__heading"><i class="bi bi-check2-circle" aria-hidden="true"></i><div><h2>Confirmar pagamento</h2><p>Registre a liquidação com dados completos.</p></div></div>
                    <label for="payment-value" class="form-label">Valor pago</label>
                    <div class="input-group mb-3"><span class="input-group-text">R$</span><input id="payment-value" name="valorPago" type="number" min="0.01" step="0.01" value="@pg.ValorPrevisto.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" inputmode="decimal" required /></div>
                    <label for="payment-date" class="form-label">Data do pagamento</label>
                    <input id="payment-date" name="dataPagamento" type="date" class="form-control mb-3" required />
                    <label for="payment-method" class="form-label">Forma de pagamento</label>
                    <select id="payment-method" name="formaPagamento" class="form-select mb-3" required><option value="">Selecione</option><option value="PIX">Pix</option><option value="TED">TED</option><option value="DOC">DOC</option><option value="BOLETO">Boleto</option><option value="OUTRO">Outro</option></select>
                    <label for="payment-notes" class="form-label">Observações</label>
                    <textarea id="payment-notes" name="observacoes" class="form-control mb-3" rows="3" maxlength="1000"></textarea>
                    <button class="btn btn-success w-100" type="submit" data-loading-text="Confirmando…"><i class="bi bi-shield-check" aria-hidden="true"></i> Confirmar pagamento</button>
                </form>

                <form asp-action="CancelarPagamento" asp-route-id="@pg.Id" method="post" class="pp-payment-card pp-payment-action pp-payment-action--danger" data-ajax-form="true" data-confirm="true" data-confirm-title="Cancelar pagamento" data-confirm-message="Confirma cancelar este pagamento? A justificativa ficará no histórico de auditoria." data-confirm-type="danger">
                    @Html.AntiForgeryToken()
                    <h2><i class="bi bi-x-circle" aria-hidden="true"></i> Cancelar pagamento</h2>
                    <label for="payment-cancel-reason" class="form-label">Justificativa</label>
                    <textarea id="payment-cancel-reason" name="justificativa" class="form-control mb-3" minlength="3" maxlength="1000" rows="3" required></textarea>
                    <button class="btn btn-outline-danger w-100" type="submit">Cancelar pagamento</button>
                </form>

                <form asp-action="ContestarPagamento" asp-route-id="@pg.Id" method="post" class="pp-payment-card pp-payment-action" data-ajax-form="true" data-confirm="true" data-confirm-title="Contestar pagamento" data-confirm-message="Confirma registrar esta contestação? O valor original será preservado." data-confirm-type="warning">
                    @Html.AntiForgeryToken()
                    <h2><i class="bi bi-exclamation-diamond" aria-hidden="true"></i> Registrar contestação</h2>
                    <label for="payment-contest-reason" class="form-label">Motivo</label>
                    <textarea id="payment-contest-reason" name="motivo" class="form-control mb-3" required minlength="3" maxlength="1000" rows="3"></textarea>
                    <button class="btn btn-outline-warning w-100" type="submit" data-loading-text="Registrando…">Registrar contestação</button>
                </form>
            }
            else
            {
                <section class="pp-payment-state pp-payment-state--compact">
                    <i class="bi @statusIcon" aria-hidden="true"></i><div><h2>Pagamento @statusText</h2><p>Não há ações disponíveis para este status.</p></div>
                </section>
            }

            <section class="pp-payment-card pp-payment-history" aria-labelledby="payment-history-title">
                <div class="pp-payment-card__heading"><i class="bi bi-clock-history" aria-hidden="true"></i><div><h2 id="payment-history-title">Rastreabilidade</h2><p>Histórico básico disponível neste detalhe.</p></div></div>
                <ol><li><span></span><div><strong>Lançamento criado</strong><time datetime="@pg.RegDate.ToString("O")">@pg.RegDate.ToString("dd/MM/yyyy HH:mm")</time></div></li>@if (pg.DataPagamento.HasValue){<li><span></span><div><strong>Pagamento registrado</strong><time>@pg.DataPagamento.Value.ToString("dd/MM/yyyy")</time></div></li>}</ol>
            </section>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar ao financeiro</a>
        </aside>
    </div>
</main>
