@model PlantaoPro.Web.Models.CargosIndexViewModel
@{
    ViewData["Title"] = "Cargos — Administrativo 360";
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
    string Num(long valor) => valor.ToString("N0", ptBr);
    var total = Model.Pagina.Total;
    var fimItem = Math.Min((long)Model.Page * Model.Pagina.PageSize, total);
    var iniItem = total == 0 ? 0L : fimItem - Model.Pagina.PageSize + 1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/administrativo360-organizacao.css" asp-append-version="true" />
}

<div class="container-fluid py-3 pp-a360-org">
    <partial name="_SuprimentosNav" />
    <partial name="_AlertasAcao" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 fw-bold">Cargos</h2>
            <p class="text-muted small mb-0">Funções da estrutura organizacional e vínculo com departamentos. Colaboradores vinculados preservam o histórico quando o cargo é inativado.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErroLista))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" data-pp-persist>
            <i class="bi bi-exclamation-triangle me-2"></i>Não foi possível carregar a lista de cargos. @Model.ErroLista
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Lista -->
        <div class="col-lg-8 col-xl-9">
            <div class="card bg-dark border-secondary text-light">
                <div class="card-header bg-transparent border-secondary d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h5 class="card-title mb-0 h6"><i class="bi bi-person-badge me-2 text-info"></i>Cargos cadastrados
                        <span class="badge bg-secondary ms-1">@Num(total)</span>
                    </h5>
                    <form method="get" class="d-flex gap-1">
                        <input type="hidden" name="page" value="1" />
                        <input type="text" name="busca" value="@Model.Busca" placeholder="Buscar por código ou nome" class="form-control form-control-sm bg-dark text-light border-secondary" aria-label="Buscar cargo" />
                        <button type="submit" class="btn btn-sm btn-outline-info" title="Filtrar"><i class="bi bi-search"></i></button>
                        @if (!string.IsNullOrEmpty(Model.Busca))
                        {
                            <a asp-action="Cargos" class="btn btn-sm btn-outline-secondary" title="Limpar busca"><i class="bi bi-x-circle"></i></a>
                        }
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0" id="tabelaCgs">
                            <thead class="table-secondary text-secondary small">
                                <tr>
                                    <th>Código</th>
                                    <th>Nome</th>
                                    <th>Departamento</th>
                                    <th>Status</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @if (Model.Pagina.HasItems)
                                {
                                    foreach (var c in Model.Pagina.Items)
                                    {
                                        <tr class="@(c.Ativo ? "" : "opacity-75")">
                                            <td class="fw-bold">@c.Codigo</td>
                                            <td>@c.Nome</td>
                                            <td>@(string.IsNullOrWhiteSpace(c.Departamento) ? "—" : c.Departamento)</td>
                                            <td>
                                                @if (c.Ativo)
                                                { <span class="badge bg-success">Ativo</span> }
                                                else
                                                { <span class="badge bg-secondary">Inativo</span> }
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    @if (c.Ativo)
                                                    {
                                                        <button type="button" class="btn btn-outline-primary" data-editar-cg data-id="@c.Id" data-codigo="@c.Codigo" data-nome="@c.Nome" data-depid="@c.DepartamentoId" title="Editar" aria-label="Editar @c.Nome"><i class="bi bi-pencil"></i></button>
                                                        <button type="button" class="btn btn-outline-warning" data-impacto-cg data-acao="inativar" data-id="@c.Id" data-nome="@c.Nome" title="Inativar" aria-label="Inativar @c.Nome"><i class="bi bi-pause-circle"></i></button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-outline-success" data-impacto-cg data-acao="ativar" data-id="@c.Id" data-nome="@c.Nome" title="Reativar" aria-label="Reativar @c.Nome"><i class="bi bi-play-circle"></i></button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            @if (!string.IsNullOrWhiteSpace(Model.Busca))
                                            { <span>Nenhum cargo encontrado para a busca "@Model.Busca".</span> }
                                            else
                                            { <span>Nenhum cargo cadastrado ainda — use o formulário ao lado.</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Pagina.TotalPages > 1)
                    {
                        <div class="d-flex flex-wrap justify-content-between align-items-center px-3 py-2 border-top border-secondary gap-2">
                            <span class="small text-muted">Exibindo @Num(iniItem)–@Num(fimItem) de @Num(total)</span>
                            <div class="d-flex gap-1">
                                <a asp-action="Cargos" asp-route-busca="Model.Busca" asp-route-page="Model.Page - 1" class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"><i class="bi bi-chevron-left me-1"></i>Anterior</a>
                                <span class="btn btn-sm btn-secondary disabled">Página @Model.Page de @Model.Pagina.TotalPages</span>
                                <a asp-action="Cargos" asp-route-busca="Model.Busca" asp-route-page="Model.Page + 1" class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.Pagina.TotalPages ? "disabled" : "")">Próxima<i class="bi bi-chevron-right ms-1"></i></a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Formulário de criação -->
        <div class="col-lg-4 col-xl-3">
            <div class="card bg-dark border-secondary text-light">
                <div class="card-header bg-transparent border-secondary">
                    <h5 class="card-title mb-0 h6"><i class="bi bi-plus-circle me-2 text-info"></i>Novo Cargo</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.FormError))
                    {
                        <div class="alert alert-danger py-2 small" role="alert" data-pp-persist>
                            <i class="bi bi-exclamation-triangle me-1"></i>@Model.FormError
                        </div>
                    }
                    <form asp-action="Cargo" method="post" data-single-submit>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="busca" value="@Model.Busca" />
                        <div class="mb-3">
                            <label class="form-label small fw-bold" for="cgCodigo">Código *</label>
                            <input type="text" id="cgCodigo" name="codigo" value="@Model.Codigo" maxlength="30" required class="form-control form-control-sm bg-black text-light border-secondary" placeholder="Ex: CTO-ENF" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold" for="cgNome">Nome *</label>
                            <input type="text" id="cgNome" name="nome" value="@Model.Nome" maxlength="120" required class="form-control form-control-sm bg-black text-light border-secondary" placeholder="Ex: Enfermeiro Plantonista" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold" for="cgDep">Departamento</label>
                            <select id="cgDep" name="departamentoId" class="form-select form-select-sm bg-black text-light border-secondary">
                                <option value="">Sem departamento vinculado</option>
                                @foreach (var dep in Model.Departamentos.Where(d => d.Ativo))
                                {
                                    <option value="@dep.Id" selected="@(Model.DepartamentoId == dep.Id ? "selected" : null)">@dep.Nome (@dep.Codigo)</option>
                                }
                            </select>
                            <div class="form-text text-secondary">Opcional — vincula o cargo ao departamento ativo.</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 btn-sm"><i class="bi bi-check-lg me-1"></i>Cadastrar Cargo</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal: editar -->
    <div class="modal fade" id="modalEditarCg" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="AtualizarCargo" method="post" class="modal-content bg-dark text-light border-secondary" data-single-submit>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edCgId" value="" />
                <input type="hidden" name="busca" value="@Model.Busca" />
                <input type="hidden" name="page" value="@Model.Page" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title"><i class="bi bi-pencil me-2 text-info"></i>Editar Cargo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="edCgCodigo">Código *</label>
                        <input type="text" id="edCgCodigo" name="codigo" maxlength="30" required class="form-control form-control-sm bg-black text-light border-secondary" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="edCgNome">Nome *</label>
                        <input type="text" id="edCgNome" name="nome" maxlength="120" required class="form-control form-control-sm bg-black text-light border-secondary" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="edCgDep">Departamento</label>
                        <select id="edCgDep" name="departamentoId" class="form-select form-select-sm bg-black text-light border-secondary">
                            <option value="">Sem departamento vinculado</option>
                            @foreach (var dep in Model.Departamentos)
                            {
                                <option value="@dep.Id">@dep.Nome (@dep.Codigo)@(dep.Ativo ? "" : " — inativo")</option>
                            }
                        </select>
                        <div class="form-text text-secondary">O cargo atual mantém seu vínculo mesmo se o departamento estiver inativo.</div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Salvar alterações</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: impacto (inativar / reativar) -->
    <div class="modal fade" id="modalImpactoCg" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="InativarCargo" method="post" class="modal-content bg-dark text-light border-secondary" data-single-submit>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="impCgId" value="" />
                <input type="hidden" name="busca" value="@Model.Busca" />
                <input type="hidden" name="page" value="@Model.Page" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title" id="impCgTitulo"><i class="bi bi-exclamation-triangle me-2 text-warning"></i>Confirmar mudança</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p id="impCgTexto" class="mb-0 small text-secondary"></p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Voltar</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Confirmar</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Editar is not null)
    {
        <span id="editarInicial" class="d-none" data-id="@Model.Editar.Id" data-codigo="@Model.Editar.Codigo" data-nome="@Model.Editar.Nome" data-depid="@Model.Editar.DepartamentoId"></span>
    }

    <script>
        (function () {
            document.querySelectorAll('form[data-single-submit]').forEach(function (f) {
                f.addEventListener('submit', function () {
                    var b = f.querySelector('button[type="submit"]');
                    if (b) { b.disabled = true; b.classList.add('opacity-50'); }
                });
            });

            var modalEditar = document.getElementById('modalEditarCg');
            function abrirEdicao(id, codigo, nome, depId) {
                document.getElementById('edCgId').value = id;
                document.getElementById('edCgCodigo').value = codigo || '';
                document.getElementById('edCgNome').value = nome || '';
                document.getElementById('edCgDep').value = depId || '';
                bootstrap.Modal.getOrCreateInstance(modalEditar).show();
            }

            var formImp = document.querySelector('#modalImpactoCg form');
            function abrirImpacto(acao, id, nome) {
                var inativar = acao === 'inativar';
                formImp.action = inativar ? '/Administrativo360/InativarCargo' : '/Administrativo360/AtivarCargo';
                document.getElementById('impCgTitulo').innerHTML = '<i class="bi bi-exclamation-triangle me-2 text-warning"></i>' + (inativar ? 'Inativar cargo?' : 'Reativar cargo?');
                document.getElementById('impCgTexto').textContent = inativar
                    ? '"' + nome + '" será marcado como inativo. Ele sai dos seletores para novos colaboradores, mas quem já está vinculado permanece com todo o histórico preservado.'
                    : '"' + nome + '" voltará a aparecer nos seletores para novos vínculos. O histórico anterior permanece intacto.';
                document.getElementById('impCgId').value = id;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalImpactoCg')).show();
            }

            var tabela = document.getElementById('tabelaCgs');
            if (tabela) {
                tabela.addEventListener('click', function (e) {
                    var ed = e.target.closest('[data-editar-cg]');
                    if (ed) abrirEdicao(ed.dataset.id, ed.dataset.codigo, ed.dataset.nome, ed.dataset.depid);
                    var im = e.target.closest('[data-impacto-cg]');
                    if (im) abrirImpacto(im.dataset.acao, im.dataset.id, im.dataset.nome);
                });
            }

            var inicial = document.getElementById('editarInicial');
            if (inicial) {
                (function abrirQuandoPronto(n) {
                    if (window.bootstrap && window.bootstrap.Modal) { abrirEdicao(inicial.dataset.id, inicial.dataset.codigo, inicial.dataset.nome, inicial.dataset.depid); return; }
                    if (n < 250) setTimeout(function () { abrirQuandoPronto(n + 1); }, 40);
                })(0);
            }
        })();
    </script>
</div>
