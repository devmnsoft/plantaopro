@model PlantaoPro.Web.Models.OnboardingClienteViewModel
@{ ViewData["Title"] = UiText.L("Onboarding.WizardTitle"); ViewData["Subtitle"] = UiText.L("Onboarding.WizardSubtitle"); }
<div class="pp-page pp-form-page">
    <header class="pp-page-hero">
        <div class="pp-page-hero__copy"><span class="pp-eyebrow">@UiText.L("Onboarding.PageTitle")</span><h2>@UiText.L("Onboarding.WizardHeroTitle")</h2><p>@UiText.L("Onboarding.WizardHeroBody")</p></div>
        <div class="pp-hero-actions"><a asp-action="Index" class="btn btn-outline-secondary">@UiText.L("Onboarding.CancelWizard")</a></div>
    </header>
    <ol class="pp-stepper" aria-label="@((string)UiText.L("Onboarding.StepperAria"))">
        <li data-step="1" aria-current="step">@UiText.L("Onboarding.StepCompany")</li><li data-step="2">@UiText.L("Onboarding.StepPlan")</li><li data-step="3">@UiText.L("Onboarding.StepAdmin")</li><li data-step="4">@UiText.L("Onboarding.StepReview")</li><li data-step="5">@UiText.L("Onboarding.StepFinish")</li>
    </ol>
    <form method="post" class="pp-wizard-layout pp-form" novalidate data-focus-invalid>
        @Html.AntiForgeryToken()
        <div class="pp-form-card">
            <div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" aria-live="assertive" tabindex="-1"></div>
            <section class="pp-form-section" aria-labelledby="companySection">
                <header class="pp-form-section-header"><span class="pp-step">1</span><div><h2 id="companySection">@UiText.L("Onboarding.StepCompany")</h2><p>@UiText.L("Onboarding.CompanySectionBody")</p></div></header>
                <div class="pp-form-grid">
                    <div class="pp-form-field"><label asp-for="RazaoSocial">@UiText.L("Onboarding.LabelCompanyName")</label><input asp-for="RazaoSocial" class="pp-form-control" aria-describedby="RazaoSocial-help RazaoSocial-error" /><small id="RazaoSocial-help" class="form-help">@UiText.L("Onboarding.HelpCompanyName")</small><span asp-validation-for="RazaoSocial" id="RazaoSocial-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="NomeFantasia">@UiText.L("Onboarding.LabelTradeName")</label><input asp-for="NomeFantasia" class="pp-form-control" aria-describedby="NomeFantasia-error" /><span asp-validation-for="NomeFantasia" id="NomeFantasia-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="Cnpj">CNPJ</label><input asp-for="Cnpj" class="pp-form-control" inputmode="numeric" aria-describedby="Cnpj-help Cnpj-error" /><small id="Cnpj-help" class="form-help">@UiText.L("Onboarding.HelpCnpj")</small><span asp-validation-for="Cnpj" id="Cnpj-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="Email">@UiText.L("Onboarding.LabelCorporateEmail")</label><input asp-for="Email" class="pp-form-control" autocomplete="organization-email" aria-describedby="Email-error" /><span asp-validation-for="Email" id="Email-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="Telefone">@UiText.L("Profile.Phone")</label><input asp-for="Telefone" class="pp-form-control" inputmode="tel" autocomplete="tel" aria-describedby="Telefone-error" /><span asp-validation-for="Telefone" id="Telefone-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="Cidade">@UiText.L("Onboarding.LabelCity")</label><input asp-for="Cidade" class="pp-form-control" autocomplete="address-level2" aria-describedby="Cidade-error" /><span asp-validation-for="Cidade" id="Cidade-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="Estado">@UiText.L("Onboarding.LabelUf")</label><input asp-for="Estado" class="pp-form-control" maxlength="2" autocomplete="address-level1" aria-describedby="Estado-error" /><span asp-validation-for="Estado" id="Estado-error" class="pp-form-error"></span></div>
                </div>
            </section>
            <section class="pp-form-section" aria-labelledby="planSection">
                <header class="pp-form-section-header"><span class="pp-step">2</span><div><h2 id="planSection">@UiText.L("Onboarding.PlanSectionTitle")</h2><p>@UiText.L("Onboarding.PlanSectionBody")</p></div></header>
                <div class="pp-form-grid">
                    <div class="pp-form-field"><label asp-for="PlanoId">@UiText.L("Onboarding.LabelPlanId")</label><input asp-for="PlanoId" class="pp-form-control" aria-describedby="PlanoId-help PlanoId-error" /><small id="PlanoId-help" class="form-help">@UiText.L("Onboarding.HelpPlanId")</small><span asp-validation-for="PlanoId" id="PlanoId-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="Status">@UiText.L("Onboarding.LabelInitialStatus")</label><select asp-for="Status" class="pp-form-control" aria-describedby="Status-help Status-error"><option value="ATIVO">@UiText.L("Onboarding.StatusActive")</option><option value="TESTE">@UiText.L("Onboarding.StatusTrial")</option></select><small id="Status-help" class="form-help">@UiText.L("Onboarding.HelpInitialStatus")</small><span asp-validation-for="Status" id="Status-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="UnidadeNome">@UiText.L("Onboarding.LabelUnitName")</label><input asp-for="UnidadeNome" class="pp-form-control" aria-describedby="UnidadeNome-help UnidadeNome-error" /><small id="UnidadeNome-help" class="form-help">@UiText.L("Onboarding.HelpUnitName")</small><span asp-validation-for="UnidadeNome" id="UnidadeNome-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="UnidadeTipo">@UiText.L("Onboarding.LabelUnitType")</label><input asp-for="UnidadeTipo" class="pp-form-control" aria-describedby="UnidadeTipo-error" /><span asp-validation-for="UnidadeTipo" id="UnidadeTipo-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="UnidadeCidade">@UiText.L("Onboarding.LabelUnitCity")</label><input asp-for="UnidadeCidade" class="pp-form-control" aria-describedby="UnidadeCidade-error" /><span asp-validation-for="UnidadeCidade" id="UnidadeCidade-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="UnidadeEstado">@UiText.L("Onboarding.LabelUnitUf")</label><input asp-for="UnidadeEstado" class="pp-form-control" maxlength="2" aria-describedby="UnidadeEstado-error" /><span asp-validation-for="UnidadeEstado" id="UnidadeEstado-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="UnidadeResponsavel">@UiText.L("Onboarding.LabelUnitManager")</label><input asp-for="UnidadeResponsavel" class="pp-form-control" aria-describedby="UnidadeResponsavel-help" /><small id="UnidadeResponsavel-help" class="form-help">@UiText.L("Onboarding.HelpUnitManager")</small></div>
                </div>
            </section>
            <section class="pp-form-section" aria-labelledby="adminSection">
                <header class="pp-form-section-header"><span class="pp-step">3</span><div><h2 id="adminSection">@UiText.L("Onboarding.AdminSectionTitle")</h2><p>@UiText.L("Onboarding.AdminSectionBody")</p></div></header>
                <div class="pp-form-grid">
                    <div class="pp-form-field"><label asp-for="UsuarioNome">@UiText.L("Clinical.LabelFullName")</label><input asp-for="UsuarioNome" class="pp-form-control" autocomplete="name" aria-describedby="UsuarioNome-error" /><span asp-validation-for="UsuarioNome" id="UsuarioNome-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="UsuarioEmail">@UiText.L("Onboarding.LabelCorporateEmail")</label><input asp-for="UsuarioEmail" class="pp-form-control" autocomplete="email" aria-describedby="UsuarioEmail-help UsuarioEmail-error" /><small id="UsuarioEmail-help" class="form-help">@UiText.L("Onboarding.HelpAdminEmail")</small><span asp-validation-for="UsuarioEmail" id="UsuarioEmail-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="UsuarioTelefone">@UiText.L("Profile.Phone")</label><input asp-for="UsuarioTelefone" class="pp-form-control" inputmode="tel" autocomplete="tel" aria-describedby="UsuarioTelefone-error" /><span asp-validation-for="UsuarioTelefone" id="UsuarioTelefone-error" class="pp-form-error"></span></div>
                    <div class="pp-form-field"><label asp-for="UsuarioSenha">@UiText.L("Onboarding.LabelTempPassword")</label><input asp-for="UsuarioSenha" type="password" class="pp-form-control" autocomplete="new-password" aria-describedby="UsuarioSenha-help UsuarioSenha-error" /><small id="UsuarioSenha-help" class="form-help">@UiText.L("Onboarding.HelpTempPassword")</small><span asp-validation-for="UsuarioSenha" id="UsuarioSenha-error" class="pp-form-error"></span></div>
                </div>
            </section>
            <div class="pp-form-actions"><a asp-action="Index" class="btn btn-outline-secondary">@UiText.L("Shift.Back")</a><button class="btn btn-primary" type="submit">@UiText.L("Onboarding.ReviewAndCreate")</button></div>
        </div>
        <aside class="pp-form-card pp-wizard-summary" aria-labelledby="summaryTitle"><span class="pp-eyebrow">@UiText.L("Onboarding.SummaryKicker")</span><h2 id="summaryTitle">@UiText.L("Onboarding.SummaryBeforeTitle")</h2><ul class="pp-feature-list"><li>@UiText.L("Onboarding.SummaryCheck1")</li><li>@UiText.L("Onboarding.SummaryCheck2")</li><li>@UiText.L("Onboarding.SummaryCheck3")</li><li>@UiText.L("Onboarding.SummaryCheck4")</li></ul><p class="form-help">@UiText.L("Onboarding.SummaryNoSample")</p></aside>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
