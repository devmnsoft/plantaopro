<script>
(function () {
    // P0 CSRF: wrapper global de window.fetch — injeta o token antiforgery em requests
    // same-origin com método inseguro (POST/PUT/PATCH/DELETE) via header canônico
    // RequestVerificationToken. O cookie antiforgery já é enviado automaticamente pelo
    // browser em requests same-origin. O wrapper nunca bloqueia a página em caso de erro.
    var meta = document.querySelector('meta[name="antiforgery-token"]');
    var token = meta ? meta.getAttribute('content') : '';
    if (!token || !window.fetch) return;
    var unsafe = { POST: 1, PUT: 1, PATCH: 1, DELETE: 1 };
    var original = window.fetch.bind(window);
    window.fetch = function (input, init) {
        try {
            var method = String((init && init.method) || (input && input.method) || 'GET').toUpperCase();
            if (!unsafe[method]) return original(input, init);
            var url = typeof input === 'string' ? input : (input && input.url) || '';
            var sameOrigin = !url || url.charAt(0) === '/' || url.indexOf(window.location.origin) === 0;
            if (!sameOrigin) return original(input, init);
            init = init || {};
            if (!init.headers) { init.headers = new Headers({ RequestVerificationToken: token }); return original(input, init); }
            if (init.headers instanceof Headers) { init.headers.set('RequestVerificationToken', token); }
            else if (Array.isArray(init.headers)) { init.headers.push(['RequestVerificationToken', token]); }
            else { init.headers['RequestVerificationToken'] = token; }
            return original(input, init);
        } catch (err) {
            return original(input, init);
        }
    };
})();
</script>
