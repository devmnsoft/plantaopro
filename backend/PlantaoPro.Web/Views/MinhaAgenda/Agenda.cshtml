@model PlantaoPro.Web.Models.ProfessionalAgendaPageViewModel
@{ ViewData["Title"]="Minha agenda"; var today=DateOnly.FromDateTime(DateTime.Today); var returnUrl=Context.Request.Path+Context.Request.QueryString; }
@section Styles { <link rel="stylesheet" href="~/css/pages/professional-portal.css" asp-append-version="true" /> }
<main class="professional-portal" aria-labelledby="agenda-title">
 <header class="page-intro"><span class="eyebrow">Agenda · contexto atual</span><h1 id="agenda-title">Minha agenda</h1><p>Consulte somente suas alocações neste cliente. A confirmação registra presença futura; a execução depende de check-in, check-out e conferência.</p></header>
 @if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
 <form method="get" class="professional-filters" aria-label="Filtros da agenda"><div><label for="inicio">De</label><input id="inicio" name="inicio" type="date" value="@Model.Inicio.ToString("yyyy-MM-dd")" required /></div><div><label for="fim">Até</label><input id="fim" name="fim" type="date" value="@Model.Fim.ToString("yyyy-MM-dd")" required /></div><div><label for="unidade">Unidade</label><input id="unidade" name="unidade" value="@Model.Unidade" maxlength="120" /></div><div><label for="situacao">Situação</label><select id="situacao" name="situacao"><option value="">Todas</option>@foreach(var state in new[]{"solicitado","confirmado","realizado","cancelado","recusado","substituido"}){<option value="@state" selected="@(Model.Situacao==state)">@state.Replace('_',' ')</option>}</select></div><div><label for="visualizacao">Visualização</label><select id="visualizacao" name="visualizacao"><option value="semana" selected="@(Model.Visualizacao=="semana")">Semana</option><option value="mes" selected="@(Model.Visualizacao=="mes")">Mês</option><option value="lista" selected="@(Model.Visualizacao=="lista")">Lista acessível</option></select></div><button class="btn btn-primary" type="submit">Aplicar filtros</button></form>
 @if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>}else if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="portal-state portal-state--error" role="alert"><strong>Agenda indisponível</strong><span>@Model.ErrorMessage</span></div>}else if(!Model.Items.Any()){<div class="portal-state"><strong>Nenhum plantão no período</strong><span>Ajuste os filtros ou aguarde uma alocação da coordenação. Nenhum horário ou valor foi estimado.</span></div>}else{
 <section class="agenda-list" aria-label="Plantões em ordem cronológica">@foreach(var item in Model.Items){var isToday=item.DataInicio.HasValue&&DateOnly.FromDateTime(item.DataInicio.Value.LocalDateTime)==today;<article class="agenda-item @(isToday?"is-today":null)"><time datetime="@(item.DataInicio?.ToString("O"))"><strong>@(item.DataInicio?.ToString("dd/MM")??"Data não informada")</strong><span>@(item.DataInicio?.ToString("HH:mm")??"—") – @(item.DataFim?.ToString("dd/MM HH:mm")??"término não informado")</span></time><div><span class="eyebrow">@item.EspecialidadeNome</span><h2>@item.HospitalNome</h2>@if(item.DataInicio.HasValue&&item.DataFim.HasValue){<p>Duração: @((item.DataFim.Value-item.DataInicio.Value).TotalHours.ToString("0.##")) h@(item.DataFim.Value.Date>item.DataInicio.Value.Date?" · atravessa a meia-noite":null)</p>}else{<p>O registro legado não contém o período completo.</p>}</div><span class="status-badge">@item.Status.Replace('_',' ')</span><a class="btn btn-outline-primary" asp-action="Detalhe" asp-route-id="@item.EscalaId" asp-route-retorno="@returnUrl">Abrir detalhe</a></article>}</section>}
 <aside class="usage-help"><h2>Como usar</h2><p>Filtre por período, unidade e situação. “Solicitado” aguarda sua decisão; “confirmado” é compromisso futuro; “realizado” ainda pode depender de conferência e apuração. Ações ficam indisponíveis quando o vínculo, o horário ou o estado mudou.</p></aside>
</main>
