@model PlantaoPro.Web.Models.ListPageViewModel<PlantaoPro.Web.Models.ProfessionalCheckInDto>
@{ ViewData["Title"]="Check-in e check-out"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/professional-portal.css" asp-append-version="true" /> }
<main class="professional-portal"><header class="page-intro"><span class="eyebrow">Presença segura</span><h1>Check-in e check-out</h1><p>Registre o início e o término somente nos plantões vinculados ao seu perfil.</p></header>
@if(!Model.Items.Any()){<div class="portal-state"><strong>Nenhum plantão elegível</strong><span>Plantões confirmados aparecem aqui perto do horário de início.</span></div>}
<section class="payment-list">@foreach(var p in Model.Items){<article><div><span class="eyebrow">@p.DataInicio.ToString("dd/MM · HH:mm")</span><h2>@p.HospitalNome</h2><p>@p.EspecialidadeNome</p><small>Check-in: @(p.CheckInEm?.ToString("dd/MM HH:mm") ?? "pendente") · Check-out: @(p.CheckOutEm?.ToString("dd/MM HH:mm") ?? "pendente")</small></div><form asp-action="RegistrarPresenca" method="post">@Html.AntiForgeryToken()<input type="hidden" name="escalaId" value="@p.EscalaId"/><input type="hidden" name="operacao" value="@(p.PodeCheckOut ? "checkout" : "checkin")"/><button class="btn btn-primary btn-lg" type="submit" disabled="@(!p.PodeCheckIn && !p.PodeCheckOut)">@(p.PodeCheckOut ? "Registrar check-out" : p.PodeCheckIn ? "Registrar check-in" : "Aguardando horário")</button></form></article>}</section></main>
