@model PlantaoPro.Web.Models.HospitalFormViewModel
<form method="post" data-ajax-form="true" data-focus-invalid data-unsaved-form class="pp-form" novalidate aria-label="Dados da unidade">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="pp-error-panel" role="alert" aria-live="assertive" tabindex="-1"></div>
    <div data-ajax-errors class="alert alert-danger d-none" role="alert"></div>
    <div class="card pp-operation-panel">
        <div class="card-body">
            <div class="pp-form-section-title"><h2>Identificação da unidade</h2><p>Campos com * são obrigatórios. Confira CNPJ e localização antes de salvar.</p></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="RazaoSocial" class="form-label">Razão social <span class="text-danger">*</span></label><input asp-for="RazaoSocial" class="form-control" /><span asp-validation-for="RazaoSocial" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="NomeFantasia" class="form-label">Nome fantasia <span class="text-danger">*</span></label><input asp-for="NomeFantasia" class="form-control" /><span asp-validation-for="NomeFantasia" class="text-danger small"></span></div>
                <div class="col-md-4"><label asp-for="Cnpj" class="form-label form-required">CNPJ</label><input asp-for="Cnpj" class="form-control" data-mask="cnpj" inputmode="numeric" autocomplete="off" required /><small class="form-help">Informe o documento oficial da unidade.</small><span asp-validation-for="Cnpj" class="text-danger small"></span></div>
                <div class="col-md-4"><label asp-for="Telefone" class="form-label">Telefone</label><input asp-for="Telefone" class="form-control" data-mask="phone" inputmode="tel" autocomplete="tel" /><small class="form-help">Inclua DDD para contato operacional.</small><span asp-validation-for="Telefone" class="text-danger small"></span></div>
                <div class="col-md-4"><label asp-for="Email" class="form-label">E-mail</label><input asp-for="Email" class="form-control" type="email" autocomplete="email" /><small class="form-help">Canal institucional para avisos.</small><span asp-validation-for="Email" class="text-danger small"></span></div>
                <div class="col-md-8"><label asp-for="Endereco" class="form-label">Endereço</label><input asp-for="Endereco" class="form-control" /></div>
                <div class="col-md-3"><label asp-for="Cidade" class="form-label">Cidade <span class="text-danger">*</span></label><input asp-for="Cidade" class="form-control" /><span asp-validation-for="Cidade" class="text-danger small"></span></div>
                <div class="col-md-1"><label asp-for="Estado" class="form-label">UF <span class="text-danger">*</span></label><input asp-for="Estado" class="form-control text-uppercase" maxlength="2" /><span asp-validation-for="Estado" class="text-danger small"></span></div>
                <div class="col-md-8"><label asp-for="Responsavel" class="form-label">Responsável</label><input asp-for="Responsavel" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="RegStatus" class="form-label">Status</label><select asp-for="RegStatus" class="form-select"><option value="A">Ativo</option><option value="I">Inativo</option></select><small class="form-help">Inativar pode afetar escalas e relatórios vinculados.</small></div>
            </div>
        </div>
        <div class="pp-form-actions"><span class="pp-form-actions__hint" role="status">Aguarde a confirmação de sucesso antes de sair.</span><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary btn-submit" type="submit"><app-icon name="Check" size="18" /> Salvar unidade</button></div></div>
    </div>
</form>
