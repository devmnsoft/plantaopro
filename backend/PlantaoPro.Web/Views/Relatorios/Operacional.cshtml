@model PlantaoPro.Web.Models.OperationalReportPageViewModel
@using System.Globalization
@{ ViewData["Title"] = Model.Report?.Title ?? "Relatório operacional"; var r=Model.Report; }
<link rel="stylesheet" href="~/css/pages/operational-reports.css" asp-append-version="true" />
<main class="pp-operational-report">
<header class="report-head"><div><span>PlantãoPro · MNSOFT</span><h1>@ViewData["Title"]</h1><p>Fatos operacionais rastreáveis no contexto autorizado da organização.</p></div><div class="report-actions"><button type="button" class="btn btn-outline-secondary" onclick="window.print()" aria-label="Imprimir relatório"><i class="bi bi-printer"></i> Imprimir</button><a class="btn btn-primary" asp-action="ExportarOperacional" asp-route-kind="@Model.Kind" asp-route-inicio="@Model.Inicio" asp-route-fim="@Model.Fim" asp-route-unidadeId="@Model.UnidadeId" asp-route-especialidadeId="@Model.EspecialidadeId" asp-route-profissionalId="@Model.ProfissionalId" asp-route-situacao="@Model.Situacao"><i class="bi bi-download"></i> CSV</a></div></header>
<details class="report-filters" open><summary>Filtros do relatório</summary><form method="get" class="filter-grid"><label>Início<input class="form-control" type="date" name="inicio" value="@Model.Inicio.ToString("yyyy-MM-dd")" required /></label><label>Fim<input class="form-control" type="date" name="fim" value="@Model.Fim.ToString("yyyy-MM-dd")" required /></label><label>Unidade (identificador)<input class="form-control" type="text" name="unidadeId" value="@Model.UnidadeId" /></label><label>Especialidade (identificador)<input class="form-control" type="text" name="especialidadeId" value="@Model.EspecialidadeId" /></label><label>Profissional (quando autorizado)<input class="form-control" type="text" name="profissionalId" value="@Model.ProfissionalId" /></label><label>Situação<input class="form-control" name="situacao" value="@Model.Situacao" /></label><button class="btn btn-primary" type="submit">Aplicar filtros</button></form></details>
@if(Model.Error is not null){<div class="alert alert-danger" role="alert"><strong>Falha na consulta.</strong> @Model.Error Os valores não foram substituídos por zero.</div>}
else if(r is not null){<section class="print-meta" aria-label="Contexto do relatório"><strong>Período:</strong> @Model.Inicio.ToString("dd/MM/yyyy") a @Model.Fim.ToString("dd/MM/yyyy") · <strong>Critério:</strong> @r.TimeCriterion · <strong>Atualizado:</strong> @r.GeneratedAtUtc.ToString("dd/MM/yyyy HH:mm 'UTC'")<p>Situação atual dos registros selecionados; não representa fotografia histórica.</p></section><section class="indicator-grid" aria-label="Indicadores">@foreach(var i in r.Indicators){<article><span>@i.Label</span><strong>@(i.Unit=="R$"?i.Value.ToString("C",CultureInfo.GetCultureInfo("pt-BR")):i.Value.ToString("N0"))</strong><small>@i.Unit</small>@if(i.DetailStatus is not null){<a asp-route-inicio="@Model.Inicio" asp-route-fim="@Model.Fim" asp-route-unidadeId="@Model.UnidadeId" asp-route-especialidadeId="@Model.EspecialidadeId" asp-route-profissionalId="@Model.ProfissionalId" asp-route-situacao="@i.DetailStatus">Ver registros <span class="visually-hidden">de @i.Label</span></a>}<p>@i.Definition</p></article>}</section><section><h2>Registros de origem <small>@r.Total no total</small></h2>@if(r.Total==0){<div class="empty-state">Nenhum registro corresponde aos filtros. Isso não é uma falha de carregamento.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Referência</th><th>Unidade</th><th>Profissional</th><th>Situação</th><th>Valor</th><th class="no-print">Ação</th></tr></thead><tbody>@foreach(var x in r.Items){<tr><td>@x.PeriodDate.ToString("dd/MM/yyyy HH:mm")</td><td>@x.Reference</td><td>@x.Unit</td><td>@(string.IsNullOrEmpty(x.Professional)?"Não se aplica":x.Professional)</td><td><span class="status-text">@x.Status</span></td><td>@(x.Value?.ToString("C",CultureInfo.GetCultureInfo("pt-BR"))??"Não se aplica")</td><td class="no-print"><a href="@x.ActionUrl">Abrir origem</a></td></tr>}</tbody></table></div>}</section>}
<details class="report-help"><summary>Como interpretar este relatório</summary><p>Os cards e a lista usam os mesmos filtros e estado atual. Cada definição informa a etapa contada: vaga não é plantão; atribuição não é confirmação; execução não é aprovação; apuração não é pagamento. Datas finais são inclusivas na interface e convertidas em intervalo semiaberto no servidor. Plantões iniciados no período continuam incluídos quando atravessam a meia-noite. Sem denominador, nenhum percentual é apresentado. Pagamentos usam data de pagamento, enquanto apuração usa a competência pelo início do plantão.</p><p>Limitação: o sistema preserva a situação atual e trilhas específicas, mas este relatório não reconstrói uma fotografia histórica.</p></details>
</main>
