ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=
Jwt__Key=
Jwt__Issuer=PlantaoPro
Jwt__Audience=PlantaoPro
DevelopmentSeed__Enabled=true
# Defina fora do Git (user-secrets ou variável local):
# PLANTAOPRO_DEMO_PASSWORD=<senha-local-forte>
# PLANTAOPRO_BOOTSTRAP_PASSWORD=<senha-temporaria-forte>
# Chaves GLOBAIS opcionais de IA (a chave do cliente tem prioridade; sem elas o
# provedor só funciona com chave do próprio cliente na tela Assistente IA):
# Ai__Providers__Gemini__ApiKey=
# Ai__Providers__Groq__ApiKey=
# Ai__Providers__DeepSeek__ApiKey=
# Ai__Providers__Drael__ApiKey=
# Ai__Providers__Mistral__ApiKey=
