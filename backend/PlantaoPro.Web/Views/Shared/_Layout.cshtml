@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f73f1" />
    <link rel="manifest" href="~/manifest.json" />
    <title>@(ViewData["Title"] ?? "PlantãoPro")</title>
    <link rel="icon" type="image/svg+xml" href="~/media/brand/favicon.svg" />
    <link rel="apple-touch-icon" href="~/media/brand/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/css/plantaopro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/drawers.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system/kanban.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-body">
    <a class="skip-link" href="#mainContent">Pular para o conteúdo</a>
    @if (isAuthenticated)
    {
        <partial name="_ImpersonationBanner" />
        <div class="pp-app app-shell">
            <partial name="_AppSidebar" />
            <section class="pp-main app-main" data-app-shell="true">
                <partial name="_AppTopbar" />
                <main class="pp-content app-content" id="mainContent" tabindex="-1">
                    <partial name="_ToastMessages" />
                    @if (ViewData["WorkspaceHeader"] is PlantaoPro.Web.Models.WorkspaceHeaderViewModel workspaceHeader) { <partial name="_WorkspaceHeader" model="workspaceHeader" /> } else { @await Component.InvokeAsync("PageContext") }
                    @RenderBody()
                </main>
                <partial name="_AppFooter" />
            </section>
        </div>
        <button class="sidebar-overlay border-0" id="sidebarOverlay" type="button" aria-label="Fechar menu" tabindex="-1"></button>
        <partial name="_MobileNavigation" />
        <partial name="_CommandPalette" />
        <partial name="_OverlayPortal" />
        <partial name="_ToastRegion" />
    }
    else
    {
        <main class="auth-main" id="mainContent">
            <partial name="_ToastMessages" />
            @RenderBody()
        </main>
    }
    <div class="pp-live-region" id="appLiveRegion" role="status" aria-live="polite" aria-atomic="true"></div>
    <partial name="_ConfirmModal" model="new PlantaoPro.Web.Models.ConfirmModalViewModel()" />
    <script src="~/js/plantaopro-toast.js" asp-append-version="true"></script>
    <script src="~/js/plantaopro-ui.js" asp-append-version="true"></script>
    <script src="~/js/form-experience.js" asp-append-version="true"></script>
    @if (isAuthenticated)
    {
        <script src="~/js/command-palette.js" asp-append-version="true"></script>
    }
    <script src="~/js/service-worker-registration.js" asp-append-version="true"></script>
    @if (isAuthenticated) { <script type="module" src="~/js/core/app-shell.js" asp-append-version="true"></script> }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
