@model PlantaoPro.Web.Models.Saude360PageViewModel
@{
    var vm = Model ?? new PlantaoPro.Web.Models.Saude360PageViewModel();
    ViewData["Title"] = vm.Titulo;
    var registros = (vm.Registros ?? Array.Empty<PlantaoPro.Web.Models.Saude360RegistroViewModel>()).ToList();
    string? Quantidade(string indicador) => registros.FirstOrDefault(item => string.Equals(item.Nome, indicador, StringComparison.OrdinalIgnoreCase))?.Descricao;
}

@if (ViewBag.AssistenteContextual is PlantaoPro.Web.Models.AssistenteContextualViewModel assistenteContextual)
{
    @await Html.PartialAsync("_AssistenteContextual", assistenteContextual)
}

@await Html.PartialAsync("_PageHelp", new PlantaoPro.Web.Models.PageHelpViewModel
{
    Title = vm.Titulo,
    Description = vm.Descricao,
    WhenToUse = "Use esta tela para conduzir a jornada assistencial com dados reais da API e contexto por tenant.",
    StepByStep = new List<string> { "Revise os indicadores e registros.", "Use os botões de ação para avançar no fluxo.", "Se não houver dados, siga a próxima ação recomendada.", "Consulte o manual do perfil em caso de dúvida." },
    Tips = new List<string> { "Acesso clínico é auditado.", "Registros respeitam o tenant atual.", "Dados sensíveis não aparecem em logs técnicos." },
    RelatedActions = vm.Acoes,
    ProfileNotes = "A tela adapta a operação para recepção, triagem, médico, financeiro e convênios.",
    DocumentationUrl = Url.Action("Perfil", "Manual") ?? string.Empty
})

<div class="pp-page pp-clinical-page clinical-mvp-journey" data-clinical-mvp-journey data-patient-context="@(string.Equals(vm.Controller, "Pacientes", StringComparison.OrdinalIgnoreCase) ? "available-from-api" : null)">
<section class="pp-page-hero" aria-labelledby="saude360Title">
    <div>
        <span class="pp-eyebrow">PlantãoPro Saúde 360 · jornada assistencial</span>
        <h1 id="saude360Title">@vm.Titulo</h1>
        <p>@vm.Descricao</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var acao in vm.Acoes ?? Array.Empty<PlantaoPro.Web.Models.Saude360ActionLinkViewModel>())
        {
            <a asp-controller="@(string.IsNullOrWhiteSpace(acao.Controller) ? vm.Controller : acao.Controller)" asp-action="@acao.Action" class="btn btn-primary">
                <i class="bi @acao.Icone me-1" aria-hidden="true"></i>@acao.Titulo
            </a>
        }
    </div>
</section>

<nav class="clinical-journey" aria-label="Etapas da jornada Saúde 360">
    <a asp-controller="Pacientes" asp-action="Index"><i class="bi bi-person-vcard" aria-hidden="true"></i><span>Paciente</span></a>
    <a asp-controller="Agendamentos" asp-action="Index"><i class="bi bi-calendar-check" aria-hidden="true"></i><span>Agendamento</span>@if (Quantidade("agendamentos hoje") is string agendamentos) { <strong aria-label="Agendamentos de hoje">@agendamentos</strong> }</a>
    <a asp-controller="Agendamentos" asp-action="CheckIn"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i><span>Check-in</span>@if (Quantidade("checkins realizados") is string checkins) { <strong aria-label="Check-ins realizados">@checkins</strong> }</a>
    <a asp-controller="PainelChamada" asp-action="Index"><i class="bi bi-megaphone" aria-hidden="true"></i><span>Chamada</span>@if (Quantidade("pacientes aguardando") is string aguardando) { <strong aria-label="Pacientes aguardando">@aguardando</strong> }</a>
    <a asp-controller="Triagem" asp-action="Index"><i class="bi bi-activity" aria-hidden="true"></i><span>Triagem</span>@if (Quantidade("triagens pendentes") is string triagens) { <strong aria-label="Triagens pendentes">@triagens</strong> }</a>
    <a asp-controller="Consultas" asp-action="Index"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i><span>Consulta</span>@if (Quantidade("consultas em andamento") is string consultas) { <strong aria-label="Consultas em andamento">@consultas</strong> }</a>
    <a asp-controller="Prescricoes" asp-action="Index"><i class="bi bi-capsule" aria-hidden="true"></i><span>Prescrição</span>@if (Quantidade("prescricoes pendentes") is string prescricoes) { <strong aria-label="Prescrições pendentes">@prescricoes</strong> }</a>
    <a asp-controller="ClinicaFinanceiro" asp-action="Index"><i class="bi bi-receipt" aria-hidden="true"></i><span>Financeiro</span>@if (Quantidade("financeiro pendente") is string financeiro) { <strong aria-label="Financeiro pendente">@financeiro</strong> }</a>
</nav>

<section class="clinical-next-action" data-next-action aria-labelledby="clinicalNextActionTitle">
    <div>
        <span class="pp-section-kicker">Próxima ação</span>
        <h2 id="clinicalNextActionTitle">Continue somente com vínculo e status reais</h2>
        <p>Abra um registro retornado pela API para confirmar paciente, agendamento e identificadores antes de avançar. Ações sem vínculo permanecem indisponíveis.</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="ClinicaDashboard" asp-action="FluxoAtendimento">Ver regras da jornada</a>
</section>

@if (string.Equals(vm.Controller, "Pacientes", StringComparison.OrdinalIgnoreCase))
{
    <section class="clinical-patient-sections" aria-label="Contexto longitudinal do paciente">
        @foreach (var bloco in new[] { "Dados", "Agenda", "Triagem", "Consultas", "Faturamento" })
        {
            <article class="clinical-context-card"><h2>@bloco</h2><p>Selecione um paciente retornado pela API para consultar este bloco. Nenhum histórico demonstrativo é exibido.</p></article>
        }
    </section>
}

@if (!string.IsNullOrWhiteSpace(vm.ErrorMessage) && !string.Equals(vm.ErrorMessage, "Registros carregados.", StringComparison.OrdinalIgnoreCase))
{
    <div class="pp-alert pp-alert--warning" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>@vm.ErrorMessage</span></div>
}

@if (registros.Count == 0 && string.IsNullOrWhiteSpace(vm.ErrorMessage))
{
    <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-inbox", "Nenhum registro encontrado", "A API não retornou registros reais para este módulo.")' />
}

<div class="pp-kpi-strip" aria-label="Contexto do módulo">
    <article class="pp-kpi-card"><span>Plano mínimo</span><strong>@vm.Plano</strong><small>requisito do módulo</small></article>
    <article class="pp-kpi-card"><span>Registros</span>@if (string.IsNullOrWhiteSpace(vm.ErrorMessage) || string.Equals(vm.ErrorMessage, "Registros carregados.", StringComparison.OrdinalIgnoreCase)) { <strong>@registros.Count</strong><small>resultado real carregado</small> } else { <strong>Indisponível</strong><small>a API não confirmou o total</small> }</article>
    <article class="pp-kpi-card"><span>Controle de acesso</span><strong>Protegido</strong><small>tenant, perfil e auditoria</small></article>
</div>

<section class="pp-data-table" aria-labelledby="moduleRecordsTitle">
    <div class="pp-section-heading">
        <div><span class="pp-section-kicker">Registros assistenciais</span><h2 id="moduleRecordsTitle">@vm.Modulo</h2></div>
        <span class="badge bg-light text-dark">@vm.Permissao</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0" aria-label="Registros do módulo @vm.Modulo">
            <thead><tr><th scope="col">Identificação</th><th scope="col">Código</th><th scope="col">Descrição</th><th scope="col">Status</th><th scope="col">Registro</th></tr></thead>
            <tbody>
            @if (!registros.Any())
            {
                <tr><td colspan="5"><div class="saude360-empty-state" role="status" aria-live="polite"><i class="bi bi-inbox" aria-hidden="true"></i><strong>Nenhum registro encontrado</strong><span>Comece pela ação principal desta tela ou ajuste os filtros da jornada.</span></div></td></tr>
            }
            else
            {
                @foreach (var item in registros)
                {
                    <tr>
                        <td><span class="fw-semibold">@(string.IsNullOrWhiteSpace(item.Nome) ? item.Id.ToString() : item.Nome)</span></td>
                        <td>@(string.IsNullOrWhiteSpace(item.Codigo) ? "—" : item.Codigo)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Descricao) ? "—" : item.Descricao)</td>
                        <td><span class="badge bg-primary-subtle text-primary">@item.Status</span></td>
                        <td>@item.RegDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>


<div class="pp-info-banner" role="note">
    <strong>LGPD e auditoria:</strong> as ações deste módulo usam endpoints autenticados, escopo por tenant e trilha de auditoria clínica/operacional.
</div>
</div>
