@model PlantaoPro.Web.Models.AgendamentoFormViewModel
<form asp-action="Save" method="post" class="pp-form" novalidate data-focus-invalid data-unsaved-form>
    @Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="pp-error-panel" role="alert" aria-live="assertive" tabindex="-1"></div>
    <section class="pp-form-section" aria-labelledby="schedulePeople"><header class="pp-form-section__header"><app-icon name="Calendar" size="24"/><div><h2 id="schedulePeople">Paciente e atendimento</h2><p>Vincule o paciente, o profissional e o local antes de definir o horário.</p></div></header><div class="pp-form-grid">
        <div class="pp-form-field pp-form-field--half"><label asp-for="PacienteId" class="pp-form-label">Paciente <span class="pp-required-marker">*</span></label><input asp-for="PacienteId" class="form-control" required/><span asp-validation-for="PacienteId" class="pp-form-error" data-valmsg-for="PacienteId"></span></div><div class="pp-form-field pp-form-field--half"><label asp-for="MedicoId" class="pp-form-label">Profissional <span class="pp-required-marker">*</span></label><input asp-for="MedicoId" class="form-control" required/><span asp-validation-for="MedicoId" class="pp-form-error" data-valmsg-for="MedicoId"></span></div><div class="pp-form-field pp-form-field--half"><label asp-for="UnidadeId" class="pp-form-label">Unidade</label><input asp-for="UnidadeId" class="form-control"/></div><div class="pp-form-field pp-form-field--half"><label asp-for="SalaId" class="pp-form-label">Sala</label><input asp-for="SalaId" class="form-control"/></div>
    </div></section>
    <section class="pp-form-section" aria-labelledby="scheduleTime"><header class="pp-form-section__header"><app-icon name="Waiting" size="24"/><div><h2 id="scheduleTime">Horário e classificação</h2><p>O término precisa ser posterior ao início. Conflitos serão validados ao salvar.</p></div></header><div class="pp-form-grid">
        <div class="pp-form-field pp-form-field--half"><label asp-for="DataInicio" class="pp-form-label">Início <span class="pp-required-marker">*</span></label><input asp-for="DataInicio" class="form-control" type="datetime-local" required/><span asp-validation-for="DataInicio" class="pp-form-error" data-valmsg-for="DataInicio"></span></div><div class="pp-form-field pp-form-field--half"><label asp-for="DataFim" class="pp-form-label">Término <span class="pp-required-marker">*</span></label><input asp-for="DataFim" class="form-control" type="datetime-local" required/><span asp-validation-for="DataFim" class="pp-form-error" data-valmsg-for="DataFim"></span></div><div class="pp-form-field pp-form-field--half"><label asp-for="Tipo" class="pp-form-label">Tipo</label><input asp-for="Tipo" class="form-control"/></div><div class="pp-form-field pp-form-field--half"><label asp-for="Especialidade" class="pp-form-label">Especialidade</label><input asp-for="Especialidade" class="form-control"/></div><div class="pp-form-field"><label asp-for="Observacoes" class="pp-form-label">Observações administrativas</label><textarea asp-for="Observacoes" class="form-control" rows="4" aria-describedby="scheduleNotesHelp"></textarea><small id="scheduleNotesHelp" class="pp-field-help">Não registre informações clínicas ou dados sensíveis neste campo.</small></div>
    </div></section>
    <footer class="pp-form-sticky-footer"><div class="pp-form-status"><app-icon name="Information" size="18"/><span>Disponibilidade será verificada ao salvar.</span></div><div class="pp-form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary" type="submit"><app-icon name="Check" size="18"/> Salvar agendamento</button></div></footer>
</form>
