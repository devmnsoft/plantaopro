@{ ViewData["Title"] = "Minha disponibilidade"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/minha-disponibilidade.css" asp-append-version="true" /> }
<main class="availability-page" data-availability-root data-api-base="/api/medicos/me" aria-labelledby="availability-title">
  <header class="availability-hero">
    <div><span class="eyebrow">Área do profissional</span><h1 id="availability-title">Minha disponibilidade</h1><p>Informe quando você pode atuar. Esses registros ajudam o planejamento, mas não confirmam nem cancelam plantões.</p></div>
    <button class="btn btn-light" type="button" data-open-form><i class="bi bi-plus-lg" aria-hidden="true"></i> Adicionar disponibilidade</button>
  </header>
  <div class="context-strip" aria-label="Contexto"><span><strong>Cliente:</strong> vínculo autenticado</span><span><strong>Unidade:</strong> todas as unidades autorizadas</span><span><strong>Fuso:</strong> horário local do dispositivo (<output data-timezone></output>)</span></div>
  <section class="availability-filter" aria-labelledby="period-title"><h2 id="period-title">Período</h2><form data-filter-form><label>Início<input class="form-control" name="inicio" type="date" required /></label><label>Fim<input class="form-control" name="fim" type="date" required /></label><button class="btn btn-primary" type="submit">Atualizar período</button></form></section>
  <div class="availability-feedback" data-feedback role="status" aria-live="polite"></div>
  <div class="availability-grid">
    <section class="availability-list" aria-labelledby="list-title"><div class="section-heading"><div><span class="eyebrow">Lista cronológica</span><h2 id="list-title">Intervalos declarados</h2></div><a asp-controller="MedicoArea" asp-action="Agenda">Ver minha agenda</a></div><div data-list><div class="availability-state"><span class="spinner-border" aria-hidden="true"></span><strong>Carregando disponibilidade…</strong></div></div></section>
    <aside class="availability-help"><h2>Como usar</h2><ul><li>Intervalos usam limites <strong>[início, fim)</strong>; horários adjacentes são permitidos.</li><li>Ausência de registro não significa disponibilidade irrestrita.</li><li>Uma indisponibilidade não cancela plantão alocado. Solicite substituição pelo fluxo da agenda.</li><li>Em conflito de edição, atualize a lista antes de tentar novamente.</li></ul></aside>
  </div>
  <dialog data-editor aria-labelledby="editor-title"><form data-editor-form><header><h2 id="editor-title">Adicionar disponibilidade</h2><button type="button" class="dialog-close" data-close aria-label="Fechar">×</button></header><input name="id" type="hidden"/><input name="versaoEsperada" type="hidden"/><div class="form-grid"><label>Início<input class="form-control" name="dataInicio" type="datetime-local" required /></label><label>Término<input class="form-control" name="dataFim" type="datetime-local" required /></label><label>Turno<select class="form-select" name="turno"><option value="GERAL">Período informado</option><option>MANHA</option><option>TARDE</option><option>NOITE</option></select></label><label class="wide">Observação <span>(opcional)</span><textarea class="form-control" name="observacoes" maxlength="500"></textarea></label></div><p class="form-hint">Salvar apenas declara disponibilidade para planejamento; nenhuma escala será criada.</p><div data-form-error class="field-error" role="alert"></div><footer><button type="button" class="btn btn-outline-secondary" data-close>Voltar</button><button type="submit" class="btn btn-primary">Salvar intervalo</button></footer></form></dialog>
  <dialog data-cancel-dialog aria-labelledby="cancel-title"><form method="dialog"><h2 id="cancel-title">Cancelar este registro?</h2><p data-cancel-summary></p><p>Plantões existentes permanecerão íntegros.</p><footer><button class="btn btn-outline-secondary" value="no">Manter</button><button class="btn btn-danger" value="yes">Cancelar registro</button></footer></form></dialog>
</main>
@section Scripts { <script src="~/js/pages/minha-disponibilidade.js" asp-append-version="true"></script> }
