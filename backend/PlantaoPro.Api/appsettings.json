{
  "ConnectionStrings": {
    "Default": ""  // Credencial versionada removida: definir via user-secrets ou variavel ConnectionStrings__Default (vide appsettings.example.json)
  },
  "Database": {
    "AllowLegacyPostgresDatabase": false,
    "AllowDevelopmentAutoCreate": false
  },
  "Jwt": {
    "Issuer": "PlantaoPro",
    "Audience": "PlantaoPro",
    "Key": ""
  },
  // P2 IA — chaves dos provedores ficam SOMENTE no servidor (variáveis de ambiente ou user-secrets).
  // EncryptionKey: 64 caracteres hex (32 bytes) para cifrar as chaves por tenant (AES-GCM).
  // BaseUrl terminam em "/" (os adapters usam URIs relativas).
  "Ai": {
    "EncryptionKey": "",
    "TimeoutSeconds": 30,
    "Providers": {
      "Groq": {
        "ApiKey": "",
        "BaseUrl": "https://api.groq.com/openai/v1/",
        "DefaultModel": "llama-3.3-70b-versatile"
      },
      "Gemini": {
        "ApiKey": "",
        "BaseUrl": "https://generativelanguage.googleapis.com/",
        "DefaultModel": "gemini-2.0-flash"
      },
      "DeepSeek": {
        "ApiKey": "",
        "BaseUrl": "https://api.deepseek.com/",
        "DefaultModel": "deepseek-chat"
      }
    }
  },
  "ConfigurationNotice": "CHANGE_ME: Configure segredos por variáveis de ambiente; nunca versione credenciais reais."
}
