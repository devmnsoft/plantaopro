@model PlantaoPro.Web.Models.ListPageViewModel<PlantaoPro.Web.Models.PagamentoResumoDto>
@{ ViewData["Title"] = "Central de pagamentos"; var itens = Model?.Items?.ToList() ?? new(); }
<div class="container-fluid py-4">
 <header class="mb-4"><span class="text-primary fw-semibold">FINANCEIRO · PLANTÕES REALIZADOS</span><h1 class="h2 mt-1">Central de pagamentos</h1><p class="text-muted">Confira a origem, previsão e liquidação de cada pagamento.</p></header>
 <section class="row g-3 mb-4" aria-label="Indicadores financeiros">
  <div class="col-md-4"><div class="card card-body h-100"><span class="text-muted">Previsto</span><strong class="fs-3">@itens.Sum(x => x.ValorPrevisto).ToString("C")</strong></div></div>
  <div class="col-md-4"><div class="card card-body h-100"><span class="text-muted">Pendente</span><strong class="fs-3">@itens.Where(x => x.Status.Equals("pendente", StringComparison.OrdinalIgnoreCase)).Sum(x => x.ValorPrevisto).ToString("C")</strong></div></div>
  <div class="col-md-4"><div class="card card-body h-100"><span class="text-muted">Pago</span><strong class="fs-3">@itens.Sum(x => x.ValorPago ?? 0).ToString("C")</strong></div></div>
 </section>
 <form method="get" class="card card-body mb-4"><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status"><option value="">Todos</option><option value="pendente">Pendente</option><option value="pago">Pago</option><option value="cancelado">Cancelado</option></select></div><div class="col-md-3"><label class="form-label" for="inicio">Início</label><input class="form-control" id="inicio" name="inicio" type="date" /></div><div class="col-md-3"><label class="form-label" for="fim">Fim</label><input class="form-control" id="fim" name="fim" type="date" /></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrar</button></div></div></form>
 @if (itens.Count == 0) { <div class="card card-body text-center py-5"><i class="bi bi-cash-coin fs-1 text-primary" aria-hidden="true"></i><h2 class="h5 mt-3">Nenhum pagamento nesta competência.</h2><p class="text-muted">Pagamentos aparecem após realização e fechamento válido da escala.</p></div> }
 else { <div class="table-responsive card"><table class="table table-hover align-middle mb-0"><thead><tr><th>Médico</th><th>Origem</th><th>Data</th><th>Previsto</th><th>Pago</th><th>Status</th></tr></thead><tbody>@foreach(var item in itens){<tr><td><strong>@item.MedicoNome</strong><small class="d-block text-muted">@item.MedicoCrm</small></td><td>@item.HospitalNome<small class="d-block text-muted">@item.EspecialidadeNome</small></td><td>@item.DataPlantao.ToString("dd/MM/yyyy")</td><td>@item.ValorPrevisto.ToString("C")</td><td>@((item.ValorPago ?? 0).ToString("C"))</td><td><span class="badge text-bg-light">@item.Status</span></td></tr>}</tbody></table></div> }
</div>
