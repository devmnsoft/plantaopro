@model PlantaoPro.Web.Models.ConfirmModalViewModel?
@{
    var modal = Model ?? new PlantaoPro.Web.Models.ConfirmModalViewModel();

    var id = string.IsNullOrWhiteSpace(modal.Id)
        ? "pp-confirm-modal"
        : modal.Id;

    var title = string.IsNullOrWhiteSpace(modal.Title)
        ? "Confirmar ação"
        : modal.Title;

    var message = string.IsNullOrWhiteSpace(modal.Message)
        ? "Deseja realmente continuar?"
        : modal.Message;

    var confirmText = string.IsNullOrWhiteSpace(modal.ConfirmText)
        ? "Confirmar"
        : modal.ConfirmText;

    var cancelText = string.IsNullOrWhiteSpace(modal.CancelText)
        ? "Cancelar"
        : modal.CancelText;

    var requestedType = string.IsNullOrWhiteSpace(modal.Type)
        ? "warning"
        : modal.Type.Trim().ToLowerInvariant();

    var allowedTypes = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "primary", "secondary", "success", "danger", "warning", "info"
    };

    var type = allowedTypes.Contains(requestedType)
        ? requestedType
        : "warning";

}

<div class="modal fade" id="@id" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@(id)-title" aria-describedby="@(id)-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pp-confirm-modal pp-confirm-modal-@type @(type == "danger" ? "pp-delete-dialog" : string.Empty)" aria-busy="false">
            <div class="modal-header">
                <div class="pp-confirm-heading">
                    <span class="pp-confirm-icon" aria-hidden="true"><app-icon name="Warning" size="22" /></span>
                    <div>
                    <span class="pp-confirm-kicker">Confirmação necessária</span>
                    <h5 class="modal-title mb-0" id="@(id)-title" data-pp-confirm-title>@title</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <div class="modal-body">
                <div class="pp-delete-confirmation"><strong>Revise antes de continuar</strong><p class="mb-0" id="@(id)-description" data-pp-confirm-message>@message</p></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">@cancelText</button>
                <button type="button" class="btn @(type == "danger" ? "btn-danger" : "btn-primary")" data-pp-confirm-action>
                    @if (type == "danger")
                    {
                        <app-icon name="Delete" size="18" />
                    }
                    else
                    {
                        <app-icon name="Check" size="18" />
                    }
                    <span>@confirmText</span>
                    <span class="spinner-border spinner-border-sm d-none" data-pp-confirm-loading aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>
