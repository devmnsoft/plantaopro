@model PlantaoPro.Web.Models.OnboardingResumoDto
@{
    ViewData["Title"] = UiText.L("Onboarding.SuccessPageTitle");
}
<div class="container py-4">
    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@UiText.L("Onboarding.SuccessAlert")</div>
    <div class="card shadow-sm"><div class="card-body">
        <h4>@Model.ClienteNome</h4>
        <ul>
            <li>@UiText.L("Onboarding.SuccessPlanLabel") @Model.PlanoNome</li>
            <li>@UiText.L("Onboarding.SuccessUnitLabel") @Model.UnidadeNome</li>
            <li>@UiText.L("Onboarding.SuccessAdminLabel") @Model.UsuarioNome (@Model.UsuarioEmail)</li>
            <li>@UiText.L("Onboarding.SuccessSubscriptionLabel") @Model.AssinaturaStatus</li>
            <li>@UiText.L("Onboarding.SuccessCreatedLabel") @Model.DataCriacaoAssinatura.ToString("dd/MM/yyyy HH:mm")</li>
        </ul>
        <a asp-controller="Clientes" asp-action="Index" class="btn btn-primary">@UiText.L("Onboarding.GoToClients")</a>
    </div></div>
</div>
