@model PlantaoPro.Web.Models.ParametrosFiscaisConfiguracaoViewModel
@{
    ViewData["Title"] = "Configuração Fiscal — Administrativo 360";

    // Html.Raw marca o resultado como HTML bruto (sem escape); os inputs são literais controlados.
    // Lambda var para não nomear o tipo de retorno do Html.Raw (mudou entre versões do framework).
    var Opcao = (string valor, string? atual, string rotulo) =>
        Html.Raw($"<option value=\"{valor}\" {(string.Equals(valor, atual, StringComparison.OrdinalIgnoreCase) ? "selected" : "")}>{rotulo}</option>");
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">
                <i class="bi bi-gear text-warning me-2"></i>Configuração Fiscal de Emissão
            </h2>
            <p class="text-muted small mb-0">
                Parâmetros da instituição para emissão de NF-e. O que estiver em aberto aparece como pendência visível;
                a credencial fica guardada apenas pelo nome — nunca o valor.
            </p>
        </div>
        <a href="/Administrativo360/Fiscal/Notas" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-receipt me-1"></i>Pré-Emissão de NF-e
        </a>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-2"><i class="bi bi-info-circle me-2"></i>Como configurar a emissão fiscal</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">1. Para que serve</strong>
                    Manter os dados da empresa para emitir NF-e: quem emite, o certificado, o ambiente e os tipos de nota.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">2. Como utilizar</strong>
                    Revise cada seção, complete o que faltar e salve. Decisões em aberto aparecem como pendências visíveis, sem ficar ocultas.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">3. O que acontece ao salvar</strong>
                    A configuração passa a valer para todas as pré-notas seguintes; o certificado fica guardado só pelo nome, sem o segredo.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">4. Próxima ação</strong>
                    Com a configuração pronta, vá até a pré-emissão de NF-e e crie a primeira nota em rascunho.
                </div>
            </div>
        </div>
    </div>

    @if (Model.Erro is not null)
    {
        <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Erro</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StatusAtual))
    {
        <div class="mb-2">
            <span class="badge @(Model.StatusAtual == "CONFIGURADO" ? "bg-success" : Model.StatusAtual == "BLOQUEADO" ? "bg-danger" : "bg-warning text-dark") fs-6 px-2 py-1">
                STATUS ATUAL: @Model.StatusAtual
            </span>
            @if (Model.CredencialDisponivelNoAmbiente == true)
            {
                <span class="badge bg-success ms-1">Credencial disponível no ambiente</span>
            }
            else if (Model.CredencialDisponivelNoAmbiente == false && !string.IsNullOrWhiteSpace(Model.CertificadoReferencia))
            {
                <span class="badge bg-danger ms-1">Credencial '@Model.CertificadoReferencia' indisponível neste ambiente</span>
            }
            @if (Model.TransmissorRegistradoNoAmbiente == true)
            {
                <span class="badge bg-success ms-1">Conector do provedor integrado</span>
            }
            else if (Model.JaCadastrado && !string.IsNullOrWhiteSpace(Model.Provedor))
            {
                <span class="badge bg-warning text-dark ms-1">Conector '@Model.Provedor' ainda não integrado</span>
            }
        </div>
    }

    @if (Model.PendenciasP2.Count > 0)
    {
        <div class="alert border-warning bg-dark py-2 small" style="border-color:#ffc107 !important; color:#f5e9c8;">
            <strong><i class="bi bi-hourglass-split me-1"></i>@(Model.JaCadastrado ? "Pendência P2 registrada — decisões comerciais ausentes:" : "Ainda não cadastrado — pendência P2 registrada. Defina:")</strong>
            <ul class="mb-1 ps-4 mt-1">
                @foreach (var pendencia in Model.PendenciasP2)
                {
                    <li>@pendencia</li>
                }
            </ul>
            <span class="text-secondary">
                Enquanto houver pendência, o status permanece <code>PENDENTE_DE_CONFIGURACAO</code> e o botão
                "Emitir" devolve o motivo real — nenhum sucesso fictício.
            </span>
        </div>
    }

    <form method="post" action="/Administrativo360/Fiscal/SalvarConfiguracao" class="card bg-dark border-secondary mb-4">
        @Html.AntiForgeryToken()
        <div class="card-body p-3">
            <h6 class="text-light small fw-bold text-uppercase mb-2"><i class="bi bi-buildings me-1"></i>Dados do Emitente</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-2">
                    <label class="form-label text-light small">UF de emissão</label>
                    <input aria-label="UF"  type="text" name="uf" maxlength="2" value="@Model.Uf" placeholder="SP" class="form-control form-control-sm bg-black text-light border-secondary text-uppercase" />
                </div>
                <div class="col-md-4">
                    <label class="form-label text-light small">Município</label>
                    <input aria-label="Município"  type="text" name="municipio" maxlength="80" value="@Model.Municipio" placeholder="São Paulo" class="form-control form-control-sm bg-black text-light border-secondary" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-light small">Regime fiscal</label>
                    <select name="regimeFiscal" class="form-select form-select-sm bg-black text-light border-secondary" aria-label="Regime fiscal">
                        <option value="">Não definido (pendência P2)</option>
                        @Opcao("SIMPLES_NACIONAL", Model.RegimeFiscal, "Simples Nacional")
                        @Opcao("LUCRO_PRESUMIDO", Model.RegimeFiscal, "Lucro Presumido")
                        @Opcao("LUCRO_REAL", Model.RegimeFiscal, "Lucro Real")
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-light small">Operação fiscal principal</label>
                    <select name="operacaoFiscal" class="form-select form-select-sm bg-black text-light border-secondary" aria-label="Operação fiscal">
                        <option value="">Não definida (pendência P2)</option>
                        @Opcao("VENDA", Model.OperacaoFiscal, "Venda")
                        @Opcao("REMESSA", Model.OperacaoFiscal, "Remessa")
                        @Opcao("RETORNO", Model.OperacaoFiscal, "Retorno")
                    </select>
                </div>
            </div>

            <h6 class="text-light small fw-bold text-uppercase mb-2"><i class="bi bi-plug me-1"></i>Emissão Externa</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-3">
                    <label class="form-label text-light small">Provedor de emissão</label>
                    <select name="provedor" class="form-select form-select-sm bg-black text-light border-secondary" aria-label="Provedor">
                        <option value="">Não definido (pendência P2)</option>
                        @Opcao("SEFAZ_DIRETO", Model.Provedor, "Direto na Sefaz")
                        @Opcao("OPMENEXO", Model.Provedor, "OpMenexo")
                        @Opcao("INPART", Model.Provedor, "InPart")
                        @Opcao("OUTRO", Model.Provedor, "Outro")
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-light small">Ambiente</label>
                    <select name="ambiente" class="form-select form-select-sm bg-black text-light border-secondary" aria-label="Ambiente">
                        @Opcao("PENDENTE", Model.Ambiente, "Pendente de definição")
                        @Opcao("HOMOLOGACAO", Model.Ambiente, "Homologação")
                        @Opcao("PRODUCAO", Model.Ambiente, "Produção")
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-light small">Credencial de emissão (nome do segredo)</label>
                    <input aria-label="Referência do certificado"  type="text" name="certificadoReferencia" maxlength="120" value="@Model.CertificadoReferencia"
                           placeholder="CNPJ do emitente" class="form-control form-control-sm bg-black text-light border-secondary font-monospace" />
                    <div class="form-text text-secondary">Só o nome da referência. O valor do certificado fica em configuração separada, nunca no banco de dados nem nas telas.</div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check form-switch mb-1">
                        <input type="checkbox" class="form-check-input" id="bloqueioExterno" name="bloqueioExterno" @(Model.BloqueioExterno ? "checked" : "") />
                        <label class="form-check-label text-light small" for="bloqueioExterno">Bloqueado externamente</label>
                    </div>
                </div>
            </div>

            <h6 class="text-light small fw-bold text-uppercase mb-2"><i class="bi bi-hash me-1"></i>CFOP por Operação <span class="text-secondary fw-normal">(sem CFOP universal — L376)</span></h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label text-light small">CFOP — Venda</label>
                    <input aria-label="CFOP de venda"  type="text" name="cfopVenda" maxlength="4" inputmode="numeric" pattern="[0-9]*" value="@Model.CfopVenda" placeholder="5101" class="form-control form-control-sm bg-black text-light border-secondary font-monospace" />
                </div>
                <div class="col-md-4">
                    <label class="form-label text-light small">CFOP — Remessa</label>
                    <input aria-label="CFOP de remessa"  type="text" name="cfopRemessa" maxlength="4" inputmode="numeric" pattern="[0-9]*" value="@Model.CfopRemessa" placeholder="6001" class="form-control form-control-sm bg-black text-light border-secondary font-monospace" />
                </div>
                <div class="col-md-4">
                    <label class="form-label text-light small">CFOP — Retorno</label>
                    <input aria-label="CFOP de retorno"  type="text" name="cfopRetorno" maxlength="4" inputmode="numeric" pattern="[0-9]*" value="@Model.CfopRetorno" placeholder="6101" class="form-control form-control-sm bg-black text-light border-secondary font-monospace" />
                </div>
            </div>

            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label text-light small">Responsável pela emissão (nome)</label>
                    <input aria-label="Nome do responsável"  type="text" name="responsavelNome" maxlength="120" value="@Model.ResponsavelNome" placeholder="Nome do responsável" class="form-control form-control-sm bg-black text-light border-secondary" />
                </div>
                <div class="col-md-8">
                    <label class="form-label text-light small">Observação</label>
                    <input aria-label="Observação"  type="text" name="observacao" maxlength="200" value="@Model.Observacao" placeholder="Contexto da pendência / bloqueio (ex.: aguardando contrato com provedor)" class="form-control form-control-sm bg-black text-light border-secondary" />
                </div>
            </div>
        </div>
        <div class="card-footer bg-dark p-2 d-flex justify-content-between align-items-center">
            <span class="text-secondary small">
                Status derivado automaticamente dos campos: incompleto = <code>PENDENTE_DE_CONFIGURACAO</code>;
                completo = <code>CONFIGURADO</code> (ou <code>BLOQUEADO</code> se bloqueio externo declarado).
            </span>
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-save me-1"></i>Salvar Parâmetros Fiscais
            </button>
        </div>
    </form>
</div>
