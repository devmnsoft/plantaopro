@model PlantaoPro.Web.Models.MinhaAssinaturaViewModel
@{ ViewData["Title"] = "Minha assinatura"; }
<div class="pp-page pp-subscription-page">
    <header class="pp-page-hero" aria-labelledby="subscription-title">
        <div class="pp-page-hero__copy"><span class="pp-eyebrow"><i class="bi bi-gem" aria-hidden="true"></i> Contrato e cobranças</span><h1 id="subscription-title">Minha assinatura</h1><p>Consulte somente as informações do contrato da sua organização.</p></div>
        <div class="pp-hero-actions"><a class="btn btn-outline-primary" asp-controller="Planos" asp-action="Index"><i class="bi bi-layers" aria-hidden="true"></i> Consultar planos</a></div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="pp-notice" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div><strong>Não foi possível consultar a assinatura.</strong><br />@Model.ErrorMessage</div></div>
    }
    else if (!Model.HasSubscription)
    {
        <section class="pp-empty-state pp-empty-state--featured" aria-labelledby="subscription-empty-title"><span class="pp-icon-surface" aria-hidden="true"><i class="bi bi-link-45deg"></i></span><h2 id="subscription-empty-title">Assinatura ainda não vinculada</h2><p>Não encontramos um vínculo contratual para esta organização. Plano, preço, limites, consumo e cobranças permanecem ocultos para não apresentar estimativas como dados reais.</p><a class="btn btn-outline-primary" asp-controller="Configuracoes" asp-action="Index">Abrir central administrativa</a></section>
    }
    else
    {
        <section class="pp-kpi-grid pp-subscription-summary" aria-label="Resumo da assinatura">
            @if (!string.IsNullOrWhiteSpace(Model.Plano)) { <article class="pp-kpi-card"><span>Plano atual</span><strong>@Model.Plano</strong><small>Informado pelo contrato vinculado</small></article> }
            @if (!string.IsNullOrWhiteSpace(Model.Status)) { <article class="pp-kpi-card"><span>Status</span><strong>@Model.Status</strong><small>Situação atual</small></article> }
            @if (!string.IsNullOrWhiteSpace(Model.Ciclo)) { <article class="pp-kpi-card"><span>Ciclo</span><strong>@Model.Ciclo</strong><small>Periodicidade contratual</small></article> }
            @if (Model.Vencimento.HasValue) { <article class="pp-kpi-card"><span>Próximo vencimento</span><strong>@Model.Vencimento.Value.ToString("dd/MM/yyyy")</strong><small>Data combinada no contrato.</small></article> }
            @if (Model.FimDoTeste.HasValue) { <article class="pp-kpi-card"><span>Fim do teste grátis</span><strong>@Model.FimDoTeste.Value.ToString("dd/MM/yyyy")</strong><small>Após o teste você ainda tem 30 dias para decidir sobre a assinatura.</small></article> }
        </section>

        @if (Model.JornadaImplantacao is { } jImplantacao)
        {
            <section class="card border-0 mb-3" aria-label="Andamento da implantação">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3 py-3">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-rocket-takeoff text-primary fs-4" aria-hidden="true"></i>
                        <div>
                            <strong>Sua implantação está @jImplantacao.Progresso% pronta</strong>
                            <span class="d-block text-muted small">@(string.IsNullOrWhiteSpace(jImplantacao.ProximaAcao) ? "Continue a lista para terminar de preparar sua conta." : jImplantacao.ProximaAcao)</span>
                        </div>
                    </div>
                    <a class="btn btn-primary btn-sm" asp-controller="Onboarding" asp-action="Index"><i class="bi bi-signpost-split me-1" aria-hidden="true"></i> Continuar implantação</a>
                </div>
            </section>
        }

        <section class="pp-ai-panel" data-ai-panel data-ai-url="/MinhaAssinatura/ResumoIa" data-ai-method="GET" aria-labelledby="ppAiAssinaturaTitulo">
            <div class="pp-ai-panel__head">
                <div><span class="pp-ai-panel__kicker">Assistente · opcional</span><h2 id="ppAiAssinaturaTitulo" class="pp-ai-panel__title"><i class="bi bi-stars me-1" aria-hidden="true"></i>O que você precisa saber agora</h2></div>
                <button type="button" class="btn btn-sm btn-primary" data-ai-run><i class="bi bi-lightning me-1" aria-hidden="true"></i>Pedir resumo</button>
            </div>
            <p class="small text-muted">Resumo em linguagem simples do que está pendente na sua organização — contrato ou teste grátis, configuração inicial e operação — e a ordem prática para resolver. O assistente não aplica nada sozinho: cada ação é feita nas telas indicadas.</p>
            <p class="pp-ai-panel__meta" data-ai-meta aria-live="polite"></p>
            <p class="pp-ai-panel__output" data-ai-output role="status">Nenhuma geração nesta sessão.</p>
            <pre class="pp-ai-panel__text" data-ai-text hidden></pre>
            <p class="pp-ai-panel__note">Precisa de ajuste? <a href="/AssistenteIa">Configurar assistente</a> (administradores).</p>
        </section>

        <div class="pp-subscription-layout">
            <main class="pp-subscription-main">
                <section class="pp-card pp-subscription-section" aria-labelledby="usage-title"><div class="pp-section-header"><div><span class="pp-eyebrow">Capacidade</span><h2 id="usage-title">Limites e uso</h2><p>Valores disponibilizados pela fonte contratual, sem projeções.</p></div></div>
                    @if (Model.Limites.Count == 0 && Model.Uso.Count == 0) { <div class="pp-inline-empty"><i class="bi bi-bar-chart" aria-hidden="true"></i><div><strong>Consumo não informado</strong><p>Limites e uso ainda não foram informados para este contrato.</p></div></div> }
                    else { <div class="table-responsive"><table class="pp-data-table"><thead><tr><th scope="col">Métrica</th><th scope="col">Origem</th><th scope="col">Valor</th></tr></thead><tbody>@foreach (var item in Model.Limites) { <tr><th scope="row">@item.Nome</th><td>Limite contratado</td><td>@item.Valor</td></tr> }@foreach (var item in Model.Uso) { <tr><th scope="row">@item.Nome</th><td>Uso atual</td><td>@item.Valor</td></tr> }</tbody></table></div> }
                </section>
                <section class="pp-card pp-subscription-section" aria-labelledby="billing-title"><div class="pp-section-header"><div><span class="pp-eyebrow">Cobranças</span><h2 id="billing-title">Histórico de cobrança</h2><p>Somente eventos registrados na cobrança.</p></div></div>
                    @if (Model.HistoricoCobranca.Count == 0) { <div class="pp-inline-empty"><i class="bi bi-receipt" aria-hidden="true"></i><div><strong>Nenhuma cobrança disponível</strong><p>Ainda não há cobranças registradas para esta assinatura.</p></div></div> }
                    else { <div class="pp-billing-timeline">@foreach (var item in Model.HistoricoCobranca) { <article><span class="pp-timeline-dot" aria-hidden="true"></span><div><h3>@(string.IsNullOrWhiteSpace(item.Status) ? "Status não informado" : item.Status)</h3><p>@(item.Data?.ToString("dd/MM/yyyy") ?? "Data não informada")</p></div><strong>@item.Valor</strong></article> }</div> }
                </section>
            </main>
            <aside class="pp-card pp-subscription-side" aria-labelledby="contract-details-title"><span class="pp-eyebrow">Contrato</span><h2 id="contract-details-title">Detalhes e ações</h2>
                <h3>Módulos habilitados</h3>@if (Model.Modulos.Count == 0) { <p class="text-muted">Nenhum módulo habilitado no momento.</p> } else { <ul class="pp-chip-list">@foreach (var item in Model.Modulos) { <li>@item</li> }</ul> }
                <h3>Responsável financeiro</h3><p>@(string.IsNullOrWhiteSpace(Model.ResponsavelFinanceiro) ? "Não informado." : Model.ResponsavelFinanceiro)</p>
                <h3>Alertas contratuais</h3>@if (Model.Alertas.Count == 0) { <p class="text-muted">Nenhum alerta informado.</p> } else { <ul class="pp-status-list">@foreach (var alerta in Model.Alertas) { <li><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@alerta</li> }</ul> }
                <h3>Solicitações de plano</h3>@if (Model.Solicitacoes.Count == 0) { <p class="text-muted">Nenhuma solicitação registrada.</p> } else { <ul class="pp-status-list">@foreach (var s in Model.Solicitacoes) { <li><i class="bi bi-clock-history" aria-hidden="true"></i><strong>@s.Tipo → @s.PlanoDestinoNome</strong><br />@s.Status — @s.MensagemEstado</li> }</ul> }
                <nav class="pp-stack-actions" aria-label="Ações da assinatura"><a class="btn btn-outline-primary" asp-controller="Planos" asp-action="Index">Ver catálogo de planos</a><a class="btn btn-outline-secondary" asp-controller="Configuracoes" asp-action="Index">Abrir configurações</a></nav>
            </aside>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/design-system/assistente-ia.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/ai-assistant-panel.js" asp-append-version="true"></script>
}
