@model PlantaoPro.Web.Models.ManagerRequestQueueViewModel
@{ ViewData["Title"] = "Solicitações da unidade"; var current = Context.Request.Path + Context.Request.QueryString; }
<main class="manager-journey" aria-labelledby="queue-title">
  <nav aria-label="Navegação estrutural"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Central operacional</a></li><li class="breadcrumb-item active" aria-current="page">Solicitações</li></ol></nav>
  <header class="manager-header"><div><span class="pp-section-kicker">Gestão por unidade</span><h1 id="queue-title">Fila de solicitações</h1><p>O período filtra a <strong>data de envio</strong>. Cada decisão é individual e revalidada no servidor.</p></div><a asp-controller="ConferenciaExecucao" asp-action="Index" class="btn btn-outline-primary">Conferir execuções</a></header>
  @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-warning" role="alert">@Model.Error</div> }
  <details class="manager-filters" open><summary>Filtros</summary><form method="get" class="row g-3 align-items-end">
    <div class="col-12 col-md-3"><label for="unidadeId" class="form-label">Unidade (identificador)</label><input id="unidadeId" name="unidadeId" class="form-control" value="@Model.UnidadeId" /></div>
    <div class="col-6 col-md-2"><label for="inicio" class="form-label">Enviada de</label><input id="inicio" name="inicio" type="date" class="form-control" value="@Model.Inicio?.ToString("yyyy-MM-dd")" /></div>
    <div class="col-6 col-md-2"><label for="fim" class="form-label">Enviada até</label><input id="fim" name="fim" type="date" class="form-control" value="@Model.Fim?.ToString("yyyy-MM-dd")" /></div>
    <div class="col-12 col-md-2"><label for="status" class="form-label">Situação</label><select id="status" name="status" class="form-select"><option value="">Todas</option>@foreach(var s in new[]{"SOLICITADA","APROVADA","RECUSADA","SUBSTITUTO_CONVIDADO","CONFIRMADA"}){<option value="@s" selected="@(Model.Status == s ? "selected" : null)">@s.Replace('_',' ')</option>}</select></div>
    <div class="col-12 col-md-2"><label for="profissional" class="form-label">Profissional</label><input id="profissional" name="profissional" class="form-control" value="@Model.Profissional" maxlength="120" /></div>
    <div class="col-12 col-md-1 d-grid"><button class="btn btn-primary" type="submit">Filtrar</button></div>
  </form></details>
  <section class="manager-table" aria-label="Solicitações encontradas">
    <div class="manager-table__summary"><strong>@Model.Total solicitação(ões)</strong><span>Ordenação: envio mais recente</span></div>
    @if (!Model.Items.Any()) { <div class="p-4 text-center"><strong>Nenhuma solicitação explica estes filtros.</strong><p class="text-muted mb-0">Altere o período ou a situação; dados fictícios não são adicionados.</p></div> }
    else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Tipo / situação</th><th>Profissional</th><th>Unidade</th><th>Plantão</th><th>Enviada</th><th>Motivo</th><th><span class="visually-hidden">Ação</span></th></tr></thead><tbody>
      @foreach(var item in Model.Items){<tr><td><strong>Substituição</strong><br/><span class="badge text-bg-@(item.Status == "SOLICITADA" ? "warning" : item.Status == "RECUSADA" ? "secondary" : "success")">@item.Status.Replace('_',' ')</span></td><td class="manager-name">@item.MedicoSolicitanteNome</td><td>@item.HospitalNome</td><td><time datetime="@item.DataInicio.ToString("O")">@item.DataInicio.ToString("dd/MM/yyyy HH:mm")</time><small>@item.EspecialidadeNome</small></td><td>@item.RegDate.ToString("dd/MM/yyyy HH:mm")</td><td class="manager-reason">@item.Motivo</td><td><a asp-action="SubstituicaoDetails" asp-route-id="@item.Id" asp-route-returnUrl="@current" class="btn btn-sm btn-outline-primary">@(item.Status == "SOLICITADA" ? "Analisar" : "Consultar")</a></td></tr>}
    </tbody></table></div> }
  </section>
  <nav class="manager-pagination" aria-label="Paginação"><span>Página @Model.Page de @Model.TotalPages</span><div>@if(Model.Page>1){<a class="btn btn-sm btn-outline-primary" asp-all-route-data="@Context.Request.Query.ToDictionary(x=>x.Key,x=>x.Value.ToString())" asp-route-page="@(Model.Page-1)">Anterior</a>} @if(Model.Page<Model.TotalPages){<a class="btn btn-sm btn-outline-primary" asp-all-route-data="@Context.Request.Query.ToDictionary(x=>x.Key,x=>x.Value.ToString())" asp-route-page="@(Model.Page+1)">Próxima</a>}</div></nav>
  <details class="manager-help"><summary>Como usar</summary><p>Abra uma solicitação para comparar o pedido com a atribuição atual. Aprovar autoriza a próxima etapa da cobertura, mas não remove o profissional original nem confirma um substituto. Recusar encerra o pedido e preserva o histórico.</p><p>Confirmações de escala ficam em <a asp-controller="Escalas" asp-action="Index">Escalas</a>; correções e ausências ficam em <a asp-controller="ConferenciaExecucao" asp-action="Index">Conferência de execução</a>.</p></details>
</main>
