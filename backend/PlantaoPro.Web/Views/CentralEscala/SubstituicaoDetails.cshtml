@model PlantaoPro.Web.Models.ManagerSubstitutionDto?
@{ ViewData["Title"] = "Analisar substituição"; var back = ViewBag.ReturnUrl as string ?? Url.Action("Substituicoes"); var savedReason = TempData["DecisionReason"] as string; }
<main class="manager-journey" aria-labelledby="detail-title">
 <nav aria-label="Navegação estrutural"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Central operacional</a></li><li class="breadcrumb-item"><a href="@back">Solicitações</a></li><li class="breadcrumb-item active" aria-current="page">Detalhe</li></ol></nav>
 @if(Model is null){<div class="alert alert-warning" role="alert">@(ViewBag.ErrorMessage ?? "Solicitação indisponível.")</div>}
 else {
 <header class="manager-header"><div><span class="pp-section-kicker">Pedido original</span><h1 id="detail-title">Substituição de @Model.MedicoSolicitanteNome</h1><p>@Model.HospitalNome · @Model.EspecialidadeNome · @Model.DataInicio.ToString("dd/MM/yyyy HH:mm")</p></div><span class="badge text-bg-@(Model.Status == "SOLICITADA" ? "warning" : "secondary")">@Model.Status.Replace('_',' ')</span></header>
 <div class="manager-detail-grid"><section class="manager-panel"><h2>Pedido</h2><dl><dt>Solicitação</dt><dd>@Model.Id</dd><dt>Enviada em</dt><dd>@Model.RegDate.ToString("dd/MM/yyyy HH:mm")</dd><dt>Motivo informado</dt><dd>@Model.Motivo</dd></dl></section>
 <section class="manager-panel"><h2>Registro afetado</h2><dl><dt>Unidade</dt><dd>@Model.HospitalNome</dd><dt>Plantão</dt><dd>@Model.DataInicio.ToString("dd/MM/yyyy HH:mm")–@Model.DataFim.ToString("dd/MM/yyyy HH:mm")</dd><dt>Atribuição atual</dt><dd>@Model.MedicoSolicitanteNome permanece responsável</dd></dl></section></div>
 <section class="manager-panel manager-impact"><h2>Consequências</h2><div><strong>Se aprovada</strong><p>O pedido segue para seleção e aceite de substituto. A atribuição original não é removida nesta decisão.</p></div><div><strong>Se rejeitada</strong><p>O pedido é encerrado, a responsabilidade atual permanece e a justificativa fica no histórico.</p></div></section>
 @if(Model.Status == "SOLICITADA") {<form asp-action="DecidirSubstituicao" method="post" class="manager-decision"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="versaoEsperada" value="@Model.Versao"/><input type="hidden" name="returnUrl" value="@back"/><label for="justificativa" class="form-label">Justificativa da decisão</label><textarea id="justificativa" name="justificativa" class="form-control" minlength="3" maxlength="1000" required rows="4">@savedReason</textarea><p class="form-text">Obrigatória, de 3 a 1.000 caracteres. A versão e o estado serão revalidados.</p><div class="manager-decision__actions"><button type="submit" name="decisao" value="RECUSAR" class="btn btn-outline-danger">Rejeitar solicitação</button><button type="submit" name="decisao" value="APROVAR" class="btn btn-primary">Aprovar próxima etapa</button></div></form>}
 else {<div class="alert alert-info" role="status">Esta solicitação não admite nova decisão porque já saiu do estado solicitado. Consulte o histórico operacional.</div>}
 <details class="manager-help"><summary>Como usar e interpretar</summary><p>A decisão não escolhe nem confirma automaticamente um substituto. Caso outra pessoa decida primeiro ou a origem mude, esta página informará conflito e exigirá nova revisão.</p></details> }
</main>
