@model PlantaoPro.Web.Models.DashboardPremiumPageViewModel
@{
    ViewData["Title"] = "Painel " + Model.Titulo;
    var badgeClass = Model.Fonte == "Real" ? "bg-success" : Model.Fonte == "Parcial" ? "bg-warning text-dark" : "bg-secondary";
}
<section class="pp-hero premium-hero pp-strategic-surface">
    <p class="text-uppercase text-primary fw-bold">Painel executivo</p>
    <h1>Painel @Model.Titulo</h1>
    <p>Indicadores do seu perfil, plano e módulos contratados.</p>
    <span class="badge @badgeClass">Fonte: @Model.Fonte</span>
</section>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning mt-3">@Model.ErrorMessage</div>
}
@if (!Model.Kpis.Any())
{
    <partial name="_EmptyState" model='new PlantaoPro.Web.Models.EmptyStateViewModel("bi-bar-chart", "Sem indicadores reais", "Nenhum indicador foi encontrado para este contexto. Somente indicadores reais são exibidos.")' />
}
else
{
    <div class="row g-3">
    @foreach (var kpi in Model.Kpis)
    {
        <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body">
            <span class="badge bg-primary">KPI real</span><h2 class="h6 mt-2">@kpi.Titulo</h2><strong>@kpi.Valor @kpi.Unidade</strong>
            <p class="small text-muted">@kpi.Tendencia</p>
            @* Rodada 10 r10b3 (§27-L208): drill-down apenas para KPIs com rota de listagem existente que reproduce
               o predicado do KPI (estado atual, reg_status='A', escopo tenant da API): Plantões -> /Plantoes e
               Escalas -> /Escalas (todos os status = conjunto completo reg_status='A'). Médicos fica sem link
               (listagem api/medicos é global, sem escopo de tenant) e Agendamentos também (rota /agenda é por
               período, default semana). Sem rota inventada — decisão registrada em r10b3. *@
            @if (kpi.Titulo == "Plantões") { <a class="small d-block mt-1" asp-controller="Plantoes" asp-action="Index">Ver registros</a> }
            else if (kpi.Titulo == "Escalas") { <a class="small d-block mt-1" asp-controller="Escalas" asp-action="Index">Ver registros</a> }
        </div></div></div>
    }
    </div>
}
<div class="row g-3 mt-1">
    <div class="col-lg-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Alertas</h2>@foreach (var alerta in Model.Alertas){<div class="alert alert-danger py-2">@alerta</div>}@if (!Model.Alertas.Any()){<p class="text-muted">Sem alertas para este período.</p>}</div></div></div>
    <div class="col-lg-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Próximos passos</h2><ol>@foreach (var passo in Model.ProximosPassos){<li>@passo</li>}</ol>@if (!Model.ProximosPassos.Any()){<p class="text-muted">Sem próximos passos retornados.</p>}</div></div></div>
    <div class="col-lg-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Gráfico simples</h2>@foreach (var item in Model.Series){<div class="mb-2"><span>@item.Label</span><div class="progress"><div class="progress-bar" data-progress="@Math.Min(100, (int)item.Valor)">@item.Valor</div></div></div>}@if (!Model.Series.Any()){<p class="text-muted">Sem série temporal retornada.</p>}</div></div></div>
</div>
<div class="mt-3 d-flex gap-2 flex-wrap">
@foreach (var atalho in Model.Atalhos)
{
    <a class="btn btn-outline-primary" href="@(string.IsNullOrWhiteSpace(atalho.Url) ? Url.Action("Index", "Home") : atalho.Url)">@atalho.Titulo</a>
}
<a class="btn btn-primary" asp-controller="OperacaoInteligente" asp-action="Index">Ir para Operação Inteligente</a>
</div>
<p class="small text-muted mt-3">@Model.StatusPlanoModulo</p>
