@model PlantaoPro.Web.Controllers.UserSettingsSummaryViewModel
@{
    ViewData["Title"] = "Configurações";
    var governance = new[] {
        new { Title="Organização", Description="Revise identidade, dados institucionais e contexto da organização.", Icon="bi-building", Controller="Parametrizacoes", Action="Index", Status="Rota disponível" },
        new { Title="Usuários e permissões", Description="Administre acessos e avance para a matriz de permissões.", Icon="bi-people", Controller="Usuarios", Action="Index", Status="Acesso controlado" },
        new { Title="Planos e assinatura", Description="Consulte contrato, módulos, consumo e cobranças informadas pela API.", Icon="bi-gem", Controller="MinhaAssinatura", Action="Index", Status="Dados do backend" },
        new { Title="White label", Description="Gerencie a identidade visual permitida para o ambiente.", Icon="bi-palette", Controller="WhiteLabel", Action="Index", Status="Rota disponível" },
        new { Title="Notificações", Description="Defina os canais e preferências disponíveis para sua conta.", Icon="bi-bell", Controller="Notificacoes", Action="Preferencias", Status="Preferências reais" }
    };
    var trust = new[] {
        new { Title="Segurança", Description="Revise perfis, políticas e controles de acesso do ambiente.", Icon="bi-shield-check", Controller="Seguranca", Action="Index", Status="Área crítica" },
        new { Title="LGPD", Description="Consulte políticas, consentimentos, retenção e solicitações existentes.", Icon="bi-shield-lock", Controller="Lgpd", Action="Index", Status="Governança" },
        new { Title="Auditoria", Description="Pesquise eventos efetivamente registrados, sem ocorrências simuladas.", Icon="bi-journal-check", Controller="Auditoria", Action="Index", Status="Trilha real" },
        new { Title="Integrações", Description="Acesse pontos de integração e credenciais disponibilizados.", Icon="bi-plug", Controller="Integracoes", Action="Index", Status="Acesso controlado" }
    };
    var operation = new[] {
        new { Title="Parâmetros operacionais", Description="Organize regras de operação e preferências institucionais.", Icon="bi-toggles", Controller="Parametrizacoes", Action="Index", Status="Rota disponível" },
        new { Title="Saúde 360", Description="Abra os módulos assistenciais disponíveis para a organização.", Icon="bi-heart-pulse", Controller="Saude360", Action="Index", Status="Módulo operacional" },
        new { Title="Financeiro", Description="Acesse pagamentos, repasses e fechamentos disponíveis ao perfil.", Icon="bi-cash-stack", Controller="Financeiro", Action="Index", Status="Módulo operacional" }
    };
}
<div class="pp-page pp-settings-page">
    <header class="pp-page-hero" aria-labelledby="settings-title"><div class="pp-page-hero__copy"><span class="pp-eyebrow"><i class="bi bi-sliders" aria-hidden="true"></i> Central administrativa</span><h1 id="settings-title">Configurações</h1><p>Governança, segurança e parâmetros organizados por responsabilidade. Cada atalho abaixo aponta para uma rota implementada.</p></div><div class="pp-hero-actions"><a class="btn btn-primary" asp-controller="Usuario" asp-action="Edit"><i class="bi bi-person-gear" aria-hidden="true"></i> Editar meu perfil</a></div></header>
    @if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage as string)) { <div class="pp-notice" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div><strong>Não foi possível atualizar os dados da conta.</strong><br />@ViewBag.ErrorMessage</div></div> }
    <section class="pp-card pp-account-card" aria-labelledby="account-title"><span class="pp-account-card__avatar"><i class="bi bi-person" aria-hidden="true"></i></span><div><span class="pp-eyebrow">Conta autenticada</span><h2 id="account-title">@(string.IsNullOrWhiteSpace(Model.Nome) ? "Dados da conta indisponíveis" : Model.Nome)</h2>@if (string.IsNullOrWhiteSpace(Model.Email)) { <p>O perfil não foi retornado pela API. As áreas abaixo continuam sujeitas às permissões do usuário.</p> } else { <dl><div><dt>E-mail</dt><dd>@Model.Email</dd></div><div><dt>Telefone</dt><dd>@(string.IsNullOrWhiteSpace(Model.Telefone) ? "Não informado" : Model.Telefone)</dd></div><div><dt>Notificações</dt><dd>@Model.PreferenciasNotificacao</dd></div></dl> }<a class="btn btn-outline-primary" asp-controller="Usuario" asp-action="AlterarSenha"><i class="bi bi-key" aria-hidden="true"></i> Alterar senha</a></div></section>
    @foreach (var group in new[] { new { Id="governance", Eyebrow="Administração", Title="Organização e pessoas", Description="Identidade, equipe, contrato e comunicação.", Items=governance }, new { Id="trust", Eyebrow="Confiança", Title="Segurança, LGPD e integrações", Description="Controles sensíveis e evidências para governança.", Items=trust }, new { Id="operation", Eyebrow="Operação", Title="Parâmetros por módulo", Description="Acesso direto às fontes operacionais existentes.", Items=operation } })
    {
        <section class="pp-settings-group" aria-labelledby="@group.Id-title"><div class="pp-section-header"><div><span class="pp-eyebrow">@group.Eyebrow</span><h2 id="@group.Id-title">@group.Title</h2><p>@group.Description</p></div></div><div class="pp-action-grid mt-3">
        @foreach (var item in group.Items) { <a class="pp-action-card" asp-controller="@item.Controller" asp-action="@item.Action"><span class="pp-action-card__icon"><i class="bi @item.Icon" aria-hidden="true"></i></span><h3>@item.Title</h3><p>@item.Description</p><span class="pp-action-card__meta"><span class="pp-card-status"><i class="bi bi-check-circle" aria-hidden="true"></i>@item.Status</span><span>Abrir <i class="bi bi-arrow-right" aria-hidden="true"></i></span></span></a> }
        </div></section>
    }
</div>
