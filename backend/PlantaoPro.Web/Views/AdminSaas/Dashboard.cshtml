@model CommercialDemoPageViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Subtitle"] = Model.Subtitle;
}
<div class="pp-page pp-saas-dashboard">
    <header class="pp-page-hero">
        <div class="pp-page-hero__copy">
            <span class="pp-eyebrow">Modo Global MNSOFT · acesso auditado</span>
            <h2>Central Global MNSOFT</h2>
            <p>@Model.Subtitle</p>
        </div>
        <div class="pp-hero-actions">
            <a class="btn btn-outline-primary" asp-controller="Planos" asp-action="Index"><app-icon name="Settings" size="18" /> Ver planos</a>
            <a class="btn btn-primary" asp-controller="Onboarding" asp-action="NovoCliente"><app-icon name="Hospital" size="18" /> Novo cliente</a>
        </div>
    </header>

    <div class="pp-global-scope-banner" role="note"><app-icon name="Security" size="20" /><div><strong>Visão global protegida</strong><span>Esta área é exclusiva do Super Administrador MNSOFT. Confirme o cliente antes de agir: operações sensíveis respeitam permissões do servidor e permanecem auditáveis.</span></div></div>

    <div class="pp-context-command" aria-label="Contexto administrativo atual">
        <div><span class="pp-context-command__label">Contexto atual</span><strong>Visão global MNSOFT</strong><small>Nenhum cliente está sendo assistido neste momento.</small></div>
        <a class="btn btn-outline-primary" asp-controller="Clientes" asp-action="Index"><app-icon name="Hospital" size="18" /> Selecionar cliente</a>
    </div>

    <div class="pp-scope-guardrails" role="list" aria-label="Garantias do contexto global">
        <span role="listitem"><app-icon name="Security" size="17" /><strong>Escopo:</strong> global MNSOFT</span>
        <span role="listitem"><app-icon name="Audit" size="17" /><strong>Ações:</strong> auditáveis</span>
        <span role="listitem"><app-icon name="Lock" size="17" /><strong>Cliente:</strong> selecione antes de agir</span>
    </div>

    <nav class="pp-global-command-grid" aria-label="Navegação global MNSOFT">
        <a asp-controller="Clientes" asp-action="Index"><app-icon name="Hospital" size="20" /><span><strong>Clientes e tenants</strong><small>Todos os clientes e bloqueios</small></span></a>
        <a asp-controller="Usuarios" asp-action="Index"><app-icon name="User" size="20" /><span><strong>Usuários</strong><small>Acessos em todos os contextos</small></span></a>
        <a asp-controller="Perfis" asp-action="Index"><app-icon name="Security" size="20" /><span><strong>Perfis e permissões</strong><small>Módulos e funcionalidades</small></span></a>
        <a asp-controller="FaturamentoSaas" asp-action="Index"><app-icon name="Finance" size="20" /><span><strong>Cobranças</strong><small>Faturas e inadimplência</small></span></a>
        <a asp-controller="Auditoria" asp-action="Index"><app-icon name="Audit" size="20" /><span><strong>Auditoria e logs</strong><small>Eventos globais rastreáveis</small></span></a>
        <a asp-controller="Configuracoes" asp-action="Index"><app-icon name="Settings" size="20" /><span><strong>Configurações globais</strong><small>Governança da plataforma</small></span></a>
    </nav>

    <section class="pp-section" aria-labelledby="saasModulesTitle">
        <div class="pp-section-heading"><div><h2 id="saasModulesTitle">Áreas de gestão</h2><p>Acesse dados reais e continue o fluxo necessário.</p></div></div>
        <div class="pp-clinical-grid">
            @foreach (var card in Model.Cards)
            {
                <article class="pp-action-card">
                    <span class="pp-icon-surface" aria-hidden="true"><app-icon name="Settings" size="22" /></span>
                    <h3>@card.Title</h3><p>@card.Description</p>
                    <div class="pp-card-actions"><a class="btn btn-outline-primary" asp-controller="@card.ActionController" asp-action="@card.ActionName">@card.ActionText <app-icon name="ChevronRight" size="17" /></a></div>
                </article>
            }
        </div>
    </section>

    <section class="pp-section" aria-labelledby="globalModuleMapTitle">
        <div class="pp-section-heading"><div><span class="pp-section-kicker">Cobertura da plataforma</span><h2 id="globalModuleMapTitle">Mapa de módulos e registros globais</h2><p>Atalhos para as fontes reais. As permissões do servidor, o tenant selecionado e a auditoria continuam obrigatórios.</p></div><span class="pp-badge">Visão MNSOFT</span></div>
        <nav class="pp-global-module-map" aria-label="Mapa global de módulos">
            <a asp-controller="Medicos" asp-action="Index"><app-icon name="User" size="20" /><span><strong>Médicos</strong><small>Credenciais e profissionais</small></span></a>
            <a asp-controller="Hospitais" asp-action="Index"><app-icon name="Hospital" size="20" /><span><strong>Hospitais e unidades</strong><small>Estrutura por cliente</small></span></a>
            <a asp-controller="Escalas" asp-action="Index"><app-icon name="Calendar" size="20" /><span><strong>Escalas</strong><small>Planejamento e cobertura</small></span></a>
            <a asp-controller="Plantoes" asp-action="Index"><app-icon name="Coverage" size="20" /><span><strong>Plantões</strong><small>Registros operacionais</small></span></a>
            <a asp-controller="Financeiro" asp-action="Index"><app-icon name="Finance" size="20" /><span><strong>Financeiro</strong><small>Pagamentos e repasses</small></span></a>
            <a asp-controller="Relatorios" asp-action="Index"><app-icon name="Report" size="20" /><span><strong>Relatórios</strong><small>Indicadores autorizados</small></span></a>
            <a asp-controller="Observabilidade" asp-action="Index"><app-icon name="Dashboard" size="20" /><span><strong>Saúde da plataforma</strong><small>Serviços e integrações</small></span></a>
            <a asp-controller="Onboarding" asp-action="Index"><app-icon name="Triage" size="20" /><span><strong>Implantação</strong><small>Primeiro acesso e ativação</small></span></a>
        </nav>
    </section>

    <section class="pp-section" aria-labelledby="operationsTitle">
        <div class="pp-section-heading"><div><h2 id="operationsTitle">Checklist operacional</h2><p>Revise cada frente antes de ampliar a operação do tenant.</p></div><span class="pp-badge">@(Model.Checklist.Count()) frentes</span></div>
        <div class="pp-checklist-grid">
            @foreach (var item in Model.Checklist)
            {
                <article class="pp-checklist-card">
                    <div class="pp-checklist-card__head"><span class="pp-icon-surface" aria-hidden="true"><app-icon name="Settings" size="20" /></span><h3>@item</h3></div>
                    <p>Confira configuração, responsáveis e pendências desta frente.</p>
                    <div class="pp-progress" aria-label="Revisão pendente"><span data-progress="0"></span></div>
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Implantacao" asp-action="Index">Revisar configuração</a>
                </article>
            }
        </div>
    </section>
</div>
