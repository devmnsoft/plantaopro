@model PlantaoPro.Web.Models.PortalContasConfigViewModel
@{
    ViewData["Title"] = "Contas de Portais de Cotação — Administrativo 360";
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 text-light fw-bold">
                <i class="bi bi-gear text-warning me-2"></i>Contas de Portais de Cotação
            </h2>
            <p class="text-muted small mb-0">Parametrização das contas de integração com OPMENEXO/BIONEXO e INPART Saúde por estabelecimento/CNPJ.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Administrativo360/Cotacoes/Estabelecimentos" class="btn btn-outline-info">
                <i class="bi bi-building me-1"></i> Estabelecimentos (CNPJs)
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNovaConta">
                <i class="bi bi-plus-circle me-1"></i> Nova Conta de Portal
            </button>
        </div>
    </div>

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-2"><i class="bi bi-info-circle me-2"></i>Como cadastrar as contas dos portais de cotação</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">1. Para que serve</strong>
                    Dizer ao sistema quais contas de OPMENEXO/BIONEXO e INPART Saúde existem por estabelecimento, para que as cotações possam ser captadas.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">2. Como utilizar</strong>
                    Crie uma conta por estabelecimento/CNPJ com os dados de acesso fornecidos pelo portal; eles ficam guardados sem aparecer em aberto na tela.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">3. O que acontece ao salvar</strong>
                    Só estabelecimentos com conta válida no portal passam a receber cotações por ele.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">4. Próxima ação</strong>
                    Confirme na página Estabelecimentos (CNPJs) se a unidade existe e está habilitada.
                </div>
            </div>
        </div>
    </div>

    <!-- Regra de Conectores -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-2"><i class="bi bi-shield-check me-2"></i>Conformidade e Rastreabilidade da Integração</h5>
            <p class="small text-secondary mb-0">
                Conforme as regras do Administrativo 360, <strong>nenhuma integração externa retorna sucesso fictício</strong>.
                Contas sem credenciais oficiais válidas são marcadas como <code>BLOQUEADA</code> ou <code>NAO_CONFIGURADA</code>.
                Segredos e tokens são armazenados protegidos e nunca expostos em logs ou interfaces.
            </p>
        </div>
    </div>

    <!-- Tabela de Contas -->
    <div class="card bg-dark border-secondary">
        <div class="card-header bg-dark border-secondary">
            <h5 class="card-title text-light mb-0 h6">
                Contas Registradas (@Model.Contas.Count)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th scope="col">Estabelecimento</th>
                            <th scope="col">Provedor</th>
                            <th scope="col">Nome da Conta</th>
                            <th scope="col">Usuário / ID Externo</th>
                            <th scope="col">Ambiente</th>
                            <th scope="col">Status Integração</th>
                            <th scope="col">Última Sincronização</th>
                            <th scope="col">Situação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Contas.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-white-50">
                                    Nenhuma conta de portal configurada.
                                </td>
                            </tr>
                        }
                        @foreach (var c in Model.Contas)
                        {
                            <tr>
                                <td><strong class="text-light">@c.EstabelecimentoNome</strong></td>
                                <td><span class="badge bg-secondary">@c.Provedor</span></td>
                                <td class="text-light">@c.NomeConta</td>
                                <td>
                                    <div>@(c.UsuarioAcesso ?? "Não informado")</div>
                                    @if (!string.IsNullOrWhiteSpace(c.IdentificadorExterno))
                                    {
                                        <div class="small text-white-50">ID: @c.IdentificadorExterno</div>
                                    }
                                </td>
                                <td><span class="badge bg-dark border">@c.Ambiente</span></td>
                                <td>
                                    @switch (c.StatusIntegracao)
                                    {
                                        case "CONFIGURADA":
                                            <span class="badge bg-success">Configurada</span>
                                            break;
                                        case "BLOQUEADA":
                                            <span class="badge bg-danger">Bloqueada</span>
                                            @if (!string.IsNullOrWhiteSpace(c.MotivoBloqueio))
                                            {
                                                <div class="small text-danger">@c.MotivoBloqueio</div>
                                            }
                                            break;
                                        default:
                                            <span class="badge bg-warning text-dark">@c.StatusIntegracao</span>
                                            break;
                                    }
                                </td>
                                <td class="text-white-50 small">
                                    @(c.UltimaSincronizacao?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca")
                                </td>
                                <td>
                                    <span class="badge @(c.Ativo ? "bg-success" : "bg-secondary")">
                                        @(c.Ativo ? "Ativo" : "Inativo")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nova Conta -->
<div class="modal fade" id="modalNovaConta" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary">
            <form method="post" action="/Administrativo360/Cotacoes/ConfigurarContaPortal">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title h6" id="modalLabel">Nova Conta de Portal de Cotação</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Estabelecimento / Unidade</label>
                        <select name="EstabelecimentoId" class="form-select form-select-sm bg-dark text-light border-secondary" required aria-label="Estabelecimento">
                            @foreach (var est in Model.Estabelecimentos)
                            {
                                <option value="@est.Id">@est.RazaoSocial (@est.Cnpj)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small">Provedor</label>
                            <select name="Provedor" class="form-select form-select-sm bg-dark text-light border-secondary" aria-label="Provedor">
                                <option value="OPMENEXO">OPMENEXO</option>
                                <option value="INPART">INPART Saúde</option>
                                <option value="IMPORTACAO_MANUAL">Importação Manual</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Ambiente</label>
                            <select name="Ambiente" class="form-select form-select-sm bg-dark text-light border-secondary" aria-label="Ambiente">
                                <option value="HOMOLOGACAO">Homologação</option>
                                <option value="PRODUCAO">Produção</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Nome da Conta / Identificador Interno</label>
                        <input aria-label="Nome da conta"  type="text" name="NomeConta" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Ex: Opmenexo Matriz" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small">ID Externo / Client ID</label>
                            <input type="text" name="IdentificadorExterno" class="form-control form-control-sm bg-dark text-light border-secondary" aria-label="Identificador externo">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Usuário de Acesso</label>
                            <input type="text" name="UsuarioAcesso" class="form-control form-control-sm bg-dark text-light border-secondary" aria-label="Usuário de acesso">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Referência de Segredo (Vault / Key)</label>
                        <input aria-label="Segredo de referência"  type="password" name="SegredoReferencia" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Referência ao cofre seguro (não senha plana)" />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-warning">Salvar Conta</button>
                </div>
            </form>
        </div>
    </div>
</div>
