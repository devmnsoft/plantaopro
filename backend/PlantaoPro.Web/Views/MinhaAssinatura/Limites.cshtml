@model PlantaoPro.Web.Models.UsoPlanoWebViewModel
@{
    ViewData["Title"] = "Limites do plano";
    string Kpi(int usado, int limite) => limite <= 0 ? $"{usado} (ilimitado)" : $"{usado}/{limite}";
    string Pct(int usado, int limite) => limite <= 0 ? "sem teto contratado" : $"{Math.Min(100, (int)Math.Round(usado * 100.0 / limite))}% usado";
}
<partial name="_PageHeader" model='new PlantaoPro.Web.Models.PageHeaderViewModel("Limites e uso", "Acompanhe usuários, médicos, unidades, plantões/mês e alertas de aproximação de limite.", "bi-speedometer2")' />
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card card-body"><strong>Usuários</strong><div class="fs-5">@Kpi(Model.UsuariosUsados, Model.UsuariosLimite)</div><small class="text-muted">@Pct(Model.UsuariosUsados, Model.UsuariosLimite)</small></div></div>
        <div class="col-md-3"><div class="card card-body"><strong>Médicos</strong><div class="fs-5">@Kpi(Model.MedicosUsados, Model.MedicosLimite)</div><small class="text-muted">@Pct(Model.MedicosUsados, Model.MedicosLimite)</small></div></div>
        <div class="col-md-3"><div class="card card-body"><strong>Hospitais</strong><div class="fs-5">@Kpi(Model.HospitaisUsados, Model.HospitaisLimite)</div><small class="text-muted">@Pct(Model.HospitaisUsados, Model.HospitaisLimite)</small></div></div>
        <div class="col-md-3"><div class="card card-body"><strong>Plantões/mês</strong><div class="fs-5">@Kpi(Model.PlantoesMesUsados, Model.PlantoesMesLimite)</div><small class="text-muted">@Pct(Model.PlantoesMesUsados, Model.PlantoesMesLimite)</small></div></div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card card-body"><strong>Convites/mês</strong><div class="fs-5">@Kpi(Model.ConvitesMesUsados, Model.ConvitesMesLimite)</div><small class="text-muted">@Pct(Model.ConvitesMesUsados, Model.ConvitesMesLimite)</small></div></div>
        <div class="col-md-3"><div class="card card-body"><strong>Mobile</strong><div class="fs-5">@(Model.PermiteMobile ? "Incluído" : "Não incluído")</div></div></div>
        <div class="col-md-3"><div class="card card-body"><strong>BI</strong><div class="fs-5">@(Model.PermiteBi ? "Incluído" : "Não incluído")</div></div></div>
        <div class="col-md-3"><div class="card card-body"><strong>Integrações</strong><div class="fs-5">@(Model.PermiteIntegracoes ? "Incluído" : "Não incluído")</div></div></div>
    </div>
}
<partial name="_ModuleLockedNotice" model='@("Ao atingir limite contratado, ações de criação exibem motivo claro, plano atual e CTA de upgrade antes de bloquear a operação.")' />
