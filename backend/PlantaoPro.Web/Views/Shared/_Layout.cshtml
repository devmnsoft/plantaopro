@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    // P0 CSRF: token antiforgery único por request — renderizado como meta no <head>, consumido
    // pelo wrapper global de window.fetch (logo abaixo de <body>) e pelos formulários via
    // input oculto (Html.AntiForgeryToken / __RequestVerificationToken).
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    // J11-WP7: escopo server-side do tema claro do módulo Administrativo 360
    // (consome wwwroot/css/pages/administrativo360-tema-claro.css).
    // O módulo é atendido por Administrativo360Controller (rotas convencionais)
    // e pelos sub-controllers Adm360*WebController (rotas por atributo
    // Administrativo360/Cotacoes, /DocumentosXml e /Gestao). O nome real vem
    // do ActionDescriptor — RouteData carrega o segmento de rota, não o tipo.
    var adm360Controller = ViewContext.ActionDescriptor.RouteValues["controller"] as string
        ?? ViewContext.RouteData.Values["controller"]?.ToString();
    var isAdm360 = string.Equals(adm360Controller, "Administrativo360", StringComparison.OrdinalIgnoreCase)
        || (adm360Controller != null && adm360Controller.StartsWith("Adm360", StringComparison.OrdinalIgnoreCase));
}
