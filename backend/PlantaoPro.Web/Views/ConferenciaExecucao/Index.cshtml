@model PlantaoPro.Web.Models.DetailsPageViewModel<PlantaoPro.Web.Models.ExecutionConferencePageDto>
@{ ViewData["Title"] = "Conferência de execução"; var data=Model.Data; }
<main class="container py-4" aria-labelledby="page-title">
 <header class="page-intro"><span class="eyebrow">Gestão de escalas</span><h1 id="page-title">Conferência de execução</h1><p>Compare o previsto, registrado e proposto antes da decisão operacional. Aprovar não autoriza pagamento.</p></header>
 <details class="mb-4" open><summary><strong>Filtros</strong></summary><form method="get" class="row g-3 mt-1">
  <div class="col-md-2"><label class="form-label" for="inicio">Início</label><input class="form-control" id="inicio" name="inicio" type="date" value="@ViewBag.Inicio" /></div>
  <div class="col-md-2"><label class="form-label" for="fim">Fim</label><input class="form-control" id="fim" name="fim" type="date" value="@ViewBag.Fim" /></div>
  <div class="col-md-3"><label class="form-label" for="unidadeId">Unidade (ID)</label><input class="form-control" id="unidadeId" name="unidadeId" value="@ViewBag.UnidadeId" /></div>
  <div class="col-md-3"><label class="form-label" for="profissionalId">Profissional (ID)</label><input class="form-control" id="profissionalId" name="profissionalId" value="@ViewBag.ProfissionalId" /></div>
  <div class="col-md-2"><label class="form-label" for="status">Situação</label><select class="form-select" id="status" name="status"><option value="">Todas</option><option>REGISTRO_INCOMPLETO</option><option>PENDENTE</option><option>CORRECAO_PENDENTE</option><option>APROVADA</option><option>RECUSADA</option><option>AJUSTE_POS_APURACAO</option></select></div>
  <div class="col-md-2"><label class="form-label" for="divergencia">Divergência</label><select class="form-select" id="divergencia" name="divergencia"><option value="">Todas</option><option value="true" selected="@(ViewBag.Divergencia is true)">Com divergência</option><option value="false" selected="@(ViewBag.Divergencia is false)">Sem divergência</option></select></div>
  <div class="col-12"><button class="btn btn-primary" type="submit">Aplicar filtros</button></div>
 </form></details>
 <nav class="nav nav-pills mb-4" aria-label="Etapas da conferência">
  <a class="nav-link @(ViewBag.Status is null or "PENDENTE" ? "active" : "")" asp-action="Index" asp-route-status="PENDENTE">Aguardando conferência</a>
  <a class="nav-link @(ViewBag.Status == "CORRECAO_PENDENTE" ? "active" : "")" asp-action="Index" asp-route-status="CORRECAO_PENDENTE">Correções</a>
  <a class="nav-link @(ViewBag.Status is "APROVADA" or "RECUSADA" or "AJUSTE_POS_APURACAO" ? "active" : "")" asp-action="Index" asp-route-status="APROVADA">Histórico</a>
 </nav>
 @if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
 @if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
 @if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>}
 @if(data is not null){<section aria-label="Resumo" class="d-flex gap-3 flex-wrap mb-3"><strong>@data.Total execuções</strong><span>@data.Pendentes pendentes</span><span>@data.Aprovadas aprovadas</span><span>@data.Recusadas recusadas</span></section>
 @foreach(var item in data.Items){<article class="card mb-3"><div class="card-body"><header class="d-flex justify-content-between gap-3"><div><h2 class="h5">@item.Profissional</h2><p class="mb-1">@item.Unidade</p><small>Solicitação: @item.SolicitadoEm.ToString("dd/MM/yyyy HH:mm zzz")</small></div><span class="status-badge">@item.Status.Replace('_',' ')</span></header>
 <dl class="row"><div class="col-md-3"><dt>Previsto</dt><dd>@item.InicioPrevisto.ToString("dd/MM/yyyy HH:mm zzz")<br/>@item.FimPrevisto.ToString("dd/MM/yyyy HH:mm zzz")</dd></div><div class="col-md-3"><dt>Registrado</dt><dd>@item.InicioRegistrado?.ToString("dd/MM/yyyy HH:mm zzz")<br/>@item.FimRegistrado?.ToString("dd/MM/yyyy HH:mm zzz")</dd></div><div class="col-md-3"><dt>Proposto</dt><dd>@(item.InicioProposto?.ToString("dd/MM/yyyy HH:mm zzz")??"Sem alteração")<br/>@(item.FimProposto?.ToString("dd/MM/yyyy HH:mm zzz")??"Sem alteração")</dd></div><div class="col-md-3"><dt>Aprovado</dt><dd>@(item.InicioAprovado?.ToString("dd/MM/yyyy HH:mm zzz")??"—")<br/>@(item.FimAprovado?.ToString("dd/MM/yyyy HH:mm zzz")??"—")</dd></div></dl>
 @if(item.Status is "PENDENTE" or "CORRECAO_PENDENTE"){var reasonId=$"decision-reason-{item.PresencaId:N}";<form asp-action="Decidir" method="post" data-submit-once>@Html.AntiForgeryToken()<input type="hidden" name="presencaId" value="@item.PresencaId"/><input type="hidden" name="correcaoId" value="@item.CorrecaoId"/><input type="hidden" name="versao" value="@item.Versao"/><input type="hidden" name="versaoPresenca" value="@item.VersaoPresenca"/><input type="hidden" name="inicio" value="@ViewBag.Inicio"/><input type="hidden" name="fim" value="@ViewBag.Fim"/><input type="hidden" name="unidadeId" value="@ViewBag.UnidadeId"/><input type="hidden" name="profissionalId" value="@ViewBag.ProfissionalId"/><input type="hidden" name="status" value="@ViewBag.Status"/><input type="hidden" name="divergencia" value="@ViewBag.Divergencia"/><label class="form-label" for="@reasonId">Justificativa da decisão</label><textarea class="form-control" id="@reasonId" name="justificativa" minlength="3" maxlength="1000" required>@(TempData.Peek("DecisionReason")??item.Justificativa)</textarea><div class="d-flex gap-2 mt-2">@if(item.CorrecaoId.HasValue){<button class="btn btn-primary" type="submit" name="decisao" value="AprovarCorrecao">Aprovar correção</button><button class="btn btn-outline-danger" type="submit" name="decisao" value="RecusarCorrecao" data-confirm="true" data-confirm-title="Recusar proposta de correção" data-confirm-message="Confirma recusar esta proposta de correção de horários? A decisão será auditada e o registro original mantido." data-confirm-type="danger">Recusar correção</button>}else{<button class="btn btn-primary" type="submit" name="decisao" value="AprovarExecucao">Aprovar execução</button>}</div></form>}
 </div></article>}
 <nav class="d-flex align-items-center justify-content-between" aria-label="Paginação"><span>Página @data.Page · até @data.PageSize itens por página</span><div class="d-flex gap-2">@if(data.Page>1){<a class="btn btn-outline-primary" asp-action="Index" asp-route-inicio="@ViewBag.Inicio" asp-route-fim="@ViewBag.Fim" asp-route-unidadeId="@ViewBag.UnidadeId" asp-route-profissionalId="@ViewBag.ProfissionalId" asp-route-status="@ViewBag.Status" asp-route-divergencia="@ViewBag.Divergencia" asp-route-page="@(data.Page-1)" asp-route-pageSize="@data.PageSize">Anterior</a>}@if(data.Page*data.PageSize<data.Total){<a class="btn btn-outline-primary" asp-action="Index" asp-route-inicio="@ViewBag.Inicio" asp-route-fim="@ViewBag.Fim" asp-route-unidadeId="@ViewBag.UnidadeId" asp-route-profissionalId="@ViewBag.ProfissionalId" asp-route-status="@ViewBag.Status" asp-route-divergencia="@ViewBag.Divergencia" asp-route-page="@(data.Page+1)" asp-route-pageSize="@data.PageSize">Próxima</a>}</div></nav>}
 <details class="mt-4"><summary><strong>Como usar esta página</strong></summary><p>Execuções incompletas aguardam saída; pendentes podem ser aprovadas; correções exigem aprovação ou recusa explícita. Uma decisão operacional não realiza pagamento. Em conflito, atualize a lista e revise versões e horários antes de decidir novamente.</p></details>
</main>
