@model PlantaoPro.Web.Models.OrganizacaoIndexViewModel
@{
    ViewData["Title"] = UiText.L("Adm360.Org.PageTitle");
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
    string Num(long valor) => valor.ToString("N0", ptBr);
    var definicoesOrg = Model.Resumo?.Definicoes ?? Array.Empty<PlantaoPro.Web.Models.KpiDefinicaoDto>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/administrativo360-organizacao.css" asp-append-version="true" />
}

<div class="container-fluid py-3 pp-a360-org">
    <partial name="_SuprimentosNav" />
    <partial name="_AlertasAcao" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 mb-1 fw-bold">@UiText.L("Adm360.Org.Heading")</h2>
            <p class="text-muted small mb-0">@UiText.L("Adm360.Org.Subheading")</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Erro))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.Erro
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@UiText.L("Implantacao.CloseAria")"></button>
        </div>
    }

    <!-- Guia da tela -->
    <div class="card bg-dark border-secondary mb-4 text-light">
        <div class="card-body">
            <h5 class="card-title text-info h6 mb-2"><i class="bi bi-info-circle me-2"></i>Como ler o panorama organizacional</h5>
            <div class="row g-3 small text-secondary">
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">1. Para que serve</strong>
                    Ver de relance como a organização está estruturada: quantos departamentos, cargos, colaboradores e contratos existem hoje.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">2. Como utilizar</strong>
                    Passe o mouse sobre um indicador para ver exatamente o que ele mede; use o menu acima para abrir cada área de cadastro.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">3. O que esta página mostra</strong>
                    Contagens atuais restritas à sua instituição. Nada muda só por visualizar.
                </div>
                <div class="col-md-3">
                    <strong class="text-light d-block mb-1">4. Próxima ação</strong>
                    Número não bate com a realidade? Abra a tela específica do cadastro e ajuste.
                </div>
            </div>
        </div>
    </div>

    <!-- Indicadores -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="badge bg-primary bg-opacity-25 text-primary rounded-2 p-3"><i class="bi bi-building fs-4"></i></span>
                    <div>
                        <div class="display-6 fw-bold text-light lh-1">@Num(Model.Resumo.Departamentos)</div>
                        <div class="text-secondary small">@UiText.L("Adm360.Org.KpiDepartments")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="badge bg-info bg-opacity-25 text-info rounded-2 p-3"><i class="bi bi-person-badge fs-4"></i></span>
                    <div>
                        <div class="display-6 fw-bold text-light lh-1">@Num(Model.Resumo.Cargos)</div>
                        <div class="text-secondary small">@UiText.L("Adm360.Org.KpiRoles")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="badge bg-success bg-opacity-25 text-success rounded-2 p-3"><i class="bi bi-people fs-4"></i></span>
                    <div>
                        <div class="display-6 fw-bold text-light lh-1">@Num(Model.Resumo.ColaboradoresAtivos)</div>
                        <div class="text-secondary small">@UiText.L("Adm360.Org.KpiActiveEmployees")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="badge bg-warning bg-opacity-25 text-warning rounded-2 p-3"><i class="bi bi-file-earmark-text fs-4"></i></span>
                    <div>
                        <div class="display-6 fw-bold text-light lh-1">@Num(Model.Resumo.ContratosVigentes)</div>
                        <div class="text-secondary small">@UiText.L("Adm360.Org.KpiActiveContracts")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (string.IsNullOrEmpty(Model.Erro))
    {
        @* R8-B24 (§27): exibe as definições fiéis ao SQL dos indicadores organizacionais (mesmo critério "definição e rastreabilidade"; sem nova consulta/número/regra). *@
        <details class="org-definicoes mb-4">
            <summary class="fw-semibold small">Como cada indicador é calculado (fórmula · fonte · período · fuso)</summary>
            <p class="small text-muted mb-1">@Model.Resumo.TimeCriterion</p>
            @if (definicoesOrg.Count > 0)
            {
                <ul class="small mb-0">@foreach (var item in definicoesOrg) { <li><strong>@item.Label</strong>: @item.Definicao</li> }</ul>
            }
            else
            {
                <p class="small text-muted mb-0">Sem definições informadas pela fonte para os indicadores.</p>
            }
        </details>
    }

    <!-- areas -->
    <h5 class="h6 mb-3"><i class="bi bi-diagram-3 me-2"></i>@UiText.L("Adm360.Org.AreasTitle")</h5>
    <div class="row g-3">
        <div class="col-md-6 col-xl-3">
            <a asp-action="Departamentos" asp-controller="Administrativo360" class="text-decoration-none">
                <div class="card bg-dark border-secondary h-100">
                    <div class="card-body d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <div class="fw-bold text-light">@UiText.L("Adm360.Org.AreaDepartments")</div>
                            <small class="text-secondary">@Num(Model.Resumo.Departamentos) @UiText.L("Adm360.Org.AreaDepartmentsDesc")</small>
                        </div>
                        <i class="bi bi-chevron-right text-secondary"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a asp-action="Cargos" asp-controller="Administrativo360" class="text-decoration-none">
                <div class="card bg-dark border-secondary h-100">
                    <div class="card-body d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <div class="fw-bold text-light">@UiText.L("Adm360.Org.AreaRoles")</div>
                            <small class="text-secondary">@Num(Model.Resumo.Cargos) @UiText.L("Adm360.Org.AreaRolesDesc")</small>
                        </div>
                        <i class="bi bi-chevron-right text-secondary"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a asp-action="Colaboradores" asp-controller="Administrativo360" class="text-decoration-none">
                <div class="card bg-dark border-secondary h-100">
                    <div class="card-body d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <div class="fw-bold text-light">@UiText.L("Adm360.Org.AreaEmployees")</div>
                            <small class="text-secondary">@Num(Model.Resumo.ColaboradoresAtivos) @UiText.L("Adm360.Org.AreaEmployeesDesc")</small>
                        </div>
                        <i class="bi bi-chevron-right text-secondary"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-xl-3">
            <a asp-action="Contratos" asp-controller="Administrativo360" class="text-decoration-none">
                <div class="card bg-dark border-secondary h-100">
                    <div class="card-body d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <div class="fw-bold text-light">@UiText.L("Adm360.Org.AreaContracts")</div>
                            <small class="text-secondary">@Num(Model.Resumo.ContratosVigentes) @UiText.L("Adm360.Org.AreaContractsDesc")</small>
                        </div>
                        <i class="bi bi-chevron-right text-secondary"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <p class="text-muted small mt-4">
        <i class="bi bi-info-circle me-1"></i>@UiText.L("Adm360.Org.HistoryNote")
    </p>
</div>
