@inject PlantaoPro.Web.Services.IBreadcrumbService BreadcrumbService
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var subtitle = ViewData["Subtitle"]?.ToString() ?? "Acompanhe prioridades e continue sua jornada.";
    var canUpgrade = User.IsInRole("ADMINISTRADOR_GLOBAL") || User.IsInRole("ADMINISTRADOR") || User.IsInRole("ADMINISTRADOR_CLIENTE") || User.IsInRole("DIRETOR");
    // Trilho unico e canonico: derivado de rota/catalogo, sem hardcode de controller/acao na view.
    // A view pode aportar dados opcionais: rotulo curto (BreadcrumbLabel) e folha dinamica (BreadcrumbLeaf).
    var breadcrumbTrail = BreadcrumbService.ResolveTrail(
        controller,
        action,
        pageTitle: ViewData["Title"]?.ToString(),
        breadcrumbLabel: ViewData["BreadcrumbLabel"]?.ToString(),
        dynamicLeaf: ViewData["BreadcrumbLeaf"]?.ToString());
}
<header class="pp-topbar app-topbar">
    <div class="pp-topbar__identity topbar-left">
        <button class="btn btn-light btn-icon d-lg-none" id="sidebarToggle" type="button" aria-controls="appSidebar" aria-expanded="false" aria-label="Abrir menu">
            <app-icon name="Menu" size="20" />
        </button>
        <div>
            <nav class="pp-breadcrumb" aria-label="Você está em">
                <ol class="app-breadcrumb">
                    @for (var i = 0; i < breadcrumbTrail.Count; i++)
                    {
                        var segment = breadcrumbTrail[i];
                        @if (i == breadcrumbTrail.Count - 1)
                        {
                            <li aria-current="page">@segment.Label</li>
                        }
                        else if (!string.IsNullOrEmpty(segment.Url))
                        {
                            <li><a href="@segment.Url">@segment.Label</a></li>
                        }
                        else
                        {
                            <li>@segment.Label</li>
                        }
                    }
                </ol>
            </nav>
            <h1 class="pp-topbar__title page-title">@(ViewData["Title"] ?? breadcrumbTrail[breadcrumbTrail.Count - 1].Label)</h1>
            <p class="pp-topbar__subtitle pp-caption d-none d-md-block">@subtitle</p>
        </div>
    </div>
    <div class="pp-topbar__actions topbar-actions">
        <span class="pp-live-context d-none d-xxl-inline-flex" role="status"><span aria-hidden="true"></span> Ambiente operacional</span>
        <div class="pp-session-health d-none d-xl-flex" role="status" aria-live="polite" data-session-health data-online="true">
            <span class="pp-session-health__dot" aria-hidden="true"></span>
            <span><small>Conexão</small><strong data-session-health-label>Protegida</strong></span>
        </div>
        <button class="topbar-search d-none d-xl-flex" type="button" data-command-open aria-haspopup="dialog" aria-controls="commandPalette" aria-label="Buscar no PlantãoPro">
            <app-icon name="Search" size="18" />
            <span>Buscar no PlantãoPro</span>
            <kbd>Ctrl K</kbd>
        </button>
        <partial name="_TenantContextBadge" />
        <partial name="_PlanUsageMiniCard" />
        <a class="btn btn-light btn-icon" asp-controller="Ajuda" asp-action="Index" title="Ajuda contextual" aria-label="Ajuda contextual">
            <app-icon name="Help" size="20" />
        </a>
        <partial name="_NotificationMenu" />
        @if (canUpgrade)
        {
            <a class="btn btn-warning btn-sm d-none d-md-inline-flex" asp-controller="MinhaAssinatura" asp-action="Upgrade">
                <app-icon name="Finance" size="18" /> Upgrade
            </a>
        }
        <partial name="_UserMenu" />
    </div>
</header>
