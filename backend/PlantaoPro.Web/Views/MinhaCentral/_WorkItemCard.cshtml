@model PlantaoPro.Web.Models.WorkItemViewModel
<article class="work-item" draggable="true" tabindex="0" data-work-item data-id="@Model.Id" data-version="@Model.Version" data-status="@Model.Status"><button type="button" class="work-item-main" data-work-item-open="@Model.Id"><span class="priority priority-@Model.Priority.ToLowerInvariant()">@Model.Priority</span><h4>@Model.Title</h4><p>@Model.Description</p>@if(Model.DueAt.HasValue){<time datetime="@Model.DueAt.Value.ToString("O")">Até @Model.DueAt.Value.ToLocalTime().ToString("dd/MM HH:mm")</time>}</button><label><span class="sr-only">Mover @Model.Title para</span><select data-move-select><option value="">Mover para…</option><option value="ENTRADA">Entrada</option><option value="PRIORIDADE">Prioridade</option><option value="EM_ANDAMENTO">Em andamento</option><option value="AGUARDANDO">Aguardando</option><option value="CONCLUIDO">Concluído</option></select></label></article>
