@model IEnumerable<PlantaoPro.Web.Models.PerfilWebViewModel>
@{
    ViewData["Title"] = "Perfis e permissões";
}
<section class="container-fluid py-4">
    <div class="d-flex justify-content-between mb-3"><div><h1>Perfis parametrizáveis</h1><p class="text-muted">Perfis base e customizados restritos ao tenant.</p></div><a class="btn btn-primary" asp-controller="Perfis" asp-action="Create">Novo perfil</a></div>
    <details class="pp-screen-guide mb-3"><summary><span><i class="bi bi-compass" aria-hidden="true"></i><strong>Como usar esta tela</strong></span><span class="pp-screen-guide__hint">Orientação rápida</span></summary><div class="pp-screen-guide__body"><p>Monte perfis de acesso por função, como financeiro, escala, coordenação e atendimento.</p><ol><li>Crie ou selecione um perfil do seu tenant.</li><li>Libere somente permissões previstas nos módulos contratados.</li><li>Revise o impacto antes de atribuir o perfil aos usuários.</li></ol><div class="pp-screen-guide__note"><i class="bi bi-shield-lock" aria-hidden="true"></i> Perfis do cliente não concedem escopo global nem ultrapassam os limites do plano.</div></div></details>
    <div class="card shadow-sm pp-premium-table"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Perfil</th><th>Código</th><th>Tipo</th><th>Status</th><th><span class="visually-hidden">Ações</span></th></tr></thead><tbody>@if (!Model.Any()){<tr><td colspan="5"><div class="pp-guided-empty"><i class="bi bi-person-lock" aria-hidden="true"></i><strong>Nenhum perfil disponível</strong><span>Crie o primeiro perfil com nome, escopo e ao menos uma permissão permitida para o tenant.</span><a class="btn btn-sm btn-primary" asp-controller="Perfis" asp-action="Create">Criar perfil</a></div></td></tr>}else{foreach (var perfil in Model){<tr><td><strong>@perfil.Nome</strong></td><td><code>@perfil.Codigo</code></td><td>@(perfil.BaseSistema ? "Base" : "Personalizado")</td><td><span class="badge bg-success">@perfil.Status</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-controller="Perfis" asp-action="Permissoes" asp-route-id="@perfil.Id" title="Revisar as permissões efetivas deste perfil">Revisar permissões</a></td></tr>}}</tbody></table></div></div>
</section>
