@model PlantaoPro.Web.Models.ProdutosIndexViewModel
@{
    ViewData["Title"] = UiText.L("Adm360.Produtos.PageTitle");
}

<div class="container-fluid py-3">
    <partial name="_SuprimentosNav" />

    @if (!string.IsNullOrWhiteSpace(Model.Erro))
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><strong>@UiText.L("Adm360.Produtos.ErroLbl")</strong> @Model.Erro</div>
        </div>
    }

    <!-- Header Executivo -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 mb-1 text-dark fw-bold">@UiText.L("Adm360.Produtos.Heading")</h1>
            <p class="text-muted mb-0 small">
                @UiText.L("Adm360.Produtos.Subheading")
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#comoUsarProdutos" aria-expanded="false">
                <i class="bi bi-info-circle me-1"></i> @UiText.L("Adm360.Produtos.BtnComoUsar")
            </button>
            <button class="btn btn-primary btn-sm px-3" type="button" onclick="abrirModalNovoProduto()">
                <i class="bi bi-plus-lg me-1"></i> @UiText.L("Adm360.Produtos.BtnNovoProduto")
            </button>
        </div>
    </div>

    <!-- Guia Como Usar -->
    <div class="collapse mb-4" id="comoUsarProdutos">
        <div class="card card-body bg-light border-0 shadow-sm rounded-3">
            <h6 class="fw-bold mb-2 text-primary"><i class="bi bi-shield-check me-1"></i> @UiText.L("Adm360.Produtos.GuiaTitulo")</h6>
            <ul class="mb-0 small text-secondary">
                <li>@Html.Raw(UiText.L("Adm360.Produtos.GuiaSkuUnico"))</li>
                <li>@Html.Raw(UiText.L("Adm360.Produtos.GuiaPrecoCusto"))</li>
                <li>@Html.Raw(UiText.L("Adm360.Produtos.GuiaTravaMov"))</li>
                <li>@Html.Raw(UiText.L("Adm360.Produtos.GuiaControleLote"))</li>
            </ul>
        </div>
    </div>

    <!-- Filtros de Consulta -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Produtos" class="row g-2 align-items-center">
                <div class="col-md-7 col-lg-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="busca" value="@Model.Busca" class="form-control" placeholder="@UiText.L("Adm360.Produtos.PhBusca")" />
                    </div>
                </div>
                <div class="col-md-3 col-lg-2">
                    <div class="form-check form-switch pt-1">
                        <input class="form-check-input" type="checkbox" name="apenasAtivos" id="filtroApenasAtivos" value="true" checked="@Model.ApenasAtivos" onchange="this.form.submit()" />
                        <label class="form-check-label small" for="filtroApenasAtivos">@UiText.L("Adm360.Produtos.ChkApenasAtivos")</label>
                    </div>
                </div>
                <div class="col-md-2 col-lg-2 d-flex gap-1">
                    <button type="submit" class="btn btn-secondary btn-sm flex-fill">@UiText.L("Adm360.ButtonFiltrar")</button>
                    <a asp-action="Produtos" class="btn btn-outline-secondary btn-sm">@UiText.L("Adm360.ButtonLimpar")</a>
                </div>
            </form>
        </div>
    </div>

    <!-- s5 (rodada 9): Lotes vinculados ao produto em contexto -->
    @if (Model.ProdutoId.HasValue)
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4" style="border-left: 4px solid var(--bs-primary);">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-boxes me-1 text-primary"></i> @UiText.L("Adm360.Produtos.LotesVinculados")
                    <span class="badge bg-primary-subtle text-primary ms-1">@Model.Lotes.Count</span>
                    @if (!string.IsNullOrWhiteSpace(Model.ProdutoSku))
                    {
                        <span class="badge bg-light text-dark font-monospace border ms-1">@Model.ProdutoSku</span>
                    }
                </h6>
                <a asp-action="Produtos" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>@UiText.L("Adm360.Produtos.VoltarCatalogo")</a>
            </div>
            <div class="card-body p-3">
                <p class="small text-muted mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    @Model.ProdutoNome. @Html.Raw(UiText.L("Adm360.Produtos.LoteAviso"))
                </p>
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th>@UiText.L("Adm360.Produtos.LhCodigoLote")</th>
                                <th>@UiText.L("Adm360.Produtos.LhValidade")</th>
                                <th>@UiText.L("Adm360.Produtos.LhCustoUnit")</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (Model.Lotes.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-3 text-muted">@UiText.L("Adm360.Produtos.LotesVazio")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var l in Model.Lotes)
                                {
                                    var vencido = l.Validade.HasValue && l.Validade.Value < DateOnly.FromDateTime(DateTime.Now);
                                    <tr>
                                        <td><span class="badge bg-light text-dark font-monospace border">@l.Codigo</span></td>
                                        <td>
                                            @if (l.Validade.HasValue)
                                            {
                                                <span class="@(vencido ? "text-danger fw-semibold" : "")">@l.Validade.Value.ToString("dd/MM/yyyy")@(vencido ? " " + UiText.L("Adm360.Produtos.VencidoPar") : "")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="font-monospace">@(l.CustoUnitario.HasValue ? l.CustoUnitario.Value.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) : "—")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <form method="post" asp-action="SalvarLote" class="row g-2 align-items-end" onsubmit="return desabilitarAoEnviar(this);">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="produtoId" value="@Model.ProdutoId" />
                    <div class="col-md-4">
                        <label for="loteCodigo" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LhCodigoLote") <span class="text-danger">*</span></label>
                        <input type="text" name="codigo" id="loteCodigo" class="form-control form-control-sm font-monospace" required maxlength="60" placeholder="Ex.: LT-2026-014" />
                    </div>
                    <div class="col-md-3">
                        <label for="loteValidade" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LhDataValidade") <span class="text-danger">*</span></label>
                        <input type="date" name="validade" id="loteValidade" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-3">
                        <label for="loteCusto" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LhCustoUnit")</label>
                        <input type="number" step="0.01" min="0" name="custoUnitario" id="loteCusto" class="form-control form-control-sm font-monospace" placeholder="@UiText.L("Adm360.Produtos.PlOpcional")" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-plus-lg me-1"></i>@UiText.L("Adm360.Produtos.BtnRegistrarLote")</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Tabela de Produtos -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                @UiText.L("Adm360.Produtos.TabTituloMateriais") <span class="badge bg-secondary ms-1">@Model.Produtos.Count</span>
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th style="min-width: 120px;">@UiText.L("Adm360.Produtos.ThSku")</th>
                        <th style="min-width: 250px;">@UiText.L("Adm360.Produtos.ThDescricaoProduto")</th>
                        <th>@UiText.L("Adm360.Produtos.ThUnidade")</th>
                        <th>@UiText.L("Adm360.Produtos.ThPrecoCusto")</th>
                        <th>@UiText.L("Adm360.Produtos.ThPrecoVenda")</th>
                        <th>@UiText.L("Adm360.Produtos.ThRastreabilidade")</th>
                        <th>@UiText.L("Adm360.Produtos.ThAnvisa")</th>
                        <th>@UiText.L("Adm360.Produtos.ThStatus")</th>
                        <th class="text-end pe-3">@UiText.L("Adm360.Produtos.ThAcoes")</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Produtos.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam fs-2 d-block mb-2 text-secondary"></i>
                                @UiText.L("Adm360.Produtos.TabVazia")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model.Produtos)
                        {
                            var anvisaVigenciaStr = p.AnvisaVigencia?.ToString("yyyy-MM-dd") ?? "";
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark font-monospace border">@p.Sku</span>
                                </td>
                                <td>
                                    <strong class="text-dark">@p.Nome</strong>
                                    @if (!string.IsNullOrWhiteSpace(p.CodigoBarras))
                                    {
                                        <div class="small text-muted font-monospace"><i class="bi bi-upc me-1"></i>@p.CodigoBarras</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">@p.Unidade</span>
                                </td>
                                <td class="font-monospace fw-semibold">
                                    @if (p.PrecoCusto.HasValue)
                                    {
                                        @p.PrecoCusto.Value.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="@UiText.L("Adm360.Produtos.TitCustoAusente")">—</span>
                                    }
                                </td>
                                <td>
                                    @if (p.PrecoVenda.HasValue)
                                    {
                                        <div class="font-monospace fw-semibold">@p.PrecoVenda.Value.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>
                                        <div class="small @(p.MargemPercentual.HasValue && p.MargemPercentual.Value < 0 ? "text-danger fw-semibold" : "text-muted")">
                                            @UiText.L("Adm360.Produtos.LucroUnitLbl") @(p.LucroBrutoUnitario?.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) ?? "—") ·
                                            @UiText.L("Adm360.Produtos.MargemVendaLbl") @(p.MargemPercentual?.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) ?? UiText.L("Adm360.Produtos.NaoCalc"))% ·
                                            @UiText.L("Adm360.Produtos.MarkupLbl") @(p.MarkupPercentual?.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) ?? UiText.L("Adm360.Produtos.NaoCalc"))%
                                        </div>
                                        @if (p.MargemPercentual.HasValue && p.MargemPercentual.Value < 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@UiText.L("Adm360.Produtos.MargemNeg")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="@UiText.L("Adm360.Produtos.TitPrecoVendaND")">—</span>
                                    }
                                </td>
                                <td>
                                    @if (p.ControlaLote)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle me-1" title="@UiText.L("Adm360.Produtos.TitExigeLote")">
                                            <i class="bi bi-tag me-1"></i> @UiText.L("Adm360.Produtos.BadgeLote")
                                        </span>
                                    }
                                    @if (p.ExigeInspecao)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" title="@UiText.L("Adm360.Produtos.TitExigeInspecao")">
                                            <i class="bi bi-shield-check me-1"></i> @UiText.L("Adm360.Produtos.BadgeInspecao")
                                        </span>
                                    }
                                    @if (!p.ControlaLote && !p.ExigeInspecao)
                                    {
                                        <span class="text-muted small">@UiText.L("Adm360.Produtos.BadgePadrao")</span>
                                    }
                                </td>
                                <td>
                                    @switch (p.AnvisaAplicabilidade)
                                    {
                                        case "INFORMADO":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" title="@UiText.L("Adm360.Produtos.AnvisaTitManual")@(p.AnvisaVigencia.HasValue ? UiText.L("Adm360.Produtos.AnvisaVigPrefix") + p.AnvisaVigencia.Value.ToString("dd/MM/yyyy") : "")">
                                                <i class="bi bi-patch-check me-1"></i>@(p.AnvisaNumero ?? "")
                                            </span>
                                            break;
                                        case "NAO_APLICAVEL":
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" title="@p.AnvisaJustificacao">
                                                <i class="bi bi-slash-circle me-1"></i>n/a
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">@UiText.L("Adm360.Produtos.BadgePendente")</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (p.Ativo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">@UiText.L("Adm360.Produtos.StatusAtivo")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@UiText.L("Adm360.Produtos.StatusInativo")</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Produtos" asp-route-produtoId="@p.Id" class="btn btn-outline-secondary btn-sm py-0 px-2 me-1"
                                       title="@UiText.L("Adm360.Produtos.LotesVinculados")">
                                        <i class="bi bi-boxes"></i>
                                    </a>
                                    <button class="btn btn-outline-primary btn-sm py-0 px-2 me-1" type="button"
                                            onclick="editarProduto('@p.Id', '@p.Sku', '@p.Nome', '@p.Unidade', '@p.CodigoBarras', @p.ControlaLote.ToString().ToLower(), @p.ExigeInspecao.ToString().ToLower(), @((p.PrecoCusto?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? ""), @p.Ativo.ToString().ToLower(), '@p.AnvisaNumero', '@p.AnvisaAplicabilidade', '@anvisaVigenciaStr', '@p.AnvisaJustificacao', @((p.PrecoVenda?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? ""))">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" asp-action="AlternarStatusProduto" class="d-inline" onsubmit="return desabilitarAoEnviar(this);"
                                          data-confirm="true" data-confirm-type="@(p.Ativo ? "warning" : "success")"
                                          data-confirm-title="@((p.Ativo ? UiText.L("Adm360.Produtos.ConfInativarTitulo") : UiText.L("Adm360.Produtos.ConfAtivarTitulo")) + " " + p.Sku)"
                                          data-confirm-message="@((p.Ativo ? UiText.L("Adm360.Produtos.ConfInativarMsg") : UiText.L("Adm360.Produtos.ConfAtivarMsg")) + UiText.L("Adm360.Produtos.ConfContinuar"))">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="ativo" value="@((!p.Ativo).ToString().ToLower())" />
                                        <button type="submit" class="btn btn-sm py-0 px-2 @(p.Ativo ? "btn-outline-danger" : "btn-outline-success")"
                                                title="@(p.Ativo ? UiText.L("Adm360.Produtos.ConfInativarTitulo") : UiText.L("Adm360.Produtos.ConfAtivarTitulo"))">
                                            <i class="bi @(p.Ativo ? "bi-slash-circle" : "bi-check2-circle")"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Pagina > 1 || Model.TemProximaPagina)
        {
            <nav class="d-flex justify-content-between align-items-center pt-3" aria-label="@UiText.L("Adm360.Produtos.AriaPaginacao")">
                @if (Model.Pagina > 1)
                {
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Produtos", new { busca = Model.Busca, status = Model.Status, pagina = Model.Pagina - 1 })">
                        <i class="bi bi-chevron-left"></i> @UiText.L("Adm360.Produtos.NavAnterior")
                    </a>
                }
                else
                {
                    <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true"><i class="bi bi-chevron-left"></i> @UiText.L("Adm360.Produtos.NavAnterior")</span>
                }
                <span class="small text-muted">@Model.Produtos.Count @UiText.L("Adm360.Produtos.PaginaItensInfo") @Model.Pagina · @UiText.L("Adm360.Produtos.PaginaMaxInfo")</span>
                @if (Model.TemProximaPagina)
                {
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Produtos", new { busca = Model.Busca, status = Model.Status, pagina = Model.Pagina + 1 })">
                        @UiText.L("Adm360.Produtos.NavProxima") <i class="bi bi-chevron-right"></i>
                    </a>
                }
                else
                {
                    <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">@UiText.L("Adm360.Produtos.NavProxima") <i class="bi bi-chevron-right"></i></span>
                }
            </nav>
        }
    </div>
</div>

<!-- Modal de Cadastro / Edição de Produto -->
<div class="modal fade" id="modalProduto" tabindex="-1" aria-labelledby="modalProdutoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="SalvarProduto" id="formProduto" onsubmit="return desabilitarAoEnviar(this);">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="modalProdutoLabel">@UiText.L("Adm360.Produtos.BtnNovoProduto")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@UiText.L("Implantacao.CloseAria")"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="Id" id="produtoId" value="" />

                    <!-- Seção 1 — Identificação (r9h) -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-2 text-dark">1 · @UiText.L("Adm360.Produtos.SecIdentificacao")</span>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label for="produtoSku" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LblSkuCodigo") <span class="text-danger">*</span></label>
                                <input type="text" name="Sku" id="produtoSku" class="form-control form-control-sm font-monospace text-uppercase" required maxlength="60" placeholder="Ex.: STENT-001" />
                            </div>
                            <div class="col-md-6">
                                <label for="produtoUnidade" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.ThUnidade") <span class="text-danger">*</span></label>
                                <select name="Unidade" id="produtoUnidade" class="form-select form-select-sm" required>
                                    <option value="UN">@UiText.L("Adm360.Produtos.OptUN")</option>
                                    <option value="CX">@UiText.L("Adm360.Produtos.OptCX")</option>
                                    <option value="PC">@UiText.L("Adm360.Produtos.OptPC")</option>
                                    <option value="KIT">@UiText.L("Adm360.Produtos.OptKIT")</option>
                                    <option value="KG">@UiText.L("Adm360.Produtos.OptKG")</option>
                                    <option value="LT">@UiText.L("Adm360.Produtos.OptLT")</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label for="produtoNome" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LblDescricaoMaterial") <span class="text-danger">*</span></label>
                            <input type="text" name="Nome" id="produtoNome" class="form-control form-control-sm" required maxlength="200" placeholder="@UiText.L("Adm360.Produtos.PhExNome")" />
                        </div>
                        <div class="mb-0">
                            <label for="produtoCodigoBarras" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LblCodigoBarras")</label>
                            <input type="text" name="CodigoBarras" id="produtoCodigoBarras" class="form-control form-control-sm font-monospace" maxlength="60" placeholder="@UiText.L("Adm360.Produtos.PlOpcional")" />
                        </div>
                    </div>

                    <!-- Seção 2 — Estoque, Lotes e Rastreabilidade (r9h) -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-1 text-dark">2 · @UiText.L("Adm360.Produtos.SecEstoqueLotes")</span>
                        <p class="small text-muted mb-2">@UiText.L("Adm360.Produtos.Sec2Aviso")</p>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="ControlaLote" id="produtoControlaLote" value="true" checked />
                            <label class="form-check-label small" for="produtoControlaLote">@UiText.L("Adm360.Produtos.ChkControlaLote")</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="ExigeInspecao" id="produtoExigeInspecao" value="true" checked />
                            <label class="form-check-label small" for="produtoExigeInspecao">@UiText.L("Adm360.Produtos.ChkExigeInspecao")</label>
                        </div>
                    </div>

                    <!-- Seção 3 — Regulação ANVISA (r9h; bloco existente preservado) -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-1 text-dark">3 · @UiText.L("Adm360.Produtos.SecRegulacaoAnvisa")</span>
                        <p class="small text-muted mb-2">@UiText.L("Adm360.Produtos.Sec3Aviso")</p>
                        <input type="hidden" name="AnvisaEntradaManual" value="true" />
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label for="produtoAnvisaNumero" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LblAnvisaNumero")</label>
                                <input type="text" name="AnvisaNumero" id="produtoAnvisaNumero" class="form-control form-control-sm font-monospace" maxlength="60" placeholder="Ex.: 800123456789512" autocomplete="off" />
                            </div>
                            <div class="col-md-6">
                                <label for="produtoAnvisaAplicabilidade" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LblAplicabilidade")</label>
                                <select name="AnvisaAplicabilidade" id="produtoAnvisaAplicabilidade" class="form-select form-select-sm">
                                    <option value="PENDENTE">@UiText.L("Adm360.Produtos.OptPendente")</option>
                                    <option value="INFORMADO">@UiText.L("Adm360.Produtos.OptInformado")</option>
                                    <option value="NAO_APLICAVEL">@UiText.L("Adm360.Produtos.OptNaoAplicavel")</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label for="produtoAnvisaVigencia" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LblAnvisaVigencia")</label>
                                <input type="date" name="AnvisaVigencia" id="produtoAnvisaVigencia" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-6">
                                <label for="produtoAnvisaJustificacao" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LblJustificacao")</label>
                                <input type="text" name="AnvisaJustificacao" id="produtoAnvisaJustificacao" class="form-control form-control-sm" maxlength="200" placeholder="@UiText.L("Adm360.Produtos.PhExAnvisaJustif")" />
                            </div>
                        </div>
                    </div>

                    <!-- Seção 4 — Precificação (r9h) -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-2 text-dark">4 · @UiText.L("Adm360.Produtos.SecPrecificacao")</span>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label for="produtoPrecoCusto" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LblPrecoCusto") <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0" name="PrecoCusto" id="produtoPrecoCusto" class="form-control form-control-sm font-monospace" required placeholder="0.00" oninput="recalcularPrecos()" />
                            </div>
                            <div class="col-md-6">
                                <label for="produtoPrecoVenda" class="form-label small fw-bold">@UiText.L("Adm360.Produtos.LblPrecoVendaPadrao")</label>
                                <input type="number" step="0.01" min="0" name="PrecoVenda" id="produtoPrecoVenda" class="form-control form-control-sm font-monospace" placeholder="@UiText.L("Adm360.Produtos.PlOpcional")" oninput="recalcularPrecos()" />
                            </div>
                        </div>
                        <div class="small text-muted mb-0" id="previewPrecos" aria-live="polite"></div>
                    </div>

                    <!-- Seção 5 — Status (r9h) -->
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="small fw-bold d-block mb-2 text-dark">5 · @UiText.L("Adm360.Produtos.SecStatus")</span>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" name="Ativo" id="produtoAtivo" value="true" checked />
                            <label class="form-check-label small fw-bold" for="produtoAtivo">@UiText.L("Adm360.Produtos.ChkProdutoAtivo")</label>
                        </div>
                        <p class="small text-muted mb-0">@UiText.L("Adm360.Produtos.Sec5Aviso")</p>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@UiText.L("Clinical.ButtonCancel")</button>
                    <button type="submit" id="btnSalvarProduto" class="btn btn-primary btn-sm px-4">@UiText.L("Clinical.ButtonSave")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function abrirModalNovoProduto() {
        document.getElementById('modalProdutoLabel').innerText = '@UiText.L("Adm360.Produtos.BtnNovoProduto")';
        document.getElementById('produtoId').value = '';
        document.getElementById('produtoSku').value = '';
        document.getElementById('produtoSku').readOnly = false;
        document.getElementById('produtoNome').value = '';
        document.getElementById('produtoUnidade').value = 'UN';
        document.getElementById('produtoPrecoCusto').value = '0.00';
        document.getElementById('produtoCodigoBarras').value = '';
        document.getElementById('produtoControlaLote').checked = true;
        document.getElementById('produtoExigeInspecao').checked = true;
        document.getElementById('produtoAnvisaNumero').value = '';
        document.getElementById('produtoAnvisaAplicabilidade').value = 'PENDENTE';
        document.getElementById('produtoAnvisaVigencia').value = '';
        document.getElementById('produtoAnvisaJustificacao').value = '';
        document.getElementById('produtoAtivo').checked = true;
        document.getElementById('produtoPrecoVenda').value = '';
        recalcularPrecos();
        new bootstrap.Modal(document.getElementById('modalProduto')).show();
    }

    function editarProduto(id, sku, nome, unidade, codigoBarras, controlaLote, exigeInspecao, precoCusto, ativo, anvisaNumero, anvisaAplicabilidade, anvisaVigencia, anvisaJustificacao, precoVenda) {
        document.getElementById('modalProdutoLabel').innerText = '@UiText.L("Adm360.Produtos.JsEditarProduto")';
        document.getElementById('produtoId').value = id;
        document.getElementById('produtoSku').value = sku;
        document.getElementById('produtoNome').value = nome;
        document.getElementById('produtoUnidade').value = unidade || 'UN';
        document.getElementById('produtoPrecoCusto').value = precoCusto || '0.00';
        document.getElementById('produtoCodigoBarras').value = codigoBarras || '';
        document.getElementById('produtoControlaLote').checked = controlaLote;
        document.getElementById('produtoExigeInspecao').checked = exigeInspecao;
        document.getElementById('produtoAnvisaNumero').value = anvisaNumero || '';
        document.getElementById('produtoAnvisaAplicabilidade').value = anvisaAplicabilidade || 'PENDENTE';
        document.getElementById('produtoAnvisaVigencia').value = anvisaVigencia || '';
        document.getElementById('produtoAnvisaJustificacao').value = anvisaJustificacao || '';
        document.getElementById('produtoAtivo').checked = ativo;
        document.getElementById('produtoPrecoVenda').value = precoVenda || '';
        recalcularPrecos();
        new bootstrap.Modal(document.getElementById('modalProduto')).show();
    }

    // s7 (rodada 9): prévia LOCAL apenas para usabilidade — o cálculo oficial das derivadas
    // (lucro unitário, margem sobre venda %, markup sobre custo %) é recalculado no SERVIDOR.
    // Mesmas regras: ausente ≠ zero; denominador zero => "não calculável"; negativo é evidenciado.
    function recalcularPrecos() {
        var el = document.getElementById('previewPrecos');
        if (!el) { return; }
        var c = parseFloat(document.getElementById('produtoPrecoCusto').value);
        var v = parseFloat(document.getElementById('produtoPrecoVenda').value);
        var fmt = function (n) { return n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
        if (isNaN(v)) { el.textContent = '@UiText.L("Adm360.Produtos.JsMsgSemVenda")'; return; }
        if (isNaN(c)) { el.textContent = '@UiText.L("Adm360.Produtos.JsMsgSemCusto")'; return; }
        var lucro = Math.round((v - c) * 100) / 100;
        var m = v > 0 ? Math.round((v - c) / v * 10000) / 100 : null;
        var mu = c > 0 ? Math.round((v - c) / c * 10000) / 100 : null;
        el.textContent = '@UiText.L("Adm360.Produtos.JsLucroPrefix")' + fmt(lucro)
            + '@UiText.L("Adm360.Produtos.JsMargemLbl")' + (m === null ? '@UiText.L("Adm360.Produtos.JsNaoCalcVenda")' : fmt(m) + '%')
            + '@UiText.L("Adm360.Produtos.JsMarkupLbl")' + (mu === null ? '@UiText.L("Adm360.Produtos.JsNaoCalcCusto")' : fmt(mu) + '%')
            + (m !== null && m < 0 ? '@UiText.L("Adm360.Produtos.JsMargemNeg")' : '')
            + '@UiText.L("Adm360.Produtos.JsPrevLocal")';
    }

    function desabilitarAoEnviar(form) {
        var btn = form.querySelector('button[type="submit"]');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> '@UiText.L("Adm360.Produtos.JsProcessando")';
        }
        return true;
    }
</script>
}
