@{ ViewData["Title"]="Solicitar plantões"; }
<main class="container py-4"><header class="mb-4"><a asp-action="Index" class="text-decoration-none">← Portal da unidade</a><h1 class="h2 mt-3">Nova solicitação de plantões</h1><p class="text-secondary">Informe a necessidade operacional. A unidade é definida pelo seu contexto de acesso.</p></header>
<form method="post" class="card border-0 shadow-sm" data-shift-request-form><div class="card-body row g-3">
 <div class="col-md-6"><label class="form-label" for="unit">Unidade solicitante</label><select id="unit" name="UnitId" class="form-select" required><option value="">Selecione a unidade autorizada</option></select><div class="invalid-feedback">Selecione uma unidade.</div></div>
 <div class="col-md-6"><label class="form-label" for="specialty">Especialidade</label><select id="specialty" name="SpecialtyId" class="form-select" required><option value="">Selecione a especialidade contratada</option></select></div>
 <div class="col-md-6"><label class="form-label" for="sector">Setor/local</label><input id="sector" name="Sector" class="form-control" autocomplete="organization-title" required /></div>
 <div class="col-md-3"><label class="form-label" for="date">Data</label><input id="date" name="Date" type="date" class="form-control" required /></div>
 <div class="col-md-3"><label class="form-label" for="professionals">Profissionais</label><input id="professionals" name="Professionals" type="number" min="1" value="1" class="form-control" required /></div>
 <div class="col-6 col-md-3"><label class="form-label" for="starts">Início</label><input id="starts" name="StartsAt" type="time" class="form-control" required /></div><div class="col-6 col-md-3"><label class="form-label" for="ends">Fim</label><input id="ends" name="EndsAt" type="time" class="form-control" required /></div>
 <fieldset class="col-md-6"><legend class="form-label">Prioridade</legend><div class="d-flex gap-3"><label><input type="radio" name="Priority" value="normal" checked /> Normal</label><label><input type="radio" name="Priority" value="alta" /> Alta</label><label><input type="radio" name="Priority" value="critica" /> Crítica</label></div></fieldset>
 <div class="col-12"><label class="form-label" for="justification">Justificativa</label><textarea id="justification" name="Justification" class="form-control" rows="3" required></textarea></div><div class="col-12"><label class="form-label" for="notes">Observações</label><textarea id="notes" name="Notes" class="form-control" rows="2"></textarea></div>
</div><footer class="card-footer bg-transparent d-flex flex-wrap justify-content-end gap-2 p-3"><button name="Draft" value="true" class="btn btn-outline-secondary" type="submit">Salvar rascunho</button><button name="Draft" value="false" class="btn btn-primary" type="submit">Enviar para análise</button></footer></form></main>
