@model PlantaoPro.Web.Models.OcorrenciasIndexViewModel
@{
    ViewData["Title"] = UiText.L("Adm360.Occ.PageTitle");
    ViewData["BreadcrumbLabel"] = UiText.L("Adm360.Occ.BreadcrumbLabel");
    var hoje = DateOnly.FromDateTime(DateTime.Today);
}

<div class="container-fluid py-3">

    <partial name="_SuprimentosNav" />

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 text-light fw-bold mb-1">@UiText.L("Adm360.Occ.Heading")</h1>
            <p class="text-secondary small mb-0">@UiText.L("Adm360.Occ.Subtitle")</p>
        </div>
        <div>
            <a asp-action="Inspecoes" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-shield-check me-1"></i>@UiText.L("Adm360.Occ.LinkIrInspecoes")
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Erro))
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@Model.Erro</div>
        </div>
    }

    <!-- Tabela de Ocorrências (adm360_ocorrencias) -->
    <div class="card bg-dark border-secondary shadow-sm mb-4">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center py-2">
            <span class="text-light fw-bold small"><i class="bi bi-exclamation-octagon me-2 text-danger"></i>@UiText.L("Adm360.Occ.TableTitulo")</span>
            <span class="text-secondary small">@UiText.L("Adm360.Occ.TotalLabel") @Model.Ocorrencias.Count</span>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped align-middle mb-0">
                <thead>
                    <tr class="text-secondary small">
                        <th scope="col">@UiText.L("Adm360.Occ.ThProdutoLote")</th>
                        <th scope="col">@UiText.L("Adm360.Occ.ThLocal")</th>
                        <th scope="col">@UiText.L("Adm360.Occ.ThTipo")</th>
                        <th scope="col">@UiText.L("Adm360.Occ.ThDescricao")</th>
                        <th class="text-end" scope="col">@UiText.L("Adm360.Occ.ThQuantidade")</th>
                        <th scope="col">@UiText.L("Adm360.Occ.ThPrazo")</th>
                        <th scope="col">@UiText.L("Adm360.Occ.ThStatus")</th>
                        <th scope="col">@UiText.L("Adm360.Occ.ThDestino")</th>
                        <th class="text-end" scope="col">@UiText.L("Adm360.Occ.ThAcao")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Ocorrencias.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-secondary">
                                <i class="bi bi-check-circle fs-3 d-block mb-2 text-success"></i>@UiText.L("Adm360.Occ.EmptyState")
                            </td>
                        </tr>
                    }
                    @foreach (var oc in Model.Ocorrencias)
                    {
                        var abertaEmTratamento = oc.Situacao is "ABERTA" or "EM_TRATAMENTO";
                        <tr>
                            <td>
                                <strong class="text-light">@oc.Produto</strong><br />
                                <code class="text-warning small">@oc.Lote</code>
                            </td>
                            <td><span class="badge bg-secondary">@oc.Local</span></td>
                            <td><span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>@oc.Tipo</span></td>
                            <td class="small">@oc.Descricao</td>
                            <td class="text-end font-monospace text-warning fw-bold">@oc.Quantidade.ToString("N4")</td>
                            <td class="text-secondary small">
                                @(oc.Prazo?.ToString("dd/MM/yyyy") ?? UiText.L("Adm360.Occ.Immediato"))
                                @if (abertaEmTratamento && oc.Prazo.HasValue && oc.Prazo.Value < hoje)
                                {
                                    <span class="badge bg-danger ms-1">@UiText.L("Adm360.Occ.Vencida")</span>
                                }
                            </td>
                            <td>
                                @if (oc.Situacao == "ABERTA")
                                {
                                    <span class="badge bg-warning text-dark">@UiText.L("Adm360.Occ.StatusAberta")</span>
                                }
                                else if (oc.Situacao == "EM_TRATAMENTO")
                                {
                                    <span class="badge bg-info text-dark">@UiText.L("Adm360.Occ.StatusEmTratamento")</span>
                                }
                                else if (oc.Situacao == "RESOLVIDA")
                                {
                                    <span class="badge bg-primary">@UiText.L("Adm360.Occ.StatusResolvida")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@UiText.L("Adm360.Occ.StatusEncerrada")</span>
                                }
                            </td>
                            <td class="small">
                                @if (oc.Situacao == "ENCERRADA")
                                {
                                    <span title="@oc.JustificativaEncerramento">@oc.Destino</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (oc.Situacao == "ABERTA")
                                {
                                    <form asp-action="TratarOcorrencia" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@oc.Id" />
                                        <input type="hidden" name="versao" value="@oc.Versao" />
                                        <button type="submit" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-arrow-right-circle me-1"></i>@UiText.L("Adm360.Occ.BtnTratar")
                                        </button>
                                    </form>
                                }
                                else if (oc.Situacao == "EM_TRATAMENTO")
                                {
                                    <form asp-action="ResolverOcorrencia" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@oc.Id" />
                                        <input type="hidden" name="versao" value="@oc.Versao" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-check-lg me-1"></i>@UiText.L("Adm360.Occ.BtnResolver")
                                        </button>
                                    </form>
                                }
                                else if (oc.Situacao == "RESOLVIDA")
                                {
                                    <div class="d-inline">
                                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#encerrar-@oc.Id" aria-expanded="false">
                                            <i class="bi bi-flag me-1"></i>@UiText.L("Adm360.Occ.BtnEncerrar")
                                        </button>
                                        <div class="collapse mt-2" id="encerrar-@oc.Id">
                                            <form asp-action="EncerrarOcorrencia" method="post" class="row g-2">
                                                <input type="hidden" name="id" value="@oc.Id" />
                                                <input type="hidden" name="versao" value="@oc.Versao" />
                                                <div class="col-auto">
                                                    <input type="text" name="destino" required maxlength="200" class="form-control form-control-sm bg-dark text-light border-secondary"
                                                           placeholder="@UiText.L("Adm360.Occ.ThDestino")" />
                                                </div>
                                                <!-- Rodada 15 r15b1: efeito fisico do saldo bloqueado (DEVOLUCAO volta a
                                                     circulacao; BAIXA consome fisicamente - descarte/consumo). -->
                                                <div class="col-auto">
                                                    <label class="form-label small text-secondary mb-0">@UiText.L("Adm360.Occ.LabelEfeitoFisico")</label>
                                                    <select name="efeitoFisico" required class="form-select form-select-sm bg-dark text-light border-secondary" aria-label="Efeito físico">
                                                        <option value="DEVOLUCAO" selected>@UiText.L("Adm360.Occ.EfeitoDevolucao")</option>
                                                        <option value="BAIXA">@UiText.L("Adm360.Occ.EfeitoBaixa")</option>
                                                    </select>
                                                </div>
                                                <div class="col-auto">
                                                    <input type="text" name="justificativa" required maxlength="400" class="form-control form-control-sm bg-dark text-light border-secondary"
                                                           placeholder="@UiText.L("Adm360.Occ.LabelJustificativa")" />
                                                </div>
                                                <div class="col-auto">
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-check2-all me-1"></i>@UiText.L("Adm360.Occ.BtnEncerrar")
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Abrir ocorrência -->
    <div class="card bg-dark border-secondary shadow-sm">
        <div class="card-header bg-dark border-secondary py-2">
            <span class="text-light fw-bold small"><i class="bi bi-plus-circle me-2 text-success"></i>@UiText.L("Adm360.Occ.SecNova")</span>
            <span class="text-secondary small ms-2">@UiText.L("Adm360.Occ.SecNovaDesc")</span>
        </div>
        <div class="card-body py-3">
            <form asp-action="CriarOcorrencia" method="post" class="row g-3">
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small text-secondary" for="selProduto">@UiText.L("Adm360.Occ.LabelProduto") *</label>
                    <select name="produtoId" id="selProduto" class="form-select form-select-sm bg-dark text-light border-secondary" required>
                        <option value="">@UiText.L("Adm360.Occ.SelectPlaceholder")</option>
                        @foreach (var p in Model.Produtos)
                        {
                            <option value="@p.Id">@p.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small text-secondary" for="selLote">@UiText.L("Adm360.Occ.LabelLote") *</label>
                    <select name="loteId" id="selLote" class="form-select form-select-sm bg-dark text-light border-secondary" required>
                        <option value="">@UiText.L("Adm360.Occ.SelectPlaceholder")</option>
                        @foreach (var l in Model.Lotes)
                        {
                            <option value="@l.Id" data-produto="@l.ProdutoId">@l.Codigo (@l.Validade?.ToString("dd/MM/yyyy"))</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small text-secondary" for="selLocal">@UiText.L("Adm360.Occ.ThLocal") *</label>
                    <select name="localId" id="selLocal" class="form-select form-select-sm bg-dark text-light border-secondary" required>
                        <option value="">@UiText.L("Adm360.Occ.SelectPlaceholder")</option>
                        @foreach (var loc in Model.Locais)
                        {
                            <option value="@loc.Id">@loc.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small text-secondary" for="txtTipo">@UiText.L("Adm360.Occ.LabelTipo") *</label>
                    <input type="text" name="tipo" id="txtTipo" maxlength="40" required class="form-control form-control-sm bg-dark text-light border-secondary" />
                </div>
                <div class="col-md-6 col-sm-6">
                    <label class="form-label small text-secondary" for="txtDescricao">@UiText.L("Adm360.Occ.LabelDescricao") *</label>
                    <textarea name="descricao" id="txtDescricao" rows="2" required class="form-control form-control-sm bg-dark text-light border-secondary"></textarea>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small text-secondary" for="numQuantidade">@UiText.L("Adm360.Occ.LabelQuantidade") *</label>
                    <input type="number" name="quantidade" id="numQuantidade" min="0.0001" step="0.0001" required class="form-control form-control-sm bg-dark text-light border-secondary" />
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small text-secondary" for="dtPrazo">@UiText.L("Adm360.Occ.LabelPrazo")</label>
                    <input type="date" name="prazo" id="dtPrazo" class="form-control form-control-sm bg-dark text-light border-secondary" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>@UiText.L("Adm360.Occ.BtnCriar")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Filtra o seletor de lotes pelo produto escolhido (evita combinação inválida produto x lote).
    (function () {
        var selProduto = document.getElementById('selProduto');
        var selLote = document.getElementById('selLote');
        if (!selProduto || !selLote) return;
        function filtrarLotes() {
            var produto = selProduto.value;
            Array.prototype.forEach.call(selLote.options, function (op) {
                op.hidden = produto !== '' && op.dataset.produto !== produto;
            });
            var atual = selLote.options[selLote.selectedIndex];
            if (atual && atual.hidden) selLote.value = '';
        }
        selProduto.addEventListener('change', filtrarLotes);
    })();
</script>
