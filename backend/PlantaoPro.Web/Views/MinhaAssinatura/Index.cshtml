@model PlantaoPro.Web.Models.MinhaAssinaturaViewModel
@{ ViewData["Title"] = "Minha assinatura"; }
<div class="pp-page">
    <header class="pp-hero" aria-labelledby="subscription-title"><div class="pp-hero__copy"><span class="pp-eyebrow"><i class="bi bi-gem" aria-hidden="true"></i> Contrato e módulos</span><h1 id="subscription-title">Minha assinatura</h1><p>Dados fornecidos pela assinatura vinculada à organização autenticada.</p></div></header>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    { <div class="pp-notice" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div><strong>Não foi possível consultar a assinatura.</strong><br />@Model.ErrorMessage</div></div> }
    else if (!Model.HasSubscription)
    { <section class="pp-empty-state" aria-labelledby="subscription-empty-title"><i class="bi bi-link-45deg" aria-hidden="true"></i><h2 id="subscription-empty-title">Assinatura ainda não vinculada</h2><p>A API não retornou uma assinatura para esta organização. Um administrador precisa concluir o vínculo contratual antes que plano, limites e cobranças possam ser exibidos.</p></section> }
    else
    {
        <section class="pp-action-grid" aria-label="Resumo da assinatura">
            @if (!string.IsNullOrWhiteSpace(Model.Plano)) { <article class="pp-card"><h2 class="h6">Plano atual</h2><p>@Model.Plano</p></article> }
            @if (!string.IsNullOrWhiteSpace(Model.Status)) { <article class="pp-card"><h2 class="h6">Status</h2><p>@Model.Status</p></article> }
            @if (!string.IsNullOrWhiteSpace(Model.Ciclo)) { <article class="pp-card"><h2 class="h6">Ciclo</h2><p>@Model.Ciclo</p></article> }
            @if (Model.Vencimento.HasValue) { <article class="pp-card"><h2 class="h6">Próximo vencimento</h2><p>@Model.Vencimento.Value.ToString("dd/MM/yyyy")</p></article> }
        </section>
        <section class="mt-4" aria-labelledby="modules-title"><h2 id="modules-title">Módulos</h2>@if (Model.Modulos.Count == 0) { <p class="text-muted">Nenhum módulo foi informado pela API.</p> } else { <ul>@foreach (var item in Model.Modulos) { <li>@item</li> }</ul> }</section>
        <section class="mt-4" aria-labelledby="limits-title"><h2 id="limits-title">Limites e uso</h2><div class="table-responsive"><table class="table"><thead><tr><th scope="col">Métrica</th><th scope="col">Limite</th></tr></thead><tbody>@foreach (var item in Model.Limites) { <tr><th scope="row">@item.Nome</th><td>@item.Valor</td></tr> }@foreach (var item in Model.Uso) { <tr><th scope="row">Uso: @item.Nome</th><td>@item.Valor</td></tr> }</tbody></table></div>@if (Model.Limites.Count == 0 && Model.Uso.Count == 0) { <p class="text-muted">A API não informou limites ou consumo.</p> }</section>
        @if (!string.IsNullOrWhiteSpace(Model.ResponsavelFinanceiro)) { <section class="mt-4"><h2>Responsável financeiro</h2><p>@Model.ResponsavelFinanceiro</p></section> }
        <section class="mt-4"><h2>Alertas</h2>@if (Model.Alertas.Count == 0) { <p class="text-muted">Nenhum alerta informado.</p> } else { <ul>@foreach (var alerta in Model.Alertas) { <li>@alerta</li> }</ul> }</section>
        <section class="mt-4"><h2>Histórico de cobrança</h2>@if (Model.HistoricoCobranca.Count == 0) { <p class="text-muted">Nenhuma cobrança foi informada pela API.</p> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Status</th><th>Valor</th></tr></thead><tbody>@foreach (var item in Model.HistoricoCobranca) { <tr><td>@(item.Data?.ToString("dd/MM/yyyy") ?? "Não informada")</td><td>@item.Status</td><td>@item.Valor</td></tr> }</tbody></table></div> }</section>
    }
</div>
