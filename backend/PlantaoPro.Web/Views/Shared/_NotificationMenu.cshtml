<button class="btn btn-light btn-icon position-relative notification-menu" type="button" data-notification-open
        aria-label="Abrir central de notificações" aria-haspopup="dialog" aria-controls="notificationDrawer">
    <i class="bi bi-bell" aria-hidden="true"></i>
    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger"
          data-notification-count hidden><span data-notification-count-value aria-hidden="true"></span><span class="visually-hidden" data-notification-count-description></span></span>
</button>
